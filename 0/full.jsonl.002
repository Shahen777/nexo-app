{"parentUuid":"c32393ce-f320-4f46-8245-929601983c3c","isSidechain":false,"promptId":"ca452d66-6e3e-487c-8b7f-991ac670b018","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTQQHmi1r9EfJ2BpsBAMSP","type":"tool_result","content":"\"\"\"Client-app catalog for the guided setup: which apps fit each device and how to install them.\n\nPure data, no Telegram code. The first app of every platform is the one the bot recommends;\nSWITCH lists the fallback buttons of each app's install screen.\nOnly the first install link is shown as a button; the rest are offered on the «Не получается» screen.\n`auto_rules` marks apps that load the Russian direct-routing rules from the subscription,\nso banks and marketplaces work without toggling anything. All links are official store/vendor pages.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass\n\nfrom config import PUBLIC_BASE_URL\n\nHAPP_IOS = \"https://apps.apple.com/us/app/happ-proxy-utility/id6504287215?l=ru\"\nHAPP_SITE = \"https://www.happ.su/main\"\nHAPP_PLAY = \"https://play.google.com/store/apps/details?id=com.happproxy\"\nHAPP_APK = \"https://github.com/Happ-proxy/happ-android/releases/latest/download/Happ.apk\"\nHAPP_TV_IOS = \"https://apps.apple.com/us/app/happ-proxy-utility-for-tv/id6748297274\"\nKARING_IOS = \"https://apps.apple.com/app/id6472431552\"  # also in the Russian App Store\nONEXRAY_IOS = \"https://apps.apple.com/app/id6745748773\"  # also in the Russian App Store\nSINGBOX_DOCS = \"https://sing-box.sagernet.org/installation/package-manager/\"\n\n# Our own app (github.com/Shahen777/nexo-app), served from assets/downloads/ of this server:\n# GitHub downloads are often slow from Russia. {file name: content type}\nNEXO_FILES = {\n    \"Nexo-android.apk\": \"application/vnd.android.package-archive\",\n    \"Nexo-android-old.apk\": \"application/vnd.android.package-archive\",\n    \"Nexo-windows-setup.exe\": \"application/vnd.microsoft.portable-executable\",\n    \"Nexo-macos.dmg\": \"application/x-apple-diskimage\",\n}\n\n\n_NEXO_VERSION = r\"(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\"\n_VERSIONED_NEXO_FILES = (\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-android-(?:arm64-v8a|armeabi-v7a|x86_64)\\.apk\"),\n     \"application/vnd.android.package-archive\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-windows-amd64-setup\\.exe\"),\n     \"application/vnd.microsoft.portable-executable\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-windows-amd64\\.zip\"), \"application/zip\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-macos(?:-(?:universal|arm64|amd64))?\\.dmg\"),\n     \"application/x-apple-diskimage\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-macos(?:-(?:universal|arm64|amd64))?\\.zip\"), \"application/zip\"),\n)\n\n\ndef nexo_file_type(name):\n    if name in NEXO_FILES:\n        return NEXO_FILES[name]\n    return next((content_type for pattern, content_type in _VERSIONED_NEXO_FILES if pattern.fullmatch(name)), None)\n\n\ndef nexo_download(name):\n    return f\"{PUBLIC_BASE_URL.rstrip('/')}/nexo/download/{name}\"\n\n\n@dataclass(frozen=True)\nclass App:\n    key: str\n    name: str\n    importer: str | None        # \"happ\" | \"xray\" (HTTPS landing page that opens the app) | \"karing\" | None = QR only\n    auto_rules: bool\n    install: tuple[tuple[str, str], ...]   # (button label, official URL); the first one is the main button\n\n\ndef _app(key, name, importer, auto_rules, install):\n    return App(key, name, importer, auto_rules, tuple(install))\n\n\nCATALOG: dict[str, list[App]] = {\n    \"ios\": [\n        # Recommended: in the Russian App Store and in every other one; Russian rules come from\n        # choosing Russia on first launch.\n        _app(\"karing\", \"Karing\", \"karing\", False, [(\"App Store\", KARING_IOS)]),\n        # Backup: imports the Xray JSON subscription with our rules as a provider configuration.\n        _app(\"onexray\", \"OneXray\", \"xray\", True, [(\"App Store\", ONEXRAY_IOS)]),\n        # Only for App Store accounts of other countries (missing from the Russian App Store).\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"App Store\", HAPP_IOS)]),\n    ],\n    \"android\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"Google Play\", HAPP_PLAY), (\"⬇️ Скачать Happ без Google Play (APK)\", HAPP_APK)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"APK\", nexo_download(\"Nexo-android.apk\")),\n                                            (\"⬇️ Nexo для старых телефонов (APK)\", nexo_download(\"Nexo-android-old.apk\"))]),\n    ],\n    \"windows\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"сайт\", HAPP_SITE)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"установщик\", nexo_download(\"Nexo-windows-setup.exe\"))]),\n    ],\n    \"macos\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"сайт\", HAPP_SITE)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"dmg\", nexo_download(\"Nexo-macos.dmg\"))]),\n    ],\n    \"appletv\": [\n        _app(\"happ\", \"Happ TV\", None, True, [(\"App Store\", HAPP_TV_IOS)]),\n    ],\n    \"androidtv\": [\n        _app(\"happ\", \"Happ\", None, True, [(\"APK\", HAPP_APK)]),\n    ],\n    \"router\": [\n        _app(\"singbox\", \"sing-box\", None, False, [(\"инструкция\", SINGBOX_DOCS)]),\n    ],\n}\n\n# Buttons on the install screen that switch to another app: {platform: {app: [(label, app)]}}.\nSWITCH = {\n    \"ios\": {\n        \"karing\": [(\"Запасной вариант — OneXray\", \"onexray\")],\n        \"onexray\": [(\"‹ Вернуться к Karing\", \"karing\")],\n        \"happ\": [(\"Запасной вариант — Karing\", \"karing\")],\n    },\n    **{platform: {\"happ\": [(\"⬇️ Наше приложение Nexo\", \"nexo\")], \"nexo\": [(\"‹ Вернуться к Happ\", \"happ\")]}\n       for platform in (\"android\", \"windows\", \"macos\")},\n}\n\n# Shown under the install step: how to get past the system warning for an app from outside the stores.\nINSTALL_NOTES = {\n    \"android\": {\"nexo\": \"Телефон спросит, можно ли устанавливать приложения из Telegram или браузера, — разрешите.\"},\n    \"windows\": {\"nexo\": \"Если Windows покажет предупреждение, нажмите «Подробнее» → «Выполнить в любом случае».\"},\n    \"macos\": {\"nexo\": \"Перетащите Nexo в «Программы». Если Mac не открывает его: «Системные настройки» → \"\n                      \"«Конфиденциальность и безопасность» → «Всё равно открыть».\"},\n}\n\n# Video walkthroughs (files in assets/video/, kept out of git): {platform: {app: file name}}.\nVIDEOS = {\"ios\": {\"karing\": \"karing.mp4\"}}\n\n# iPhone: which app to start with, by the country of the user's App Store account.\nSTORE_APP = {\"ru\": \"karing\", \"other\": \"happ\", \"unknown\": \"karing\"}\n\n# How the user turns the VPN on, per platform (step 3).\nPOWER_ON = {\n    \"ios\": \"Откройте {app} и нажмите большую кнопку. iPhone спросит разрешение — нажмите «Разрешить».\",\n    \"android\": \"Откройте {app} и нажмите большую кнопку. Разрешите подключение.\",\n    \"windows\": \"Откройте {app} и нажмите кнопку подключения.\",\n    \"macos\": \"Откройте {app} и нажмите кнопку подключения. Разрешите добавить VPN.\",\n    \"appletv\": \"Откройте {app} на телевизоре и включите подключение.\",\n    \"androidtv\": \"Откройте {app} на телевизоре и включите подключение.\",\n    \"router\": \"Включите профиль в клиенте роутера.\",\n}\n\n\ndef apps_for(platform: str) -> list[App]:\n    return CATALOG.get(platform, [])\n\n\ndef get_app(platform: str, key: str | None) -> App | None:\n    apps = apps_for(platform)\n    if not apps:\n        return None\n    return next((a for a in apps if a.key == key), apps[0])\n=====\n    devices = active_devices(owner)\n    if not devices and not has_legacy(user):\n        return await show(message, \"welcome\", WELCOME, reply_markup=welcome_keyboard())\n    text = f\"<b>{BRAND_TITLE}</b>\\n\\nПодключено устройств: <b>{len(devices)} из {device_limit(user)}</b>.\"\n    until = payments.active_until(user)\n    if until:\n        text += f\"\\nДоступ оплачен до <b>{until:%d.%m.%Y}</b>.\"\n    return await show(message, \"home\", text, reply_markup=main_menu(user))\n\n\n# ---------------------------------------------------------------- step 1 --------\n@router.callback_query(F.data.in_({\"get_vpn\", \"install_karing\"}))\nasync def begin_setup(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.clear()\n    rows = [[cb(label, f\"setup:{key}\") for key, label in MAIN_PLATFORMS[i:i + 2]] for i in (0, 2)]\n    await show_card(callback.message, \"step1\", \"<b>Шаг 1 из 3</b>\\n\\nКакое у вас устройство?\",\n                    reply_markup=kb(*rows, [cb(\"Другое: телевизор, роутер\", \"setup_other\")], [cb(\"‹ Назад\", \"back_main\")]))\n\n\n@router.callback_query(F.data == \"setup_other\")\nasync def other_devices(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.clear()\n    await show_card(callback.message, \"step1\", \"<b>Шаг 1 из 3</b>\\n\\nКакое у вас устройство?\",\n                    reply_markup=kb([cb(label, f\"setup:{key}\") for key, label in OTHER_PLATFORMS[:2]],\n                                    [cb(OTHER_PLATFORMS[2][1], f\"setup:{OTHER_PLATFORMS[2][0]}\")],\n                                    [cb(\"‹ Назад\", \"get_vpn\")]))\n\n\n# ---------------------------------------------------------------- key -----------\nasync def wizard_data(state, nonce):\n    data = await state.get_data()\n    if nonce and data.get(\"request_id\") == nonce and data.get(\"platform\") in PLATFORMS:\n        return data\n    return None\n\n\ndef auto_label(owner, platform):\n    base = PLATFORMS[platform]\n    taken = {d[\"label\"] for d in db.list_devices(owner) if d[\"status\"] not in (\"revoked\", \"failed\")}\n    label, n = base, 2\n    while label in taken:\n        label, n = f\"{base} {n}\", n + 1\n    return label\n\n\nSTORE_QUESTION = (\"<b>Шаг 1 из 3</b>\\n\\nКакой у вас App Store?\\n\\n\"\n                  \"<i>Откройте App Store: если цены в рублях — российский.</i>\")\n\n\n@router.callback_query(F.data.startswith(\"setup:\"))\nasync def choose_platform(callback: CallbackQuery, state: FSMContext):\n    platform = callback.data.split(\":\", 1)[1]\n    if platform not in PLATFORMS or not apps_for(platform):\n        await callback.answer(\"Выберите устройство заново\")\n        return\n    if platform == \"ios\":  # Happ is missing from the Russian App Store, so the app depends on the account's country\n        await callback.answer()\n        await show_card(callback.message, \"step1\", STORE_QUESTION,\n                        reply_markup=kb([cb(\"🇷🇺 Российский\", \"store:ru\"), cb(\"🌍 Другой страны\", \"store:other\")],\n                                        [cb(\"Не знаю\", \"store:unknown\")], [cb(\"‹ Назад\", \"get_vpn\")]))\n        return\n    await start_wizard(callback, state, platform, apps_for(platform)[0].key)\n\n\n@router.callback_query(F.data.startswith(\"store:\"))\nasync def choose_store(callback: CallbackQuery, state: FSMContext):\n    app = STORE_APP.get(callback.data.split(\":\", 1)[1])\n    if not app:\n        await callback.answer(\"Выберите устройство заново\")\n        return\n    await start_wizard(callback, state, \"ios\", app)\n\n\nasync def start_wizard(callback: CallbackQuery, state: FSMContext, platform, app):\n    await state.clear()\n    nonce = secrets.token_hex(8)\n    data = {\"platform\": platform, \"label\": PLATFORMS[platform], \"app\": app, \"request_id\": nonce}\n    await state.set_data(data)\n    owner = callback.from_user.id\n    reusable = [row for row in active_devices(owner) if row[\"platform\"] == platform]\n    legacy = has_legacy(db.get_user(owner))\n    if not legacy and not reusable:\n        await callback.answer(\"Готовлю ключ…\")\n        await provision(callback, state, data)\n        return\n    await callback.answer()\n    rows = []\n    if legacy:\n        rows.append([cb(\"Использовать мой ключ\", f\"reuse_legacy:{nonce}\")])\n    rows += [[cb(f\"Да, это «{row['label'][:24]}»\", f\"reuse_device:{row['id']}:{nonce}\")] for row in reusable]\n    rows += [[cb(\"Нет, это новое устройство\", f\"new_device:{nonce}\")], [cb(\"‹ Назад\", \"get_vpn\")]]\n    await show_card(callback.message, \"step2\",\n                    \"<b>У вас уже есть ключ для этого устройства</b>\\n\\n\"\n                    \"Переустановили приложение или сменили телефон — выберите его. Новое устройство — нажмите «Нет».\",\n                    reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"new_device:\"))\nasync def new_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    data = await wizard_data(state, callback.data.split(\":\", 1)[1])\n    if not data:\n        await callback.answer(STALE)\n        return\n    await callback.answer(\"Готовлю ключ…\")\n    await provision(callback, state, data)\n\n\nasync def provision(callback: CallbackQuery, state: FSMContext, data):\n    owner = callback.from_user.id\n    await show_card(callback.message, \"step2\", \"<b>Шаг 2 из 3</b>\\n\\nГотовлю ваш ключ…\")\n    try:\n        row = await DeviceService().create(owner, callback.from_user.username or \"\", callback.from_user.first_name or \"\",\n                                           auto_label(owner, data[\"platform\"]), data[\"platform\"], data[\"request_id\"])\n    except DeviceError as error:\n        await show_card(callback.message, \"help\", f\"<b>Не удалось подключить</b>\\n\\n{escape(str(error))}\",\n                        reply_markup=kb([support_button()],\n                                        [cb(\"Мои устройства\", \"devices\"), cb(\"Главное меню\", \"back_main\")]))\n        return\n    data = {**data, \"device_id\": row[\"id\"]}\n    if (await state.get_data()).get(\"request_id\") == data[\"request_id\"]:\n        await state.update_data(device_id=row[\"id\"])\n    await render_step2(callback.message, owner, data)\n\n\n@router.callback_query(F.data.startswith(\"reuse_legacy:\"))\nasync def reuse_legacy(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    data = await wizard_data(state, callback.data.split(\":\", 1)[1])\n    if not data or not has_legacy(db.get_user(callback.from_user.id)):\n        await callback.answer(\"Этот ключ недоступен. Начните подключение заново.\", show_alert=True)\n        return\n    await callback.answer()\n    await state.update_data(legacy=True, device_id=None)\n    await render_step2(callback.message, callback.from_user.id, {**data, \"legacy\": True, \"device_id\": None})\n\n\n@router.callback_query(F.data.startswith(\"reuse_device:\"))\nasync def reuse_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    parts = callback.data.split(\":\")\n    data = await wizard_data(state, parts[2]) if len(parts) == 3 else None\n    row = db.get_device(callback.from_user.id, int(parts[1])) if data and parts[1].isdigit() else None\n    if not row or row[\"status\"] != \"active\" or row[\"platform\"] != data[\"platform\"]:\n        await callback.answer(\"Этот ключ недоступен. Начните подключение заново.\", show_alert=True)\n        return\n    await callback.answer()\n    await state.update_data(device_id=row[\"id\"], legacy=False)\n    await render_step2(callback.message, callback.from_user.id, {**data, \"device_id\": row[\"id\"], \"legacy\": False})\n\n\ndef key_urls(owner, data):\n    \"\"\"(label, install page URL, subscription URL for manual import) of the wizard's key, or None.\"\"\"\n    base = PUBLIC_BASE_URL.rstrip(\"/\")\n    if data.get(\"legacy\"):\n        from handlers.vpn import subscription_urls\n        sub, install = subscription_urls(owner)\n        label = \"ваш ключ\"\n    else:\n        row = db.get_device(owner, data.get(\"device_id\") or -1)\n        if not row or row[\"status\"] != \"active\":\n            return None\n        sub, install, label = f\"{base}/sub/{row['token']}\", f\"{base}/install/{row['token']}\", row[\"label\"]\n    app = get_app(data[\"platform\"], data.get(\"app\"))\n    if app and app.auto_rules and install.startswith(\"https://\"):\n        # mihomo profile for Nexo, Xray JSON for the rest; both carry the Russian direct-routing rules\n        sub = nexo_subscription_url(install) if app.key == \"nexo\" else happ_subscription_url(install)\n    return label, install, sub\n\n\ndef import_link(app, install):\n    try:\n        if app.importer == \"happ\":\n            return happ_install_url(install)\n        if app.importer == \"xray\":\n            return client_import_url(install, app.key)\n        if app.importer == \"karing\" and install.startswith(\"https://\"):\n            return install\n    except ValueError:\n        return None\n    return None\n\n\n# ---------------------------------------------------------------- step 2 --------\nasync def render_step2(message, owner, data):\n    \"\"\"Install the app and add the key: two numbered buttons, then «Готово».\"\"\"\n    urls = key_urls(owner, data)\n    if not urls:\n        await show_card(message, \"help\", f\"<b>Ключ не найден</b>\\n\\n{STALE}\",\n                        reply_markup=kb([cb(\"Начать заново\", \"get_vpn\")], [cb(\"Главное меню\", \"back_main\")]))\n        return\n    _, install, _ = urls\n    platform, nonce = data[\"platform\"], data[\"request_id\"]\n    app = get_app(platform, data.get(\"app\"))\n    link = import_link(app, install)\n    apps = apps_for(platform)\n    i = next((n for n, a in enumerate(apps) if a.key == app.key), 0)\n    first = \"1️⃣ Открыть инструкцию\" if platform == \"router\" else f\"1️⃣ Установить {app.name}\"\n    second = f\"Нажмите «Добавить ключ в {app.name}».\" if link else \"Нажмите «QR-код» и отсканируйте его в приложении.\"\n    recommended = \" (рекомендуем)\" if i == 0 and len(apps) > 1 else \"\"\n    text = (f\"<b>Шаг 2 из 3</b>\\n\\n\"\n            f\"1. Установите приложение {app.name}{recommended}.\\n\"\n            f\"2. {second}\\n\"\n            \"3. Вернитесь сюда и нажмите «Готово».\")\n    if platform in (\"windows\", \"macos\"):\n        text += \"\\n\\n<i>Откройте этот чат в Telegram на самом компьютере.</i>\"\n    note = INSTALL_NOTES.get(platform, {}).get(app.key)\n    if note:\n        text += f\"\\n\\n<i>{note}</i>\"\n    if not app.auto_rules and app.importer:\n        text += f\"\\n\\n<i>Чтобы банки и Госуслуги работали, при первом запуске {app.name} выберите страну «Россия».</i>\"\n    rows = [[url(first, app.install[0][1])],\n            [url(f\"2️⃣ Добавить ключ в {app.name}\", link)] if link else [cb(\"2️⃣ QR-код\", f\"ob_qr:{nonce}\")],\n            [cb(\"✅ Готово →\", f\"activate:{platform}\")]]\n    if video_path(VIDEOS.get(platform, {}).get(app.key)):\n        rows.insert(2, [cb(\"▶️ Видео: как это сделать (1 мин)\", f\"howto:{nonce}\")])\n    rows += [[cb(label, f\"app:{key}:{nonce}\")] for label, key in SWITCH.get(platform, {}).get(app.key, [])]\n    rows.append([cb(\"‹ Назад\", \"get_vpn\"), cb(\"Не получается\", f\"stuck:2:{nonce}\")])\n    await show_card(message, \"step2\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"app:\"))","is_error":false}]},"uuid":"6405007b-0a24-4c02-820d-2241db35ecf8","timestamp":"2026-11-07T19:43:23.553Z","toolUseResult":{"stdout":"\"\"\"Client-app catalog for the guided setup: which apps fit each device and how to install them.\n\nPure data, no Telegram code. The first app of every platform is the one the bot recommends;\nSWITCH lists the fallback buttons of each app's install screen.\nOnly the first install link is shown as a button; the rest are offered on the «Не получается» screen.\n`auto_rules` marks apps that load the Russian direct-routing rules from the subscription,\nso banks and marketplaces work without toggling anything. All links are official store/vendor pages.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass\n\nfrom config import PUBLIC_BASE_URL\n\nHAPP_IOS = \"https://apps.apple.com/us/app/happ-proxy-utility/id6504287215?l=ru\"\nHAPP_SITE = \"https://www.happ.su/main\"\nHAPP_PLAY = \"https://play.google.com/store/apps/details?id=com.happproxy\"\nHAPP_APK = \"https://github.com/Happ-proxy/happ-android/releases/latest/download/Happ.apk\"\nHAPP_TV_IOS = \"https://apps.apple.com/us/app/happ-proxy-utility-for-tv/id6748297274\"\nKARING_IOS = \"https://apps.apple.com/app/id6472431552\"  # also in the Russian App Store\nONEXRAY_IOS = \"https://apps.apple.com/app/id6745748773\"  # also in the Russian App Store\nSINGBOX_DOCS = \"https://sing-box.sagernet.org/installation/package-manager/\"\n\n# Our own app (github.com/Shahen777/nexo-app), served from assets/downloads/ of this server:\n# GitHub downloads are often slow from Russia. {file name: content type}\nNEXO_FILES = {\n    \"Nexo-android.apk\": \"application/vnd.android.package-archive\",\n    \"Nexo-android-old.apk\": \"application/vnd.android.package-archive\",\n    \"Nexo-windows-setup.exe\": \"application/vnd.microsoft.portable-executable\",\n    \"Nexo-macos.dmg\": \"application/x-apple-diskimage\",\n}\n\n\n_NEXO_VERSION = r\"(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\"\n_VERSIONED_NEXO_FILES = (\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-android-(?:arm64-v8a|armeabi-v7a|x86_64)\\.apk\"),\n     \"application/vnd.android.package-archive\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-windows-amd64-setup\\.exe\"),\n     \"application/vnd.microsoft.portable-executable\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-windows-amd64\\.zip\"), \"application/zip\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-macos(?:-(?:universal|arm64|amd64))?\\.dmg\"),\n     \"application/x-apple-diskimage\"),\n    (re.compile(rf\"Nexo-{_NEXO_VERSION}-macos(?:-(?:universal|arm64|amd64))?\\.zip\"), \"application/zip\"),\n)\n\n\ndef nexo_file_type(name):\n    if name in NEXO_FILES:\n        return NEXO_FILES[name]\n    return next((content_type for pattern, content_type in _VERSIONED_NEXO_FILES if pattern.fullmatch(name)), None)\n\n\ndef nexo_download(name):\n    return f\"{PUBLIC_BASE_URL.rstrip('/')}/nexo/download/{name}\"\n\n\n@dataclass(frozen=True)\nclass App:\n    key: str\n    name: str\n    importer: str | None        # \"happ\" | \"xray\" (HTTPS landing page that opens the app) | \"karing\" | None = QR only\n    auto_rules: bool\n    install: tuple[tuple[str, str], ...]   # (button label, official URL); the first one is the main button\n\n\ndef _app(key, name, importer, auto_rules, install):\n    return App(key, name, importer, auto_rules, tuple(install))\n\n\nCATALOG: dict[str, list[App]] = {\n    \"ios\": [\n        # Recommended: in the Russian App Store and in every other one; Russian rules come from\n        # choosing Russia on first launch.\n        _app(\"karing\", \"Karing\", \"karing\", False, [(\"App Store\", KARING_IOS)]),\n        # Backup: imports the Xray JSON subscription with our rules as a provider configuration.\n        _app(\"onexray\", \"OneXray\", \"xray\", True, [(\"App Store\", ONEXRAY_IOS)]),\n        # Only for App Store accounts of other countries (missing from the Russian App Store).\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"App Store\", HAPP_IOS)]),\n    ],\n    \"android\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"Google Play\", HAPP_PLAY), (\"⬇️ Скачать Happ без Google Play (APK)\", HAPP_APK)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"APK\", nexo_download(\"Nexo-android.apk\")),\n                                            (\"⬇️ Nexo для старых телефонов (APK)\", nexo_download(\"Nexo-android-old.apk\"))]),\n    ],\n    \"windows\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"сайт\", HAPP_SITE)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"установщик\", nexo_download(\"Nexo-windows-setup.exe\"))]),\n    ],\n    \"macos\": [\n        _app(\"happ\", \"Happ\", \"happ\", True, [(\"сайт\", HAPP_SITE)]),\n        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"dmg\", nexo_download(\"Nexo-macos.dmg\"))]),\n    ],\n    \"appletv\": [\n        _app(\"happ\", \"Happ TV\", None, True, [(\"App Store\", HAPP_TV_IOS)]),\n    ],\n    \"androidtv\": [\n        _app(\"happ\", \"Happ\", None, True, [(\"APK\", HAPP_APK)]),\n    ],\n    \"router\": [\n        _app(\"singbox\", \"sing-box\", None, False, [(\"инструкция\", SINGBOX_DOCS)]),\n    ],\n}\n\n# Buttons on the install screen that switch to another app: {platform: {app: [(label, app)]}}.\nSWITCH = {\n    \"ios\": {\n        \"karing\": [(\"Запасной вариант — OneXray\", \"onexray\")],\n        \"onexray\": [(\"‹ Вернуться к Karing\", \"karing\")],\n        \"happ\": [(\"Запасной вариант — Karing\", \"karing\")],\n    },\n    **{platform: {\"happ\": [(\"⬇️ Наше приложение Nexo\", \"nexo\")], \"nexo\": [(\"‹ Вернуться к Happ\", \"happ\")]}\n       for platform in (\"android\", \"windows\", \"macos\")},\n}\n\n# Shown under the install step: how to get past the system warning for an app from outside the stores.\nINSTALL_NOTES = {\n    \"android\": {\"nexo\": \"Телефон спросит, можно ли устанавливать приложения из Telegram или браузера, — разрешите.\"},\n    \"windows\": {\"nexo\": \"Если Windows покажет предупреждение, нажмите «Подробнее» → «Выполнить в любом случае».\"},\n    \"macos\": {\"nexo\": \"Перетащите Nexo в «Программы». Если Mac не открывает его: «Системные настройки» → \"\n                      \"«Конфиденциальность и безопасность» → «Всё равно открыть».\"},\n}\n\n# Video walkthroughs (files in assets/video/, kept out of git): {platform: {app: file name}}.\nVIDEOS = {\"ios\": {\"karing\": \"karing.mp4\"}}\n\n# iPhone: which app to start with, by the country of the user's App Store account.\nSTORE_APP = {\"ru\": \"karing\", \"other\": \"happ\", \"unknown\": \"karing\"}\n\n# How the user turns the VPN on, per platform (step 3).\nPOWER_ON = {\n    \"ios\": \"Откройте {app} и нажмите большую кнопку. iPhone спросит разрешение — нажмите «Разрешить».\",\n    \"android\": \"Откройте {app} и нажмите большую кнопку. Разрешите подключение.\",\n    \"windows\": \"Откройте {app} и нажмите кнопку подключения.\",\n    \"macos\": \"Откройте {app} и нажмите кнопку подключения. Разрешите добавить VPN.\",\n    \"appletv\": \"Откройте {app} на телевизоре и включите подключение.\",\n    \"androidtv\": \"Откройте {app} на телевизоре и включите подключение.\",\n    \"router\": \"Включите профиль в клиенте роутера.\",\n}\n\n\ndef apps_for(platform: str) -> list[App]:\n    return CATALOG.get(platform, [])\n\n\ndef get_app(platform: str, key: str | None) -> App | None:\n    apps = apps_for(platform)\n    if not apps:\n        return None\n    return next((a for a in apps if a.key == key), apps[0])\n=====\n    devices = active_devices(owner)\n    if not devices and not has_legacy(user):\n        return await show(message, \"welcome\", WELCOME, reply_markup=welcome_keyboard())\n    text = f\"<b>{BRAND_TITLE}</b>\\n\\nПодключено устройств: <b>{len(devices)} из {device_limit(user)}</b>.\"\n    until = payments.active_until(user)\n    if until:\n        text += f\"\\nДоступ оплачен до <b>{until:%d.%m.%Y}</b>.\"\n    return await show(message, \"home\", text, reply_markup=main_menu(user))\n\n\n# ---------------------------------------------------------------- step 1 --------\n@router.callback_query(F.data.in_({\"get_vpn\", \"install_karing\"}))\nasync def begin_setup(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.clear()\n    rows = [[cb(label, f\"setup:{key}\") for key, label in MAIN_PLATFORMS[i:i + 2]] for i in (0, 2)]\n    await show_card(callback.message, \"step1\", \"<b>Шаг 1 из 3</b>\\n\\nКакое у вас устройство?\",\n                    reply_markup=kb(*rows, [cb(\"Другое: телевизор, роутер\", \"setup_other\")], [cb(\"‹ Назад\", \"back_main\")]))\n\n\n@router.callback_query(F.data == \"setup_other\")\nasync def other_devices(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.clear()\n    await show_card(callback.message, \"step1\", \"<b>Шаг 1 из 3</b>\\n\\nКакое у вас устройство?\",\n                    reply_markup=kb([cb(label, f\"setup:{key}\") for key, label in OTHER_PLATFORMS[:2]],\n                                    [cb(OTHER_PLATFORMS[2][1], f\"setup:{OTHER_PLATFORMS[2][0]}\")],\n                                    [cb(\"‹ Назад\", \"get_vpn\")]))\n\n\n# ---------------------------------------------------------------- key -----------\nasync def wizard_data(state, nonce):\n    data = await state.get_data()\n    if nonce and data.get(\"request_id\") == nonce and data.get(\"platform\") in PLATFORMS:\n        return data\n    return None\n\n\ndef auto_label(owner, platform):\n    base = PLATFORMS[platform]\n    taken = {d[\"label\"] for d in db.list_devices(owner) if d[\"status\"] not in (\"revoked\", \"failed\")}\n    label, n = base, 2\n    while label in taken:\n        label, n = f\"{base} {n}\", n + 1\n    return label\n\n\nSTORE_QUESTION = (\"<b>Шаг 1 из 3</b>\\n\\nКакой у вас App Store?\\n\\n\"\n                  \"<i>Откройте App Store: если цены в рублях — российский.</i>\")\n\n\n@router.callback_query(F.data.startswith(\"setup:\"))\nasync def choose_platform(callback: CallbackQuery, state: FSMContext):\n    platform = callback.data.split(\":\", 1)[1]\n    if platform not in PLATFORMS or not apps_for(platform):\n        await callback.answer(\"Выберите устройство заново\")\n        return\n    if platform == \"ios\":  # Happ is missing from the Russian App Store, so the app depends on the account's country\n        await callback.answer()\n        await show_card(callback.message, \"step1\", STORE_QUESTION,\n                        reply_markup=kb([cb(\"🇷🇺 Российский\", \"store:ru\"), cb(\"🌍 Другой страны\", \"store:other\")],\n                                        [cb(\"Не знаю\", \"store:unknown\")], [cb(\"‹ Назад\", \"get_vpn\")]))\n        return\n    await start_wizard(callback, state, platform, apps_for(platform)[0].key)\n\n\n@router.callback_query(F.data.startswith(\"store:\"))\nasync def choose_store(callback: CallbackQuery, state: FSMContext):\n    app = STORE_APP.get(callback.data.split(\":\", 1)[1])\n    if not app:\n        await callback.answer(\"Выберите устройство заново\")\n        return\n    await start_wizard(callback, state, \"ios\", app)\n\n\nasync def start_wizard(callback: CallbackQuery, state: FSMContext, platform, app):\n    await state.clear()\n    nonce = secrets.token_hex(8)\n    data = {\"platform\": platform, \"label\": PLATFORMS[platform], \"app\": app, \"request_id\": nonce}\n    await state.set_data(data)\n    owner = callback.from_user.id\n    reusable = [row for row in active_devices(owner) if row[\"platform\"] == platform]\n    legacy = has_legacy(db.get_user(owner))\n    if not legacy and not reusable:\n        await callback.answer(\"Готовлю ключ…\")\n        await provision(callback, state, data)\n        return\n    await callback.answer()\n    rows = []\n    if legacy:\n        rows.append([cb(\"Использовать мой ключ\", f\"reuse_legacy:{nonce}\")])\n    rows += [[cb(f\"Да, это «{row['label'][:24]}»\", f\"reuse_device:{row['id']}:{nonce}\")] for row in reusable]\n    rows += [[cb(\"Нет, это новое устройство\", f\"new_device:{nonce}\")], [cb(\"‹ Назад\", \"get_vpn\")]]\n    await show_card(callback.message, \"step2\",\n                    \"<b>У вас уже есть ключ для этого устройства</b>\\n\\n\"\n                    \"Переустановили приложение или сменили телефон — выберите его. Новое устройство — нажмите «Нет».\",\n                    reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"new_device:\"))\nasync def new_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    data = await wizard_data(state, callback.data.split(\":\", 1)[1])\n    if not data:\n        await callback.answer(STALE)\n        return\n    await callback.answer(\"Готовлю ключ…\")\n    await provision(callback, state, data)\n\n\nasync def provision(callback: CallbackQuery, state: FSMContext, data):\n    owner = callback.from_user.id\n    await show_card(callback.message, \"step2\", \"<b>Шаг 2 из 3</b>\\n\\nГотовлю ваш ключ…\")\n    try:\n        row = await DeviceService().create(owner, callback.from_user.username or \"\", callback.from_user.first_name or \"\",\n                                           auto_label(owner, data[\"platform\"]), data[\"platform\"], data[\"request_id\"])\n    except DeviceError as error:\n        await show_card(callback.message, \"help\", f\"<b>Не удалось подключить</b>\\n\\n{escape(str(error))}\",\n                        reply_markup=kb([support_button()],\n                                        [cb(\"Мои устройства\", \"devices\"), cb(\"Главное меню\", \"back_main\")]))\n        return\n    data = {**data, \"device_id\": row[\"id\"]}\n    if (await state.get_data()).get(\"request_id\") == data[\"request_id\"]:\n        await state.update_data(device_id=row[\"id\"])\n    await render_step2(callback.message, owner, data)\n\n\n@router.callback_query(F.data.startswith(\"reuse_legacy:\"))\nasync def reuse_legacy(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    data = await wizard_data(state, callback.data.split(\":\", 1)[1])\n    if not data or not has_legacy(db.get_user(callback.from_user.id)):\n        await callback.answer(\"Этот ключ недоступен. Начните подключение заново.\", show_alert=True)\n        return\n    await callback.answer()\n    await state.update_data(legacy=True, device_id=None)\n    await render_step2(callback.message, callback.from_user.id, {**data, \"legacy\": True, \"device_id\": None})\n\n\n@router.callback_query(F.data.startswith(\"reuse_device:\"))\nasync def reuse_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    parts = callback.data.split(\":\")\n    data = await wizard_data(state, parts[2]) if len(parts) == 3 else None\n    row = db.get_device(callback.from_user.id, int(parts[1])) if data and parts[1].isdigit() else None\n    if not row or row[\"status\"] != \"active\" or row[\"platform\"] != data[\"platform\"]:\n        await callback.answer(\"Этот ключ недоступен. Начните подключение заново.\", show_alert=True)\n        return\n    await callback.answer()\n    await state.update_data(device_id=row[\"id\"], legacy=False)\n    await render_step2(callback.message, callback.from_user.id, {**data, \"device_id\": row[\"id\"], \"legacy\": False})\n\n\ndef key_urls(owner, data):\n    \"\"\"(label, install page URL, subscription URL for manual import) of the wizard's key, or None.\"\"\"\n    base = PUBLIC_BASE_URL.rstrip(\"/\")\n    if data.get(\"legacy\"):\n        from handlers.vpn import subscription_urls\n        sub, install = subscription_urls(owner)\n        label = \"ваш ключ\"\n    else:\n        row = db.get_device(owner, data.get(\"device_id\") or -1)\n        if not row or row[\"status\"] != \"active\":\n            return None\n        sub, install, label = f\"{base}/sub/{row['token']}\", f\"{base}/install/{row['token']}\", row[\"label\"]\n    app = get_app(data[\"platform\"], data.get(\"app\"))\n    if app and app.auto_rules and install.startswith(\"https://\"):\n        # mihomo profile for Nexo, Xray JSON for the rest; both carry the Russian direct-routing rules\n        sub = nexo_subscription_url(install) if app.key == \"nexo\" else happ_subscription_url(install)\n    return label, install, sub\n\n\ndef import_link(app, install):\n    try:\n        if app.importer == \"happ\":\n            return happ_install_url(install)\n        if app.importer == \"xray\":\n            return client_import_url(install, app.key)\n        if app.importer == \"karing\" and install.startswith(\"https://\"):\n            return install\n    except ValueError:\n        return None\n    return None\n\n\n# ---------------------------------------------------------------- step 2 --------\nasync def render_step2(message, owner, data):\n    \"\"\"Install the app and add the key: two numbered buttons, then «Готово».\"\"\"\n    urls = key_urls(owner, data)\n    if not urls:\n        await show_card(message, \"help\", f\"<b>Ключ не найден</b>\\n\\n{STALE}\",\n                        reply_markup=kb([cb(\"Начать заново\", \"get_vpn\")], [cb(\"Главное меню\", \"back_main\")]))\n        return\n    _, install, _ = urls\n    platform, nonce = data[\"platform\"], data[\"request_id\"]\n    app = get_app(platform, data.get(\"app\"))\n    link = import_link(app, install)\n    apps = apps_for(platform)\n    i = next((n for n, a in enumerate(apps) if a.key == app.key), 0)\n    first = \"1️⃣ Открыть инструкцию\" if platform == \"router\" else f\"1️⃣ Установить {app.name}\"\n    second = f\"Нажмите «Добавить ключ в {app.name}».\" if link else \"Нажмите «QR-код» и отсканируйте его в приложении.\"\n    recommended = \" (рекомендуем)\" if i == 0 and len(apps) > 1 else \"\"\n    text = (f\"<b>Шаг 2 из 3</b>\\n\\n\"\n            f\"1. Установите приложение {app.name}{recommended}.\\n\"\n            f\"2. {second}\\n\"\n            \"3. Вернитесь сюда и нажмите «Готово».\")\n    if platform in (\"windows\", \"macos\"):\n        text += \"\\n\\n<i>Откройте этот чат в Telegram на самом компьютере.</i>\"\n    note = INSTALL_NOTES.get(platform, {}).get(app.key)\n    if note:\n        text += f\"\\n\\n<i>{note}</i>\"\n    if not app.auto_rules and app.importer:\n        text += f\"\\n\\n<i>Чтобы банки и Госуслуги работали, при первом запуске {app.name} выберите страну «Россия».</i>\"\n    rows = [[url(first, app.install[0][1])],\n            [url(f\"2️⃣ Добавить ключ в {app.name}\", link)] if link else [cb(\"2️⃣ QR-код\", f\"ob_qr:{nonce}\")],\n            [cb(\"✅ Готово →\", f\"activate:{platform}\")]]\n    if video_path(VIDEOS.get(platform, {}).get(app.key)):\n        rows.insert(2, [cb(\"▶️ Видео: как это сделать (1 мин)\", f\"howto:{nonce}\")])\n    rows += [[cb(label, f\"app:{key}:{nonce}\")] for label, key in SWITCH.get(platform, {}).get(app.key, [])]\n    rows.append([cb(\"‹ Назад\", \"get_vpn\"), cb(\"Не получается\", f\"stuck:2:{nonce}\")])\n    await show_card(message, \"step2\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"app:\"))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"c88f55bf-bcc2-4a2c-9e18-7da87cfeed4a","context":{"git_state":{"cwd":"/Users/Sagenkazaran/Projects/nexo-app","root":"/Users/Sagenkazaran/Projects/nexo-app","branch":"fix/adaptive-headers","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"},{"name":"upstream","host":"github.com","remote":"chen08209/FlClash","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"}]}},"live_cwd":"/Users/Sagenkazaran/Projects/nexo-app","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"c32393ce-f320-4f46-8245-929601983c3c","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"fix/adaptive-headers","slug":"deep-singing-taco"}
