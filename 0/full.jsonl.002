__list_projects\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__list_voices\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__list_website_categories\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__list_websites\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__list_workspaces\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__manage_reference_elements\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__media_confirm\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__media_import_url\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__media_upload\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__media_upload_widget\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__models_explore\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__motion_control\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__move_folder\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__move_project_asset\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__outpaint_image\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__participate_in_contest\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__publish_playable_game\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__publish_project\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__publish_website\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__reframe\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__register_katana_result\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__register_result\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__register_what_if_result\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__remove_background\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__remove_project_asset\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__rename_folder\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__rename_website\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__resolve_explainer_preset\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__resolve_project_assets\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__sandbox_exec\nREDACTED\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__scene_builder_3d_create_project\nmcp__efc2fbfd-2467-4027-aef7-177d67d0371f__scene_builder_3d_generate_angles\nmcp__efc2fbfd-2467-4027-aef7-177d67