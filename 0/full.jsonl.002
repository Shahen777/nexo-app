rlsplit\n\nfrom happ_client import DIRECT_DOMAINS, DIRECT_IPS\n\nSELECT = 'Nexo'\nAUTO = 'Автовыбор'\nDOMESTIC_DNS = '77.88.8.8'\nPROBE_URL = 'https://www.gstatic.com/generate_204'\n\ndef profile(encoded_payload):\n    proxies = [_proxy(line) for line in base64.b64decode(encoded_payload, validate=True).decode().splitlines()\n    if not proxies:\n        raise ValueError('No protected VPN profiles')\n    names = [p['name'] for p in proxies]\n    rules = [f'IP-CIDR,{DOMESTIC_DNS}/32,DIRECT,no-resolve']\n    rules += [f'DOMAIN-SUFFIX,{domain},DIRECT' for domain in DIRECT_DOMAINS]\n    rules += [f\"{'IP-CIDR6' if ':' in net else 'IP-CIDR'},{net},DIRECT,no-resolve\" for net in DIRECT_IPS]\n    rules.append(f'MATCH,{SELECT}')\n    return {\n\"\"\"Platega payments: a payment link per tariff, status checks and the provider callback.\n\nSecrets come from the environment (PLATEGA_MERCHANT_ID, PLATEGA_SECRET); without them paym\nare switched off and the bot hides the pay buttons. The provider decides the payment metho\nits own page (СБП, card, crypto). Access is extended only by database.settle_payment.\n\"\"\"\nfrom __future__ import annotations\n\nimport hmac\nimport logging\nimport os\n\nimport aiohttp\n\nimport database as db\nimport legal\nfrom config import BOT_TOKEN, BOT_USERNAME, BRAND_TITLE\n\nlogger = logging.getLogger(\"AuraVPN.payments\")\n\n    async def test_every_client_gets_the_end_date_and_no_notice_while_time_remains(self):\n        _, token, until = await self.period_ending_in(timedelta(days=10))\n        for path in (\"/sub/\", \"/happ/sub/\", \"/nexo/sub/\"):\n            response = await self.client.get(path + token)\n            self.assertEqual(response.status, 200)\n            self.assertIn(f\"expire={calendar.timegm(until.timetuple())}\", response.headers[\"subscription-userinfo\"])\n            self.assertEqual(response.headers[\"announce\"], \"0\")\n            self.assertEqual(response.headers[\"profile-web-page-url\"], \"https://vpn.example/app#pay\")\n\n    async def test_vpn_app_warns_in_the_last_days(self):\n        location, token, until = await self.period_ending_in(timedelta(days=2))\n        response = await self.client.get(\"/happ/sub/\" + token)\n        notice = self.notice(response)\n\"\"\"Web cabinet without Telegram: real routes, SQLite and device provisioning; panels and P\nimport asyncio\nimport base64\nimport calendar\nimport importlib\nimport os\nimport re\nimport tempfile\nimport unittest\nfrom datetime import datetime, timedelta, timezone\nfrom unittest.mock import AsyncMock, patch\n\nfrom aiohttp.test_utils import TestClient, TestServer\n\nimport database as db\nimport payments\nimport webapp\nfrom test_devices import Panel\nfrom vpn_service import Node\n\nIPHONE = \"Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Vers\nANDROID = \"Mozilla/5.0 (Linux; Android 15; Pixel 9) AppleWebKit/537.36 Chrome/130.0 Mobile\n\n\nclass WebCabinetTests(unittest.IsolatedAsyncioTestCase):\n    async def asyncSetUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.db_patch = patch.object(db, \"DB_PATH\", self.tmp.name + \"/test.db\")\n        self.db_patch.start()\n        db.init_db()\n        webapp._starts.clear()\n        webapp._attempts.clear()\n        webapp._restore_fails.clear()\n        self.nodes = [Node(k, k, k + \".example\", 443, \"pk\", \"sid\", \"sni\") for k in (\"a\", \"\n        self.panels = {n.key: Panel() for n in self.nodes}\n        import subscription\n        self.subscription = importlib.reload(subscription)\n        app = self.subscription.create_app(database_module=db, node_provider=lambda: self.\n                                           public_base_url=\"https://vpn.example\", device_c\n        self.client = TestClient(TestServer(app))\n25:class WebCabinetTests(unittest.IsolatedAsyncioTestCase):\n26:    async def asyncSetUp(self):\n252:class WebLinkAndExpiryTests(WebCabinetTests):\n276:class UnlimitedAccountTests(WebCabinetTe