{"parentUuid":"7e3b11d2-6186-471e-8b84-52ef5c6d8083","isSidechain":false,"promptId":"589016f6-3825-42e9-b835-49c190edd644","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tdQnePJiBbVcJuzCBQU4j","type":"tool_result","content":"1\timport 'dart:async';\n2\t\n3\timport 'package:fl_clash/common/common.dart';\n4\timport 'package:fl_clash/enum/enum.dart';\n5\timport 'package:fl_clash/models/models.dart';\n6\timport 'package:fl_clash/providers/providers.dart';\n7\timport 'package:fl_clash/ui/icons/icons.dart';\n8\timport 'package:fl_clash/ui/ui.dart';\n9\timport 'package:fl_clash/views/proxies/card.dart';\n10\timport 'package:flutter/services.dart';\n11\timport 'package:flutter_riverpod/flutter_riverpod.dart';\n12\timport 'package:material_ui/material_ui.dart';\n13\t\n14\timport 'strings.dart';\n15\t\n16\tconst _accent = Color(0xFF2F6BFF);\n17\tconst _navy = Color(0xFF0B1F3A);\n18\tconst _lightPage = Color(0xFFF5F7FB);\n19\tconst _lightCard = Colors.white;\n20\tconst _darkCard = Color(0xFF13294A);\n21\tconst _warning = Color(0xFFF59E0B);\n22\tconst _contentWidth = 440.0;\n23\t\n24\tColor _pageColor(BuildContext context) =>\n25\t    Theme.of(context).brightness == Brightness.dark ? _navy : _lightPage;\n26\t\n27\tColor _cardColor(BuildContext context) =>\n28\t    Theme.of(context).brightness == Brightness.dark ? _darkCard : _lightCard;\n29\t\n30\tColor _textColor(BuildContext context) =>\n31\t    Theme.of(context).brightness == Brightness.dark ? Colors.white : _navy;\n32\t\n33\tTextStyle _manrope(\n34\t  BuildContext context,\n35\t  AppTextStyle style, {\n36\t  double weight = 400,\n37\t  Color? color,\n38\t}) {\n39\t  return style\n40\t      .of(context)\n41\t      .copyWith(\n42\t        color: color ?? _textColor(context),\n43\t        fontFamily: 'Manrope',\n44\t        fontVariations: [FontVariation('wght', weight)],\n45\t      );\n46\t}\n47\t\n48\tclass NexoHomeView extends ConsumerWidget {\n49\t  const NexoHomeView({super.key});\n50\t\n51\t  String _statusText({\n52\t    required bool hasProfile,\n53\t    required bool isRunning,\n54\t    required CoreStatus coreStatus,\n55\t  }) {\n56\t    if (!hasProfile) return NexoStrings.noAccessKey;\n57\t    if (coreStatus == CoreStatus.connecting) return NexoStrings.connecting;\n58\t    return isRunning ? NexoStrings.protected : NexoStrings.disconnected;\n59\t  }\n60\t\n61\t  @override\n62\t  Widget build(BuildContext context, WidgetRef ref) {\n63\t    final profile = ref.watch(currentProfileProvider);\n64\t    final isRunning = ref.watch(isStartProvider);\n65\t    final coreStatus = ref.watch(coreStatusProvider);\n66\t    final runtime = ref.watch(runTimeProvider);\n67\t    final status = _statusText(\n68\t      hasProfile: profile != null,\n69\t      isRunning: isRunning,\n70\t      coreStatus: coreStatus,\n71\t    );\n72\t    return CommonScaffold(\n73\t      backgroundColor: _pageColor(context),\n74\t      titleWidget: Text(\n75\t        NexoStrings.appName,\n76\t        style: AppTextStyle.pageTitle\n77\t            .of(context)\n78\t            .copyWith(\n79\t              color: _textColor(context),\n80\t              fontFamily: 'Unbounded',\n81\t              fontVariations: const [FontVariation('wght', 650)],\n82\t            ),\n83\t      ),\n84\t      body: SingleChildScrollView(\n85\t        padding: EdgeInsets.fromLTRB(20, 72, 20, 24 + context.bottomInset),\n86\t        child: Center(\n87\t          child: ConstrainedBox(\n88\t            constraints: const BoxConstraints(maxWidth: _contentWidth),\n89\t            child: Column(\n90\t              crossAxisAlignment: CrossAxisAlignment.stretch,\n91\t              children: [\n92\t                Text(\n93\t                  status,\n94\t                  textAlign: TextAlign.center,\n95\t                  style: _manrope(\n96\t                    context,\n97\t                    AppTextStyle.subheadline,\n98\t                    weight: 500,\n99\t                    color: _textColor(context).withValues(alpha: 0.62),\n100\t                  ),\n101\t                ),\n102\t                const SizedBox(height: 28),\n103\t                if (profile == null)\n104\t                  const _EmptyState()\n105\t                else ...[\n106\t                  _ConnectButton(\n107\t                    isRunning: isRunning,\n108\t                    connecting: coreStatus == CoreStatus.connecting,\n109\t                    runtime: runtime,\n110\t                  ),\n111\t                  const SizedBox(height: 28),\n112\t                  const _ServerCard(),\n113\t                  const SizedBox(height: 16),\n114\t                  _InfoRow(profile: profile),\n115\t                ],\n116\t              ],\n117\t            ),\n118\t          ),\n119\t        ),\n120\t      ),\n121\t    );\n122\t  }\n123\t}\n124\t\n125\tclass _ConnectButton extends ConsumerWidget {\n126\t  const _ConnectButton({\n127\t    required this.isRunning,\n128\t    required this.connecting,\n129\t    required this.runtime,\n130\t  });\n131\t\n132\t  final bool isRunning;\n133\t  final bool connecting;\n134\t  final int? runtime;\n135\t\n136\t  void _toggle(WidgetRef ref) {\n137\t    if (connecting) return;\n138\t    if (system.isAndroid) {\n139\t      unawaited(HapticFeedback.mediumImpact());\n140\t    }\n141\t    ref.read(commonActionProvider.notifier).toggleRunning();\n142\t  }\n143\t\n144\t  @override\n145\t  Widget build(BuildContext context, WidgetRef ref) {\n146\t    final foreground = isRunning ? Colors.white : _textColor(context);\n147\t    final fill = isRunning ? _accent : _cardColor(context);\n148\t    final label = connecting\n149\t        ? NexoStrings.connecting\n150\t        : isRunning\n151\t        ? NexoStrings.connected\n152\t        : NexoStrings.connect;\n153\t    return Center(\n154\t      child: SizedBox.square(\n155\t        dimension: 240,\n156\t        child: Stack(\n157\t          alignment: Alignment.center,\n158\t          children: [\n159\t            if (connecting)\n160\t              const CommonCircleLoading(\n161\t                size: 240,\n162\t                color: _accent,\n163\t                semanticLabel: NexoStrings.connecting,\n164\t              ),\n165\t            AnimatedSwitcher(\n166\t              duration: const Duration(milliseconds: 250),\n167\t              child: SizedBox.square(\n168\t                key: ValueKey((isRunning, connecting)),\n169\t                dimension: 192,\n170\t                child: Material(\n171\t                  color: fill,\n172\t                  elevation: isRunning ? 12 : 4,\n173\t                  shadowColor: _accent.withValues(\n174\t                    alpha: isRunning ? 0.34 : 0.1,\n175\t                  ),\n176\t                  shape: AppShape.circle.copyWith(\n177\t                    side: isRunning\n178\t                        ? BorderSide.none\n179\t                        : const BorderSide(color: _accent, width: 2),\n180\t                  ),\n181\t                  clipBehavior: Clip.antiAlias,\n182\t                  child: InkWell(\n183\t                    customBorder: AppShape.circle,\n184\t                    onTap: connecting ? null : () => _toggle(ref),\n185\t                    child: Column(\n186\t                      mainAxisAlignment: MainAxisAlignment.center,\n187\t                      children: [\n188\t                        Text(\n189\t                          label,\n190\t                          textAlign: TextAlign.center,\n191\t                          style: _manrope(\n192\t                            context,\n193\t                            AppTextStyle.headline,\n194\t                            weight: 650,\n195\t                            color: foreground,\n196\t                          ),\n197\t                        ),\n198\t                        if (isRunning) ...[\n199\t                          const SizedBox(height: 8),\n200\t                          Text(\n201\t                            getTimeText(runtime),\n202\t                            style: _manrope(\n203\t                              context,\n204\t                              AppTextStyle.footnote,\n205\t                              weight: 500,\n206\t                              color: foreground.withValues(alpha: 0.78),\n207\t                            ),\n208\t                          ),\n209\t                        ],\n210\t                      ],\n211\t                    ),\n212\t                  ),\n213\t                ),\n214\t              ),\n215\t            ),\n216\t          ],\n217\t        ),\n218\t      ),\n219\t    );\n220\t  }\n221\t}\n222\t\n223\tclass _ServerCard extends ConsumerWidget {\n224\t  const _ServerCard();\n225\t\n226\t  Future<void> _openPicker(BuildContext context) {\n227\t    return showFormSheet<void>(\n228\t      context: context,\n229\t      builder: (_) => const _ServerPicker(),\n230\t    );\n231\t  }\n232\t\n233\t  @override\n234\t  Widget build(BuildContext context, WidgetRef ref) {\n235\t    final groups = ref.watch(groupsProvider);\n236\t    final group = groups.getGroup(NexoStrings.appName);\n237\t    final selected = ref.watch(proxyNameProvider(NexoStrings.appName));\n238\t    final selectedName = (selected ?? '').takeFirstValid([\n239\t      group?.realNow ?? '',\n240\t      NexoStrings.automatic,\n241\t    ]);\n242\t    final autoNow =\n243\t        groups.getGroup(NexoStrings.automatic)?.realNow ??\n244\t        group?.all\n245\t            .where((proxy) => proxy.name == NexoStrings.automatic)\n246\t            .firstOrNull\n247\t            ?.now ??\n248\t        '';\n249\t    final actual = selectedName == NexoStrings.automatic ? autoNow : '';\n250\t    final delay = group == null\n251\t        ? null\n252\t        : ref.watch(\n253\t            delayProvider(proxyName: selectedName, testUrl: group.testUrl),\n254\t          );\n255\t    return _NexoCard(\n256\t      onPressed: group == null ? null : () => _openPicker(context),\n257\t      child: Row(\n258\t        children: [\n259\t          Flexible(\n260\t            child: _ServerMark(name: actual.isNotEmpty ? actual : selectedName),\n261\t          ),\n262\t          const SizedBox(width: 14),\n263\t          Expanded(\n264\t            child: Column(\n265\t              crossAxisAlignment: CrossAxisAlignment.start,\n266\t              children: [\n267\t                Text(\n268\t                  NexoStrings.server,\n269\t                  style: _manrope(\n270\t                    context,\n271\t                    AppTextStyle.footnote,\n272\t                    weight: 500,\n273\t                    color: _textColor(context).withValues(alpha: 0.58),\n274\t                  ),\n275\t                ),\n276\t                const SizedBox(height: 3),\n277\t                EmojiText(\n278\t                  _serverTitle(selectedName),\n279\t                  maxLines: 1,\n280\t                  overflow: TextOverflow.ellipsis,\n281\t                  style: _manrope(context, AppTextStyle.headline, weight: 650),\n282\t                ),\n283\t                if (actual.isNotEmpty) ...[\n284\t                  const SizedBox(height: 3),\n285\t                  EmojiText(\n286\t                    NexoStrings.currentServer(_serverTitle(actual)),\n287\t                    maxLines: 1,\n288\t                    overflow: TextOverflow.ellipsis,\n289\t                    style: _manrope(\n290\t                      context,\n291\t                      AppTextStyle.footnote,\n292\t                      weight: 500,\n293\t                      color: _textColor(context).withValues(alpha: 0.58),\n294\t                    ),\n295\t                  ),\n296\t                ] else if (group == null) ...[\n297\t                  const SizedBox(height: 3),\n298\t                  Text(\n299\t                    NexoStrings.serversLoading,\n300\t                    style: _manrope(\n301\t                      context,\n302\t                      AppTextStyle.footnote,\n303\t                      color: _textColor(context).withValues(alpha: 0.58),\n304\t                    ),\n305\t                  ),\n306\t                ],\n307\t              ],\n308\t            ),\n309\t          ),\n310\t          const SizedBox(width: 12),\n311\t          Text(\n312\t            _delayText(delay),\n313\t            style: _manrope(\n314\t              context,\n315\t              AppTextStyle.footnote,\n316\t              weight: 600,\n317\t              color: delay != null && delay < 0\n318\t                  ? context.colorScheme.error\n319\t                  : _accent,\n320\t            ),\n321\t          ),\n322\t          const SizedBox(width: 6),\n323\t          GlyphIcon(\n324\t            AppGlyphs.chevronForward,\n325\t            size: 18,\n326\t            color: _textColor(context).withValues(alpha: 0.42),\n327\t          ),\n328\t        ],\n329\t      ),\n330\t    );\n331\t  }\n332\t}\n333\t\n334\tclass _ServerPicker extends ConsumerWidget {\n335\t  const _ServerPicker();\n336\t\n337\t  void _select(BuildContext context, WidgetRef ref, Group group, Proxy proxy) {\n338\t    selectGroupProxy(\n339\t      ref,\n340\t      groupName: group.name,\n341\t      groupType: group.type,\n342\t      proxyName: proxy.name,\n343\t    );\n344\t    Navigator.of(context).pop();\n345\t  }\n346\t\n347\t  void _test(WidgetRef ref, Group group) {\n348\t    unawaited(\n349\t      ref\n350\t          .read(proxiesActionProvider.notifier)\n351\t          .delayTestPageGroup(group.name, matchSearch: false),\n352\t    );\n353\t  }\n354\t\n355\t  @override\n356\t  Widget build(BuildContext context, WidgetRef ref) {\n357\t    final group = ref.watch(\n358\t      groupsProvider.select((groups) => groups.getGroup(NexoStrings.appName)),\n359\t    );\n360\t    final testing = ref.watch(\n361\t      delayTestingGroupsProvider.select(\n362\t        (groups) => groups.contains(NexoStrings.appName),\n363\t      ),\n364\t    );\n365\t    final selected = ref.watch(proxyNameProvider(NexoStrings.appName));\n366\t    final proxies = group == null\n367\t        ? const <Proxy>[]\n368\t        : [\n369\t            ...group.all.where((proxy) => proxy.name == NexoStrings.automatic),\n370\t            ...group.all.where((proxy) => proxy.name != NexoStrings.automatic),\n371\t          ];\n372\t    return CommonScaffold(\n373\t      title: NexoStrings.chooseServer,\n374\t      backgroundColor: _pageColor(context),\n375\t      body: ListView(\n376\t        shrinkWrap: true,\n377\t        padding: const EdgeInsets.fromLTRB(16, 8, 16, 16),\n378\t        children: [\n379\t          for (final proxy in proxies)\n380\t            _ServerPickerRow(\n381\t              group: group!,\n382\t              proxy: proxy,\n383\t              selected:\n384\t                  (selected ?? '').takeFirstValid([group.realNow]) ==\n385\t                  proxy.name,\n386\t              onPressed: () => _select(context, ref, group, proxy),\n387\t            ),\n388\t          const SizedBox(height: 12),\n389\t          FilledButton(\n390\t            onPressed: group == null || testing\n391\t                ? null\n392\t                : () => _test(ref, group),\n393\t            style: const ButtonStyle(\n394\t              backgroundColor: WidgetStatePropertyAll(_accent),\n395\t              foregroundColor: WidgetStatePropertyAll(Colors.white),\n396\t              minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n397\t            ),\n398\t            child: Row(\n399\t              mainAxisAlignment: MainAxisAlignment.center,\n400\t              children: [\n401\t                if (testing)\n402\t                  const CommonCircleLoading(\n403\t                    size: 18,\n404\t                    color: Colors.white,\n405\t                    semanticLabel: NexoStrings.speedTesting,\n406\t                  )\n407\t                else\n408\t                  const GlyphIcon(\n409\t                    AppGlyphs.speed,\n410\t                    size: 20,\n411\t                    fill: 1,\n412\t                    color: Colors.white,\n413\t                  ),\n414\t                const SizedBox(width: 8),\n415\t                Text(\n416\t                  testing ? NexoStrings.speedTesting : NexoStrings.speedTest,\n417\t                  style: _manrope(\n418\t                    context,\n419\t                    AppTextStyle.subheadline,\n420\t                    weight: 650,\n421\t                    color: Colors.white,\n422\t                  ),\n423\t                ),\n424\t              ],\n425\t            ),\n426\t          ),\n427\t        ],\n428\t      ),\n429\t    );\n430\t  }\n431\t}\n432\t\n433\tclass _ServerPickerRow extends ConsumerWidget {\n434\t  const _ServerPickerRow({\n435\t    required this.group,\n436\t    required this.proxy,\n437\t    required this.selected,\n438\t    required this.onPressed,\n439\t  });\n440\t\n441\t  final Group group;\n442\t  final Proxy proxy;\n443\t  final bool selected;\n444\t  final VoidCallback onPressed;\n445\t\n446\t  @override\n447\t  Widget build(BuildContext context, WidgetRef ref) {\n448\t    final delay = ref.watch(\n449\t      delayProvider(proxyName: proxy.name, testUrl: group.testUrl),\n450\t    );\n451\t    return Padding(\n452\t      padding: const EdgeInsets.only(bottom: 6),\n453\t      child: Material(\n454\t        color: _cardColor(context),\n455\t        shape: AppShape.md,\n456\t        clipBehavior: Clip.antiAlias,\n457\t        child: InkWell(\n458\t          customBorder: AppShape.md,\n459\t          onTap: onPressed,\n460\t          child: ConstrainedBox(\n461\t            constraints: const BoxConstraints(minHeight: 60),\n462\t            child: Padding(\n463\t              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),\n464\t              child: Row(\n465\t                children: [\n466\t                  _ServerMark(name: proxy.name, size: 38),\n467\t                  const SizedBox(width: 12),\n468\t                  Expanded(\n469\t                    child: EmojiText(\n470\t                      _serverTitle(proxy.name),\n471\t                      maxLines: 2,\n472\t                      overflow: TextOverflow.ellipsis,\n473\t                      style: _manrope(\n474\t                        context,\n475\t                        AppTextStyle.subheadline,\n476\t                        weight: selected ? 650 : 500,\n477\t                      ),\n478\t                    ),\n479\t                  ),\n480\t                  const SizedBox(width: 10),\n481\t                  Text(\n482\t                    _delayText(delay),\n483\t                    style: _manrope(\n484\t                      context,\n485\t                      AppTextStyle.footnote,\n486\t                      weight: 600,\n487\t                      color: delay != null && delay < 0\n488\t                          ? context.colorScheme.error\n489\t                          : _accent,\n490\t                    ),\n491\t                  ),\n492\t                  const SizedBox(width: 10),\n493\t                  SizedBox(\n494\t                    width: SelectionCheck.size,\n495\t                    child: selected ? const SelectionCheck() : null,\n496\t                  ),\n497\t                ],\n498\t              ),\n499\t            ),\n500\t          ),\n501\t        ),\n502\t      ),\n503\t    );\n504\t  }\n505\t}\n506\t\n507\tclass _InfoRow extends ConsumerWidget {\n508\t  const _InfoRow({required this.profile});\n509\t\n510\t  final Profile profile;\n511\t\n512\t  @override\n513\t  Widget build(BuildContext context, WidgetRef ref) {\n514\t    final expire = profile.subscriptionInfo?.expireDate;\n515\t    final seconds = expire?.difference(DateTime.now()).inSeconds;\n516\t    final rawDays = seconds == null\n517\t        ? null\n518\t        : (seconds / Duration.secondsPerDay).ceil();\n519\t    final days = rawDays == null || rawDays >= 0 ? rawDays : 0;\n520\t    final warning = days != null && days < 3;\n521\t    final traffics = ref.watch(trafficsProvider).list;\n522\t    final traffic = traffics.isEmpty ? const Traffic() : traffics.last;\n523\t    return _NexoCard(\n524\t      child: Row(\n525\t        children: [\n526\t          Expanded(\n527\t            child: _InfoValue(\n528\t              label: days == null\n529\t                  ? NexoStrings.unlimitedAccess\n530\t                  : NexoStrings.daysLeft(days),\n531\t              color: warning ? _warning : null,\n532\t            ),\n533\t          ),\n534\t          const SizedBox(width: 16),\n535\t          Expanded(\n536\t            child: _InfoValue(\n537\t              label: NexoStrings.speed(\n538\t                traffic.down.shortTraffic.show,\n539\t                traffic.up.shortTraffic.show,\n540\t              ),\n541\t              alignEnd: true,\n542\t            ),\n543\t          ),\n544\t        ],\n545\t      ),\n546\t    );\n547\t  }\n548\t}\n549\t\n550\tclass _InfoValue extends StatelessWidget {\n551\t  const _InfoValue({required this.label, this.color, this.alignEnd = false});\n552\t\n553\t  final String label;\n554\t  final Color? color;\n555\t  final bool alignEnd;\n556\t\n557\t  @override\n558\t  Widget build(BuildContext context) {\n559\t    return Text(\n560\t      label,\n561\t      maxLines: 2,\n562\t      textAlign: alignEnd ? TextAlign.end : TextAlign.start,\n563\t      overflow: TextOverflow.ellipsis,\n564\t      style: _manrope(\n565\t        context,\n566\t        AppTextStyle.footnote,\n567\t        weight: 600,\n568\t        color: color,\n569\t      ),\n570\t    );\n571\t  }\n572\t}\n573\t\n574\tclass _EmptyState extends ConsumerWidget {\n575\t  const _EmptyState();\n576\t\n577\t  String? _accessUrl(String? value) {\n578\t    final text = value?.trim();\n579\t    if (text == null || text.isEmpty) return null;\n580\t    final uri = Uri.tryParse(text);\n581\t    if (uri == null) return null;\n582\t    if (uri.scheme == 'https' && uri.host.isNotEmpty) return text;\n583\t    if (uri.scheme != 'nexo' || uri.host != 'install-config') return null;\n584\t    final nested = uri.queryParameters['url']?.trim();\n585\t    final nestedUri = nested == null ? null : Uri.tryParse(nested);\n586\t    return nestedUri?.scheme == 'https' && nestedUri?.host.isNotEmpty == true\n587\t        ? nested\n588\t        : null;\n589\t  }\n590\t\n591\t  Future<void> _paste(WidgetRef ref) async {\n592\t    final data = await Clipboard.getData('text/plain');\n593\t    final url = _accessUrl(data?.text);\n594\t    if (url == null) {\n595\t      dialogs.showNotifier(\n596\t        NexoStrings.invalidAccessLink,\n597\t        level: MessageLevel.warning,\n598\t      );\n599\t      return;\n600\t    }\n601\t    unawaited(\n602\t      ref.read(profilesActionProvider.notifier).addProfileFromLink(url),\n603\t    );\n604\t  }\n605\t\n606\t  @override\n607\t  Widget build(BuildContext context, WidgetRef ref) {\n608\t    return _NexoCard(\n609\t      child: Column(\n610\t        children: [\n611\t          const SizedBox.square(\n612\t            dimension: 58,\n613\t            child: DecoratedBox(\n614\t              decoration: ShapeDecoration(\n615\t                color: Color(0x1A2F6BFF),\n616\t                shape: AppShape.circle,\n617\t              ),\n618\t              child: Center(\n619\t                child: GlyphIcon(AppGlyphs.profiles, color: _accent, size: 26),\n620\t              ),\n621\t            ),\n622\t          ),\n623\t          const SizedBox(height: 18),\n624\t          Text(\n625\t            NexoStrings.addAccessKey,\n626\t            textAlign: TextAlign.center,\n627\t            style: _manrope(context, AppTextStyle.title3, weight: 650),\n628\t          ),\n629\t          const SizedBox(height: 8),\n630\t          Text(\n631\t            NexoStrings.accessKeyHint,\n632\t            textAlign: TextAlign.center,\n633\t            style: _manrope(\n634\t              context,\n635\t              AppTextStyle.subheadline,\n636\t              color: _textColor(context).withValues(alpha: 0.6),\n637\t            ),\n638\t          ),\n639\t          const SizedBox(height: 24),\n640\t          SizedBox(\n641\t            width: double.infinity,\n642\t            child: FilledButton(\n643\t              onPressed: () => _paste(ref),\n644\t              style: const ButtonStyle(\n645\t                backgroundColor: WidgetStatePropertyAll(_accent),\n646\t                foregroundColor: WidgetStatePropertyAll(Colors.white),\n647\t                minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n648\t              ),\n649\t              child: Text(\n650\t                NexoStrings.pasteLink,\n651\t                style: _manrope(\n652\t                  context,\n653\t                  AppTextStyle.subheadline,\n654\t                  weight: 650,\n655\t                  color: Colors.white,\n656\t                ),\n657\t              ),\n658\t            ),\n659\t          ),\n660\t          if (system.isAndroid) ...[\n661\t            const SizedBox(height: 10),\n662\t            SizedBox(\n663\t              width: double.infinity,\n664\t              child: OutlinedButton(\n665\t                onPressed: () => unawaited(\n666\t                  ref\n667\t                      .read(profilesActionProvider.notifier)\n668\t                      .addProfileFormQrCode(),\n669\t                ),\n670\t                style: const ButtonStyle(\n671\t                  foregroundColor: WidgetStatePropertyAll(_accent),\n672\t                  side: WidgetStatePropertyAll(BorderSide(color: _accent)),\n673\t                  minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n674\t                ),\n675\t                child: Text(\n676\t                  NexoStrings.scanQr,\n677\t                  style: _manrope(\n678\t                    context,\n679\t                    AppTextStyle.subheadline,\n680\t                    weight: 650,\n681\t                    color: _accent,\n682\t                  ),\n683\t                ),\n684\t              ),\n685\t            ),\n686\t          ],\n687\t        ],\n688\t      ),\n689\t    );\n690\t  }\n691\t}\n692\t\n693\tclass _NexoCard extends StatelessWidget {\n694\t  const _NexoCard({required this.child, this.onPressed});\n695\t\n696\t  final Widget child;\n697\t  final VoidCallback? onPressed;\n698\t\n699\t  @override\n700\t  Widget build(BuildContext context) {\n701\t    final content = Padding(padding: const EdgeInsets.all(18), child: child);\n702\t    return DecoratedBox(\n703\t      decoration: ShapeDecoration(\n704\t        color: _cardColor(context),\n705\t        shape: AppShape.xl,\n706\t        shadows: [\n707\t          BoxShadow(\n708\t            color: Colors.black.withValues(\n709\t              alpha: Theme.of(context).brightness == Brightness.dark\n710\t                  ? 0.2\n711\t                  : 0.06,\n712\t            ),\n713\t            blurRadius: 24,\n714\t            offset: const Offset(0, 8),\n715\t          ),\n716\t        ],\n717\t      ),\n718\t      child: Material(\n719\t        color: Colors.transparent,\n720\t        shape: AppShape.xl,\n721\t        clipBehavior: Clip.antiAlias,\n722\t        child: onPressed == null\n723\t            ? content\n724\t            : InkWell(\n725\t                customBorder: AppShape.xl,\n726\t                onTap: onPressed,\n727\t                child: content,\n728\t              ),\n729\t      ),\n730\t    );\n731\t  }\n732\t}\n733\t\n734\tclass _ServerMark extends StatelessWidget {\n735\t  const _ServerMark({required this.name, this.size = 44});\n736\t\n737\t  final String name;\n738\t  final double size;\n739\t\n740\t  @override\n741\t  Widget build(BuildContext context) {\n742\t    final flag = _serverFlag(name);\n743\t    return SizedBox.square(\n744\t      dimension: size,\n745\t      child: DecoratedBox(\n746\t        decoration: const ShapeDecoration(\n747\t          color: Color(0x142F6BFF),\n748\t          shape: AppShape.circle,\n749\t        ),\n750\t        child: Center(\n751\t          child: flag.isEmpty\n752\t              ? GlyphIcon(AppGlyphs.bolt, color: _accent, size: size * 0.48)\n753\t              : EmojiText(\n754\t                  flag,\n755\t                  style: AppTextStyle.custom(\n756\t                    context,\n757\t                    size: size * 0.48,\n758\t                    leading: size * 0.58,\n759\t                  ),\n760\t                ),\n761\t        ),\n762\t      ),\n763\t    );\n764\t  }\n765\t}\n766\t\n767\tString _serverFlag(String name) {\n768\t  final trimmed = name.trim();\n769\t  if (trimmed.isEmpty) return '';\n770\t  final token = trimmed.split(RegExp(r'\\s+')).first;\n771\t  final runes = token.runes.toList();\n772\t  return runes.length == 2 &&\n773\t          runes.every((rune) => rune >= 0x1F1E6 && rune <= 0x1F1FF)\n774\t      ? token\n775\t      : '';\n776\t}\n777\t\n778\tString _serverTitle(String name) {\n779\t  final flag = _serverFlag(name);\n780\t  final trimmed = name.trim();\n781\t  final withoutFlag = flag.isEmpty\n782\t      ? trimmed\n783\t      : trimmed.substring(flag.length).trim();\n784\t  return withoutFlag.replaceFirst(RegExp(r'^Nexo\\s*—\\s*'), '').trim();\n785\t}\n786\t\n787\tString _delayText(int? delay) {\n788\t  if (delay == null || delay == 0) return '—';\n789\t  if (delay < 0) return NexoStrings.unavailable;\n790\t  return NexoStrings.delay(delay);\n791\t}\n792\t"}]},"uuid":"f8337636-2a23-4ebc-abf2-4331b1554e7c","timestamp":"2026-11-06T10:21:50.621Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/Sagenkazaran/Projects/nexo-app/lib/views/nexo/home.dart","content":"import 'dart:async';\n\nimport 'package:fl_clash/common/common.dart';\nimport 'package:fl_clash/enum/enum.dart';\nimport 'package:fl_clash/models/models.dart';\nimport 'package:fl_clash/providers/providers.dart';\nimport 'package:fl_clash/ui/icons/icons.dart';\nimport 'package:fl_clash/ui/ui.dart';\nimport 'package:fl_clash/views/proxies/card.dart';\nimport 'package:flutter/services.dart';\nimport 'package:flutter_riverpod/flutter_riverpod.dart';\nimport 'package:material_ui/material_ui.dart';\n\nimport 'strings.dart';\n\nconst _accent = Color(0xFF2F6BFF);\nconst _navy = Color(0xFF0B1F3A);\nconst _lightPage = Color(0xFFF5F7FB);\nconst _lightCard = Colors.white;\nconst _darkCard = Color(0xFF13294A);\nconst _warning = Color(0xFFF59E0B);\nconst _contentWidth = 440.0;\n\nColor _pageColor(BuildContext context) =>\n    Theme.of(context).brightness == Brightness.dark ? _navy : _lightPage;\n\nColor _cardColor(BuildContext context) =>\n    Theme.of(context).brightness == Brightness.dark ? _darkCard : _lightCard;\n\nColor _textColor(BuildContext context) =>\n    Theme.of(context).brightness == Brightness.dark ? Colors.white : _navy;\n\nTextStyle _manrope(\n  BuildContext context,\n  AppTextStyle style, {\n  double weight = 400,\n  Color? color,\n}) {\n  return style\n      .of(context)\n      .copyWith(\n        color: color ?? _textColor(context),\n        fontFamily: 'Manrope',\n        fontVariations: [FontVariation('wght', weight)],\n      );\n}\n\nclass NexoHomeView extends ConsumerWidget {\n  const NexoHomeView({super.key});\n\n  String _statusText({\n    required bool hasProfile,\n    required bool isRunning,\n    required CoreStatus coreStatus,\n  }) {\n    if (!hasProfile) return NexoStrings.noAccessKey;\n    if (coreStatus == CoreStatus.connecting) return NexoStrings.connecting;\n    return isRunning ? NexoStrings.protected : NexoStrings.disconnected;\n  }\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final profile = ref.watch(currentProfileProvider);\n    final isRunning = ref.watch(isStartProvider);\n    final coreStatus = ref.watch(coreStatusProvider);\n    final runtime = ref.watch(runTimeProvider);\n    final status = _statusText(\n      hasProfile: profile != null,\n      isRunning: isRunning,\n      coreStatus: coreStatus,\n    );\n    return CommonScaffold(\n      backgroundColor: _pageColor(context),\n      titleWidget: Text(\n        NexoStrings.appName,\n        style: AppTextStyle.pageTitle\n            .of(context)\n            .copyWith(\n              color: _textColor(context),\n              fontFamily: 'Unbounded',\n              fontVariations: const [FontVariation('wght', 650)],\n            ),\n      ),\n      body: SingleChildScrollView(\n        padding: EdgeInsets.fromLTRB(20, 72, 20, 24 + context.bottomInset),\n        child: Center(\n          child: ConstrainedBox(\n            constraints: const BoxConstraints(maxWidth: _contentWidth),\n            child: Column(\n              crossAxisAlignment: CrossAxisAlignment.stretch,\n              children: [\n                Text(\n                  status,\n                  textAlign: TextAlign.center,\n                  style: _manrope(\n                    context,\n                    AppTextStyle.subheadline,\n                    weight: 500,\n                    color: _textColor(context).withValues(alpha: 0.62),\n                  ),\n                ),\n                const SizedBox(height: 28),\n                if (profile == null)\n                  const _EmptyState()\n                else ...[\n                  _ConnectButton(\n                    isRunning: isRunning,\n                    connecting: coreStatus == CoreStatus.connecting,\n                    runtime: runtime,\n                  ),\n                  const SizedBox(height: 28),\n                  const _ServerCard(),\n                  const SizedBox(height: 16),\n                  _InfoRow(profile: profile),\n                ],\n              ],\n            ),\n          ),\n        ),\n      ),\n    );\n  }\n}\n\nclass _ConnectButton extends ConsumerWidget {\n  const _ConnectButton({\n    required this.isRunning,\n    required this.connecting,\n    required this.runtime,\n  });\n\n  final bool isRunning;\n  final bool connecting;\n  final int? runtime;\n\n  void _toggle(WidgetRef ref) {\n    if (connecting) return;\n    if (system.isAndroid) {\n      unawaited(HapticFeedback.mediumImpact());\n    }\n    ref.read(commonActionProvider.notifier).toggleRunning();\n  }\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final foreground = isRunning ? Colors.white : _textColor(context);\n    final fill = isRunning ? _accent : _cardColor(context);\n    final label = connecting\n        ? NexoStrings.connecting\n        : isRunning\n        ? NexoStrings.connected\n        : NexoStrings.connect;\n    return Center(\n      child: SizedBox.square(\n        dimension: 240,\n        child: Stack(\n          alignment: Alignment.center,\n          children: [\n            if (connecting)\n              const CommonCircleLoading(\n                size: 240,\n                color: _accent,\n                semanticLabel: NexoStrings.connecting,\n              ),\n            AnimatedSwitcher(\n              duration: const Duration(milliseconds: 250),\n              child: SizedBox.square(\n                key: ValueKey((isRunning, connecting)),\n                dimension: 192,\n                child: Material(\n                  color: fill,\n                  elevation: isRunning ? 12 : 4,\n                  shadowColor: _accent.withValues(\n                    alpha: isRunning ? 0.34 : 0.1,\n                  ),\n                  shape: AppShape.circle.copyWith(\n                    side: isRunning\n                        ? BorderSide.none\n                        : const BorderSide(color: _accent, width: 2),\n                  ),\n                  clipBehavior: Clip.antiAlias,\n                  child: InkWell(\n                    customBorder: AppShape.circle,\n                    onTap: connecting ? null : () => _toggle(ref),\n                    child: Column(\n                      mainAxisAlignment: MainAxisAlignment.center,\n                      children: [\n                        Text(\n                          label,\n                          textAlign: TextAlign.center,\n                          style: _manrope(\n                            context,\n                            AppTextStyle.headline,\n                            weight: 650,\n                            color: foreground,\n                          ),\n                        ),\n                        if (isRunning) ...[\n                          const SizedBox(height: 8),\n                          Text(\n                            getTimeText(runtime),\n                            style: _manrope(\n                              context,\n                              AppTextStyle.footnote,\n                              weight: 500,\n                              color: foreground.withValues(alpha: 0.78),\n                            ),\n                          ),\n                        ],\n                      ],\n                    ),\n                  ),\n                ),\n              ),\n            ),\n          ],\n        ),\n      ),\n    );\n  }\n}\n\nclass _ServerCard extends ConsumerWidget {\n  const _ServerCard();\n\n  Future<void> _openPicker(BuildContext context) {\n    return showFormSheet<void>(\n      context: context,\n      builder: (_) => const _ServerPicker(),\n    );\n  }\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final groups = ref.watch(groupsProvider);\n    final group = groups.getGroup(NexoStrings.appName);\n    final selected = ref.watch(proxyNameProvider(NexoStrings.appName));\n    final selectedName = (selected ?? '').takeFirstValid([\n      group?.realNow ?? '',\n      NexoStrings.automatic,\n    ]);\n    final autoNow =\n        groups.getGroup(NexoStrings.automatic)?.realNow ??\n        group?.all\n            .where((proxy) => proxy.name == NexoStrings.automatic)\n            .firstOrNull\n            ?.now ??\n        '';\n    final actual = selectedName == NexoStrings.automatic ? autoNow : '';\n    final delay = group == null\n        ? null\n        : ref.watch(\n            delayProvider(proxyName: selectedName, testUrl: group.testUrl),\n          );\n    return _NexoCard(\n      onPressed: group == null ? null : () => _openPicker(context),\n      child: Row(\n        children: [\n          Flexible(\n            child: _ServerMark(name: actual.isNotEmpty ? actual : selectedName),\n          ),\n          const SizedBox(width: 14),\n          Expanded(\n            child: Column(\n              crossAxisAlignment: CrossAxisAlignment.start,\n              children: [\n                Text(\n                  NexoStrings.server,\n                  style: _manrope(\n                    context,\n                    AppTextStyle.footnote,\n                    weight: 500,\n                    color: _textColor(context).withValues(alpha: 0.58),\n                  ),\n                ),\n                const SizedBox(height: 3),\n                EmojiText(\n                  _serverTitle(selectedName),\n                  maxLines: 1,\n                  overflow: TextOverflow.ellipsis,\n                  style: _manrope(context, AppTextStyle.headline, weight: 650),\n                ),\n                if (actual.isNotEmpty) ...[\n                  const SizedBox(height: 3),\n                  EmojiText(\n                    NexoStrings.currentServer(_serverTitle(actual)),\n                    maxLines: 1,\n                    overflow: TextOverflow.ellipsis,\n                    style: _manrope(\n                      context,\n                      AppTextStyle.footnote,\n                      weight: 500,\n                      color: _textColor(context).withValues(alpha: 0.58),\n                    ),\n                  ),\n                ] else if (group == null) ...[\n                  const SizedBox(height: 3),\n                  Text(\n                    NexoStrings.serversLoading,\n                    style: _manrope(\n                      context,\n                      AppTextStyle.footnote,\n                      color: _textColor(context).withValues(alpha: 0.58),\n                    ),\n                  ),\n                ],\n              ],\n            ),\n          ),\n          const SizedBox(width: 12),\n          Text(\n            _delayText(delay),\n            style: _manrope(\n              context,\n              AppTextStyle.footnote,\n              weight: 600,\n              color: delay != null && delay < 0\n                  ? context.colorScheme.error\n                  : _accent,\n            ),\n          ),\n          const SizedBox(width: 6),\n          GlyphIcon(\n            AppGlyphs.chevronForward,\n            size: 18,\n            color: _textColor(context).withValues(alpha: 0.42),\n          ),\n        ],\n      ),\n    );\n  }\n}\n\nclass _ServerPicker extends ConsumerWidget {\n  const _ServerPicker();\n\n  void _select(BuildContext context, WidgetRef ref, Group group, Proxy proxy) {\n    selectGroupProxy(\n      ref,\n      groupName: group.name,\n      groupType: group.type,\n      proxyName: proxy.name,\n    );\n    Navigator.of(context).pop();\n  }\n\n  void _test(WidgetRef ref, Group group) {\n    unawaited(\n      ref\n          .read(proxiesActionProvider.notifier)\n          .delayTestPageGroup(group.name, matchSearch: false),\n    );\n  }\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final group = ref.watch(\n      groupsProvider.select((groups) => groups.getGroup(NexoStrings.appName)),\n    );\n    final testing = ref.watch(\n      delayTestingGroupsProvider.select(\n        (groups) => groups.contains(NexoStrings.appName),\n      ),\n    );\n    final selected = ref.watch(proxyNameProvider(NexoStrings.appName));\n    final proxies = group == null\n        ? const <Proxy>[]\n        : [\n            ...group.all.where((proxy) => proxy.name == NexoStrings.automatic),\n            ...group.all.where((proxy) => proxy.name != NexoStrings.automatic),\n          ];\n    return CommonScaffold(\n      title: NexoStrings.chooseServer,\n      backgroundColor: _pageColor(context),\n      body: ListView(\n        shrinkWrap: true,\n        padding: const EdgeInsets.fromLTRB(16, 8, 16, 16),\n        children: [\n          for (final proxy in proxies)\n            _ServerPickerRow(\n              group: group!,\n              proxy: proxy,\n              selected:\n                  (selected ?? '').takeFirstValid([group.realNow]) ==\n                  proxy.name,\n              onPressed: () => _select(context, ref, group, proxy),\n            ),\n          const SizedBox(height: 12),\n          FilledButton(\n            onPressed: group == null || testing\n                ? null\n                : () => _test(ref, group),\n            style: const ButtonStyle(\n              backgroundColor: WidgetStatePropertyAll(_accent),\n              foregroundColor: WidgetStatePropertyAll(Colors.white),\n              minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n            ),\n            child: Row(\n              mainAxisAlignment: MainAxisAlignment.center,\n              children: [\n                if (testing)\n                  const CommonCircleLoading(\n                    size: 18,\n                    color: Colors.white,\n                    semanticLabel: NexoStrings.speedTesting,\n                  )\n                else\n                  const GlyphIcon(\n                    AppGlyphs.speed,\n                    size: 20,\n                    fill: 1,\n                    color: Colors.white,\n                  ),\n                const SizedBox(width: 8),\n                Text(\n                  testing ? NexoStrings.speedTesting : NexoStrings.speedTest,\n                  style: _manrope(\n                    context,\n                    AppTextStyle.subheadline,\n                    weight: 650,\n                    color: Colors.white,\n                  ),\n                ),\n              ],\n            ),\n          ),\n        ],\n      ),\n    );\n  }\n}\n\nclass _ServerPickerRow extends ConsumerWidget {\n  const _ServerPickerRow({\n    required this.group,\n    required this.proxy,\n    required this.selected,\n    required this.onPressed,\n  });\n\n  final Group group;\n  final Proxy proxy;\n  final bool selected;\n  final VoidCallback onPressed;\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final delay = ref.watch(\n      delayProvider(proxyName: proxy.name, testUrl: group.testUrl),\n    );\n    return Padding(\n      padding: const EdgeInsets.only(bottom: 6),\n      child: Material(\n        color: _cardColor(context),\n        shape: AppShape.md,\n        clipBehavior: Clip.antiAlias,\n        child: InkWell(\n          customBorder: AppShape.md,\n          onTap: onPressed,\n          child: ConstrainedBox(\n            constraints: const BoxConstraints(minHeight: 60),\n            child: Padding(\n              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),\n              child: Row(\n                children: [\n                  _ServerMark(name: proxy.name, size: 38),\n                  const SizedBox(width: 12),\n                  Expanded(\n                    child: EmojiText(\n                      _serverTitle(proxy.name),\n                      maxLines: 2,\n                      overflow: TextOverflow.ellipsis,\n                      style: _manrope(\n                        context,\n                        AppTextStyle.subheadline,\n                        weight: selected ? 650 : 500,\n                      ),\n                    ),\n                  ),\n                  const SizedBox(width: 10),\n                  Text(\n                    _delayText(delay),\n                    style: _manrope(\n                      context,\n                      AppTextStyle.footnote,\n                      weight: 600,\n                      color: delay != null && delay < 0\n                          ? context.colorScheme.error\n                          : _accent,\n                    ),\n                  ),\n                  const SizedBox(width: 10),\n                  SizedBox(\n                    width: SelectionCheck.size,\n                    child: selected ? const SelectionCheck() : null,\n                  ),\n                ],\n              ),\n            ),\n          ),\n        ),\n      ),\n    );\n  }\n}\n\nclass _InfoRow extends ConsumerWidget {\n  const _InfoRow({required this.profile});\n\n  final Profile profile;\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final expire = profile.subscriptionInfo?.expireDate;\n    final seconds = expire?.difference(DateTime.now()).inSeconds;\n    final rawDays = seconds == null\n        ? null\n        : (seconds / Duration.secondsPerDay).ceil();\n    final days = rawDays == null || rawDays >= 0 ? rawDays : 0;\n    final warning = days != null && days < 3;\n    final traffics = ref.watch(trafficsProvider).list;\n    final traffic = traffics.isEmpty ? const Traffic() : traffics.last;\n    return _NexoCard(\n      child: Row(\n        children: [\n          Expanded(\n            child: _InfoValue(\n              label: days == null\n                  ? NexoStrings.unlimitedAccess\n                  : NexoStrings.daysLeft(days),\n              color: warning ? _warning : null,\n            ),\n          ),\n          const SizedBox(width: 16),\n          Expanded(\n            child: _InfoValue(\n              label: NexoStrings.speed(\n                traffic.down.shortTraffic.show,\n                traffic.up.shortTraffic.show,\n              ),\n              alignEnd: true,\n            ),\n          ),\n        ],\n      ),\n    );\n  }\n}\n\nclass _InfoValue extends StatelessWidget {\n  const _InfoValue({required this.label, this.color, this.alignEnd = false});\n\n  final String label;\n  final Color? color;\n  final bool alignEnd;\n\n  @override\n  Widget build(BuildContext context) {\n    return Text(\n      label,\n      maxLines: 2,\n      textAlign: alignEnd ? TextAlign.end : TextAlign.start,\n      overflow: TextOverflow.ellipsis,\n      style: _manrope(\n        context,\n        AppTextStyle.footnote,\n        weight: 600,\n        color: color,\n      ),\n    );\n  }\n}\n\nclass _EmptyState extends ConsumerWidget {\n  const _EmptyState();\n\n  String? _accessUrl(String? value) {\n    final text = value?.trim();\n    if (text == null || text.isEmpty) return null;\n    final uri = Uri.tryParse(text);\n    if (uri == null) return null;\n    if (uri.scheme == 'https' && uri.host.isNotEmpty) return text;\n    if (uri.scheme != 'nexo' || uri.host != 'install-config') return null;\n    final nested = uri.queryParameters['url']?.trim();\n    final nestedUri = nested == null ? null : Uri.tryParse(nested);\n    return nestedUri?.scheme == 'https' && nestedUri?.host.isNotEmpty == true\n        ? nested\n        : null;\n  }\n\n  Future<void> _paste(WidgetRef ref) async {\n    final data = await Clipboard.getData('text/plain');\n    final url = _accessUrl(data?.text);\n    if (url == null) {\n      dialogs.showNotifier(\n        NexoStrings.invalidAccessLink,\n        level: MessageLevel.warning,\n      );\n      return;\n    }\n    unawaited(\n      ref.read(profilesActionProvider.notifier).addProfileFromLink(url),\n    );\n  }\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    return _NexoCard(\n      child: Column(\n        children: [\n          const SizedBox.square(\n            dimension: 58,\n            child: DecoratedBox(\n              decoration: ShapeDecoration(\n                color: Color(0x1A2F6BFF),\n                shape: AppShape.circle,\n              ),\n              child: Center(\n                child: GlyphIcon(AppGlyphs.profiles, color: _accent, size: 26),\n              ),\n            ),\n          ),\n          const SizedBox(height: 18),\n          Text(\n            NexoStrings.addAccessKey,\n            textAlign: TextAlign.center,\n            style: _manrope(context, AppTextStyle.title3, weight: 650),\n          ),\n          const SizedBox(height: 8),\n          Text(\n            NexoStrings.accessKeyHint,\n            textAlign: TextAlign.center,\n            style: _manrope(\n              context,\n              AppTextStyle.subheadline,\n              color: _textColor(context).withValues(alpha: 0.6),\n            ),\n          ),\n          const SizedBox(height: 24),\n          SizedBox(\n            width: double.infinity,\n            child: FilledButton(\n              onPressed: () => _paste(ref),\n              style: const ButtonStyle(\n                backgroundColor: WidgetStatePropertyAll(_accent),\n                foregroundColor: WidgetStatePropertyAll(Colors.white),\n                minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n              ),\n              child: Text(\n                NexoStrings.pasteLink,\n                style: _manrope(\n                  context,\n                  AppTextStyle.subheadline,\n                  weight: 650,\n                  color: Colors.white,\n                ),\n              ),\n            ),\n          ),\n          if (system.isAndroid) ...[\n            const SizedBox(height: 10),\n            SizedBox(\n              width: double.infinity,\n              child: OutlinedButton(\n                onPressed: () => unawaited(\n                  ref\n                      .read(profilesActionProvider.notifier)\n                      .addProfileFormQrCode(),\n                ),\n                style: const ButtonStyle(\n                  foregroundColor: WidgetStatePropertyAll(_accent),\n                  side: WidgetStatePropertyAll(BorderSide(color: _accent)),\n                  minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n                ),\n                child: Text(\n                  NexoStrings.scanQr,\n                  style: _manrope(\n                    context,\n                    AppTextStyle.subheadline,\n                    weight: 650,\n                    color: _accent,\n                  ),\n                ),\n              ),\n            ),\n          ],\n        ],\n      ),\n    );\n  }\n}\n\nclass _NexoCard extends StatelessWidget {\n  const _NexoCard({required this.child, this.onPressed});\n\n  final Widget child;\n  final VoidCallback? onPressed;\n\n  @override\n  Widget build(BuildContext context) {\n    final content = Padding(padding: const EdgeInsets.all(18), child: child);\n    return DecoratedBox(\n      decoration: ShapeDecoration(\n        color: _cardColor(context),\n        shape: AppShape.xl,\n        shadows: [\n          BoxShadow(\n            color: Colors.black.withValues(\n              alpha: Theme.of(context).brightness == Brightness.dark\n                  ? 0.2\n                  : 0.06,\n            ),\n            blurRadius: 24,\n            offset: const Offset(0, 8),\n          ),\n        ],\n      ),\n      child: Material(\n        color: Colors.transparent,\n        shape: AppShape.xl,\n        clipBehavior: Clip.antiAlias,\n        child: onPressed == null\n            ? content\n            : InkWell(\n                customBorder: AppShape.xl,\n                onTap: onPressed,\n                child: content,\n              ),\n      ),\n    );\n  }\n}\n\nclass _ServerMark extends StatelessWidget {\n  const _ServerMark({required this.name, this.size = 44});\n\n  final String name;\n  final double size;\n\n  @override\n  Widget build(BuildContext context) {\n    final flag = _serverFlag(name);\n    return SizedBox.square(\n      dimension: size,\n      child: DecoratedBox(\n        decoration: const ShapeDecoration(\n          color: Color(0x142F6BFF),\n          shape: AppShape.circle,\n        ),\n        child: Center(\n          child: flag.isEmpty\n              ? GlyphIcon(AppGlyphs.bolt, color: _accent, size: size * 0.48)\n              : EmojiText(\n                  flag,\n                  style: AppTextStyle.custom(\n                    context,\n                    size: size * 0.48,\n                    leading: size * 0.58,\n                  ),\n                ),\n        ),\n      ),\n    );\n  }\n}\n\nString _serverFlag(String name) {\n  final trimmed = name.trim();\n  if (trimmed.isEmpty) return '';\n  final token = trimmed.split(RegExp(r'\\s+')).first;\n  final runes = token.runes.toList();\n  return runes.length == 2 &&\n          runes.every((rune) => rune >= 0x1F1E6 && rune <= 0x1F1FF)\n      ? token\n      : '';\n}\n\nString _serverTitle(String name) {\n  final flag = _serverFlag(name);\n  final trimmed = name.trim();\n  final withoutFlag = flag.isEmpty\n      ? trimmed\n      : trimmed.substring(flag.length).trim();\n  return withoutFlag.replaceFirst(RegExp(r'^Nexo\\s*—\\s*'), '').trim();\n}\n\nString _delayText(int? delay) {\n  if (delay == null || delay == 0) return '—';\n  if (delay < 0) return NexoStrings.unavailable;\n  return NexoStrings.delay(delay);\n}\n","numLines":792,"startLine":1,"totalLines":792}},"sourceToolAssistantUUID":"7e3b11d2-6186-471e-8b84-52ef5c6d8083","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"feat/in-app-update","slug":"deep-singing-taco"}
