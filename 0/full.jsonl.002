{"parentUuid":"99abe1e6-054c-4efe-88ec-cbd07861011c","isSidechain":false,"promptId":"6c5529e4-4d01-4965-a960-ed25ddcc71ed","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018jre3ohvWeQ4Nx9zWa9QDK","type":"tool_result","content":"\"\"\"AuraVPN Database — SQLite\"\"\"\n\nimport sqlite3\nimport os\nimport secrets\nimport json\nfrom datetime import datetime, timedelta, timezone\n\nRECOVERY_CODE_DIGITS = 12\nDB_PATH = os.environ.get(\n    \"AURA_DB_PATH\",\n    os.path.join(os.path.dirname(__file__), \"aura_vpn.db\"),\n)\n\n\ndef get_db():\n    conn = sqlite3.connect(DB_PATH)\n    conn.row_factory = sqlite3.Row\n    return conn\n\n\ndef init_db():\n    conn = get_db()\n    conn.executescript(\"\"\"\n        CREATE TABLE IF NOT EXISTS users (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            tg_id INTEGER UNIQUE NOT NULL,\n            username TEXT,\n            first_name TEXT,\n            vpn_uuid TEXT,\n            vless_link TEXT,\n            server TEXT DEFAULT 'timeweb',\n            created_at TEXT DEFAULT (datetime('now')),\n            is_active INTEGER DEFAULT 1,\n            is_premium INTEGER DEFAULT 0,\n            traffic_up INTEGER DEFAULT 0,\n            traffic_down INTEGER DEFAULT 0,\n            referrer_id INTEGER,\n            referral_code TEXT UNIQUE\n        );\nadmin.py\ndevices.py\nfallback.py\n__init__.py\nlegal.py\nonboarding.py\npay.py\n__pycache__\nreferral.py\nstart.py\nvpn.py\nhandlers/admin.py:16:from config import ADMIN_IDS, BRAND\nhandlers/admin.py:30:def is_admin(user_id: int) -> bool:\nhandlers/admin.py:31:    return user_id in ADMIN_IDS\nhandlers/admin.py:37:                and message.chat.id == event.from_user.id and is_admin(event.from_user.id))\nhandlers/admin.py:49:@router.message(Command(\"admin\"))\nhandlers/admin.py:187:            if owner in _cancelled or not is_admin(owner):\nhandlers/admin.py:196:                        if owner in _cancelled or not is_admin(owner):\nhandlers/admin.p