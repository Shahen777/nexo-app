ode: LaunchMode.externalApplication));\n  }\n\n  @override\n  Widget build(BuildContext context) {\n    return FilledButton(\n      onPressed: _open,\n      style: const ButtonStyle(\n        backgroundColor: WidgetStatePropertyAll(_accent),\n        foregroundColor: WidgetStatePropertyAll(Colors.white),\n        minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),\n      ),\n      child: Text(\n        NexoStrings.renew,\n        style: _manrope(\n          context,\n          AppTextStyle.subheadline,\n          weight: 650,\n          color: Colors.white,\n        ),\n      ),\n    );\n  }\n}\n\nclass _InfoValue extends StatelessWidget {","originalFile":null,"structuredPatch":[{"oldStart":552,"oldLines":6,"newStart":552,"newLines":81,"lines":["   }"," }"," ","+class _RenewButton extends ConsumerStatefulWidget {","+  const _RenewButton({required this.profile});","+","+  final Profile profile;","+","+  @override","+  ConsumerState<_RenewButton> createState() => _RenewButtonState();","+}","+","+class _RenewButtonState extends ConsumerState<_RenewButton>","+    with WidgetsBindingObserver {","+  bool _opened = false;","+","+  @override","+  void initState() {","+    super.initState();","+    WidgetsBinding.instance.addObserver(this);","+  }","+","+  @override","+  void dispose() {","+    WidgetsBinding.instance.removeObserver(this);","+    super.dispose();","+  }","+","+  // Coming back from the browser, the new end date should show at once.","+  @override","+  void didChangeAppLifecycleState(AppLifecycleState state) {","+    if (state != AppLifecycleState.resumed || !_opened) return;","+    _opened = false;","+    unawaited(_refresh());","+  }","+","+  Future<void> _refresh() async {","+    try {","+      await ref","+          .read(profilesActionProvider.notifier)","+          .updateProfile(widget.profile);","+    } catch (error) {","+      commonPrint.log(","+        'profile refresh after renewal failed: ${compactError(error)}',","+        logLevel: LogLevel.warning,","+      );","+    }","+  }","+","+  void _open() {","+    final url = nexoRenewUrl(widget.profile.url);","+    if (url == null) return;","+    _opened = true;","+    unawaited(launchUrl(url, mode: LaunchMode.externalApplication));","+  }","+","+  @override","+  Widget build(BuildContext context) {","+    return FilledButton(","+      onPressed: _open,","+      style: const ButtonStyle(","+        backgroundColor: WidgetStatePropertyAll(_accent),","+        foregroundColor: WidgetStatePropertyAll(Colors.white),","+        minimumSize: WidgetStatePropertyAll(Size.fromHeight(48)),","+      ),","+      child: Text(","+        NexoStrings.renew,","+        style: _manrope(","+          context,","+          AppTextStyle.subheadline,","+          weight: 650,","+          color: Colors.white,","+        ),","+      ),","+    );","+  }","+}","+"," class _InfoValue extends StatelessWidget {","   const _InfoValue({required this.label, this.color, this.alignEnd = false});"," "]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"57b52e6d-3d1d-458c-a873-bca2077279e5","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"feat/in-app-update","slug":"deep-singing-taco"}
