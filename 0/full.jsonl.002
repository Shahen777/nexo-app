{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"76d9a06bbb39e29b263a664b9c066e29d186a0012341cd89a9c1b5d565d57c0b","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01HwVRcuwxit6CBYpR3GdFtZ","name":"Write","input":{"file_path":"/private/tmp/claude-501/-Users-Sagenkazaran-Projects-nexo-app/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/users_report.py","content":"import collections\nimport sqlite3\nimport sys\n\ndb = sqlite3.connect(f'file:{sys.argv[1]}?mode=ro', uri=True)\ndb.row_factory = sqlite3.Row\nSKIP = {'vless_link', 'token', 'uuid', 'vpn_uuid', 'request_id', 'node_targets', 'referral_code'}\n\nfor table in ('users', 'devices', 'payments'):\n    print(table, [r[1] for r in db.execute(f'pragma table_info({table})')])\n\nuser_cols = [r[1] for r in db.execute('pragma table_info(users)')]\nprint('\\nusers total', db.execute('select count(*) from users').fetchone()[0])\nfor col in ('is_active', 'is_premium', 'server', 'brand', 'bot', 'platform', 'app', 'source'):\n    if col in user_cols:\n        print(col, dict(db.execute(f'select {col}, count(*) from users group by 1').fetchall()))\nexpiry = next((c for c in user_cols if 'expir' in c or c.endswith('_until') or c == 'paid_until'), None)\nif expiry:\n    print('expiry column', expiry)\n    print('with access now', db.execute(f\"select count(*) from users where {expiry} > datetime('now')\").fetchone()[0])\nprint('by signup day', db.execute(\"select substr(created_at,1,10) d, count(*) from users group by d order by d\").fetchall())\n\nprint('\\ndevices', db.execute('select count(*) from devices').fetchone()[0])\nprint('device status', dict(db.execute('select status, count(*) from devices group by 1').fetchall()))\nprint('device platform', dict(db.execute(\"select platform, count(*) from devices where status='active' group by 1\").fetchall()))\nprint('users with an active device', db.execute(\"select count(distinct tg_id) from devices where status='active'\").fetchone()[0])\n\nprint('\\npayments', dict(db.execute('select status, count(*) from payments group by 1').fetchall()))\nprint('paid sum', db.execute(\"select tariff, count(*), sum(amount) from payments where status='paid' group by 1\").fetchall())\n\ndevices = collections.defaultdict(list)\nfor row in db.execute(\"select tg_id, platform, label, status from devices\"):\n    devices[row['tg_id']].append(f\"{row['platform']}{'' if row['status'] == 'active' else '(' + row['status'] + ')'}\")\npaid = dict(db.execute(\"select tg_id, count(*) from payments where status='paid' group by 1\").fetchall())\ncols = [c for c in user_cols if c not in SKIP]\nprint('\\nLIST', cols)\nfor row in db.execute('select * from users order by created_at'):\n    shown = {c: row[c] for c in cols if c in ('username', 'first_name', 'created_at', 'is_active', 'is_premium', 'server')\n             or c == expiry}\n    print(row['tg_id'], shown, 'devices:', ','.join(devices.get(row['tg_id'], [])) or '-', 'paid:', paid.get(row['tg_id'], 0))\n"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01H8TEwUk4Y6bFAqXhuP1Vag","name":"Bash","input":{"command":"S=/private/tmp/claude-501/-Users-Sagenkazaran-Projects-nexo-app/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/users_report.py; scp -q -i ~/.ssh/codex_aura_vps $S codex-aura@152.53.50.204:/tmp/users_report.py && ssh -i ~/.ssh/codex_aura_vps codex-aura@152.53.50.204 'sudo -n /opt/nexo-bot/venv/bin/python3 -I /tmp/users_report.py /opt/aura-vpn-bot-next/aura_vpn.db 2>&1; rm -f /tmp/users_report.py'","description":"Read-only user and device report from live DB"},"caller":{"type":"direct"}}]}}
