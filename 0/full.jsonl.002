       previous = db.execute('SELECT epoch,tx,rx FROM nexo_hy2_cursors WHERE identity=?', (cursor_id,)).fetchone()\n91:            changed = db.execute('UPDATE client_traffics SET up=min(9223372036854775807,coalesce(up,0)+?), down=min(9223372036854775807,coalesce(down,0)+?) WHERE email=?',\n94:                db.execute('INSERT INTO nexo_hy2_cursors VALUES (?,?,?,?) ON CONFLICT(identity) DO UPDATE SET epoch=excluded.epoch,tx=excluded.tx,rx=excluded.rx',\n98:def collect_traffic(config_path, db_path, service='nexo-hysteria'):\n104:    account_traffic(db_path, epoch, traffic, service)\n107:def prune_online(config_path, db_path, inbound_port):\n113:        with closing(sqlite3.connect(Path(db_path).resolve().as_uri() + '?mode=ro', uri=True, timeout=2)) as db:\n/opt/aura-vpn-bot-next/aura_vpn.db.device-locks","is_error":false}]},"uuid":"11e79634-69f6-4d2b-bfba-639396dae5bb","timestamp":"2026-11-08T12:45:45.449Z","toolUseResult":{"stdout":"[Unit]\nDescription=Nexo Hysteria authentication and expiry checks\nAfter=x-ui.service\n\n[Service]\nExecStart=/usr/bin/python3 /opt/nexo-bot/hy2_auth.py\nRestart=on-failure\nRestartSec=3\nNoNewPrivileges=true\nProtectSystem=strict\nReadWritePaths=/etc/x-ui\nProtectHome=true\nPrivateTmp=true\n\n[Install]\nWantedBy=multi-user.target\n2:import hmac\n3:from contextlib import closing\n4:import json\n5:import os\n6:import sqlite3\n7:import time\n8:import uuid\n9:import threading\n10:import subprocess\n11:import urllib.request\n12:from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n13:from pathlib import Path\n16:def authenticate(credential, db_path, inbound_port, now_ms=None):\n23:        with closing(sqlite3.connect(Path(db_path).resolve().as_uri() + '?mode=ro', uri=True, timeout=2)) as db:\n24:            rows = db.execute('SELECT settings FROM inbounds WHERE port=?', (inbound_port,))\n32:                    traffic = db.execute('SELECT enable, up, down FROM client_traffics WHERE email=?', (client['email'],)).fetchone()\n3