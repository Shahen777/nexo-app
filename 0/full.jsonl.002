s from before payments keep their unlimited access\ndatabase.py:583:            paid_until = max(own[\"paid_until\"], web[\"paid_until\"] or own[\"paid_until\"])\ndatabase.py:592:        conn.execute(\"UPDATE users SET merged_into = ?, paid_until = NULL, web_token = REDACTED, recovery_code = ? WHERE tg_id = ?\",\ndatabase.py:594:        conn.execute(\"UPDATE users SET paid_until = ?, web_token = REDACTED, ?), recovery_code = COALESCE(recovery_code, ?), \"\ndatabase.py:596:                     (paid_until, None if own_token else token, None if own_code else code, web[\"device_limit\"] or 3, tg_id))\ndatabase.py:610:        rows = conn.execute(\"\"\"SELECT * FROM users WHERE tg_id > 0 AND paid_until > ? AND paid_until <= ?\ndatabase.py:611:                               AND COALESCE(reminder_for, '') != paid_until\"\"\", (now, soon)).fetchall()\ndatabase.py:613:        rows = conn.execute(\"\"\"SELECT * FROM users WHERE tg_id > 0 AND paid_until <= ?\ndatabase.py:614:                               AND COALESCE(expiry_notice_for, '') != paid_until\"\"\", (now,)).fetchall()\ndatabase.py:619:def mark_notified(tg_id: int, kind: str, paid_until: str):\ndatabase.py:622:    conn.execute(f\"UPDATE users SET {column} = ? WHERE tg_id = ?\", (paid_until, tg_id))\naccess.py:19:def notice(kind: str, paid_until: str) -> str:\naccess.py:20:    day = datetime.fromisoformat(paid_until).strftime(\"%d.%m\")\naccess.py:32:                await bot.send_message(user[\"tg_id\"], notice(kind, user[\"paid_until\"]), reply_markup=RENEW)\n            cls.dispatcher.include_router(module.router)\n\n    async def asyncSetUp(self):\n        self.transport = TelegramTransport()\n        self.bot = Bot(\"123456789:TEST_TOKEN_FOR_LOCAL_TESTS_ONLY\", session=self.transport)\n        self.patches = [\n            patch.object(start.db, \"get_user\", return_value=None),\n            patch.object(start.db, \"get_referral_count\", return_value=0),\n            patch.object(start.db, \"get_stats\", return_value=dict(total=0, active=0, premium=0, today_new=0)),\n            patch.object(start.db, \"get_all_users\", return_value=[]),\n            patch.object(start.db, \"list_devices\", return_value=[]),\n            patch.object(admin, \"ADMIN_IDS\", [123]),\n            patch.object(referral, \"BOT_USERNAME\", \"TestBot\"),\n        ]\n        for item in self.patches:\n            item.start()\n\n    async def asyncTearDown(self):\n        for item in reversed(self.patches):\n            item.stop()\n        await self.transport.close()\n\n    async def press(self, data, photo=False):\n        self.transport.photo = photo\n        message = dict(message_id=42, date=1700000000, chat={\"id\": 123, \"type\": \"private\"})\n        message.update({\"photo\": [{\"file_id\": \"qr\", \"file_unique_id\": \"qr\", \"width\": 100, \"height\": 100}], \"caption\": \"Subscription\"} if photo else {\"text\": \"Menu\"})\n        update = Update.model_validate({\"update_id\": 1, \"callback_query\": {\n            \"id\": \"query\", \"from\": {\"id\": 123, \"is_bot\": False, \"first_name\": \"Test\"},\n            \"chat_instance\": \"test\", \"data\": data, \"message\": message,\n        }})\n        return await self.dispatcher.feed_update(self.bot, update)\n\n    async def test_all_navigation_buttons_from_text_and_qr(self):\n        callbacks = {button.callback_data for markup in (main_menu(), instructions_menu(), admin_menu(), subscription_actions(\"https://example.com/install/test\"))\n                     for row in markup.inline_keyboard for button in row if button.callback_data}\n        # Provisioning is separately tested; this suite must not create accounts.\n        callbacks.remove(\"get_vpn\")\n        for photo in (False, True):\n            for data in sorted(callbacks):\n                with self.subTest(photo=photo, button=data):\n                    self.transport.calls.clear()\n\n    async def test_main_menu_cancels_pending_broadcast(self):\n        state = self.dispatcher.fsm.get_context(bot=self.bot, chat_id=123, user_id=123)\n        await self.press(\"admin_broadcast\")\n        self.assertIsNotNone(await state.get_state())\n        await self.press(\"back_main\")\n        self.assertIsNone(await state.get_state())\n\n    async def test_admin_names_cannot_break_html(self):\n        with patch.object(admin.db, \"get_all_users\", return_value=[dict(tg_id=1, first_name=\"A <B> & C\", is_active=True, created_at=\"2026-09-24\")]):\n            await self.press(\"admin_users\")\n        screen = next(call for call in self.transport.calls if isinstance(call, EditMessageText))\n        self.assertIn(\"A &lt;B&gt; &amp; C\", screen.text)\n\n    async def test_each_device_has_official_download_and_navigation(self):\n        from config import APP_LINKS, INSTALL_LINKS, PLATFORMS\n        urls = {platform: [url for _, url in (APP_LINKS.get(platform) or [INSTALL_LINKS[platform]])]\n                for platform in PLATFORMS}\n        for photo in (False, True):\n            for platform, url in urls.items():\n                with self.subTest(platform=platform, photo=photo):\n                    self.transport.calls.clear()\n                    await self.press(f\"inst_{platform}\", photo)\n                    kind = (SendMessage, EditMessageCaption) if photo else EditMessageText\n                    screen = next(call for call in self.transport.calls if isinstance(call, kind))\n                    screen_text = getattr(screen, \"text\", None) or getattr(screen, \"caption\", \"\")","is_error":false}]},"uuid":"a2af3f6a-ffbb-4a91-8661-69f11ff397fa","timestamp":"2026-11-08T12:46:46.684Z","toolUseResult":{"stdout":"database.py:112:        \"paid_until\": \"TEXT\",\ndatabase.py:396:    \"\"\"Apply a provider status idempotently. CONFIRMED extends paid_until once, from the later of\ndatabase.py:408:            user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (row[\"tg_id\"],)).fetchone()\ndatabase.py:409:            curr