{"type":"file-history-snapshot","messageId":"caad82c6-f312-4535-9f13-57f70f0b5f7d","snapshot":{"messageId":"caad82c6-f312-4535-9f13-57f70f0b5f7d","trackedFileBackups":{"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory/build_nexo_karing.py":{"backupFileName":"40004dcbb493c31b@v6","version":6,"backupTime":"2026-10-31T23:00:27.238Z","realParentDir":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/nexo_client.py":{"backupFileName":"6bd60eca1bf4b970@v5","version":5,"backupTime":"2026-11-06T10:50:24.204Z","realParentDir":"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/tests/test_webapp.py":{"backupFileName":"1fdd5065048514d6@v15","version":15,"backupTime":"2026-11-06T10:55:00.378Z","realParentDir":"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/tests"},"test/common/request_test.dart":{"backupFileName":"785c446b89471eef@v2","version":2,"backupTime":"2026-11-06T10:50:24.203Z","realParentDir":"/Users/Sagenkazaran/Projects/nexo-app/test/common"},"/Users/Sagenkazaran/.claude/projects/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/memory/shagen-preferences.md":{"backupFileName":"67d39924f7efe52c@v2","version":2,"backupTime":"2026-10-28T16:59:20.357Z","realParentDir":"/Users/Sagenkazaran/.claude/projects/REDACTED/memory"},"/private/tmp/claude-501/-Users-Sagenkazaran-