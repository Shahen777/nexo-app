{"parentUuid":"591df669-9114-4c2d-a7fc-740f0109ec97","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgmWaHP3dAToXu7338LCx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L5W1hPjwB7n69v1XdpNkp8","name":"Bash","input":{"command":"SP=\"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad\"; cd \"$SP/nexo-work\" && cat > \"$SP/apply_promo.py\" <<'PY'\ndef sub(path, old, new):\n    s = open(path, encoding='utf-8').read()\n    assert s.count(old) == 1, (path, old[:70], s.count(old))\n    open(path, 'w', encoding='utf-8').write(s.replace(old, new))\n\n# ---- database\nsub('database.py', \"\"\"            paid_at TEXT\n        );\n    \\\"\\\"\\\")\n\"\"\", \"\"\"            paid_at TEXT\n        );\n        CREATE TABLE IF NOT EXISTS promo_codes (\n            code TEXT PRIMARY KEY,\n            days INTEGER NOT NULL,\n            active INTEGER NOT NULL DEFAULT 1,\n            max_uses INTEGER,\n            created_at TEXT DEFAULT (datetime('now'))\n        );\n        CREATE TABLE IF NOT EXISTS promo_uses (\n            code TEXT NOT NULL,\n            tg_id INTEGER NOT NULL,\n            used_at TEXT NOT NULL,\n            PRIMARY KEY (code, tg_id)\n        );\n        INSERT OR IGNORE INTO promo_codes (code, days) VALUES ('TASHIR2026', 90);\n    \\\"\\\"\\\")\n\"\"\")\nsub('database.py', \"\"\"def create_web_user(trial_days: int) -> tuple[int, str]:\"\"\", \"\"\"def redeem_promo(tg_id: int, raw_code: str) -> tuple[str, str | None]:\n    \\\"\\\"\\\"Add a promo code's days once per account, from the later of now and the current end. Returns\n    (status, paid_until): ok, bad, used, unlimited (no end date to extend) or no_account.\\\"\\\"\\\"\n    code = raw_code.strip().upper()\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        promo = conn.execute(\"SELECT * FROM promo_codes WHERE code = ? AND active = 1\", (code,)).fetchone()\n        if not promo:\n            conn.rollback()\n            return \"bad\", None\n        user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not user:\n            conn.rollback()\n            return \"no_account\", None\n        if user[\"paid_until\"] is None:\n            conn.rollback()\n            return \"unlimited\", None\n        if conn.execute(\"SELECT 1 FROM promo_uses WHERE code = ? AND tg_id = ?\", (code, tg_id)).fetchone():\n            conn.rollback()\n            return \"used\", user[\"paid_until\"]\n        uses = conn.execute(\"SELECT COUNT(*) FROM promo_uses WHERE code = ?\", (code,)).fetchone()[0]\n        if promo[\"max_uses\"] is not None and uses >= promo[\"max_uses\"]:\n            conn.rollback()\n            return \"bad\", None\n        now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)  # stored as naive UTC\n        until = max(now, datetime.fromisoformat(user[\"paid_until\"])) + timedelta(days=promo[\"days\"])\n        conn.execute(\"INSERT INTO promo_uses (code, tg_id, used_at) VALUES (?, ?, ?)\", (code, tg_id, now.isoformat()))\n        conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), tg_id))\n        conn.commit()\n        return \"ok\", until.isoformat()\n    finally:\n        conn.close()\n\n\ndef create_web_user(trial_days: int) -> tuple[int, str]:\"\"\")\nsub('database.py', \"\"\"        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n\"\"\", \"\"\"        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"UPDATE OR IGNORE promo_uses SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"DELETE FROM promo_uses WHERE tg_id = ?\", (web[\"tg_id\"],))\n\"\"\")\n\n# ---- payments\nsub('payments.py', \"\"\"import hmac\nimport logging\nimport os\n\"\"\", \"\"\"import hmac\nimport logging\nimport os\nimport time\n\"\"\")\nsub('payments.py', \"\"\"async def resume_access(tg_id: int, service=None):\"\"\", \"\"\"async def redeem_promo(tg_id: int, code: str, attempts_key: str, service=None) -> tuple[str, str | None]:\n    \\\"\\\"\\\"db.redeem_promo with a limit on wrong guesses (status \"limit\") and access turned back on.\\\"\\\"\\\"\n    now = time.time()\n    fails = [t for t in _promo_fails.get(attempts_key, []) if now - t < 3600]\n    _promo_fails[attempts_key] = fails\n    if len(fails) >= PROMO_FAILS_PER_HOUR:\n        return \"limit\", None\n    status, until = db.redeem_promo(tg_id, code)\n    if status == \"bad\":\n        _promo_fails[attempts_key] = fails + [now]\n    elif status == \"ok\":\n        await resume_access(tg_id, service)\n    return status, until\n\n\nasync def resume_access(tg_id: int, service=None):\"\"\")\nsub('payments.py', \"\"\"DAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\n\"\"\", \"\"\"DAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\nPROMO_FAILS_PER_HOUR = 10\n_promo_fails: dict[str, list[float]] = {}\n\"\"\")\nsub('payments.py', \"\"\"def paid_until_text(value: str | None) -> str:\"\"\", \"\"\"def promo_text(status: str, until: str | None) -> str:\n    return {\n        \"ok\": f\"Промокод применён. Доступ продлён до {paid_until_text(until)}.\",\n        \"bad\": \"Такого промокода нет. Проверьте написание.\",\n        \"used\": \"Этот промокод уже использован на вашем аккаунте.\",\n        \"unlimited\": \"У вас доступ без срока, промокод не нужен.\",\n        \"no_account\": \"Сначала подключите устройство, затем введите промокод.\",\n        \"limit\": \"Слишком много неверных промокодов. Попробуйте через час.\",\n    }[status]\n\n\ndef paid_until_text(value: str | None) -> str:\"\"\")\n\n# ---- web\nw = 'webapp.py'\nsub(w, \"\"\"    # -- pay\n    pay = '<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\"\"\", \"\"\"    # -- pay\n    pay = f'<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>{pay_options(f\"/c/{token}\")}</section>'\n\"\"\")\nsub(w, \"\"\"async def handle_cabinet(request):\n    db, user = _user(request)\"\"\", \"\"\"def pay_options(prefix):\n    \\\"\\\"\\\"Tariffs and the promo code form, posting to {prefix}/pay and {prefix}/promo.\\\"\\\"\\\"\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        out = '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            out += (f'<form method=\"post\" action=\"{prefix}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        out += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        out = '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    return (out + '<div class=\"cap\">Промокод</div><div class=\"group pad\">'\n            f'<form method=\"post\" action=\"{prefix}/promo\"><label for=\"promo\">Если у вас есть промокод</label>'\n            '<input class=\"field\" id=\"promo\" name=\"code\" autocomplete=\"off\" autocapitalize=\"characters\" maxlength=\"32\" required>'\n            '<button class=\"btn quiet\">Применить</button></form></div>')\n\n\nasync def _payment_flash(request, owner):\n    \\\"\\\"\\\"The banner for the way back from the payment page (?check=) or a promo code (?promo=).\\\"\\\"\\\"\n    db, q = request.app[_keys().DATABASE_KEY], request.query\n    promo = q.get(\"promo\")\n    if promo:\n        fresh = db.get_user(owner[\"tg_id\"]) or owner\n        known = promo in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\")\n        if not known:\n            return \"\"\n        return f'<div class=\"flash{\"\" if promo == \"ok\" else \" err\"}\">{payments.promo_text(promo, fresh.get(\"paid_until\"))}</div>'\n    if q.get(\"check\", \"\").isdigit():\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == owner[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            if payment[\"status\"] == \"paid\":\n                return '<div class=\"flash\">Оплата получена, доступ продлён.</div>'\n            if payment[\"status\"] == \"pending\":\n                return '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили, обновите страницу через минуту.</div>'\n            return '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попробовать снова.</div>'\n    return \"\"\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\"\"\")\nsub(w, \"\"\"    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов.\"\"\", \"\"\"    if q.get(\"promo\"):\n        flash += await _payment_flash(request, user)\n        user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов.\"\"\")\nsub(w, \"\"\"# ---------------------------------------------------------------- documents & files\n\"\"\", \"\"\"async def handle_promo(request):\n    _, user = _user(request)\n    token = request.match_info[\"token\"]\n    status, _ = await payments.redeem_promo(user[\"tg_id\"], str((await request.post()).get(\"code\", \"\")),\n                                            request.remote or \"unknown\", service=_service(request))\n    raise web.HTTPSeeOther(f\"/c/{token}?promo={status}#{'home' if status == 'ok' else 'pay'}\")\n\n\n# ---------------------------------------------------------------- renewal from a VPN app\n# Reached with a subscription token, which people share: it shows the end date and takes payment,\n# never the cabinet, its keys or the access code.\ndef _renew_owner(request):\n    db = request.app[_keys().DATABASE_KEY]\n    row = db.get_user_by_subscription_token(request.match_info.get(\"token\", \"\"))\n    owner = db.get_user(row[\"tg_id\"]) if row else None\n    if not owner:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return owner\n\n\nasync def handle_renew(request):\n    owner = _renew_owner(request)\n    token = request.match_info[\"token\"]\n    flash = await _payment_flash(request, owner)\n    owner = request.app[_keys().DATABASE_KEY].get_user(owner[\"tg_id\"])\n    until = payments.active_until(owner)\n    state = (\"Доступ без срока\" if not owner.get(\"paid_until\") else\n             f\"Доступ до {until:%d.%m.%Y}\" if until else \"Доступ закончился, VPN отключён\")\n    body = (f'<div class=\"app solo\">{appbar(f\"/renew/{token}\")}<div class=\"screen\" style=\"display:block\">'\n            f'<h1 class=\"large\">Продление</h1>{flash}<div class=\"group pad\"><b>{state}</b></div>'\n            f'{pay_options(f\"/renew/{token}\")}</div></div>')\n    return page(f\"{BRAND_TITLE} — продление\", body)\n\n\nasync def handle_renew_pay(request):\n    owner = _renew_owner(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    try:\n        created = await payments.create_link(owner[\"tg_id\"], request.query.get(\"tariff\", \"\"), return_url=f\"{base}/renew/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/renew/{token}?promo=payfail\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\nasync def handle_renew_promo(request):\n    owner = _renew_owner(request)\n    status, _ = await payments.redeem_promo(owner[\"tg_id\"], str((await request.post()).get(\"code\", \"\")),\n                                            request.remote or \"unknown\", service=_service(request))\n    raise web.HTTPSeeOther(f\"/renew/{request.match_info['token']}?promo={status}\")\n\n\n# ---------------------------------------------------------------- documents & files\n\"\"\")\nsub(w, \"\"\"    app.router.add_post(\"/c/{token}/telegram\", handle_telegram)\n\"\"\", \"\"\"    app.router.add_post(\"/c/{token}/telegram\", handle_telegram)\n    app.router.add_post(\"/c/{token}/promo\", handle_promo)\n    app.router.add_get(\"/renew/{token}\", handle_renew)\n    app.router.add_post(\"/renew/{token}/pay\", handle_renew_pay)\n    app.router.add_post(\"/renew/{token}/promo\", handle_renew_promo)\n\"\"\")\nsub(w, \"\"\"        known = promo in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\")\n        if not known:\n            return \"\"\n\"\"\", \"\"\"        if promo == \"payfail\":\n            return '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n        if promo not in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\"):\n            return \"\"\n\"\"\")\n\n# ---- subscription header\nsub('subscription.py', \"\"\"        # Every client shows the end date. The notice and the renew button are Happ's; the button leads\n        # to /app, not to the cabinet link, because people share subscription links.\n\"\"\", \"\"\"        # Every client shows the end date. The notice and the renew button are Happ's; the button leads\n        # to the renewal page, not to the cabinet link, because people share subscription links.\n\"\"\")\nsub('subscription.py', \"\"\"        headers['profile-web-page-url'] = f'{base}/app#pay'\n\"\"\", \"\"\"        headers['profile-web-page-url'] = f'{base}/renew/{token}'\n\"\"\")\n\n# ---- Nexo profile: the site stays reachable when the VPN is cut or the access has ended\nn = 'nexo_client.py'\nsub(n, \"\"\"import base64\nimport json\nfrom urllib.parse import parse_qs, unquote, urlsplit\n\nfrom happ_client import DIRECT_DOMAINS, DIRECT_IPS\n\"\"\", \"\"\"import base64\nimport ipaddress\nimport json\nfrom urllib.parse import parse_qs, unquote, urlsplit\n\nfrom config import PUBLIC_BASE_URL\nfrom happ_client import DIRECT_DOMAINS, DIRECT_IPS\n\"\"\")\nsub(n, \"\"\"    rules.append(f'MATCH,{SELECT}')\n\"\"\", \"\"\"    rules += _site_rule()\n    rules.append(f'MATCH,{SELECT}')\n\"\"\")\nsub(n, \"\"\"def profile(encoded_payload):\"\"\", \"\"\"def _site_rule():\n    \\\"\\\"\\\"Renewing and updating must work when the access has ended and the tunnel no longer carries traffic.\\\"\\\"\\\"\n    host = urlsplit(PUBLIC_BASE_URL).hostname\n    if not host:\n        return []\n    try:\n        return [f'IP-CIDR,{ipaddress.IPv4Address(host)}/32,DIRECT,no-resolve']\n    except ValueError:\n        return [f'DOMAIN,{host},DIRECT']\n\n\ndef profile(encoded_payload):\"\"\")\n\n# ---- bot\nb = 'handlers/pay.py'\nsub(b, \"\"\"from aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\"\"\", \"\"\"from aiogram import F, Router\nfrom aiogram.fsm.context import FSMContext\nfrom aiogram.fsm.state import State, StatesGroup\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup, Message\n\"\"\")\nsub(b, \"\"\"router = Router()\n\"\"\", \"\"\"router = Router()\n\n\nclass PromoState(StatesGroup):\n    waiting_code = State()\n\"\"\")\nsub(b, \"\"\"async def choose_tariff(callback: CallbackQuery):\n\"\"\", \"\"\"async def choose_tariff(callback: CallbackQuery, state: FSMContext):\n    await state.clear()\n\"\"\")\nsub(b, \"\"\"    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n\"\"\", \"\"\"    rows.append([cb(\"🎁 Ввести промокод\", \"promo\")])\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n\"\"\")\nsub(b, \"\"\"@router.callback_query(F.data.startswith(\"buy:\"))\n\"\"\", \"\"\"@router.callback_query(F.data == \"promo\")\nasync def ask_promo(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.set_state(PromoState.waiting_code)\n    await show_card(callback.message, \"docs\", \"<b>Промокод</b>\\\\n\\\\nОтправьте промокод одним сообщением.\",\n                    reply_markup=kb([cb(\"‹ Назад\", \"pay\")]))\n\n\n@router.message(PromoState.waiting_code, F.text)\nasync def enter_promo(message: Message, state: FSMContext):\n    await state.clear()\n    status, until = await payments.redeem_promo(message.from_user.id, message.text, f\"tg{message.from_user.id}\")\n    row = [cb(\"Главное меню\", \"back_main\")] if status == \"ok\" else [cb(\"Ввести ещё раз\", \"promo\")]\n    await message.answer(payments.promo_text(status, until), reply_markup=kb(row))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\n\"\"\")\n\n# ---- tests\nt = 'tests/test_webapp.py'\nsub(t, 'self.assertEqual(response.headers[\"profile-web-page-url\"], \"https://vpn.example/app#pay\")', 'self.assertEqual(response.headers[\"profile-web-page-url\"], f\"https://vpn.example/renew/{token}\")')\ns = open(t, encoding='utf-8').read()\ns = s.rstrip('\\n') + '''\n\n\nclass PromoAndRenewTests(NexoProfileTests):\n    async def enter(self, path, code):\n        return await self.client.post(path, data={\"code\": code}, allow_redirects=False)\n\n    async def test_cabinet_promo_adds_ninety_days_once_in_any_letter_case(self):\n        location, _, until = await self.period_ending_in(timedelta(days=10))\n        cabinet = location.split(\"?\")[0].split(\"#\")[0]\n        tg_id = db.get_user_by_web_token(cabinet.rsplit(\"/\", 1)[1])[\"tg_id\"]\n        response = await self.enter(cabinet + \"/promo\", \" tashir2026 \")\n        self.assertIn(\"promo=ok\", response.headers[\"Location\"])\n        extended = datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"])\n        self.assertEqual(extended - until, timedelta(days=90))\n        page = await (await self.client.get(response.headers[\"Location\"])).text()\n        self.assertIn(f\"Доступ продлён до {extended:%d.%m.%Y}\", page)\n        again = await self.enter(cabinet + \"/promo\", \"Tashir2026\")\n        self.assertIn(\"promo=used\", again.headers[\"Location\"])\n        self.assertEqual(datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"]), extended)\n\n    async def test_ended_access_runs_from_today_and_wrong_codes_are_limited(self):\n        location, _, _ = await self.period_ending_in(timedelta(days=-5))\n        cabinet = location.split(\"?\")[0].split(\"#\")[0]\n        tg_id = db.get_user_by_web_token(cabinet.rsplit(\"/\", 1)[1])[\"tg_id\"]\n        for _ in range(payments.PROMO_FAILS_PER_HOUR):\n            self.assertIn(\"promo=bad\", (await self.enter(cabinet + \"/promo\", \"nope\")).headers[\"Location\"])\n        self.assertIn(\"promo=limit\", (await self.enter(cabinet + \"/promo\", \"Tashir2026\")).headers[\"Location\"])\n        payments._promo_fails.clear()\n        await self.enter(cabinet + \"/promo\", \"Tashir2026\")\n        left = datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"]) - datetime.now(timezone.utc).replace(tzinfo=None)\n        self.assertGreater(left, timedelta(days=89))\n        self.assertLessEqual(left, timedelta(days=90))\n\n    async def test_renew_page_shows_no_cabinet_and_accepts_promo(self):\n        location, token, until = await self.period_ending_in(timedelta(days=2))\n        cabinet_token = REDACTED, 1)[1]\n        text = await (await self.client.get(\"/renew/\" + token)).text()\n        self.assertIn(f\"Доступ до {until:%d.%m.%Y}\", text)\n        self.assertNotIn(cabinet_token, text)\n        response = await self.enter(f\"/renew/{token}/promo\", \"Tashir2026\")\n        self.assertIn(\"promo=ok\", response.headers[\"Location\"])\n        self.assertEqual((await self.client.get(\"/renew/\" + \"x\" * 40)).status, 404)\n\n    async def test_renew_payment_returns_to_the_renew_page(self):\n        _, token, _ = await self.period_ending_in(timedelta(days=2))\n        with patch.object(payments, \"create_link\", AsyncMock(return_value={\"url\": \"https://pay.example/1\"})) as link:\n            response = await self.client.post(f\"/renew/{token}/pay?tariff=m1\", allow_redirects=False)\n        self.assertEqual(response.headers[\"Location\"], \"https://pay.example/1\")\n        self.assertEqual(link.await_args.kwargs[\"return_url\"], f\"https://vpn.example/renew/{token}?check={{id}}\")\n\n    def test_merging_accounts_keeps_the_code_used(self):\n        web_id, _ = db.create_web_user(7)\n        self.assertEqual(db.redeem_promo(web_id, \"Tashir2026\")[0], \"ok\")\n        code = db.create_link_code(web_id)\n        db.merge_web_account(code, 555, \"u\", \"U\")\n        self.assertEqual(db.redeem_promo(555, \"Tashir2026\")[0], \"used\")\n'''\nopen(t, 'w', encoding='utf-8').write(s)\n\nt = 'tests/test_payments.py'\ns = open(t, encoding='utf-8').read()\ns = s.rstrip('\\n') + '''\n\n\nclass PromoBotTests(unittest.IsolatedAsyncioTestCase):\n    async def asyncSetUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.db_patch = patch.object(db, \"DB_PATH\", self.tmp.name + \"/test.db\")\n        self.db_patch.start()\n        db.init_db()\n        payments._promo_fails.clear()\n\n    async def asyncTearDown(self):\n        self.db_patch.stop()\n        self.tmp.cleanup()\n\n    async def send(self, tg_id, text):\n        message, state = AsyncMock(), AsyncMock()\n        message.text = text\n        message.from_user.id = tg_id\n        with patch.object(payments, \"resume_access\", AsyncMock()) as resume:\n            await pay.enter_promo(message, state)\n        state.clear.assert_awaited()\n        return message.answer.await_args.args[0], resume\n\n    async def test_code_extends_access_and_turns_it_back_on(self):\n        db.add_user(123, \"u\", \"Owner\", None, None)\n        conn = db.get_db()\n        conn.execute(\"UPDATE users SET paid_until = '2020-01-01T00:00:00' WHERE tg_id = 123\")\n        conn.commit()\n        conn.close()\n        text, resume = await self.send(123, \"Tashir2026\")\n        self.assertIn(\"Доступ продлён\", text)\n        resume.assert_awaited()\n        self.assertIn(\"уже использован\", (await self.send(123, \"TASHIR2026\"))[0])\n\n    async def test_unknown_person_and_unlimited_account_are_told_why(self):\n        self.assertIn(\"Сначала подключите\", (await self.send(999, \"Tashir2026\"))[0])\n        db.add_user(123, \"u\", \"Owner\", None, None)\n        self.assertIn(\"без срока\", (await self.send(123, \"Tashir2026\"))[0])\n        self.assertIn(\"нет\", (await self.send(123, \"другое\"))[0])\n'''\nopen(t, 'w', encoding='utf-8').write(s)\nPY\npython3 \"$SP/apply_promo.py\" && grep -n \"period_ending_in\" -A12 tests/test_webapp.py | sed -n 1,16p | cut -c1-130; cat > \"$SP/stg.sh\" <<'SH'\nset -e\nrm -rf /tmp/stg /tmp/st.db; mkdir -p /tmp/stg\nsudo tar -C /opt/nexo-bot --exclude=venv --exclude=.git --exclude=assets/downloads --exclude=assets/video -cf - . | tar -xf - -C /tmp/stg\ntar -xf /tmp/upd.tar -C /tmp/stg\ncd /tmp/stg\nPYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=/tmp/st.db AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay /opt/nexo-bot/venv/bin/python -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -vE '^(\\.|$|INFO|WARNING)' | tail -45 | cut -c1-170\nSH\nCOPYFILE_DISABLE=1 tar --no-xattrs -cf \"$SP/upd.tar\" database.py payments.py webapp.py subscription.py nexo_client.py handlers/pay.py tests/test_webapp.py tests/test_payments.py && scp -q -i ~/.ssh/codex_aura_vps \"$SP/upd.tar\" \"$SP/stg.sh\" codex-aura@152.53.50.204:/tmp/ && ssh -i ~/.ssh/codex_aura_vps codex-aura@152.53.50.204 'bash /tmp/stg.sh'","description":"Apply promo and renewal server code, run tests in staging","timeout":240000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7863,"cache_read_input_tokens":354062,"output_tokens":10218,"output_tokens_details":{"thinking_tokens":44},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7863,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10218,"cache_read_input_tokens":354062,"cache_creation_input_tokens":7863,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7863},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01L5W1hPjwB7n69v1XdpNkp8":{"command":"SP=\"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad\"; cd \"$SP/nexo-work\" && cat > \"$SP/apply_promo.py\" <<'PY'\ndef sub(path, old, new):\n    s = open(path, encoding='utf-8').read()\n    assert s.count(old) == 1, (path, old[:70], s.count(old))\n    open(path, 'w', encoding='utf-8').write(s.replace(old, new))\n\n# ---- database\nsub('database.py', \"\"\"            paid_at TEXT\n        );\n    \\\"\\\"\\\")\n\"\"\", \"\"\"            paid_at TEXT\n        );\n        CREATE TABLE IF NOT EXISTS promo_codes (\n            code TEXT PRIMARY KEY,\n            days INTEGER NOT NULL,\n            active INTEGER NOT NULL DEFAULT 1,\n            max_uses INTEGER,\n            created_at TEXT DEFAULT (datetime('now'))\n        );\n        CREATE TABLE IF NOT EXISTS promo_uses (\n            code TEXT NOT NULL,\n            tg_id INTEGER NOT NULL,\n            used_at TEXT NOT NULL,\n            PRIMARY KEY (code, tg_id)\n        );\n        INSERT OR IGNORE INTO promo_codes (code, days) VALUES ('TASHIR2026', 90);\n    \\\"\\\"\\\")\n\"\"\")\nsub('database.py', \"\"\"def create_web_user(trial_days: int) -> tuple[int, str]:\"\"\", \"\"\"def redeem_promo(tg_id: int, raw_code: str) -> tuple[str, str | None]:\n    \\\"\\\"\\\"Add a promo code's days once per account, from the later of now and the current end. Returns\n    (status, paid_until): ok, bad, used, unlimited (no end date to extend) or no_account.\\\"\\\"\\\"\n    code = raw_code.strip().upper()\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        promo = conn.execute(\"SELECT * FROM promo_codes WHERE code = ? AND active = 1\", (code,)).fetchone()\n        if not promo:\n            conn.rollback()\n            return \"bad\", None\n        user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not user:\n            conn.rollback()\n            return \"no_account\", None\n        if user[\"paid_until\"] is None:\n            conn.rollback()\n            return \"unlimited\", None\n        if conn.execute(\"SELECT 1 FROM promo_uses WHERE code = ? AND tg_id = ?\", (code, tg_id)).fetchone():\n            conn.rollback()\n            return \"used\", user[\"paid_until\"]\n        uses = conn.execute(\"SELECT COUNT(*) FROM promo_uses WHERE code = ?\", (code,)).fetchone()[0]\n        if promo[\"max_uses\"] is not None and uses >= promo[\"max_uses\"]:\n            conn.rollback()\n            return \"bad\", None\n        now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)  # stored as naive UTC\n        until = max(now, datetime.fromisoformat(user[\"paid_until\"])) + timedelta(days=promo[\"days\"])\n        conn.execute(\"INSERT INTO promo_uses (code, tg_id, used_at) VALUES (?, ?, ?)\", (code, tg_id, now.isoformat()))\n        conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), tg_id))\n        conn.commit()\n        return \"ok\", until.isoformat()\n    finally:\n        conn.close()\n\n\ndef create_web_user(trial_days: int) -> tuple[int, str]:\"\"\")\nsub('database.py', \"\"\"        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n\"\"\", \"\"\"        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"UPDATE OR IGNORE promo_uses SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"DELETE FROM promo_uses WHERE tg_id = ?\", (web[\"tg_id\"],))\n\"\"\")\n\n# ---- payments\nsub('payments.py', \"\"\"import hmac\nimport logging\nimport os\n\"\"\", \"\"\"import hmac\nimport logging\nimport os\nimport time\n\"\"\")\nsub('payments.py', \"\"\"async def resume_access(tg_id: int, service=None):\"\"\", \"\"\"async def redeem_promo(tg_id: int, code: str, attempts_key: str, service=None) -> tuple[str, str | None]:\n    \\\"\\\"\\\"db.redeem_promo with a limit on wrong guesses (status \"limit\") and access turned back on.\\\"\\\"\\\"\n    now = time.time()\n    fails = [t for t in _promo_fails.get(attempts_key, []) if now - t < 3600]\n    _promo_fails[attempts_key] = fails\n    if len(fails) >= PROMO_FAILS_PER_HOUR:\n        return \"limit\", None\n    status, until = db.redeem_promo(tg_id, code)\n    if status == \"bad\":\n        _promo_fails[attempts_key] = fails + [now]\n    elif status == \"ok\":\n        await resume_access(tg_id, service)\n    return status, until\n\n\nasync def resume_access(tg_id: int, service=None):\"\"\")\nsub('payments.py', \"\"\"DAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\n\"\"\", \"\"\"DAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\nPROMO_FAILS_PER_HOUR = 10\n_promo_fails: dict[str, list[float]] = {}\n\"\"\")\nsub('payments.py', \"\"\"def paid_until_text(value: str | None) -> str:\"\"\", \"\"\"def promo_text(status: str, until: str | None) -> str:\n    return {\n        \"ok\": f\"Промокод применён. Доступ продлён до {paid_until_text(until)}.\",\n        \"bad\": \"Такого промокода нет. Проверьте написание.\",\n        \"used\": \"Этот промокод уже использован на вашем аккаунте.\",\n        \"unlimited\": \"У вас доступ без срока, промокод не нужен.\",\n        \"no_account\": \"Сначала подключите устройство, затем введите промокод.\",\n        \"limit\": \"Слишком много неверных промокодов. Попробуйте через час.\",\n    }[status]\n\n\ndef paid_until_text(value: str | None) -> str:\"\"\")\n\n# ---- web\nw = 'webapp.py'\nsub(w, \"\"\"    # -- pay\n    pay = '<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\"\"\", \"\"\"    # -- pay\n    pay = f'<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>{pay_options(f\"/c/{token}\")}</section>'\n\"\"\")\nsub(w, \"\"\"async def handle_cabinet(request):\n    db, user = _user(request)\"\"\", \"\"\"def pay_options(prefix):\n    \\\"\\\"\\\"Tariffs and the promo code form, posting to {prefix}/pay and {prefix}/promo.\\\"\\\"\\\"\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        out = '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            out += (f'<form method=\"post\" action=\"{prefix}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        out += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        out = '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    return (out + '<div class=\"cap\">Промокод</div><div class=\"group pad\">'\n            f'<form method=\"post\" action=\"{prefix}/promo\"><label for=\"promo\">Если у вас есть промокод</label>'\n            '<input class=\"field\" id=\"promo\" name=\"code\" autocomplete=\"off\" autocapitalize=\"characters\" maxlength=\"32\" required>'\n            '<button class=\"btn quiet\">Применить</button></form></div>')\n\n\nasync def _payment_flash(request, owner):\n    \\\"\\\"\\\"The banner for the way back from the payment page (?check=) or a promo code (?promo=).\\\"\\\"\\\"\n    db, q = request.app[_keys().DATABASE_KEY], request.query\n    promo = q.get(\"promo\")\n    if promo:\n        fresh = db.get_user(owner[\"tg_id\"]) or owner\n        known = promo in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\")\n        if not known:\n            return \"\"\n        return f'<div class=\"flash{\"\" if promo == \"ok\" else \" err\"}\">{payments.promo_text(promo, fresh.get(\"paid_until\"))}</div>'\n    if q.get(\"check\", \"\").isdigit():\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == owner[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            if payment[\"status\"] == \"paid\":\n                return '<div class=\"flash\">Оплата получена, доступ продлён.</div>'\n            if payment[\"status\"] == \"pending\":\n                return '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили, обновите страницу через минуту.</div>'\n            return '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попробовать снова.</div>'\n    return \"\"\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\"\"\")\nsub(w, \"\"\"    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов.\"\"\", \"\"\"    if q.get(\"promo\"):\n        flash += await _payment_flash(request, user)\n        user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов.\"\"\")\nsub(w, \"\"\"# ---------------------------------------------------------------- documents & files\n\"\"\", \"\"\"async def handle_promo(request):\n    _, user = _user(request)\n    token = request.match_info[\"token\"]\n    status, _ = await payments.redeem_promo(user[\"tg_id\"], str((await request.post()).get(\"code\", \"\")),\n                                            request.remote or \"unknown\", service=_service(request))\n    raise web.HTTPSeeOther(f\"/c/{token}?promo={status}#{'home' if status == 'ok' else 'pay'}\")\n\n\n# ---------------------------------------------------------------- renewal from a VPN app\n# Reached with a subscription token, which people share: it shows the end date and takes payment,\n# never the cabinet, its keys or the access code.\ndef _renew_owner(request):\n    db = request.app[_keys().DATABASE_KEY]\n    row = db.get_user_by_subscription_token(request.match_info.get(\"token\", \"\"))\n    owner = db.get_user(row[\"tg_id\"]) if row else None\n    if not owner:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return owner\n\n\nasync def handle_renew(request):\n    owner = _renew_owner(request)\n    token = request.match_info[\"token\"]\n    flash = await _payment_flash(request, owner)\n    owner = request.app[_keys().DATABASE_KEY].get_user(owner[\"tg_id\"])\n    until = payments.active_until(owner)\n    state = (\"Доступ без срока\" if not owner.get(\"paid_until\") else\n             f\"Доступ до {until:%d.%m.%Y}\" if until else \"Доступ закончился, VPN отключён\")\n    body = (f'<div class=\"app solo\">{appbar(f\"/renew/{token}\")}<div class=\"screen\" style=\"display:block\">'\n            f'<h1 class=\"large\">Продление</h1>{flash}<div class=\"group pad\"><b>{state}</b></div>'\n            f'{pay_options(f\"/renew/{token}\")}</div></div>')\n    return page(f\"{BRAND_TITLE} — продление\", body)\n\n\nasync def handle_renew_pay(request):\n    owner = _renew_owner(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    try:\n        created = await payments.create_link(owner[\"tg_id\"], request.query.get(\"tariff\", \"\"), return_url=f\"{base}/renew/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/renew/{token}?promo=payfail\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\nasync def handle_renew_promo(request):\n    owner = _renew_owner(request)\n    status, _ = await payments.redeem_promo(owner[\"tg_id\"], str((await request.post()).get(\"code\", \"\")),\n                                            request.remote or \"unknown\", service=_service(request))\n    raise web.HTTPSeeOther(f\"/renew/{request.match_info['token']}?promo={status}\")\n\n\n# ---------------------------------------------------------------- documents & files\n\"\"\")\nsub(w, \"\"\"    app.router.add_post(\"/c/{token}/telegram\", handle_telegram)\n\"\"\", \"\"\"    app.router.add_post(\"/c/{token}/telegram\", handle_telegram)\n    app.router.add_post(\"/c/{token}/promo\", handle_promo)\n    app.router.add_get(\"/renew/{token}\", handle_renew)\n    app.router.add_post(\"/renew/{token}/pay\", handle_renew_pay)\n    app.router.add_post(\"/renew/{token}/promo\", handle_renew_promo)\n\"\"\")\nsub(w, \"\"\"        known = promo in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\")\n        if not known:\n            return \"\"\n\"\"\", \"\"\"        if promo == \"payfail\":\n            return '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n        if promo not in (\"ok\", \"bad\", \"used\", \"unlimited\", \"limit\"):\n            return \"\"\n\"\"\")\n\n# ---- subscription header\nsub('subscription.py', \"\"\"        # Every client shows the end date. The notice and the renew button are Happ's; the button leads\n        # to /app, not to the cabinet link, because people share subscription links.\n\"\"\", \"\"\"        # Every client shows the end date. The notice and the renew button are Happ's; the button leads\n        # to the renewal page, not to the cabinet link, because people share subscription links.\n\"\"\")\nsub('subscription.py', \"\"\"        headers['profile-web-page-url'] = f'{base}/app#pay'\n\"\"\", \"\"\"        headers['profile-web-page-url'] = f'{base}/renew/{token}'\n\"\"\")\n\n# ---- Nexo profile: the site stays reachable when the VPN is cut or the access has ended\nn = 'nexo_client.py'\nsub(n, \"\"\"import base64\nimport json\nfrom urllib.parse import parse_qs, unquote, urlsplit\n\nfrom happ_client import DIRECT_DOMAINS, DIRECT_IPS\n\"\"\", \"\"\"import base64\nimport ipaddress\nimport json\nfrom urllib.parse import parse_qs, unquote, urlsplit\n\nfrom config import PUBLIC_BASE_URL\nfrom happ_client import DIRECT_DOMAINS, DIRECT_IPS\n\"\"\")\nsub(n, \"\"\"    rules.append(f'MATCH,{SELECT}')\n\"\"\", \"\"\"    rules += _site_rule()\n    rules.append(f'MATCH,{SELECT}')\n\"\"\")\nsub(n, \"\"\"def profile(encoded_payload):\"\"\", \"\"\"def _site_rule():\n    \\\"\\\"\\\"Renewing and updating must work when the access has ended and the tunnel no longer carries traffic.\\\"\\\"\\\"\n    host = urlsplit(PUBLIC_BASE_URL).hostname\n    if not host:\n        return []\n    try:\n        return [f'IP-CIDR,{ipaddress.IPv4Address(host)}/32,DIRECT,no-resolve']\n    except ValueError:\n        return [f'DOMAIN,{host},DIRECT']\n\n\ndef profile(encoded_payload):\"\"\")\n\n# ---- bot\nb = 'handlers/pay.py'\nsub(b, \"\"\"from aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\"\"\", \"\"\"from aiogram import F, Router\nfrom aiogram.fsm.context import FSMContext\nfrom aiogram.fsm.state import State, StatesGroup\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup, Message\n\"\"\")\nsub(b, \"\"\"router = Router()\n\"\"\", \"\"\"router = Router()\n\n\nclass PromoState(StatesGroup):\n    waiting_code = State()\n\"\"\")\nsub(b, \"\"\"async def choose_tariff(callback: CallbackQuery):\n\"\"\", \"\"\"async def choose_tariff(callback: CallbackQuery, state: FSMContext):\n    await state.clear()\n\"\"\")\nsub(b, \"\"\"    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n\"\"\", \"\"\"    rows.append([cb(\"🎁 Ввести промокод\", \"promo\")])\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n\"\"\")\nsub(b, \"\"\"@router.callback_query(F.data.startswith(\"buy:\"))\n\"\"\", \"\"\"@router.callback_query(F.data == \"promo\")\nasync def ask_promo(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.set_state(PromoState.waiting_code)\n    await show_card(callback.message, \"docs\", \"<b>Промокод</b>\\\\n\\\\nОтправьте промокод одним сообщением.\",\n                    reply_markup=kb([cb(\"‹ Назад\", \"pay\")]))\n\n\n@router.message(PromoState.waiting_code, F.text)\nasync def enter_promo(message: Message, state: FSMContext):\n    await state.clear()\n    status, until = await payments.redeem_promo(message.from_user.id, message.text, f\"tg{message.from_user.id}\")\n    row = [cb(\"Главное меню\", \"back_main\")] if status == \"ok\" else [cb(\"Ввести ещё раз\", \"promo\")]\n    await message.answer(payments.promo_text(status, until), reply_markup=kb(row))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\n\"\"\")\n\n# ---- tests\nt = 'tests/test_webapp.py'\nsub(t, 'self.assertEqual(response.headers[\"profile-web-page-url\"], \"https://vpn.example/app#pay\")', 'self.assertEqual(response.headers[\"profile-web-page-url\"], f\"https://vpn.example/renew/{token}\")')\ns = open(t, encoding='utf-8').read()\ns = s.rstrip('\\n') + '''\n\n\nclass PromoAndRenewTests(NexoProfileTests):\n    async def enter(self, path, code):\n        return await self.client.post(path, data={\"code\": code}, allow_redirects=False)\n\n    async def test_cabinet_promo_adds_ninety_days_once_in_any_letter_case(self):\n        location, _, until = await self.period_ending_in(timedelta(days=10))\n        cabinet = location.split(\"?\")[0].split(\"#\")[0]\n        tg_id = db.get_user_by_web_token(cabinet.rsplit(\"/\", 1)[1])[\"tg_id\"]\n        response = await self.enter(cabinet + \"/promo\", \" tashir2026 \")\n        self.assertIn(\"promo=ok\", response.headers[\"Location\"])\n        extended = datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"])\n        self.assertEqual(extended - until, timedelta(days=90))\n        page = await (await self.client.get(response.headers[\"Location\"])).text()\n        self.assertIn(f\"Доступ продлён до {extended:%d.%m.%Y}\", page)\n        again = await self.enter(cabinet + \"/promo\", \"Tashir2026\")\n        self.assertIn(\"promo=used\", again.headers[\"Location\"])\n        self.assertEqual(datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"]), extended)\n\n    async def test_ended_access_runs_from_today_and_wrong_codes_are_limited(self):\n        location, _, _ = await self.period_ending_in(timedelta(days=-5))\n        cabinet = location.split(\"?\")[0].split(\"#\")[0]\n        tg_id = db.get_user_by_web_token(cabinet.rsplit(\"/\", 1)[1])[\"tg_id\"]\n        for _ in range(payments.PROMO_FAILS_PER_HOUR):\n            self.assertIn(\"promo=bad\", (await self.enter(cabinet + \"/promo\", \"nope\")).headers[\"Location\"])\n        self.assertIn(\"promo=limit\", (await self.enter(cabinet + \"/promo\", \"Tashir2026\")).headers[\"Location\"])\n        payments._promo_fails.clear()\n        await self.enter(cabinet + \"/promo\", \"Tashir2026\")\n        left = datetime.fromisoformat(db.get_user(tg_id)[\"paid_until\"]) - datetime.now(timezone.utc).replace(tzinfo=None)\n        self.assertGreater(left, timedelta(days=89))\n        self.assertLessEqual(left, timedelta(days=90))\n\n    async def test_renew_page_shows_no_cabinet_and_accepts_promo(self):\n        location, token, until = await self.period_ending_in(timedelta(days=2))\n        cabinet_token = REDACTED, 1)[1]\n        text = await (await self.client.get(\"/renew/\" + token)).text()\n        self.assertIn(f\"Доступ до {until:%d.%m.%Y}\", text)\n        self.assertNotIn(cabinet_token, text)\n        response = await self.enter(f\"/renew/{token}/promo\", \"Tashir2026\")\n        self.assertIn(\"promo=ok\", response.headers[\"Location\"])\n        self.assertEqual((await self.client.get(\"/renew/\" + \"x\" * 40)).status, 404)\n\n    async def test_renew_payment_returns_to_the_renew_page(self):\n        _, token, _ = await self.period_ending_in(timedelta(days=2))\n        with patch.object(payments, \"create_link\", AsyncMock(return_value={\"url\": \"https://pay.example/1\"})) as link:\n            response = await self.client.post(f\"/renew/{token}/pay?tariff=m1\", allow_redirects=False)\n        self.assertEqual(response.headers[\"Location\"], \"https://pay.example/1\")\n        self.assertEqual(link.await_args.kwargs[\"return_url\"], f\"https://vpn.example/renew/{token}?check={{id}}\")\n\n    def test_merging_accounts_keeps_the_code_used(self):\n        web_id, _ = db.create_web_user(7)\n        self.assertEqual(db.redeem_promo(web_id, \"Tashir2026\")[0], \"ok\")\n        code = db.create_link_code(web_id)\n        db.merge_web_account(code, 555, \"u\", \"U\")\n        self.assertEqual(db.redeem_promo(555, \"Tashir2026\")[0], \"used\")\n'''\nopen(t, 'w', encoding='utf-8').write(s)\n\nt = 'tests/test_payments.py'\ns = open(t, encoding='utf-8').read()\ns = s.rstrip('\\n') + '''\n\n\nclass PromoBotTests(unittest.IsolatedAsyncioTestCase):\n    async def asyncSetUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.db_patch = patch.object(db, \"DB_PATH\", self.tmp.name + \"/test.db\")\n        self.db_patch.start()\n        db.init_db()\n        payments._promo_fails.clear()\n\n    async def asyncTearDown(self):\n        self.db_patch.stop()\n        self.tmp.cleanup()\n\n    async def send(self, tg_id, text):\n        message, state = AsyncMock(), AsyncMock()\n        message.text = text\n        message.from_user.id = tg_id\n        with patch.object(payments, \"resume_access\", AsyncMock()) as resume:\n            await pay.enter_promo(message, state)\n        state.clear.assert_awaited()\n        return message.answer.await_args.args[0], resume\n\n    async def test_code_extends_access_and_turns_it_back_on(self):\n        db.add_user(123, \"u\", \"Owner\", None, None)\n        conn = db.get_db()\n        conn.execute(\"UPDATE users SET paid_until = '2020-01-01T00:00:00' WHERE tg_id = 123\")\n        conn.commit()\n        conn.close()\n        text, resume = await self.send(123, \"Tashir2026\")\n        self.assertIn(\"Доступ продлён\", text)\n        resume.assert_awaited()\n        self.assertIn(\"уже использован\", (await self.send(123, \"TASHIR2026\"))[0])\n\n    async def test_unknown_person_and_unlimited_account_are_told_why(self):\n        self.assertIn(\"Сначала подключите\", (await self.send(999, \"Tashir2026\"))[0])\n        db.add_user(123, \"u\", \"Owner\", None, None)\n        self.assertIn(\"без срока\", (await self.send(123, \"Tashir2026\"))[0])\n        self.assertIn(\"нет\", (await self.send(123, \"другое\"))[0])\n'''\nopen(t, 'w', encoding='utf-8').write(s)\nPY\npython3 \"$SP/apply_promo.py\" && grep -n \"period_ending_in\" -A12 tests/test_webapp.py | sed -n 1,16p | cut -c1-130; cat > \"$SP/stg.sh\" <<'SH'\nset -e\nrm -rf /tmp/stg /tmp/st.db; mkdir -p /tmp/stg\nsudo tar -C /opt/nexo-bot --exclude=venv --exclude=.git --exclude=assets/downloads --exclude=assets/video -cf - . | tar -xf - -C /tmp/stg\ntar -xf /tmp/upd.tar -C /tmp/stg\ncd /tmp/stg\nPYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=/tmp/st.db AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay /opt/nexo-bot/venv/bin/python -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -vE '^(\\.|$|INFO|WARNING)' | tail -45 | cut -c1-170\nSH\nCOPYFILE_DISABLE=1 tar --no-xattrs -cf \"$SP/upd.tar\" database.py payments.py webapp.py subscription.py nexo_client.py handlers/pay.py tests/test_webapp.py tests/test_payments.py && scp -q -i ~/.ssh/codex_aura_vps \"$SP/upd.tar\" \"$SP/stg.sh\" codex-aura@152.53.50.204:/tmp/ && ssh -i ~/.ssh/codex_aura_vps codex-aura@152.53.50.204 'bash /tmp/stg.sh'","description":"Apply promo and renewal server code, run tests in staging","timeout":240000}},"serverClassifierRequest":"15a3726e-d182-4d25-a3dc-e95f95aade95","apiBlockIndex":1,"requestId":"req_011CgmWaGicWTUuXsJ2FWufk","requestRef":"406887cf-bc43-45d1-b162-2fdcc3627fe6","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"a77b0059-30e1-4b54-af02-2b25f253723e","timestamp":"2026-11-06T10:25:02.735Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"feat/in-app-update","slug":"deep-singing-taco"}
