,\n  });\n\n  final TakeoverSwitch kind;\n  final _RowMetrics metrics;\n  final bool showIcon;\n  final Color? color;\n\n  @override\n  Widget build(BuildContext context, WidgetRef ref) {\n    final appLocalizations = context.appLocalizations;\n    final systemProxy = kind == TakeoverSwitch.systemProxy;\n    final title = _titleOf(context, kind);\n    final value = systemProxy\n        ? ref.watch(networkSettingProvider.select((state) => state.systemProxy))\n        : ref.watch(\n            patchClashConfigProvider.select((state) => state.tun.enable),\n          );\n    final on = systemProxy\n        ? appLocalizations.portValue(\n            ref.watch(\n              patchClashConfigProvider.select((state) => state.mixedPort),\n            ),\n          )\n        : appLocalizations.enabled;\n    void change(bool value) => systemProxy\n49:class NexoHomeView extends ConsumerWidget {\n131:class _ConnectButton extends ConsumerWidget {\n229:class _ServerCard extends ConsumerWidget {\n340:class _ServerPicker extends ConsumerWidget {\n350:    Navigator.of(context).pop();\n447:class _ServerPickerRow extends ConsumerWidget {\n521:class _InfoRow extends ConsumerWidget {\n564:class _RenewButton extends ConsumerStatefulWidget {\n573:class _RenewButtonState extends ConsumerState<_RenewButton>\n639:class _InfoValue extends StatelessWidget {\n663:class _EmptyState extends ConsumerWidget {\n782:class _NexoCard extends StatelessWidget {\n823:class _ServerMark extends StatelessWidget {","is_error":false}]},"uuid":"ad302e6b-1011-4d14-a6d4-b1e2cdcb753e","timestamp":"2026-11-07T22:31:17.184Z","toolUseResult":{"stdout":"import 'package:fl_clash/common/common.dart';\nimport 'package:fl_clash/providers/providers.dart';\nimport 'package:fl_clash/ui/icons/icons.dart';\nimport 'package:fl_clash/ui/ui.dart';\nimport 'package:fl_clash/views/dashboard/layout.dart';\nimport 'package:fl_clash/views/dashboard/style.dart';\nimport 'package:flutter_riverpod/flutter_riverpod.dart';\nimport 'packag