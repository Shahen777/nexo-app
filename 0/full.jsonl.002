static const automatic = 'Автовыбор';\n  static const speedTest = 'Проверить скорость';\n  static const speedTesting = 'Проверяем скорость…';\n  static const unavailable = 'Недоступен';\n  static const unlimitedAccess = 'Доступ без срока';\n\n  static String currentServer(String name) => 'Сейчас: $name';\n\n  static String daysLeft(int days) => 'Осталось $days дней';\n\n  static String delay(int milliseconds) => '$milliseconds мс';\n\n  static String speed(String download, String upload) =>\n      '↓ $download/с  ↑ $upload/с';\n}\n\nextension NexoPageLabel on PageLabel {\n  String get nexoLabel =>\n      this == PageLabel.tools ? NexoStrings.settings : label;\n}\n","structuredPatch":[{"oldStart":33,"oldLines":6,"newStart":33,"newLines":7,"lines":["   static const speedTesting = 'Проверяем скорость…';","   static const unavailable = 'Недоступен';","   static const unlimitedAccess = 'Доступ без срока';","+  static const renew = 'Продлить';"," ","   static String currentServer(String name) => 'Сейчас: $name';"," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"4984aff2-4199-445b-bba6-996d506a3743","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"feat/in-app-update","slug":"deep-singing-taco"}
