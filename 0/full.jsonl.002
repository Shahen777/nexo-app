\": len(jobs),\n            \"checked\": datetime.now(timezone.utc).strftime(\"%H:%M UTC\")}\n\n\n_health_cache = None\n_health_lock = asyncio.Lock()\n\n\n259:def list_devices(tg_id: int) -> list[dict]:\n260-    with get_db() as conn:\n261-        rows = conn.execute('SELECT * FROM devices WHERE tg_id = ? ORDER BY id', (tg_id,)).fetchall()\n262-    conn.close()\n263-    return [_device_row(row) for row in rows]\n264-\n265-\n266-def get_device(tg_id: int, id: int) -> dict | None:\n267-    with get_db() as conn:\n268-        row = conn.execute('SELECT * FROM devices WHERE tg_id = ? AND id = ?', (tg_id, id)).fetchone()\n269-    conn.close()\n270-    return _device_row(row) if row else None\n271-\n272-\n273-def set_primary_node(tg_id: int, node_key: str):\n274-    conn = get_db()\n275-    conn.execute(\n--\n283:def get_all_users() -> list[dict]:\n284-    conn = get_db()\n285-    rows = conn.execute(\"SELECT * FROM users ORDER BY created_at DESC\").fetchall()\n286-    conn.close()\n287-    return [dict(r) for r in rows]\n288-\n289-\n290-def get_active_users_count() -> int:\n291-    conn = get_db()\n292-    count = conn.execute(\"SELECT COUNT(*) FROM users WHERE is_active = 1\").fetchone()[0]\n293-    conn.close()\n294-    return count\n295-\n296-\n297-def get_active_users_by_node() -> dict[str, int]:\n298-    conn = get_db()\n299-    rows = conn.execute(\n--\n347:def get_stats() -> dict:\n348-    conn = get_db()\n349-    total = conn.execute(\"SELECT COUNT(*) FROM users\").fetchone()[0]\n350-    active = conn.execute(\"SELECT COUNT(*) FROM users WHERE is_active = 1\").fetchone()[0]\n351-    premium = conn.execute(\"SELECT COUNT(*) FROM users WHERE is_premium = 1\").fetchone()[0]\n352-    today = datetime.now().strftime(\"%Y-%m-%d\")\n353-    today_new = conn.execute(\n354-        \"SELECT COUNT(*) FROM users WHERE created_at LIKE ?\", (f\"{today}%\",)\n355-    ).fetchone()[0]\n356-    conn.close()\n357-    return {\n358-        \"total\": total,\n359-        \"active\": 