a, including NordVPN and PIA.\n\nSources differ on scope. Some reports describe the 2026 removals as a broad purge, while others note that mainstream services like NordVPN remain available, and the removals mainly hit configurable clients."],"durationSeconds":5.712100208000047,"searchCount":1},"serverClassifierContext":{"request":"7be0098a-da50-4825-8b2f-ff1abe44291c","context":{"git_state":{"cwd":"/Users/Sagenkazaran/Projects/nexo-app","root":"/Users/Sagenkazaran/Projects/nexo-app","branch":"feat/desktop-tun","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"},{"name":"upstream","host":"github.com","remote":"chen08209/FlClash","visibility":"unknown"}],"visibility_cache":[{"host":"github.com","remote":"Shahen777/nexo-app","visibility":"public"}]}},"live_cwd":"/Users/Sagenkazaran/Projects/nexo-app","platform":"macos"}},"sourceToolAssistantUUID":"c998938e-1830-420f-81f2-125d1b81a7ac","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Projects/nexo-app","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"feat/desktop-tun","slug":"deep-singing-taco"}
