{"parentUuid":"a337e54c-0c8a-48c9-a0c6-816949ac2b08","isSidechain":false,"promptId":"589016f6-3825-42e9-b835-49c190edd644","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SjgMGP8vhjfzMJja3o4ekw","type":"tool_result","content":"            expires_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS payments (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            tg_id INTEGER NOT NULL,\n            tariff TEXT NOT NULL,\n            amount INTEGER NOT NULL,\n            days INTEGER NOT NULL,\n            provider TEXT NOT NULL DEFAULT 'platega',\n            provider_id TEXT UNIQUE,\n            status TEXT NOT NULL DEFAULT 'created',\n            created_at TEXT DEFAULT (datetime('now')),\n            paid_at TEXT\n        );\n    \"\"\")\n    existing_columns = {\n        row[1] for row in conn.execute(\"PRAGMA table_info(users)\").fetchall()\n    }\n    migrations = {\n        \"subscription_token\": \"TEXT\",\n        \"primary_node\": \"TEXT\",\n        \"device_limit\": \"INTEGER NOT NULL DEFAULT 3\",\n        \"revoked_at\": \"TEXT\",\n        \"paid_until\": \"TEXT\",\n        \"web_token\": \"TEXT\",\n        \"recovery_code\": \"TEXT\",\n        \"merged_into\": \"INTEGER\",\n        \"reminder_for\": \"TEXT\",\n        \"expiry_notice_for\": \"TEXT\",\n    }\n    for column, definition in migrations.items():\ndef settle_payment(provider_id: str, status: str) -> tuple[dict | None, bool]:\n    \"\"\"Apply a provider status idempotently. CONFIRMED extends paid_until once, from the later of\n    now and the current end; repeated or concurrent confirmations change nothing. Returns (payment, newly_paid).\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = conn.execute(\"SELECT * FROM payments WHERE provider_id = ?\", (provider_id,)).fetchone()\n        if not row:\n            conn.rollback()\n            return None, False\n        newly_paid = False\n        if status == \"CONFIRMED\" and row[\"status\"] != \"paid\":\n            now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)  # stored as naive UTC\n            user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (row[\"tg_id\"],)).fetchone()\n            current = datetime.fromisoformat(user[\"paid_until\"]) if user and user[\"paid_until\"] else now\n            until = max(now, current) + timedelta(days=row[\"days\"])\n            conn.execute(\"UPDATE payments SET status = 'paid', paid_at = ? WHERE id = ?\", (now.isoformat(), row[\"id\"]))\n            conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), row[\"tg_id\"]))\n            newly_paid = True\n        elif status in (\"CANCELED\", \"CHARGEBACKED\") and row[\"status\"] != \"paid\":\n            conn.execute(\"UPDATE payments SET status = ? WHERE id = ?\", (status.lower(), row[\"id\"]))\n        conn.commit()\n        updated = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (row[\"id\"],)).fetchone()\n        return dict(updated), newly_paid\n    finally:\n        conn.close()\n\n\ndef merge_web_account(code: str, tg_id: int, username: str, first_name: str) -> dict | None:\n    \"\"\"Join the web account behind `code` to the Telegram user: devices and payments move over, the\n    paid period becomes the later of the two (an account without a period keeps unlimited access),\n    and the old cabinet link keeps working. Returns the Telegram user, or None for a bad/expired code.\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        link = conn.execute(\"SELECT * FROM link_codes WHERE code = ? AND expires_at >= ?\", (code, _now())).fetchone()\n        conn.execute(\"DELETE FROM link_codes WHERE code = ?\", (code,))\n        web = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (link[\"tg_id\"],)).fetchone() if link else None\n        if not web or web[\"tg_id\"] >= 0 or web[\"merged_into\"] or tg_id <= 0:\n            conn.commit()\n            return None\n        own = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not own:\n            conn.execute(\"INSERT INTO users (tg_id, username, first_name, referral_code, paid_until) VALUES (?, ?, ?, ?, ?)\",\n                         (tg_id, username, first_name, f\"aura_{tg_id}\", web[\"paid_until\"]))\n            paid_until = web[\"paid_until\"]\n        elif own[\"paid_until\"] is None:\n            paid_until = None  # accounts from before payments keep their unlimited access\n        else:\n            paid_until = max(own[\"paid_until\"], web[\"paid_until\"] or own[\"paid_until\"])\n        conn.execute(\"UPDATE devices SET tg_id = ?, request_id = request_id || '-' || id WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        token = web[\"web_token\"]\n        own_token = REDACTED if own else None\n        code = web[\"recovery_code\"]\n        own_code = own[\"recovery_code\"] if own else None\n        conn.execute(\"UPDATE users SET merged_into = ?, paid_until = NULL, web_token = REDACTED, recovery_code = ? WHERE tg_id = ?\",\n                     (tg_id, None if not own_token else token, None if not own_code else code, web[\"tg_id\"]))\n        conn.execute(\"UPDATE users SET paid_until = ?, web_token = REDACTED, ?), recovery_code = COALESCE(recovery_code, ?), \"\n                     \"device_limit = MAX(device_limit, ?) WHERE tg_id = ?\",\n                     (paid_until, None if own_token else token, None if own_code else code, web[\"device_limit\"] or 3, tg_id))\n        conn.commit()\n        return dict(conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone())\n    finally:\n        conn.close()\n\n\ndef users_to_notify(kind: str) -> list[dict]:\n\n\ndef days_left(until):\n    from datetime import datetime, timezone\n    return max(1, (until - datetime.now(timezone.utc).replace(tzinfo=None)).days + 1)\n\n\ndef key_pass(user, active_count):\n    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n    until = payments.active_until(user)\n    limit = user.get(\"device_limit\") or 3\n    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n    if not user.get(\"paid_until\"):  # accounts from before the paid period have no end date\n        body = (f'{head}<span class=\"state on\">Активен</span></div><p class=\"label\">Доступ</p>'\n                '<div class=\"big\">Без срока</div><div class=\"sub\">Ваш доступ не ограничен по времени.</div>'\n                '<div class=\"meter\"><i style=\"width:100%\"></i></div>')\n    elif until:\n        days = days_left(until)\n        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n                f'<div class=\"big\">{day_month(until)}</div>'\n                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n    else:\n        body = (f'{head}<span class=\"state off\">Не активен</span></div><p class=\"label\">Доступ закончился</p>'\n                '<div class=\"big\">Продлите</div><div class=\"sub\">Ключи заработают сразу после оплаты.</div>')\n    return (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}{body}<div class=\"perf\"></div>'\n            f'<div class=\"stub\"><span>Устройств: {active_count} из {limit}</span><a href=\"#pay\">Продлить →</a></div></div>')\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    access_code = db.ensure_recovery_code(user[\"tg_id\"])\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            flash = (f'<div class=\"flash\">Оплата получена, доступ продлён. Сохраните код доступа — он вернёт вх�\n                     f'{access_code_box(access_code)}' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу ч\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попр�\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов. Это ваш личный кабинет — сохраните код доступа: он вернёт вх�\n                  f'{access_code_box(access_code)}')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Ключ не создался: сервер не ответил. Попробуйте ещё раз через минуту.</di\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n\n    unlimited = not user.get(\"paid_until\")\n    until = payments.active_until(user)\n    working = unlimited or bool(until)\n    active = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"status\"] == \"active\"]\n    chip = ('<span class=\"chip\"><i></i>Активен</span>' if unlimited else '<span class=\"chip off\"><i></i>Не активен</span>' if not until else\n            '<span class=\"chip soon\"><i></i>Заканчивается</span>' if days_left(until) <= 3 else '<span class=\"chip\"><i></i>Активен</span>')\n\n    if user.get(\"paid_until\") and not until:\n        flash = ('<div class=\"flash err\">Доступ закончился, VPN отключён. Продлите, и он заработает сразу после о�\n        if switches:\n            setup += f'<div class=\"cap\">Не получается?</div><div class=\"group\">{switches}</div>'\n    setup += \"</section>\"\n\n    # -- pay\n    pay = '<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\n    # -- more\n    link = f\"{base}/c/{token}\"\n    linked_step = bool(device) and working and user[\"tg_id\"] < 0\n    if linked_step:\n        tg = \"\"  # offered as step 4 of the setup\n    elif user[\"tg_id\"] > 0:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin:0\">Кабинет связан с Telegram: в боте '\n              f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> те же устройства, срок и оплата. '\n              'Там же придёт напоминание за 3 дня до конца срока.</p></div>')\n    else:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin-top:0\">Подключите наш бот — '\n              'в нём будут те же устройства и срок, и он напомнит, когда пора продлить.</p>'\n              f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></div>')\n    more = ('<section class=\"screen\" data-tab=\"more\"><h1 class=\"large\">Ещё</h1><div class=\"cap\">Код доступа</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Вход в кабинет на новом телефоне или если ссылка потерялась: откройте стран�\n            'подключения и нажмите «Войти по коду».</p>' + access_code_box(access_code) +\n            '<p class=\"muted\" style=\"margin-bottom:0\">Не показывайте код другим: по нему открывается ваш доступ.</p></div>'\n            '<div class=\"cap\">Ссылка на кабинет</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Это вход в кабинет — логина и пароля нет. Сохраните ссылку в заметки или доб�\n            'страницу на экран «Домой»: «Поделиться» → «На экран „Домой“».</p>'\n            f'<div class=\"linkbox\"><code>{html.escape(link)}</code><button onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано\\')\">Скопировать ссылку</button></div>'\n            '<p class=\"muted\">Не пересылайте её никому: по ней открывается ваш доступ.</p></div>'\n            + tg + f'<div class=\"cap\">Документы и помощь</div><div class=\"group\">{DOC_ROWS}</div></section>')\n\n    tabbar = ('<div class=\"tabbar\"><nav>' + \"\".join(f'<a href=\"#{key}\">{ICONS[key]}{label}</a>' for key, label in TABS) + \"</nav></div>\")\n    body = (f'<div class=\"app\">{appbar(f\"/c/{token}#home\", chip)}{home}{setup}{pay}{more}</div>{tabbar}{TAB_SCRIPT}')\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers=_cabinet_cookie(token))\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\") + \"#setup\")\n\n\nasync def handle_telegram(request):\n    \"\"\"Open the bot with a one-time code that joins this web account to the Telegram account.\"\"\"\n    db, user = _user(request)\n    if user[\"tg_id\"] > 0:\n        raise web.HTTPSeeOther(f\"https://t.me/{BOT_USERNAME}\")\n    raise web.HTTPSeeOther(f\"https://t.me/{BOT_USERNAME}?start=web_{db.create_link_code(user['tg_id'])}\")\n\n\nasync def handle_pay(request):\n\"\"\"Paying for access: tariff choice → Platega payment page → confirmation (callback or «Проверить»).\"\"\"\nfrom aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\nimport database as db\nimport payments\nfrom keyboards import support_button\nfrom navigation import show_card\n\nrouter = Router()\n\n\ndef kb(*rows):\n    return InlineKeyboardMarkup(inline_keyboard=[list(row) for row in rows])\n\n\ndef cb(text, data):\n    return InlineKeyboardButton(text=text, callback_data=data)\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\n@router.callback_query(F.data == \"pay\")\nasync def choose_tariff(callback: CallbackQuery):\n    if not payments.enabled():\n        await callback.answer(\"Оплата скоро появится.\", show_alert=True)\n        return\n    await callback.answer()\n    user = db.get_user(callback.from_user.id) or {}\n    text = \"<b>Оплата доступа</b>\\n\\nВыберите срок. В любой тариф входят все серверы и \n    if user.get(\"paid_until\"):\n        text += f\"\\n\\nСейчас доступ до <b>{payments.paid_until_text(user['paid_until'])}</b>, новый срок добави\n    rows = [[cb(f\"{t['title']} — {price(t['price'])}\", f\"buy:{t['key']}\")] for t in payments.paid_tariffs()]\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\nasync def buy(callback: CallbackQuery):\n    plan = payments.tariff(callback.data.split(\":\", 1)[1])\n    if not plan or not payments.enabled():\n        await callback.answer(\"Выберите тариф заново.\", show_alert=True)\n        return\n    await callback.answer(\"Создаю ссылку на оплату…\")\n    try:\n        payment = await payments.create_link(callback.from_user.id, plan[\"key\"])\n    except payments.PaymentError:\n        await show_card(callback.message, \"help\", \"<b>Не удалось создать оплату</b>\\n\\nПопробуйте ещё р�\n                        reply_markup=kb([cb(\"Попробовать снова\", callback.data)], [support_button()],\n                                        [cb(\"‹ Назад\", \"pay\")]))\n        return\n    text = (f\"<b>Оплата · {plan['title']} · {price(plan['price'])}</b>\\n\\n\"\n            \"1. Нажмите «Оплатить» — откроется страница оплаты: СБП, карта или крип\n            \"2. После оплаты вернитесь сюда — доступ продлится автоматически.\\n\\n\"\n            \"Сообщение не пришло — нажмите «Проверить оплату».\\n\\n\"\n            \"<i>Ссылка действует 15 минут.</i>\")\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(\n        [InlineKeyboardButton(text=f\"💳 Оплатить {price(plan['price'])}\", url=payment[\"url\"])],\n        [cb(\"🔄 Проверить оплату\", f\"pay_check:{payment['id']}\")],\n        [cb(\"‹ Другой тариф\", \"pay\")]))\n\n\n@router.callback_query(F.data == \"web_cabinet\")\nasync def web_cabinet(callback: CallbackQuery):\n    \"\"\"Personal link to the same account on the website — it opens even when Telegram does not.\"\"\"\n    from config import PUBLIC_BASE_URL\n    await callback.answer()\n    if not db.get_user(callback.from_user.id):\n        await show_card(callback.message, \"home\", \"<b>Веб-кабинет</b>\\n\\nОн появится после подключения �\n                        \"там будут те же устройства, срок доступа и оплата.\",\n                        reply_markup=kb([cb(\"🚀 Подключить устройство\", \"get_vpn\")], [cb(\"‹ Главное меню\"\n        return\n    link = f\"{PUBLIC_BASE_URL.rstrip('/')}/c/{db.ensure_web_token(callback.from_user.id)}\"\n    await show_card(callback.message, \"home\",\n                    \"<b>Веб-кабинет</b>\\n\\nТот же аккаунт на сайте: устройства, срок доступ\n                    \"Открывается в браузере даже без Telegram — сохраните ссылку в заметк\n                    \"<i>Никому не пересылайте её: по ней открывается ваш доступ.</i>\",\n                    reply_markup=kb([InlineKeyboardButton(text=\"🌐 Открыть веб-кабинет\", url=link)], [cb(\"‹ Главн�\n\n\n@router.callback_query(F.data.startswith(\"pay_check:\"))\nasync def check(callback: CallbackQuery):\n    part = callback.data.split(\":\", 1)[1]\n    payment = db.get_payment(int(part)) if part.isdigit() else None\n    if not payment or payment[\"tg_id\"] != callback.from_user.id:\n        await callback.answer(\"Платёж не найден.\", show_alert=True)\n        return\n    try:\n        payment, _ = await payments.check(payment)\n    except payments.PaymentError:\n        await callback.answer(\"Не удалось проверить. Попробуйте через минуту.\", show_alert=True)\n        return\n    if payment[\"status\"] == \"paid\":\n        await callback.answer()\n        await show_card(callback.message, \"done\", payments.success_text(callback.from_user.id),\n                        reply_markup=kb([cb(\"Главное меню\", \"back_main\")]))\n    elif payment[\"status\"] in (\"canceled\", \"chargebacked\"):\n        await callback.answer()\n        await show_card(callback.message, \"help\", \"<b>Оплата не прошла</b>\\n\\nДеньги не списаны. Можно п�\n                        reply_markup=kb([cb(\"Попробовать снова\", f\"buy:{payment['tariff']}\")], [cb(\"‹ Назад\", \"pay\")]\n    else:\n        await callback.answer(\"Оплата ещё не поступила. Если вы уже оплатили — подождите м�\n                              show_alert=True)\nsubscription.py:259:    app.router.add_get(\"/sub/{token}\", handle_subscription)\nsubscription.py:260:    app.router.add_get(\"/install/{token}\", handle_install)\nsubscription.py:261:    app.router.add_get('/happ/sub/{token}', handle_happ_subscription)\nsubscription.py:262:    app.router.add_get('/happ/install/{token}', handle_happ_install)\nsubscription.py:263:    app.router.add_get('/nexo/sub/{token}', handle_nexo_subscription)\nsubscription.py:264:    app.router.add_get('/app/{client}/install/{token}', handle_client_install)\nsubscription.py:265:    app.router.add_get(\"/health\", handle_health)\nsubscription.py:266:    app.router.add_post(\"/platega/callback\", handle_platega_callback)\n31:        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],\n38:def docs_back(pay: bool = False) -> InlineKeyboardMarkup:\ndef success_text(tg_id: int) -> str:\n    user = db.get_user(tg_id) or {}\n    return (f\"<b>✅ Оплата получена</b>\\n\\nДоступ к {BRAND_TITLE} продлён до \"\n            f\"<b>{paid_until_text(user.get('paid_until'))}</b>.\\nСпасибо!\")\n\n\nasync def notify(tg_id: int, text: str):\n    \"\"\"Message the user from the callback service (it has no bot instance of its own).\"\"\"\n    if not BOT_TOKEN or tg_id <= 0:  # web accounts have no Telegram chat\n        return\n    try:\n        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=15)) as session:\n            await session.post(f\"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage\",\n                               json={\"chat_id\": tg_id, \"text\": text, \"parse_mode\": \"HTML\"})\n    except (aiohttp.ClientError, TimeoutError):\n        logger.warning(\"Could not notify user about a payment\")\nhandlers/legal.py:6:from aiogram.fsm.context import FSMContext\nhandlers/legal.py:27:async def docs(callback: CallbackQuery, state: FSMContext):\nhandlers/legal.py:44:async def document_command(message: Message, state: FSMContext):\nhandlers/devices.py:7:from aiogram.fsm.context import FSMContext\nhandlers/devices.py:42:async def show_devices(callback: CallbackQuery, state: FSMContext):\nhandlers/devices.py:76:async def device_detail(callback: CallbackQuery, state: FSMContext)\nhandlers/devices.py:123:async def ask_revoke(callback: CallbackQuery, state: FSMContext):\nhandlers/devices.py:139:async def confirm_revoke(callback: CallbackQuery, state: FSMContex\nhandlers/devices.py:155:async def device_connect(callback: CallbackQuery, state: FSMContex\nhandlers/start.py:5:from aiogram.fsm.context import FSMContext\nShell cwd was reset to /Users/Sagenkazaran/Projects/nexo-app","is_error":false}]},"uuid":"b7b78d1b-7ba9-450e-ba81-6e2ff9f7e14e","timestamp":"2026-11-06T10:22:17.838Z","toolUseResult":{"stdout":"            expires_at TEXT NOT NULL\n        );\n        CREATE TABLE IF NOT EXISTS payments (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            tg_id INTEGER NOT NULL,\n            tariff TEXT NOT NULL,\n            amount INTEGER NOT NULL,\n            days INTEGER NOT NULL,\n            provider TEXT NOT NULL DEFAULT 'platega',\n            provider_id TEXT UNIQUE,\n            status TEXT NOT NULL DEFAULT 'created',\n            created_at TEXT DEFAULT (datetime('now')),\n            paid_at TEXT\n        );\n    \"\"\")\n    existing_columns = {\n        row[1] for row in conn.execute(\"PRAGMA table_info(users)\").fetchall()\n    }\n    migrations = {\n        \"subscription_token\": \"TEXT\",\n        \"primary_node\": \"TEXT\",\n        \"device_limit\": \"INTEGER NOT NULL DEFAULT 3\",\n        \"revoked_at\": \"TEXT\",\n        \"paid_until\": \"TEXT\",\n        \"web_token\": \"TEXT\",\n        \"recovery_code\": \"TEXT\",\n        \"merged_into\": \"INTEGER\",\n        \"reminder_for\": \"TEXT\",\n        \"expiry_notice_for\": \"TEXT\",\n    }\n    for column, definition in migrations.items():\ndef settle_payment(provider_id: str, status: str) -> tuple[dict | None, bool]:\n    \"\"\"Apply a provider status idempotently. CONFIRMED extends paid_until once, from the later of\n    now and the current end; repeated or concurrent confirmations change nothing. Returns (payment, newly_paid).\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = conn.execute(\"SELECT * FROM payments WHERE provider_id = ?\", (provider_id,)).fetchone()\n        if not row:\n            conn.rollback()\n            return None, False\n        newly_paid = False\n        if status == \"CONFIRMED\" and row[\"status\"] != \"paid\":\n            now = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)  # stored as naive UTC\n            user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (row[\"tg_id\"],)).fetchone()\n            current = datetime.fromisoformat(user[\"paid_until\"]) if user and user[\"paid_until\"] else now\n            until = max(now, current) + timedelta(days=row[\"days\"])\n            conn.execute(\"UPDATE payments SET status = 'paid', paid_at = ? WHERE id = ?\", (now.isoformat(), row[\"id\"]))\n            conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), row[\"tg_id\"]))\n            newly_paid = True\n        elif status in (\"CANCELED\", \"CHARGEBACKED\") and row[\"status\"] != \"paid\":\n            conn.execute(\"UPDATE payments SET status = ? WHERE id = ?\", (status.lower(), row[\"id\"]))\n        conn.commit()\n        updated = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (row[\"id\"],)).fetchone()\n        return dict(updated), newly_paid\n    finally:\n        conn.close()\n\n\ndef merge_web_account(code: str, tg_id: int, username: str, first_name: str) -> dict | None:\n    \"\"\"Join the web account behind `code` to the Telegram user: devices and payments move over, the\n    paid period becomes the later of the two (an account without a period keeps unlimited access),\n    and the old cabinet link keeps working. Returns the Telegram user, or None for a bad/expired code.\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        link = conn.execute(\"SELECT * FROM link_codes WHERE code = ? AND expires_at >= ?\", (code, _now())).fetchone()\n        conn.execute(\"DELETE FROM link_codes WHERE code = ?\", (code,))\n        web = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (link[\"tg_id\"],)).fetchone() if link else None\n        if not web or web[\"tg_id\"] >= 0 or web[\"merged_into\"] or tg_id <= 0:\n            conn.commit()\n            return None\n        own = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not own:\n            conn.execute(\"INSERT INTO users (tg_id, username, first_name, referral_code, paid_until) VALUES (?, ?, ?, ?, ?)\",\n                         (tg_id, username, first_name, f\"aura_{tg_id}\", web[\"paid_until\"]))\n            paid_until = web[\"paid_until\"]\n        elif own[\"paid_until\"] is None:\n            paid_until = None  # accounts from before payments keep their unlimited access\n        else:\n            paid_until = max(own[\"paid_until\"], web[\"paid_until\"] or own[\"paid_until\"])\n        conn.execute(\"UPDATE devices SET tg_id = ?, request_id = request_id || '-' || id WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        token = web[\"web_token\"]\n        own_token = REDACTED if own else None\n        code = web[\"recovery_code\"]\n        own_code = own[\"recovery_code\"] if own else None\n        conn.execute(\"UPDATE users SET merged_into = ?, paid_until = NULL, web_token = REDACTED, recovery_code = ? WHERE tg_id = ?\",\n                     (tg_id, None if not own_token else token, None if not own_code else code, web[\"tg_id\"]))\n        conn.execute(\"UPDATE users SET paid_until = ?, web_token = REDACTED, ?), recovery_code = COALESCE(recovery_code, ?), \"\n                     \"device_limit = MAX(device_limit, ?) WHERE tg_id = ?\",\n                     (paid_until, None if own_token else token, None if own_code else code, web[\"device_limit\"] or 3, tg_id))\n        conn.commit()\n        return dict(conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone())\n    finally:\n        conn.close()\n\n\ndef users_to_notify(kind: str) -> list[dict]:\n\n\ndef days_left(until):\n    from datetime import datetime, timezone\n    return max(1, (until - datetime.now(timezone.utc).replace(tzinfo=None)).days + 1)\n\n\ndef key_pass(user, active_count):\n    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n    until = payments.active_until(user)\n    limit = user.get(\"device_limit\") or 3\n    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n    if not user.get(\"paid_until\"):  # accounts from before the paid period have no end date\n        body = (f'{head}<span class=\"state on\">Активен</span></div><p class=\"label\">Доступ</p>'\n                '<div class=\"big\">Без срока</div><div class=\"sub\">Ваш доступ не ограничен по времени.</div>'\n                '<div class=\"meter\"><i style=\"width:100%\"></i></div>')\n    elif until:\n        days = days_left(until)\n        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n                f'<div class=\"big\">{day_month(until)}</div>'\n                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n    else:\n        body = (f'{head}<span class=\"state off\">Не активен</span></div><p class=\"label\">Доступ закончился</p>'\n                '<div class=\"big\">Продлите</div><div class=\"sub\">Ключи заработают сразу после оплаты.</div>')\n    return (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}{body}<div class=\"perf\"></div>'\n            f'<div class=\"stub\"><span>Устройств: {active_count} из {limit}</span><a href=\"#pay\">Продлить →</a></div></div>')\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    access_code = db.ensure_recovery_code(user[\"tg_id\"])\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            flash = (f'<div class=\"flash\">Оплата получена, доступ продлён. Сохраните код доступа — он вернёт вх�\n                     f'{access_code_box(access_code)}' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу ч\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попр�\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов. Это ваш личный кабинет — сохраните код доступа: он вернёт вх�\n                  f'{access_code_box(access_code)}')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Ключ не создался: сервер не ответил. Попробуйте ещё раз через минуту.</di\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n\n    unlimited = not user.get(\"paid_until\")\n    until = payments.active_until(user)\n    working = unlimited or bool(until)\n    active = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"status\"] == \"active\"]\n    chip = ('<span class=\"chip\"><i></i>Активен</span>' if unlimited else '<span class=\"chip off\"><i></i>Не активен</span>' if not until else\n            '<span class=\"chip soon\"><i></i>Заканчивается</span>' if days_left(until) <= 3 else '<span class=\"chip\"><i></i>Активен</span>')\n\n    if user.get(\"paid_until\") and not until:\n        flash = ('<div class=\"flash err\">Доступ закончился, VPN отключён. Продлите, и он заработает сразу после о�\n        if switches:\n            setup += f'<div class=\"cap\">Не получается?</div><div class=\"group\">{switches}</div>'\n    setup += \"</section>\"\n\n    # -- pay\n    pay = '<section class=\"screen\" data-tab=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\n    # -- more\n    link = f\"{base}/c/{token}\"\n    linked_step = bool(device) and working and user[\"tg_id\"] < 0\n    if linked_step:\n        tg = \"\"  # offered as step 4 of the setup\n    elif user[\"tg_id\"] > 0:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin:0\">Кабинет связан с Telegram: в боте '\n              f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> те же устройства, срок и оплата. '\n              'Там же придёт напоминание за 3 дня до конца срока.</p></div>')\n    else:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin-top:0\">Подключите наш бот — '\n              'в нём будут те же устройства и срок, и он напомнит, когда пора продлить.</p>'\n              f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></div>')\n    more = ('<section class=\"screen\" data-tab=\"more\"><h1 class=\"large\">Ещё</h1><div class=\"cap\">Код доступа</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Вход в кабинет на новом телефоне или если ссылка потерялась: откройте стран�\n            'подключения и нажмите «Войти по коду».</p>' + access_code_box(access_code) +\n            '<p class=\"muted\" style=\"margin-bottom:0\">Не показывайте код другим: по нему открывается ваш доступ.</p></div>'\n            '<div class=\"cap\">Ссылка на кабинет</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Это вход в кабинет — логина и пароля нет. Сохраните ссылку в заметки или доб�\n            'страницу на экран «Домой»: «Поделиться» → «На экран „Домой“».</p>'\n            f'<div class=\"linkbox\"><code>{html.escape(link)}</code><button onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано\\')\">Скопировать ссылку</button></div>'\n            '<p class=\"muted\">Не пересылайте её никому: по ней открывается ваш доступ.</p></div>'\n            + tg + f'<div class=\"cap\">Документы и помощь</div><div class=\"group\">{DOC_ROWS}</div></section>')\n\n    tabbar = ('<div class=\"tabbar\"><nav>' + \"\".join(f'<a href=\"#{key}\">{ICONS[key]}{label}</a>' for key, label in TABS) + \"</nav></div>\")\n    body = (f'<div class=\"app\">{appbar(f\"/c/{token}#home\", chip)}{home}{setup}{pay}{more}</div>{tabbar}{TAB_SCRIPT}')\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers=_cabinet_cookie(token))\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\") + \"#setup\")\n\n\nasync def handle_telegram(request):\n    \"\"\"Open the bot with a one-time code that joins this web account to the Telegram account.\"\"\"\n    db, user = _user(request)\n    if user[\"tg_id\"] > 0:\n        raise web.HTTPSeeOther(f\"https://t.me/{BOT_USERNAME}\")\n    raise web.HTTPSeeOther(f\"https://t.me/{BOT_USERNAME}?start=web_{db.create_link_code(user['tg_id'])}\")\n\n\nasync def handle_pay(request):\n\"\"\"Paying for access: tariff choice → Platega payment page → confirmation (callback or «Проверить»).\"\"\"\nfrom aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\nimport database as db\nimport payments\nfrom keyboards import support_button\nfrom navigation import show_card\n\nrouter = Router()\n\n\ndef kb(*rows):\n    return InlineKeyboardMarkup(inline_keyboard=[list(row) for row in rows])\n\n\ndef cb(text, data):\n    return InlineKeyboardButton(text=text, callback_data=data)\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\n@router.callback_query(F.data == \"pay\")\nasync def choose_tariff(callback: CallbackQuery):\n    if not payments.enabled():\n        await callback.answer(\"Оплата скоро появится.\", show_alert=True)\n        return\n    await callback.answer()\n    user = db.get_user(callback.from_user.id) or {}\n    text = \"<b>Оплата доступа</b>\\n\\nВыберите срок. В любой тариф входят все серверы и \n    if user.get(\"paid_until\"):\n        text += f\"\\n\\nСейчас доступ до <b>{payments.paid_until_text(user['paid_until'])}</b>, новый срок добави\n    rows = [[cb(f\"{t['title']} — {price(t['price'])}\", f\"buy:{t['key']}\")] for t in payments.paid_tariffs()]\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\nasync def buy(callback: CallbackQuery):\n    plan = payments.tariff(callback.data.split(\":\", 1)[1])\n    if not plan or not payments.enabled():\n        await callback.answer(\"Выберите тариф заново.\", show_alert=True)\n        return\n    await callback.answer(\"Создаю ссылку на оплату…\")\n    try:\n        payment = await payments.create_link(callback.from_user.id, plan[\"key\"])\n    except payments.PaymentError:\n        await show_card(callback.message, \"help\", \"<b>Не удалось создать оплату</b>\\n\\nПопробуйте ещё р�\n                        reply_markup=kb([cb(\"Попробовать снова\", callback.data)], [support_button()],\n                                        [cb(\"‹ Назад\", \"pay\")]))\n        return\n    text = (f\"<b>Оплата · {plan['title']} · {price(plan['price'])}</b>\\n\\n\"\n            \"1. Нажмите «Оплатить» — откроется страница оплаты: СБП, карта или крип\n            \"2. После оплаты вернитесь сюда — доступ продлится автоматически.\\n\\n\"\n            \"Сообщение не пришло — нажмите «Проверить оплату».\\n\\n\"\n            \"<i>Ссылка действует 15 минут.</i>\")\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(\n        [InlineKeyboardButton(text=f\"💳 Оплатить {price(plan['price'])}\", url=payment[\"url\"])],\n        [cb(\"🔄 Проверить оплату\", f\"pay_check:{payment['id']}\")],\n        [cb(\"‹ Другой тариф\", \"pay\")]))\n\n\n@router.callback_query(F.data == \"web_cabinet\")\nasync def web_cabinet(callback: CallbackQuery):\n    \"\"\"Personal link to the same account on the website — it opens even when Telegram does not.\"\"\"\n    from config import PUBLIC_BASE_URL\n    await callback.answer()\n    if not db.get_user(callback.from_user.id):\n        await show_card(callback.message, \"home\", \"<b>Веб-кабинет</b>\\n\\nОн появится после подключения �\n                        \"там будут те же устройства, срок доступа и оплата.\",\n                        reply_markup=kb([cb(\"🚀 Подключить устройство\", \"get_vpn\")], [cb(\"‹ Главное меню\"\n        return\n    link = f\"{PUBLIC_BASE_URL.rstrip('/')}/c/{db.ensure_web_token(callback.from_user.id)}\"\n    await show_card(callback.message, \"home\",\n                    \"<b>Веб-кабинет</b>\\n\\nТот же аккаунт на сайте: устройства, срок доступ\n                    \"Открывается в браузере даже без Telegram — сохраните ссылку в заметк\n                    \"<i>Никому не пересылайте её: по ней открывается ваш доступ.</i>\",\n                    reply_markup=kb([InlineKeyboardButton(text=\"🌐 Открыть веб-кабинет\", url=link)], [cb(\"‹ Главн�\n\n\n@router.callback_query(F.data.startswith(\"pay_check:\"))\nasync def check(callback: CallbackQuery):\n    part = callback.data.split(\":\", 1)[1]\n    payment = db.get_payment(int(part)) if part.isdigit() else None\n    if not payment or payment[\"tg_id\"] != callback.from_user.id:\n        await callback.answer(\"Платёж не найден.\", show_alert=True)\n        return\n    try:\n        payment, _ = await payments.check(payment)\n    except payments.PaymentError:\n        await callback.answer(\"Не удалось проверить. Попробуйте через минуту.\", show_alert=True)\n        return\n    if payment[\"status\"] == \"paid\":\n        await callback.answer()\n        await show_card(callback.message, \"done\", payments.success_text(callback.from_user.id),\n                        reply_markup=kb([cb(\"Главное меню\", \"back_main\")]))\n    elif payment[\"status\"] in (\"canceled\", \"chargebacked\"):\n        await callback.answer()\n        await show_card(callback.message, \"help\", \"<b>Оплата не прошла</b>\\n\\nДеньги не списаны. Можно п�\n                        reply_markup=kb([cb(\"Попробовать снова\", f\"buy:{payment['tariff']}\")], [cb(\"‹ Назад\", \"pay\")]\n    else:\n        await callback.answer(\"Оплата ещё не поступила. Если вы уже оплатили — подождите м�\n                              show_alert=True)\nsubscription.py:259:    app.router.add_get(\"/sub/{token}\", handle_subscription)\nsubscription.py:260:    app.router.add_get(\"/install/{token}\", handle_install)\nsubscription.py:261:    app.router.add_get('/happ/sub/{token}', handle_happ_subscription)\nsubscription.py:262:    app.router.add_get('/happ/install/{token}', handle_happ_install)\nsubscription.py:263:    app.router.add_get('/nexo/sub/{token}', handle_nexo_subscription)\nsubscription.py:264:    app.router.add_get('/app/{client}/install/{token}', handle_client_install)\nsubscription.py:265:    app.router.add_get(\"/health\", handle_health)\nsubscription.py:266:    app.router.add_post(\"/platega/callback\", handle_platega_callback)\n31:        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],\n38:def docs_back(pay: bool = False) -> InlineKeyboardMarkup:\ndef success_text(tg_id: int) -> str:\n    user = db.get_user(tg_id) or {}\n