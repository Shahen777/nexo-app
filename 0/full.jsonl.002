claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/tests/test_webapp.py":{"backupFileName":"1fdd5065048514d6@v16","version":16,"backupTime":"2026-11-07T09:22:55.725Z","realParentDir":"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/tests"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/reality_secret.py":{"backupFileName":"8c259b8308e20f10@v2","version":2,"backupTime":"2026-11-06T06:46:08.288Z","realParentDir":"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/port_test.py":{"backupFileName":"a2707aab19b59924@v3","version":3,"backupTime":"2026-11-06T06:46:08.292Z","realParentDir":"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad"},"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory/build_nexo_karing.py":{"backupFileName":"40004dcbb493c31b@v6","version":6,"backupTime":"2026-10-31T23:00:27.238Z","realParentDir":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory"},"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/auto_compare.py":{"backupFileName":"9dd5cef43781f807@v2","v