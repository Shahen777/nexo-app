n    Set<DnsOverrideKey> dnsOverrideKeys,\n    @Default(defaultProfileTun)\n    @JsonKey(name: 'tun-override', fromJson: ProfileTun.safeFromJson)\n    ProfileTun tunOverride,\n    @Default({})\n    @JsonKey(name: _tunOverrideKeysJsonKey, fromJson: _tunOverrideKeysFromJson)\n    Set<TunOverrideKey> tunOverrideKeys,\n    @Default(defaultGeoXUrl)\n    @JsonKey(\n      name: 'geox-url',\n      fromJson: _geoXUrlFromJson,\n      toJson: _geoXUrlToJson,\n    )\n    Map<GeoResource, String> geoXUrl,\n1549:abstract class ProfileTun with _$ProfileTun {\n1550-  const factory ProfileTun({\n1551-    @Default(defaultTunMtu) int mtu,\n1552-    @Default(defaultCongestionController)\n1553-    @JsonKey(name: 'congestion-controller')\n1554-    String congestionController,\n1555-    @Default(false) @JsonKey(name: 'strict-route') bool strictRoute,\n1556-    @Default([]) @JsonKey(name: 'route-address') List<String> routeAddress,\n1557-    @Default([])\n1558-    @JsonKey(name: 'route-exclude-address')\n1559-    List<String> routeExcludeAddress,\n1560-    @Default(defaultDnsHijack)\n1561-    @JsonKey(name: 'dns-hijack')\n        'saveConfig',\n        'isAvailable',\n      ]);\n    });\n\n    group('upgrade', () {\n      Map<String, Object?> customized() =>\n          _createConfigMap()\n            ..['themeProps'] = {\n              'primaryColor': 0xFF123456,\n              'primaryColors': [0xFF795548, 0xFF123456],\n              'schemeVariant': 'tonalSpot',\n              'themeMode': 'dark',\n              'pureBlack': true,\n              'liquidGlass': true,\n              'systemFontFamily': 'Beta Serif',\n            };\n\n      test('starts theme colors over once and keeps the rest', () async {\n        final store = _FakeMigrationStore(\n          configMap: customized(),\n          version: Migration.currentVersion,\n          upgradeVersion: 0,\n        );\n\n        final config = await Migration(store: store).run();\n\n        final theme = config.themeProps;\n        expect(theme.primaryColor, defaultPrimaryColor);\n        expect(theme.primaryColors, defaultPrimaryColors);\n        expect(theme.colorStyle, ColorStyle.vivid);\n        expect(theme.themeMode, ThemeMode.dark);\n        expect(theme.pureBlack, isTrue);\n        expect(theme.liquidGlass, LiquidGlassMode.ultra);\n        expect(theme.fontFamily, 'Beta Serif');\n        expect(store.savedConfig, config);\n        expect(store.version, Migration.currentVersion);\n        expect(store.upgradeVersion, Migration.upgradeVersion);\n        expect(store.events, [\n          'getConfigMap',\n          'getVersion',\n          'saveConfig',\n          'setUpgradeVersion',\n        ]);\n\n        final later = _FakeMigrationStore(\n          configMap: jsonDecode(\n            jsonEncode(config.copyWith.themeProps(primaryColor: 0xFF123456)),\n          ),\n          version: store.version,\n          upgradeVersion: store.upgradeVersion,\n        );\n        final kept = await Migration(store: later).run();\n\n        expect(kept.themeProps.primaryColor, 0xFF123456);\n        expect(later.events, ['getConfigMap', 'getVersion']);\n        expect((await upgrade(3)).primaryColor, 0xFFFF9500);\n      });\n\n      test('turns off the sidebar blur releases stored unseen, once', () async {\n        Future<bool> upgrade(int from) async {\n          final configMap = _createConfigMap();\n          (configMap['themeProps']! as Map<String, Object?>)['sidebarBlur'] =\n              true;\n          final store = _FakeMigrationStore(\n            configMap: configMap,\n            version: Migration.currentVersion,\n            upgradeVersion: from,\n          );\n          return (await Migration(store: store).run()).themeProps.sidebarBlur;\n        }\n\n        expect(await upgrade(3), isFalse);\n        expect(await upgrade(4), isTrue);\n      });\n\n      test('a new install only records it', () async {\n        final store = _FakeMigrationStore(\n          configMap: null,\n          version: 0,\n          upgradeVersion: 0,\n        );\n\n        final config = await Migration(store: store).run();\n\n        expect(config.themeProps, defaultThemeProps);\n        expect(store.upgradeVersion, Migration.upgradeVersion);\n        expect(\n          store.events.where((event) => event == 'saveConfig'),\n          hasLength(1),\n        );\n      });\n\n      test('waits for the next launch when saving fails', () async {\n        final store = _FakeMigrationStore(\n          configMap: customized(),\n          version: Migration.currentVersion,\n          upgradeVersion: 0,\n          configSaveResult: false,\n        );\n\n        final config = await Migration(store: store).run();\n\n        expect(config.themeProps.primaryColor, 0xFF123456);\n        expect(store.upgradeVersion, 0);\n      });\n    });","is_error":false}]},"uuid":"56acfe0f-190f-4313-ae65-6ded4c1b1bb7","timestamp":"2026-11-07T22:39:58.047Z","toolUseResult":{"stdout":"abstract class PatchClashConfig with _$PatchClashConfig {\n  const factory PatchClashConfig({\n    @Default(defaultMixedPort) @JsonKey(name: 'mixed-port') int mixedPort,\n    @Default(0) @JsonKey(name: 'socks-port') int socksPort,\n    @Default(0) @JsonKey(name: 'port') int port,\n    @Default(0) @JsonKey(name: 'redir-port') int redirPort,\n    @Default(0) @JsonKey(name: 'tproxy-port') int tproxyPort,\n    @Default(Mode.rule) Mode mode,\n    @Default(false) @JsonKey(name: 'allow-lan') bool allowLan,\n    @Default(LogLevel.error) @JsonKey(name: 'log-level') LogLevel logLevel,\n    @Default(false) bool ipv6,\n    @Default(FindProcessMode.off)\n    @JsonKey(name: 'find-process-mode', unknownEnumValue: FindProcessMode.off)\n    FindProcessMode findProcessMode,\n    @Default(InterfaceNameMode.clear)\n    @JsonKey(\n      name: 'interface-name-mode',\n      unknownEnumValue: InterfaceNameMode.clear,\n    )\n    InterfaceNameMode interfaceNameMode,\n    @Default('') @JsonKey(name: 'interface-name') String interfaceName,\n    @Def