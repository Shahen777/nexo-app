// The download can take minutes; edits and deletes made meanwhile win.\n      final latest = ref.read(profilesProvider).getProfile(profile.id);\n      if (latest == null) {\n        await clearEffect(profile.id);\n        return;\n      }\n      final newProfile = latest.copyWith(\n        label: latest.label.takeFirstValid([updated.label]),\n        subscriptionInfo: updated.subscriptionInfo,\n        lastUpdateDate: updated.lastUpdateDate,\n      );\n      ref.read(profilesProvider.notifier).put(newProfile);\n      if (profile.id == ref.read(currentProfileIdProvider)) {\n        ref\n6196d95\n1","is_error":false}]},"uuid":"91dcb57c-44e5-4847-9fa9-22b4633094b9","timestamp":"2026-11-06T10:23:49.504Z","toolUseResult":{"stdout":"374:def restore_page(error=\"\", status=200):\n375-    alert = f'<div class=\"flash err\" style=\"margin:0 0 12px\">{error}</div>' if error else \"\"\n376-    inner = (alert + '<form method=\"post\" action=\"/app/restore\"><label for=\"code\">Код доступа — 12 цифр</label>'\n377-             '<input class=\"field\" id=\"code\" name=\"code\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"0000 0000 0000\" required autofocus>'\n378-             '<button class=\"btn\">Войти</button></form>'\n379-             '<p class=\"muted\">Код показан в кабинете на вкладке «Ещё». Ключи и оплаченный срок останутся теми же, настраивать \n380-             f'<p class=\"muted\" style=\"margin-bottom:0\">Нет кода? Если подключали Telegram, кабинет открывается в боте <a href=\"https://t.me/{BOT_USERNAME}\">@{BOT\n381-             f'Если нет — <a href=\"{html.escape(legal.SUPPORT_URL, quote=True)}\" target=\"_blank\" rel=\"noreferrer\">напишите в поддержку</a>.</p>')\n382-    return page(\"Вход по коду\", simple(\"Вход по коду\", inner), status=status)\n383-\n384-\n385-async def handle_restore_form(request):\n386-    token = request.cookies.get(COOKIE, \"\")\n255:def appbar(home=\"/app\", right=\"\"):\n256-    return (f'<header class=\"appbar\"><div><a clas