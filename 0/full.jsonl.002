 'lazy': False}\n28\t\"\"\", \"\"\"    names = [p['name'] for p in proxies]\n29\t    visible_names = names\n30\t    vienna_group = None\n31\t    relayed_groups = []\n32\t    if any(p['type'] == 'hysteria2' for p in proxies):\n33\t        server = os.environ.get('NEXO_HY2_SERVER')\n34\t        vienna_names = [p['name'] for p in proxies if p['server'] == server]\n35\t        other_names = [p['name'] for p in proxies if p['server'] != server]\n36\t        country = '🇦🇹 Nexo — Вена'\n37\t        visible_names = [country, *other_names]\n38\t        vienna_group = {'name': country, 'type': 'fallback', 'proxies': vienna_names,\n39\t                        'url': PROBE_URL, 'interval': 20, 'timeout': 3000, 'lazy': False}\n40\t        # Russian providers block other countries' addresses one by one; reaching them from Vienna keeps them usable,\n41\t        # and the direct route stays as the backup for when Vienna itself is cut.\n42\t        relayed = []\n43\t        for proxy in proxies:\n44\t            if proxy['server'] == server:\n45\t                continue\n46\t            name = proxy['name']\n47\t            proxy['name'] = f'{name} напрямую'\n48\t            relayed.append({**proxy, 'name': f'{name} через Вену', 'dialer-proxy': country})\n49\t            relayed_groups.append({'name': name, 'type': 'fallback', 'proxies': [f'{name} через Вену', proxy['name']],\n50\t                                   'url': PROBE_URL, 'interval': 60, 'timeout': 5000, 'lazy': False})\n51\t        proxies += relayed\n52\t\"\"\"),\n53\t    (\"\"\"            *([vienna_group] if vienna_group else []),\n54\t            *([{'name'\"\"\", \"\"\"            *([vienna_group] if vienna_group else []),\n55\t            *relayed_groups,\n56\t            *([{'name'\"\"\"),\n57\t])\n58\t\n59\tpatch('tests/test_hy2.py', [\n60\t    (\"\"\"    def test_a_single_server_gets_no_service_choices(self):\"\"\",\n61\t     \"\"\"    def test_other_countries_are_reached_through_vienna_first(self):\n62\t      