{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"c98c593c1a214620183f86a6f054a4905e688f55df214edcf0a01918ba6a3885","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01YBZJq94MBHuoiqma92MJiZ","name":"Bash","input":{"command":"ssh -i ~/.ssh/codex_aura_vps -o ConnectTimeout=15 codex-aura@152.53.50.204 'cd /opt/nexo-bot && T=$(sudo -n bash -c \"set -a; . /opt/nexo-bot/.env 2>/dev/null; cd /opt/nexo-bot; /opt/nexo-bot/venv/bin/python -c \\\"import database,sqlite3;c=sqlite3.connect(database.DB_PATH);r=c.execute(\\\\\\\"select token from devices where status=\\x27active\\x27 limit 1\\\\\\\").fetchone() or c.execute(\\\\\\\"select subscription_token from users where is_active=1 and revoked_at is null and subscription_token is not null and vpn_uuid is not null limit 1\\\\\\\").fetchone();print(r[0] if r else \\x27\\x27)\\\"\"); [ -z \"$T\" ] && { echo no token; exit; }; curl -sk -A \"v2rayN/26.10.5 OneXray/26.10.5\" -D /tmp/h.txt \"https://127.0.0.1:8444/happ/sub/$T\" -o /tmp/b.json; grep -iE \"^HTTP|content-type|profile-title|subscription-userinfo|^routing\" /tmp/h.txt | sed \"s/routing: .*/routing: (present)/\"; python3 -c \"\nimport json; d=json.load(open(\\\"/tmp/b.json\\\")); print(\\\"configs:\\\",len(d)); c=d[0]; print(\\\"servers:\\\",[x[\\\"outbounds\\\"][0][\\\"streamSettings\\\"][\\\"security\\\"] for x in d]); print(\\\"direct domains:\\\",len(c[\\\"routing\\\"][\\\"rules\\\"][3][\\\"domain\\\"])); print(\\\"keys:\\\",sorted(c))\"; rm -f /tmp/h.txt /tmp/b.json'","description":"Fetch live subscription with a real device token"},"caller":{"type":"direct"}}]}}
