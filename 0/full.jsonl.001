{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"6d7f1a49667cdb8013e0ac55521d193eb569bc2a6cc8ded10c7a4460ea92c891","message":{"role":"user","content":[{"tool_use_id":"toolu_01PULyvKZ6ZwBg7N1W61gKhi","type":"tool_result","content":"\"\"\"Real onboarding/FSM/SQLite/provisioner with only panel/Telegram IO substituted.\"\"\"\nimport asyncio\nimport os\nos.environ.setdefault(\"AURA_NO_CARDS\", \"1\")\nimport tempfile\nimport unittest\nfrom unittest.mock import AsyncMock, patch\n\nfrom aiogram import Bot\nfrom aiogram.fsm.context import FSMContext\nfrom aiogram.fsm.storage.memory import MemoryStorage\nfrom aiogram.fsm.storage.base import StorageKey\nfrom aiogram.types import CallbackQuery, Message\n\nwith tempfile.TemporaryDirectory() as directory:\n    with patch.dict(os.environ, {\"AURA_DB_PATH\": f\"{directory}/test.db\"}):\n        import database as db\n        from handlers import devices, onboarding, vpn\nfrom device_service import DeviceService\nfrom vpn_service import Node\nfrom test_devices import Panel\n\n\nclass OnboardingTests(unittest.IsolatedAsyncioTestCase):\n    async def asyncSetUp(self):\n        self.tmp = tempfile.TemporaryDirectory()\n        self.db_patch = patch.object(db, \"DB_PATH\", self.tmp.name + \"/test.db\")\n        self.db_patch.start()\n        db.init_db()\n        self.bot = Bot(\"123456789:TEST_TOKEN_FOR_LOCAL_TESTS_ONLY\")\n        self.api = AsyncMock(return_value=True)\n        self.api_patch = patch.object(self.bot.session, \"make_request\", self.api)\n        self.api_patch.start()\n        self.storage = MemoryStorage()\n        self.state = FSMContext(self.storage, StorageKey(bot_id=self.bot.id, chat_id=123, user_id=123))\n        self.nodes = [Node(k,k,k+\".example\",443,\"pk\",\"sid\",\"sni\") for k in (\"a\",\"b\")]\n        self.panels = {n.key: Panel() for n in self.nodes}\n        self.service = DeviceService(nodes=self.nodes, client_factory=self.panels.__getitem__)\n        self.service_patch = patch.object(onboarding, \"DeviceService\", return_value=self.service)\n        self.service_patch.start()\n282:    rows = [[url(first, app.install[0][1])],\n283-            [url(f\"2️⃣ Добавить ключ в {app.name}\", link)] if link else [cb(\"2️⃣ QR-код\", f\"ob_qr:{nonce}\")],\n284-            [cb(\"✅ Готово →\", f\"activate:{platform}\")]]\n285-    rows += [[cb(label, f\"app:{key}:{nonce}\")] for label, key in SWITCH.get(platform, {}).get(app.key, [])]\n286-    rows.append([cb(\"‹ Назад\", \"get_vpn\"), cb(\"Не получается\", f\"stuck:2:{nonce}\")])\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]}}
{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"97c81bd1331b6511090d9974ddb02ee2ae7b2e9ca9843cc6d841694b71ff2670","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_017QRfWEByforiCjVh2YgYEy","name":"Bash","input":{"command":"cd /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work && python3 - <<'EOF'\ndef patch(p, pairs):\n    s=open(p).read()\n    for old,new in pairs:\n        assert old in s, (p, old[:60]); s=s.replace(old,new)\n    open(p,'w').write(s)\n\npatch('catalog.py', [('''# iPhone: which app to start with, by the country of the user's App Store account.''',\n'''# Video walkthroughs (files in assets/video/, kept out of git): {platform: {app: file name}}.\nVIDEOS = {\"ios\": {\"karing\": \"karing.mp4\"}}\n\n# iPhone: which app to start with, by the country of the user's App Store account.''')])\n\npatch('navigation.py', [('''async def show_card(message: Message, card: str, caption: str, reply_markup=None):''',\n'''VIDEO_DIR = os.path.join(ASSETS, \"video\")\n_video_ids: dict[str, str] = {}\n\n\ndef video_path(name: str | None) -> str | None:\n    path = os.path.join(VIDEO_DIR, name) if name else None\n    return path if path and os.path.exists(path) else None\n\n\nasync def send_video(bot, chat_id: int, name: str, caption: str, reply_markup=None):\n    \"\"\"Send a walkthrough video (vertical 1080x1920); the uploaded file_id is reused afterwards.\"\"\"\n    sent = await bot.send_video(chat_id=chat_id, video=_video_ids.get(name) or FSInputFile(video_path(name)),\n                                caption=caption, width=1080, height=1920, supports_streaming=True, reply_markup=reply_markup)\n    if isinstance(sent, Message) and sent.video:\n        _video_ids[name] = sent.video.file_id\n    return sent\n\n\nasync def show_card(message: Message, card: str, caption: str, reply_markup=None):''')])\n\npatch('handlers/onboarding.py', [\n('from catalog import POWER_ON, STORE_APP, SWITCH, apps_for, get_app','from catalog import POWER_ON, STORE_APP, SWITCH, VIDEOS, apps_for, get_app'),\n('from navigation import send_card, show_card','from navigation import send_card, send_video, show_card, video_path'),\n('''            [cb(\"✅ Готово →\", f\"activate:{platform}\")]]\n    rows += [[cb(label, f\"app:{key}:{nonce}\")] for label, key in SWITCH.get(platform, {}).get(app.key, [])]''',\n'''            [cb(\"✅ Готово →\", f\"activate:{platform}\")]]\n    if video_path(VIDEOS.get(platform, {}).get(app.key)):\n        rows.insert(2, [cb(\"▶️ Видео: как это сделать (1 мин)\", f\"howto:{nonce}\")])\n    rows += [[cb(label, f\"app:{key}:{nonce}\")] for label, key in SWITCH.get(platform, {}).get(app.key, [])]'''),\n('''@router.callback_query(F.data.startswith(\"ob_qr:\"))''',\n'''@router.callback_query(F.data.startswith(\"howto:\"))\nasync def howto_video(callback: CallbackQuery, state: FSMContext, bot: Bot):\n    \"\"\"Walkthrough video under the install card, with the same next steps as buttons.\"\"\"\n    data = await wizard_data(state, callback.data.split(\":\", 1)[1])\n    urls = key_urls(callback.from_user.id, data) if data else None\n    app = get_app(data[\"platform\"], data.get(\"app\")) if urls else None\n    name = VIDEOS.get(data[\"platform\"], {}).get(app.key) if app else None\n    if not video_path(name):\n        await callback.answer(STALE, show_alert=True)\n        return\n    await callback.answer(\"Загружаю видео…\")\n    link = import_link(app, urls[1])\n    rows = [[url(f\"1️⃣ Установить {app.name}\", app.install[0][1])]]\n    if link:\n        rows.append([url(f\"2️⃣ Добавить ключ в {app.name}\", link)])\n    rows.append([cb(\"✅ Готово →\", f\"activate:{data['platform']}\")])\n    await send_video(bot, callback.from_user.id, name, f\"<b>Как подключить {BRAND_TITLE} в {app.name}</b> · 1 минута\",\n                     reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"ob_qr:\"))'''),\n])\n\npatch('tests/test_onboarding.py', [('''    async def test_stale_app_choice_is_rejected(self):''',\n'''    async def test_karing_step_offers_walkthrough_video_with_next_steps(self):\n        from navigation import _video_ids\n        with tempfile.TemporaryDirectory() as videos, patch.object(onboarding, \"video_path\", lambda name: f\"{videos}/{name}\" if name else None), \\\\\n                patch(\"navigation.video_path\", lambda name: f\"{videos}/{name}\"):\n            open(f\"{videos}/karing.mp4\", \"wb\").write(b\"0\")\n            nonce = await self.draft(\"ru\")\n            data = [b.callback_data for b in self.buttons(self.screens()[-1])]\n            self.assertIn(f\"howto:{nonce}\", data)\n            await onboarding.choose_app(self.callback(f\"app:onexray:{nonce}\"), self.state)\n            self.assertNotIn(f\"howto:{nonce}\", [b.callback_data for b in self.buttons(self.screens()[-1])])\n            await onboarding.choose_app(self.callback(f\"app:karing:{nonce}\"), self.state)\n            await onboarding.howto_video(self.callback(f\"howto:{nonce}\"), self.state, self.bot)\n        video = self.screens(\"sendVideo\")[-1]\n        self.assertIn(\"Karing\", video.caption)\n        self.assertTrue(video.supports_streaming)\n        buttons = self.buttons(video)\n        self.assertIn(\"id6472431552\", buttons[0].url)\n        self.assertIn(\"/install/\", buttons[1].url)\n        self.assertEqual(buttons[2].callback_data, \"activate:ios\")\n        _video_ids.clear()\n\n    async def test_walkthrough_video_without_file_is_not_offered(self):\n        nonce = await self.draft(\"ru\")\n        self.assertNotIn(f\"howto:{nonce}\", [b.callback_data for b in self.buttons(self.screens()[-1])])\n        await onboarding.howto_video(self.callback(f\"howto:{nonce}\"), self.state, self.bot)\n        self.assertEqual(self.screens(\"sendVideo\"), [])\n\n    async def test_stale_app_choice_is_rejected(self):''')])\nprint('ok')\nEOF\ngrep -n \"^from config import\" handlers/onboarding.py; PYTHONPATH=. AURA_NO_CARDS=1 AURA_DB_PATH=/tmp/x_v.db AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay python3 -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -E \"^(FAIL|ERROR)|Error|Ran|^OK|FAILED|assert\" | head -20; rm -f /tmp/x_v.db","description":"Add the walkthrough video button and handler, with tests","timeout":300000},"caller":{"type":"direct"}}]}}
