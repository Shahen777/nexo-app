 from Russia. {file name: content type}\n26-NEXO_FILES = {\n27:    \"Nexo-android.apk\": \"application/vnd.android.package-archive\",\n28:    \"Nexo-android-old.apk\": \"application/vnd.android.package-archive\",\n29-    \"Nexo-windows-setup.exe\": \"application/vnd.microsoft.portable-executable\",\n30-    \"Nexo-macos.dmg\": \"application/x-apple-diskimage\",\n--\n61-    \"android\": [\n62-        _app(\"happ\", \"Happ\", \"happ\", True, [(\"Google Play\", HAPP_PLAY), (\"⬇️ Скачать Happ без Google Play (APK)\", HAPP_APK)]),\n63:        _app(\"nexo\", \"Nexo\", \"xray\", True, [(\"APK\", nexo_download(\"Nexo-android.apk\")),\n64:                                            (\"⬇️ Nexo для старых телефонов (APK)\", nexo_download(\"Nexo-android-old.apk\"))]),\n65-    ],\n66-    \"windows\": [","is_error":false}]},"uuid":"69a054cd-cb79-48b1-a5f5-21a829c3a3bd","timestamp":"2026-11-06T07:18:24.394Z","toolUseResult":{"stdout":"name: nexo-build\n\n# Builds the Nexo app for Android, macOS and Windows; started by hand from the Actions tab.\non:\n  workflow_dispatch:\n\nenv:\n  FLUTTER_VERSION: '3.47.6'\n  GO_VERSION: '1.27.1'\n  NDK_VERSION: r28c\n\njobs:\n  build:\n    name: ${{ matrix.platform }}\n    runs-on: ${{ matrix.os }}\n    env:\n      HAS_KEYSTORE: ${{ secrets.KEYSTORE != '' }}\n      NEXO_MAC_UNIVERSAL: ${{ matrix.universal || '' }}\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - platform: android\n            os: ubuntu-latest\n          - platform: macos\n            os: macos-15-intel\n            universal: '1'\n            artifact: nexo-macos-universal\n          - platform: windows\n            os: windows-2022\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          submodules: recursive\n\n      - name: Setup Android signing\n        if: matrix.platform == 'android' && env.HAS_KEYSTORE == 'true'\n        env:\n          KEYSTORE: ${{ secrets.KEYSTORE }}\n        run: |\n          