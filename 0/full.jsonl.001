r[\"tg_id\"]))\n        conn.commit()\n        conn.close()\n        return location, db.list_devices(user[\"tg_id\"])[0][\"token\"], until\n\n    def notice(self, response):\n        return base64.b64decode(response.headers[\"announce\"].removeprefix(\"base64:\")).decode()\n\n    async def test_every_client_gets_the_end_date_and_no_notice_while_time_remains(self):\n        _, token, until = await self.period_ending_in(timedelta(days=10))\n        for path in (\"/sub/\", \"/happ/sub/\", \"/nexo/sub/\"):\n            response = await self.client.get(path + token)\n            self.assertEqual(response.status, 200)\n            self.assertIn(f\"expire={calendar.timegm(until.timetuple())}\", response.headers[\"subscription-userinfo\"])\n            self.assertEqual(response.headers[\"announce\"], \"0\")\n            self.assertEqual(response.headers[\"profile-web-page-url\"], \"https://vpn.example/app#pay\")\n\n    async def test_vpn_app_warns_in_the_last_days(self):\n        location, token, until = await self.period_ending_in(timedelta(days=2))\n        response = await self.client.get(\"/happ/sub/\" + token)\n        notice = self.notice(response)\n        self.assertIn(f\"заканчивается {until:%d.%m}\", notice)\n        self.assertLessEqual(len(notice), 200)\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn('class=\"flash soon\"', text)\n\n    async def test_vpn_app_and_cabinet_say_when_access_has_ended(self):\n        location, token, until = await self.period_ending_in(timedelta(days=-1))\n        response = await self.client.get(\"/nexo/sub/\" + token)\n        notice = self.notice(response)\n        self.assertIn(\"закончился\", notice)\n        self.assertLessEqual(len(notice), 200)\n        self.assertIn(f\"expire={calendar.timegm(until.timetuple())}\", response.headers[\"subscription-userinfo\"])\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn(\"Доступ закончился, VPN отключён\", text)\n\n    async def test_subscription_headers_do_not_reveal_the_cabinet(self):\n        location, token, _ = await self.period_ending_in(timedelta(days=2))\n        response = await self.client.get(\"/sub/\" + token)\n        cabinet_token = REDACTED, 1)[1]\n        self.assertFalse(any(cabinet_token in value for value in response.headers.values()))\n        self.assertNotIn(cabinet_token, self.notice(response))\n\n    async def test_unknown_token_has_no_nexo_profile(self):\n''')\nt = sub(t, 'import asyncio\\nimport base64\\nimport importlib\\n', 'import asyncio\\nimport base64\\nimport calendar\\nimport importlib\\n')\nopen('tests/test_webapp.py','w').write(t)\nPY\ngrep -n \"add_get.*sub\" subscription.py | cut -c1-110; PYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=\"$S/speed/st.db\" AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay python3 -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -vE \"ResourceWarning|open\\(f|^\\.+\" | tail -25 | cut -c1-180","description":"Add end date, app notice and cabinet banner; run all tests","timeout":200000}},"serverClassifierRequest":"6f974b5c-1a94-4d8e-935e-0d19b33a3e7c","apiBlockIndex":1,"requestId":"req_011Cgkc8mbemNQsWH61NcmYK","requestRef":"f475934d-d66e-4839-a671-1bc3baef4ee3","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"0a05e614-5a3d-4d0a-b6a0-fa2f559c056a","timestamp":"2026-11-05T22:56:52.083Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.317","gitBranch":"HEAD","slug":"deep-singing-taco"}
