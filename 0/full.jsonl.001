/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    cheapest = min(per_month(t) for t in payments.paid_tariffs())\n    sample = (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}'\n              f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}<span class=\"state on\">готов к выдаче</span></div>'\n              f'<p class=\"label\">Пробный доступ</p><div class=\"big\">{TRIAL_DAYS} дней бесплатно</div>'\n              '<div class=\"sub\">Австрия и Бразилия · до 3 устройств</div>'\n              f'<div class=\"perf\"></div><div class=\"stub\"><span>{html.escape(device or \"Телефон или компьютер\")}</span>'\n              '<span class=\"muted\">банки — напрямую</span></div></div>')\n25:COOKIE = \"nexo_cabinet\"\n219:def page(title, body, status=200, headers=None):\n233:        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src 'self'; \"\n273:    token = request.cookies.get(COOKIE, \"\")\n508:        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\ndef create_web_user(trial_days: int) -> tuple[int, str]:\n    \"\"\"A user without Telegram: negative synthetic tg_id (real Telegram ids are positive), a secret\n    cabinet token and a trial period. Returns (tg_id, token).\"\"\"\n    conn = get_db()\n    try:\n        while True:\n            tg_id = -(10**12 + secrets.randbelow(2**50))\n            token = secrets.token_urlsafe(32)\n            until = (datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None) + timedelta(days=trial_days)).isoformat()\n            try:\n                conn.execute(\"INSERT INTO users (tg_id, first_name, referral_code, web_token, paid_until) VALUES (?, ?, ?, ?, ?)\",\n                             (tg_id, \"Web\", f\"aura_{tg_id}\", token, until))\n                conn.commit()\n                return tg_id, token\n            except sqlite3.IntegrityError:\n                conn.rollback()\n    finally:\n        conn.close()\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]},"uuid":"033fcf42-61d9-4338-916a-2afe0ea33b23","timestamp":"2026-11-05T22:36:10.161Z","toolUseResult":{"stdout":"LISTEN 0      128          0.0.0.0:8444       0.0.0.0:*    users:((\"python3\",pid=3666783,fd=6))         \nLISTEN 0      128          0.0.0.0:8443       0.0.0.0:*    users:((\"python3\",pid=3307282,fd=6))         \nNov 03 09:35:19 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 03 09:37:20 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (Macintosh; I\nNov 03 15:39:17 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (Linux; Andro\nNov 03 15:39:23 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (Linux; Andro\nNov 03 15:39:52 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (Linux; Andro\nNov 03 15:40:09 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (Linux; Andro\nNov 05 18:41:22 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:41:23 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:41:28 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:41:55 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:45:22 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:47:57 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \nNov 05 18:48:25 INFO AuraVPN.subscription: POST /app/start 429 ua=Mozilla/5.0 (iPhone; CPU \n['created_at', 'web_token']\n# ---------------------------------------------------------------- landing ----