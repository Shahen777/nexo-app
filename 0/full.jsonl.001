{"parentUuid":"1becac76-8ff3-41f8-9aff-7d446dd2baaf","isSidechain":false,"promptId":"3b9d0d5e-1848-4eae-b42a-febe9cc9c0e1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HMNChRLJtLNUgWArgZ2Z2w","type":"tool_result","content":"7fd417f chore(release): v0.9.2\n144M\t.\nname: build\n\non:\n  push:\n    branches:\n      - '**'\n    tags:\n      - 'v*'\n  workflow_dispatch:\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ !startsWith(github.ref, 'refs/tags/v') }}\n\nenv:\n  IS_STABLE: ${{ !contains(github.ref, '-') }}\n  # See CI Caches in .agents/commands.md.\n  BRANCH_CACHE: ${{ !startsWith(github.ref, 'refs/tags/') }}\n  FLUTTER_VERSION: '3.47.6'\n  GO_VERSION: '1.27.1'\n  NDK_VERSION: r28c\n\njobs:\n  dart:\n    name: Dart\n    # A private copy pays for its Actions minutes, so it runs the checks only when\n    # started by hand.\n    if: &checks github.event_name == 'workflow_dispatch' || !github.event.repository.private\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          submodules: true\n\n      - name: Test git hooks\n        run: bash tool/hooks/test.sh\n\n      - name: Setup Rust cache\n        uses: Swatinem/rust-cache@v2\n        with:\n          workspaces: plugins/rust_api/rust\n          cache-directories: .dart_tool/hooks_runner\n          save-if: ${{ env.BRANCH_CACHE }}\n\n      - name: Setup Flutter\n        uses: subosito/flutter-action@v2\n        with:\n          channel: stable\n          flutter-version: ${{ env.FLUTTER_VERSION }}\n          cache: ${{ env.BRANCH_CACHE }}\n\n      - name: Install dependencies\n        run: flutter pub get\n\n      - name: Check format\n        run: dart format --output=none --set-exit-if-changed lib test tool plugins setup.dart\n\n      - name: Analyze\n        run: flutter analyze --no-fatal-infos\n\n      - name: Skip the Go core build hook\n        run: |\n          yq -i '.hooks.user_defines.setup.build_assets = false' pubspec.yaml\n\n      - name: Verify changelog\n        if: github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/')\n        run: dart run tool/changelog.dart verify\n\n      - name: Run tests\n        run: dart run tool/test.dart -- --reporter expanded --coverage\n\n      - name: Check coverage\n        run: dart run tool/check_coverage.dart coverage/lcov.info 75\n\n  plugins:\n    name: Plugins\n    if: *checks\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Flutter\n        uses: subosito/flutter-action@v2\n        with:\n          channel: stable\n          flutter-version: ${{ env.FLUTTER_VERSION }}\n          cache: ${{ env.BRANCH_CACHE }}\n\n      - name: Validate local Flutter packages\n        run: bash tool/check_plugins.sh\n\n      - name: Validate setup hooks package\n        working-directory: plugins/setup/setup_hooks\n        run: |\n          dart pub get\n          dart analyze\n          dart test\n\n  desktop:\n    name: Desktop ${{ matrix.platform }}\n    if: (github.event_name == 'workflow_dispatch' || !github.event.repository.private) && !(github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v'))\n    runs-on: ${{ matrix.os }}\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - platform: linux\n            os: ubuntu-latest\n          - platform: windows\n            os: windows-2022\n          - platform: macos\n            os: macos-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          submodules: recursive\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]},"uuid":"6b67f9bc-245b-489e-acd4-12b23d47acc0","timestamp":"2026-