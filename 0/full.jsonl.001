{"parentUuid":"81e4b350-5c61-4e60-acae-2d07b9c9c6fd","isSidechain":false,"promptId":"cc6b4e86-18b8-4e65-826e-ac485cbab2ac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CKRJ9V1w4LQu85Ve1rN4oB","type":"tool_result","content":"\"\"\"Non-secret bot settings. Secrets are supplied through environment/root-only files.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\n\n\ndef _admin_ids() -> list[int]:\n    value = os.environ.get(\"AURA_ADMIN_IDS\", \"\")\n    return [int(item.strip()) for item in value.split(\",\") if item.strip()]\n\n\nBOT_TOKEN = REDACTED, \"\")\nADMIN_IDS = _admin_ids()\nPUBLIC_BASE_URL = os.environ.get(\"AURA_PUBLIC_BASE_URL\", \"\")\nDEFAULT_SERVER = os.environ.get(\"AURA_DEFAULT_NODE\", \"vienna\")\n# Brand shown in the bot UI. Several bots (Aura VPN, Nexo) share this code and the database.\nBRAND = os.environ.get(\"AURA_BRAND\", \"AURA VPN\")\nBRAND_TITLE = os.environ.get(\"AURA_BRAND_TITLE\", \"Aura VPN\" if BRAND == \"AURA VPN\" else BRAND)\nBOT_USERNAME = os.environ.get(\"AURA_BOT_USERNAME\", \"AuraVPNpro_bot\")\n\nWELCOME_TEXT = (\n    f\"<b>{BRAND}</b> — защищённое соединение для телефона, компьютера и телевизора.\\n\\n\"\n    \"Подключение занимает три шага: выберите устройство, установите приложение, добавьте профиль одной кнопкой. \"\n    \"Банки, Госуслуги и маркетплейсы работают напрямую без переключений.\\n\\n\"\n    \"<i>Тарифы, условия и поддержка — в разделе «Тарифы и документы».</i>\"\n)\n\nPLATFORMS = {\"ios\": \"iPhone / iPad\", \"android\": \"Android\", \"windows\": \"Windows\",\n             \"macos\": \"Mac\", \"appletv\": \"Apple TV\", \"androidtv\": \"Android TV\", \"router\": \"Роутер\"}\n\nHELP_TEXT = (\n    \"<b>Помощь</b>\\n\\n\"\n    \"Если VPN не работает:\\n\"\n    \"1. Проверьте, что без VPN интернет есть.\\n\"\n    \"2. В приложении обновите подписку и включите VPN снова.\\n\\n\"\n    \"Не помогло — напишите нам, поможем.\"\n)\n\nPROFILE_TEXT = (\n# -*- coding: utf-8 -*-\n\"\"\"AuraVPN — Inline Keyboards\"\"\"\n\nfrom aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton\nfrom config import INSTALL_LINKS, APP_LINKS\n\n\ndef keyboard(*rows) -> InlineKeyboardMarkup:\n    return InlineKeyboardMarkup(inline_keyboard=[\n        [InlineKeyboardButton(text=label, callback_data=data) for label, data in row]\n        for row in rows\n    ])\n\n\ndef main_menu() -> InlineKeyboardMarkup:\n    return keyboard(\n        [(\"🚀 Подключить устройство\", \"get_vpn\")],\n        [(\"📱 Мои устройства\", \"devices\")],\n        [(\"💳 Тарифы и документы\", \"docs\"), (\"🛟 Помощь\", \"help\")],\n    )\n\n\ndef docs_menu() -> InlineKeyboardMarkup:\n    return keyboard(\n        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],\n        [(\"Пользовательское соглашение\", \"doc_terms\")],\n        [(\"Политика конфиденциальности\", \"doc_privacy\")],\n        [(\"‹ Главное меню\", \"back_main\")],\n    )\n\n\ndef docs_back() -> InlineKeyboardMarkup:\n    return keyboard([(\"‹ Документы и тарифы\", \"docs\"), (\"Главное меню\", \"back_main\")])\n\n\ndef help_menu() -> InlineKeyboardMarkup:\n    return keyboard([(\"💬 Написать в поддержку\", \"doc_support\")],\n                    [(\"‹ Главное меню\", \"back_main\")])\n\n\ndef platform_menu():\n    from config import PLATFORMS\n    pairs = list(PLATFORMS.items())\n    rows = [[(label, f\"setup:{key}\") for key, label in pairs[i:i+2]] for i in range(0, len(pairs), 2)]\n    return keyboard(*rows, [(\"‹ Главное меню\", \"back_main\")])\n\n\ndef instructions_menu() -> InlineKeyboardMarkup:\n    return InlineKeyboardMarkup(inline_keyboard=[\n        [InlineKeyboardButton(text=\"⚡ Пошаговое подключение\", callback_data=\"get_vpn\")],\n        [InlineKeyboardButton(text=\"iPhone / iPad\", callback_data=\"inst_ios\"),\n         InlineKeyboardButton(text=\"Android\", callback_data=\"inst_android\")],\n        [InlineKeyboardButton(text=\"Windows\", callback_data=\"inst_windows\"),\n         InlineKeyboardButton(text=\"macOS\", callback_data=\"inst_macos\")],\n        [InlineKeyboardButton(text=\"Apple TV\", callback_data=\"inst_appletv\"),\n         InlineKeyboardButton(text=\"Android TV\", callback_data=\"inst_androidtv\")],\n        [InlineKeyboardButton(text=\"Роутер\", callback_data=\"inst_router\")],\n        [InlineKeyboardButton(text=\"< \\u041d\\u0430\\u0437\\u0430\\u0434\", callback_data=\"back_main\")],\n    ])\n\nimport base64\nimport importlib\nimport os\nimport sys\nimport tempfile\nimport unittest\n\nfrom aiohttp.test_utils import TestClient, TestServer\n\nfrom vpn_service import Node\n\n\nclass SubscriptionHttpTests(unittest.IsolatedAsyncioTestCase):\n    async def asyncSetUp(self):\n        self.previous_env = os.environ.get('AURA_DB_PATH')\n        self.previous_path = getattr(sys.modules.get('database'), 'DB_PATH', None)\n        self.tempdir = tempfile.TemporaryDirectory()\n        os.environ[\"AURA_DB_PATH\"] = os.path.join(self.tempdir.name, \"aura.db\")\n        import database\n        self.db = importlib.reload(database)\n        self.db.add_user(\n            tg_id=123,\n            username=\"user\",\n            first_name=\"Test\",\n            vpn_uuid=\"00000000-0000-4000-8000-000000000001\",\n            vless_link=\"legacy\",\n            server=\"vienna\",\n        )\n        self.db.set_primary_node(123, \"vienna\")\n        self.token = REDACTED\n        self.nodes = [\n            Node(\"vienna\", \"Vienna\", \"203.0.113.10\", 443, \"pk1\", \"sid1\", \"one.example\"),\n            Node(\"brazil\", \"Brazil\", \"203.0.113.20\", 443, \"pk2\", \"sid2\", \"two.example\"),\n        ]\n\n        import subscription\n        self.subscription = importlib.reload(subscription)\n        app = self.subscription.create_app(\n            database_module=self.db,\n            node_provider=lambda: self.nodes,\naiogram>=3.15.0\naiohttp>=3.12.0\nqrcode[pil]>=8.0\nAURA_ADMIN_IDS= AURA_DB_PATH= AURA_NODES_FILE= AURA_PUBLIC_BASE_URL= AURA_TLS_CER