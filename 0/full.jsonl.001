{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"26bffccb26c03f0618065fcfee424abd413a7993bdb2c9893cff188b2a8cf664","message":{"role":"user","content":[{"tool_use_id":"toolu_01G9fsHxP1PaXFo7tmk7pCxp","type":"tool_result","content":[{"type":"text","text":"Plan shown (6 steps)."}]},{"tool_use_id":"toolu_01WsdwYFs9ybij16i39TFipH","type":"tool_result","content":"\"\"\"/start, /menu, /help and «Главное меню». New users get the guided setup, returning users the menu.\"\"\"\nfrom aiogram import Router, F\nfrom aiogram.types import Message, CallbackQuery\nfrom aiogram.filters import CommandStart, Command\nfrom aiogram.fsm.context import FSMContext\n\nimport database as db\nfrom keyboards import help_menu\nfrom config import HELP_TEXT\nfrom handlers.onboarding import render_home\n\nrouter = Router()\n\n\ndef referrer_from(message: Message):\n    parts = (message.text or \"\").split()\n    if len(parts) < 2 or not parts[1].startswith(\"ref_\"):\n        return None\n    try:\n        referrer = int(parts[1][4:])\n    except ValueError:\n        return None\n    return None if referrer == message.from_user.id else referrer\n\n\n@router.message(CommandStart())\nasync def cmd_start(message: Message, state: FSMContext):\n    await state.clear()\n    referrer_id = referrer_from(message)\n    if referrer_id and not db.get_user(message.from_user.id):\n        # Remember the referrer until the user creates their key\n        db.set_pending_referrer(message.from_user.id, referrer_id)\n    await render_home(message, message.from_user.id, fresh=True)\n\n\n@router.message(Command(\"menu\", \"cancel\"))\nasync def cmd_menu(message: Message, state: FSMContext):\n    await state.clear()\n    await render_home(message, message.from_user.id, fresh=True)\n\n\n@router.message(Command(\"help\"))\nasync def cmd_help(message: Message, state: FSMContext):\n    await state.clear()\n    await message.answer(HELP_TEXT, reply_markup=help_menu())\n\n\n@router.callback_query(F.data == \"back_main\")\nasync def back_to_main(callback: CallbackQuery, state: FSMContext):\n    await callback.answer()\n    await state.clear()\n    await render_home(callback.message, callback.from_user.id)\n\n\ndef get_user_by_subscription_token(token: str) -> dict | None:\n    if not token or len(token) < 32:\n        return None\n    conn = get_db()\n    row = conn.execute(\n        \"\"\"SELECT * FROM users\n           WHERE subscription_token = REDACTED AND is_active = 1 AND revoked_at IS NULL\"\"\",\n        (token,),\n    ).fetchone()\n    if row:\n        conn.close()\n        return dict(row)\n    row = conn.execute(\n        \"\"\"SELECT d.*, u.is_active FROM devices d JOIN users u ON d.tg_id = u.tg_id\n           WHERE d.token = REDACTED AND d.status = 'active'\n             AND u.is_active = 1 AND u.revoked_at IS NULL\"\"\", (token,)\n    ).fetchone()\n    conn.close()\n    if not row:\n        return None\n    device = _device_row(row)\n    device.update(vpn_uuid=device['uuid'], device_id=device['id'])\n    return device\n\n\ndef _device_row(row):\n    result = dict(row)\n    result['node_keys'] = json.loads(result['node_keys'])\n    result['node_targets'] = json.loads(result['node_targets'])\n    return result\n\nweb users: 1\nusers with paid_until: 1\npayments: [('canceled', 1), ('created', 2), ('pending', 8)]\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]}}
