aml', 'version: 0.9.2+2026102401', 'version: 0.9.3+2026110601')\n\nstrings = {\n 'updateVpnTip': {'en':'VPN turns off for a moment during installation. Then open Nexo and connect again.','ru':'Во время установки VPN ненадолго отключится. Затем откройте Nexo и подключитесь снова.','es':'La VPN se desactivará un momento durante la instalación. Luego abre Nexo y conéctate de nuevo.','fr':\"Le VPN se coupera un instant pendant l'installation. Ouvrez ensuite Nexo et reconnectez-vous.\",'ja':'インストール中はVPNが一時的にオフになります。その後Nexoを開いて再接続してください。','ko':'설치 중에는 VPN이 잠시 꺼집니다. 그런 다음 Nexo를 열고 다시 연결하세요.','zh_CN':'安装期间 VPN 会短暂断开。之后请打开 Nexo 并重新连接。'},\n 'updateDownloading': {'en':'Downloading the update','ru':'Скачиваем обновление','es':'Descargando la actualización','fr':'Téléchargement de la mise à jour','ja':'アップデートをダウンロード中','ko':'업데이트 다운로드 중','zh_CN':'正在下载更新'},\n 'updateFailed': {'en':'Could not update the app. Check your internet connection and try again.','ru':'Не удалось обновить приложение. Проверьте интернет и попробуйте ещё раз.','es':'No se pudo actualizar la aplicación. Comprueba tu conexión a internet e inténtalo de nuevo.','fr':\"Impossible de mettre à jour l'application. Vérifiez votre connexion internet et réessayez.\",'ja':'アプリを更新できませんでした。インターネット接続を確認してもう一度お試しください。','ko':'앱을 업데이트하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하세요.','zh_CN':'无法更新应用。请检查网络连接后重试。'},\n}\nfor loc in ('en','ru','es','fr','ja','ko','zh_CN'):\n    path = f'arb/intl_{loc}.arb'\n    s = open(path, encoding='utf-8').read()\n    goto = re.search(r'^  \"goDownload\": .*\\n', s, re.M)\n    add = ''.join('  %s: %s,\\n' % (json.dumps(k), json.dumps(v[loc], ensure_ascii=False)) for k, v in strings.items())\n    s = s[:goto.end()] + add + s[goto.end():]\n    json.loads(s)\n    open(path, 'w', encoding='utf-8').write(s)\n    path = f'lib/l10n/intl/messages_{loc}.dart'\n    s = open(path, encoding='utf-8').read()\n    for key in sorted(strings):\n        value = strings[key][loc].replace('\\\\', '\\\\\\\\').replace('\"', '\\\\\"').replace('$', '\\\\$')\n        one = f'    \"{key}\": MessageLookupByLibrary.simpleMessage(\"{value}\"),\\n'\n        line = one if len(one) <= 81 else f'    \"{key}\": MessageLookupByLibrary.simpleMessage(\\n      \"{value}\",\\n    ),\\n'\n        keys = [m for m in re.finditer(r'^    \"([A-Za-z0-9_]+)\": ', s, re.M)]\n        after = next((m for m in keys if m.group(1) > key), None)\n        assert after, key\n        s = s[:after.start()] + line + s[after.start():]\n    open(path, 'w', encoding='utf-8').write(s)\n\ns = open('lib/l10n/l10n.dart', encoding='utf-8').read()\nanchor = re.search(r\"  /// `Download`\\n  String get goDownload \\{.*?\\n  \\}\\n\\n\", s, re.S)\nadd = ''\nfor k, v in strings.items():\n    add += f\"  /// `{v['en']}`\\n  String get {k} {{\\n    return Intl.message(\\n      '{v['en']}',\\n      name: '{k}',\\n      desc: '',\\n      args: [],\\n    );\\n  }}\\n\\n\"\ns = s[:anchor.end()] + add + s[anchor.end():]\nopen('lib/l10n/l10n.dart', 'w', encoding='utf-8').write(s)\nPY\npython3 \"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/apply_update.py\" && mkdir -p android/app/src/main/res/xml && cat > android/app/src/main/res/xml/update_paths.xml <<'XML'\n<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<paths>\n    <cache-path name=\"update\" path=\"update/\" />\n</paths>\nXML\ncat > android/app/src/main/kotlin/com/follow/clash/UpdateFileProvider.kt <<'KT'\npackage com.follow.clash\n\nimport androidx.core.content.FileProvider\n\n// A subclass keeps this manifest entry from merging with a library's own FileProvider.\nclass UpdateFileProvider : FileProvider()\nKT\ncat > lib/widgets/update_download_dialog.dart <<'DART'\nimport 'dart:async';\n\nimport 'package:dio/dio.dart';\nimport 'package:fl_clash/common/common.dart';\nimport 'package:fl_clash/enum/enum.dart';\nimport 'package:fl_clash/plugins/app.dart';\nimport 'package:fl_clash/ui/ui.dart';\nimport 'package:material_ui/material_ui.dart';\n\n/// Pops true once the system installer has opened, false when it could not,\n/// and null when the user cancels.\nclass UpdateDownloadDialog extends StatefulWidget {\n  final Map<String, dynamic> release;\n\n  const UpdateDownloadDialog({super.key, required this.release});\n\n  @override\n  State<UpdateDownloadDialog> createState() => _UpdateDownloadDialogState();\n}\n\nclass _UpdateDownloadDialogState extends State<UpdateDownloadDialog> {\n  final _cancelToken = CancelToken();\n  final _progress = ValueNotifier<double?>(null);\n\n  @override\n  void initState() {\n    super.initState();\n    unawaited(_run());\n  }\n\n  Future<void> _run() async {\n    var started = false;\n    try {\n      final path = await request.downloadUpdate(\n        widget.release,\n        cancelToken: _cancelToken,\n        onProgress: (progress) => _progress.value = progress,\n      );\n      started = await app?.installApk(path) == true;\n    } catch (error) {\n      if (_cancelToken.isCancelled) return;\n      commonPrint.log(\n        'update failed: ${compactError(error)}',\n        logLevel: LogLevel.warning,\n      );\n    }\n    if (mounted) Navigator.of(context).pop(started);\n  }\n\n  @override\n  void dispose() {\n    _cancelToken.cancel();\n    _progress.dispose();\n    super.dispose();\n  }\n\n  @override\n  Widget build(BuildContext context) {\n    return CommonDialog(\n      title: context.appLocalizations.updateDownloading,\n      actions: [\n        TextButton(\n          onPressed: () => Navigator.of(context).pop(),\n          child: Text(context.appLocalizations.cancel),\n        ),\n      ],\n      child: ValueListenableBuilder(\n        valueListenable: _progress,\n        builder: (_, progress, _) => LinearProgressIndicator(value: progress),\n      ),\n    );\n  }\n}\nDART\ngit status --short | head -30; git diff --stat | tail -1; git grep -n \"HttpHeaders\\|Uint8List\\|dart:convert\\|dart:async\\|jsonDecode\\|Completer\\|utf8\\|gzip\" test/common/request_test.dart | head; grep -n \"H