{"parentUuid":"a245fc71-44b5-46db-813f-41455e7bc6f0","isSidechain":false,"promptId":"cc6b4e86-18b8-4e65-826e-ac485cbab2ac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qpdtgdwstw3H2QrRwrFGiV","type":"tool_result","content":[{"type":"text","text":"Plan updated: step 3 of 5 is in progress."}]}]},"uuid":"db3e19e9-0487-4f60-af61-e676027fe974","timestamp":"2026-10-31T21:33:47.685Z","toolUseResult":[{"type":"text","text":"Plan updated: step 3 of 5 is in progress."}],"sourceToolAssistantUUID":"a245fc71-44b5-46db-813f-41455e7bc6f0","permissionDecision":{"decision":"accept","source":"config","reasonType":"rule","ruleSource":"cliArg"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"db3e19e9-0487-4f60-af61-e676027fe974","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgb2ocTpoui4DXxyJFLQQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q5an1uhswYyA5rANyxJbTf","name":"Bash","input":{"command":"cd /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work && python3 - <<'EOF'\ndef patch(p, pairs):\n    s=open(p).read()\n    for old,new in pairs:\n        assert old in s, (p, old[:60]); s=s.replace(old,new,1)\n    open(p,'w').write(s)\n\n# ---------------------------------------------------------------- database\npatch('database.py', [\n('''            UNIQUE(tg_id, request_id)\n        );\n    \"\"\")''', '''            UNIQUE(tg_id, request_id)\n        );\n        CREATE TABLE IF NOT EXISTS payments (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            tg_id INTEGER NOT NULL,\n            tariff TEXT NOT NULL,\n            amount INTEGER NOT NULL,\n            days INTEGER NOT NULL,\n            provider TEXT NOT NULL DEFAULT 'platega',\n            provider_id TEXT UNIQUE,\n            status TEXT NOT NULL DEFAULT 'created',\n            created_at TEXT DEFAULT (datetime('now')),\n            paid_at TEXT\n        );\n    \"\"\")'''),\n('''        \"revoked_at\": \"TEXT\",\n    }''', '''        \"revoked_at\": \"TEXT\",\n        \"paid_until\": \"TEXT\",\n    }'''),\n])\ns=open('database.py').read()\ns += '''\n\n# ---------------------------------------------------------------- payments ------\ndef create_payment(tg_id: int, tariff: str, amount: int, days: int) -> int:\n    conn = get_db()\n    cursor = conn.execute(\n        \"INSERT INTO payments (tg_id, tariff, amount, days) VALUES (?, ?, ?, ?)\",\n        (tg_id, tariff, amount, days),\n    )\n    conn.commit()\n    conn.close()\n    return cursor.lastrowid\n\n\ndef set_payment_provider_id(payment_id: int, provider_id: str):\n    conn = get_db()\n    conn.execute(\"UPDATE payments SET provider_id = ?, status = 'pending' WHERE id = ?\", (provider_id, payment_id))\n    conn.commit()\n    conn.close()\n\n\ndef get_payment(payment_id: int) -> dict | None:\n    conn = get_db()\n    row = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (payment_id,)).fetchone()\n    conn.close()\n    return dict(row) if row else None\n\n\ndef settle_payment(provider_id: str, status: str) -> tuple[dict | None, bool]:\n    \"\"\"Apply a provider status idempotently. CONFIRMED extends paid_until once, from the later of\n    now and the current end; repeated or concurrent confirmations change nothing. Returns (payment, newly_paid).\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = conn.execute(\"SELECT * FROM payments WHERE provider_id = ?\", (provider_id,)).fetchone()\n        if not row:\n            conn.rollback()\n            return None, False\n        newly_paid = False\n        if status == \"CONFIRMED\" and row[\"status\"] != \"paid\":\n            now = datetime.utcnow().replace(microsecond=0)\n            user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (row[\"tg_id\"],)).fetchone()\n            current = datetime.fromisoformat(user[\"paid_until\"]) if user and user[\"paid_until\"] else now\n            until = max(now, current) + timedelta(days=row[\"days\"])\n            conn.execute(\"UPDATE payments SET status = 'paid', paid_at = ? WHERE id = ?\", (now.isoformat(), row[\"id\"]))\n            conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), row[\"tg_id\"]))\n            newly_paid = True\n        elif status in (\"CANCELED\", \"CHARGEBACKED\") and row[\"status\"] != \"paid\":\n            conn.execute(\"UPDATE payments SET status = ? WHERE id = ?\", (status.lower(), row[\"id\"]))\n        conn.commit()\n        updated = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (row[\"id\"],)).fetchone()\n        return dict(updated), newly_paid\n    finally:\n        conn.close()\n'''\ns=s.replace('from datetime import datetime\\n','from datetime import datetime, timedelta\\n',1)\nopen('database.py','w').write(s)\n\n# ---------------------------------------------------------------- payments module\nopen('payments.py','w').write('''\"\"\"Platega payments: a payment link per tariff, status checks and the provider callback.\n\nSecrets come from the environment (PLATEGA_MERCHANT_ID, PLATEGA_SECRET); without them payments\nare switched off and the bot hides the pay buttons. The provider decides the payment method on\nits own page (СБП, card, crypto). Access is extended only by database.settle_payment.\n\"\"\"\nfrom __future__ import annotations\n\nimport hmac\nimport logging\n\nimport aiohttp\n\nimport os\n\nimport database as db\nimport legal\nfrom config import BOT_TOKEN, BOT_USERNAME, BRAND_TITLE\n\nlogger = logging.getLogger(\"AuraVPN.payments\")\n\nBASE_URL = os.environ.get(\"PLATEGA_BASE_URL\", \"https://app.platega.io\").rstrip(\"/\")\nMERCHANT_ID = os.environ.get(\"PLATEGA_MERCHANT_ID\", \"\")\nSECRET = os.environ.get(\"PLATEGA_SECRET\", \"\")\nDAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\n\n\nclass PaymentError(Exception):\n    pass\n\n\ndef enabled() -> bool:\n    return bool(MERCHANT_ID and SECRET)\n\n\ndef paid_tariffs() -> list[dict]:\n    return [t for t in legal.TARIFFS if t[\"key\"] in DAYS]\n\n\ndef tariff(key: str) -> dict | None:\n    return next((t for t in paid_tariffs() if t[\"key\"] == key), None)\n\n\nasync def _request(method: str, path: str, payload: dict | None = None) -> dict:\n    headers = {\"X-MerchantId\": MERCHANT_ID, \"X-Secret\": SECRET, \"Content-Type\": \"application/json\"}\n    timeout = aiohttp.ClientTimeout(total=20)\n    try:\n        async with aiohttp.ClientSession(timeout=timeout) as session:\n            async with session.request(method, BASE_URL + path, json=payload, headers=headers) as response:\n                body = await response.json(content_type=None)\n                if response.status != 200:\n                    logger.error(\"Platega %s %s -> %s %s\", method, path, response.status,\n                                 (body or {}).get(\"code\") if isinstance(body, dict) else \"\")\n                    raise PaymentError(f\"HTTP {response.status}\")\n                return body\n    except (aiohttp.ClientError, TimeoutError, ValueError) as error:\n        raise PaymentError(str(error)) from error\n\n\nasync def create_link(tg_id: int, key: str) -> dict:\n    \"\"\"Create our payment row and a Platega transaction; returns the row with its payment url.\"\"\"\n    plan = tariff(key)\n    if not plan or not enabled():\n        raise PaymentError(\"payments are not available\")\n    payment_id = db.create_payment(tg_id, key, plan[\"price\"], DAYS[key])\n    back = f\"https://t.me/{BOT_USERNAME}\"\n    body = await _request(\"POST\", \"/v2/transaction/process\", {\n        \"paymentDetails\": {\"amount\": plan[\"price\"], \"currency\": \"RUB\"},\n        \"description\": f\"{BRAND_TITLE} · доступ на {plan['title'].lower()}\",\n        \"return\": back,\n        \"failedUrl\": back,\n        \"payload\": f\"payment:{payment_id}\",\n        \"orderId\": str(payment_id),\n        \"metadata\": {\"user_email\": f\"{tg_id}@telegram.org\", \"userId\": str(tg_id)},\n    })\n    if not body.get(\"transactionId\") or not str(body.get(\"url\", \"\")).startswith(\"https://\"):\n        raise PaymentError(\"unexpected response\")\n    db.set_payment_provider_id(payment_id, body[\"transactionId\"])\n    return {**db.get_payment(payment_id), \"url\": body[\"url\"]}\n\n\nasync def check(payment: dict) -> tuple[dict, bool]:\n    \"\"\"Ask Platega for the current status and apply it.\"\"\"\n    if payment[\"status\"] == \"paid\" or not payment.get(\"provider_id\"):\n        return payment, False\n    body = await _request(\"GET\", f\"/transaction/{payment['provider_id']}\")\n    settled, newly_paid = db.settle_payment(payment[\"provider_id\"], str(body.get(\"status\", \"\")))\n    return settled or payment, newly_paid\n\n\ndef callback_authentic(headers) -> bool:\n    \"\"\"Platega signs callbacks with our own merchant id and secret in the headers.\"\"\"\n    if not enabled():\n        return False\n    return (hmac.compare_digest(headers.get(\"X-MerchantId\", \"\"), MERCHANT_ID)\n            and hmac.compare_digest(headers.get(\"X-Secret\", \"\"), SECRET))\n\n\ndef paid_until_text(value: str | None) -> str:\n    from datetime import datetime\n    return datetime.fromisoformat(value).strftime(\"%d.%m.%Y\") if value else \"\"\n\n\ndef success_text(tg_id: int) -> str:\n    user = db.get_user(tg_id) or {}\n    return (f\"<b>✅ Оплата получена</b>\\\\n\\\\nДоступ к {BRAND_TITLE} продлён до \"\n            f\"<b>{paid_until_text(user.get('paid_until'))}</b>.\\\\nСпасибо!\")\n\n\nasync def notify(tg_id: int, text: str):\n    \"\"\"Message the user from the callback service (it has no bot instance of its own).\"\"\"\n    if not BOT_TOKEN:\n        return\n    try:\n        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=15)) as session:\n            await session.post(f\"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage\",\n                               json={\"chat_id\": tg_id, \"text\": text, \"parse_mode\": \"HTML\"})\n    except (aiohttp.ClientError, TimeoutError):\n        logger.warning(\"Could not notify user about a payment\")\n''')\n\n# ---------------------------------------------------------------- bot handlers\nopen('handlers/pay.py','w').write('''\"\"\"Paying for access: tariff choice → Platega payment page → confirmation (callback or «Проверить»).\"\"\"\nfrom aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\nimport database as db\nimport payments\nfrom navigation import show_card\n\nrouter = Router()\n\n\ndef kb(*rows):\n    return InlineKeyboardMarkup(inline_keyboard=[list(row) for row in rows])\n\n\ndef cb(text, data):\n    return InlineKeyboardButton(text=text, callback_data=data)\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\n@router.callback_query(F.data == \"pay\")\nasync def choose_tariff(callback: CallbackQuery):\n    if not payments.enabled():\n        await callback.answer(\"Оплата скоро появится.\", show_alert=True)\n        return\n    await callback.answer()\n    user = db.get_user(callback.from_user.id) or {}\n    text = \"<b>Оплата доступа</b>\\\\n\\\\nВыберите срок. В любой тариф входят все серверы и до 3 устройств.\"\n    if user.get(\"paid_until\"):\n        text += f\"\\\\n\\\\nСейчас доступ до <b>{payments.paid_until_text(user['paid_until'])}</b>, новый срок добавится к нему.\"\n    rows = [[cb(f\"{t['title']} — {price(t['price'])}\", f\"buy:{t['key']}\")] for t in payments.paid_tariffs()]\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\nasync def buy(callback: CallbackQuery):\n    plan = payments.tariff(callback.data.split(\":\", 1)[1])\n    if not plan or not payments.enabled():\n        await callback.answer(\"Выберите тариф заново.\", show_alert=True)\n        return\n    await callback.answer(\"Создаю ссылку на оплату…\")\n    try:\n        payment = await payments.create_link(callback.from_user.id, plan[\"key\"])\n    except payments.PaymentError:\n        await show_card(callback.message, \"help\", \"<b>Не удалось создать оплату</b>\\\\n\\\\nПопробуйте ещё раз через минуту.\",\n                        reply_markup=kb([cb(\"Попробовать снова\", callback.data)], [cb(\"💬 Поддержка\", \"doc_support\")],\n                                        [cb(\"‹ Назад\", \"pay\")]))\n        return\n    text = (f\"<b>Оплата · {plan['title']} · {price(plan['price'])}</b>\\\\n\\\\n\"\n            \"1. Нажмите «Оплатить» — откроется страница оплаты: СБП, карта или криптовалюта.\\\\n\"\n            \"2. После оплаты вернитесь сюда — доступ продлится автоматически.\\\\n\\\\n\"\n            \"Сообщение не пришло — нажмите «Проверить оплату».\\\\n\\\\n\"\n            \"<i>Ссылка действует 15 минут.</i>\")\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(\n        [InlineKeyboardButton(text=f\"💳 Оплатить {price(plan['price'])}\", url=payment[\"url\"])],\n        [cb(\"🔄 Проверить оплату\", f\"pay_check:{payment['id']}\")],\n        [cb(\"‹ Другой тариф\", \"pay\")]))\n\n\n@router.callback_query(F.data.startswith(\"pay_check:\"))\nasync def check(callback: CallbackQuery):\n    part = callback.data.split(\":\", 1)[1]\n    payment = db.get_payment(int(part)) if part.isdigit() else None\n    if not payment or payment[\"tg_id\"] != callback.from_user.id:\n        await callback.answer(\"Платёж не найден.\", show_alert=True)\n        return\n    try:\n        payment, _ = await payments.check(payment)\n    except payments.PaymentError:\n        await callback.answer(\"Не удалось проверить. Попробуйте через минуту.\", show_alert=True)\n        return\n    if payment[\"status\"] == \"paid\":\n        await callback.answer()\n        await show_card(callback.message, \"done\", payments.success_text(callback.from_user.id),\n                        reply_markup=kb([cb(\"Главное меню\", \"back_main\")]))\n    elif payment[\"status\"] in (\"canceled\", \"chargebacked\"):\n        await callback.answer()\n        await show_card(callback.message, \"help\", \"<b>Оплата не прошла</b>\\\\n\\\\nДеньги не списаны. Можно попробовать ещё раз.\",\n                        reply_markup=kb([cb(\"Попробовать снова\", f\"buy:{payment['tariff']}\")], [cb(\"‹ Назад\", \"pay\")]))\n    else:\n        await callback.answer(\"Оплата ещё не поступила. Если вы уже оплатили — подождите минуту и проверьте снова.\",\n                              show_alert=True)\n''')\n\n# ---------------------------------------------------------------- entry points\npatch('keyboards.py', [('''def docs_menu() -> InlineKeyboardMarkup:\n    return keyboard(\n        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],''', '''def docs_menu() -> InlineKeyboardMarkup:\n    import payments\n    pay = [[(\"💳 Оплатить доступ\", \"pay\")]] if payments.enabled() else []\n    return keyboard(\n        *pay,\n        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],'''),\n('''def docs_back() -> InlineKeyboardMarkup:\n    return keyboard([(\"‹ Документы и тарифы\", \"docs\"), (\"Главное меню\", \"back_main\")])''', '''def docs_back(pay: bool = False) -> InlineKeyboardMarkup:\n    import payments\n    rows = [[(\"💳 Оплатить доступ\", \"pay\")]] if pay and payments.enabled() else []\n    return keyboard(*rows, [(\"‹ Документы и тарифы\", \"docs\"), (\"Главное меню\", \"back_main\")])''')])\npatch('handlers/legal.py', [('''    await show_text(callback.message, SCREENS[callback.data](), parse_mode=ParseMode.HTML,\n                    reply_markup=docs_back(), disable_web_page_preview=True)''', '''    await show_text(callback.message, SCREENS[callback.data](), parse_mode=ParseMode.HTML,\n                    reply_markup=docs_back(pay=callback.data == \"doc_tariffs\"), disable_web_page_preview=True)''')])\npatch('legal.py', [('''автоматического продления нет. Кнопка оплаты находится в разделе «Профиль».''',\n                    '''автоматического продления нет. Кнопка «💳 Оплатить доступ» — в разделе «Тарифы и документы».''')])\npatch('bot.py', [('''    dp.include_router(legal.router)''', '''    dp.include_router(legal.router)\n    dp.include_router(pay.router)''')])\n\n# ---------------------------------------------------------------- callback endpoint\npatch('subscription.py', [('''async def handle_health(_request: web.Request) -> web.Response:''', '''async def handle_platega_callback(request: web.Request) -> web.Response:\n    \"\"\"Platega payment status (POST, JSON). Authenticated by our merchant id + secret in the headers.\"\"\"\n    import payments\n    if not payments.callback_authentic(request.headers):\n        logger.warning(\"Rejected unauthenticated payment callback\")\n        return web.Response(status=401, text=\"Unauthorized\")\n    try:\n        body = await request.json()\n        provider_id, status = str(body[\"id\"]), str(body[\"status\"])\n    except (ValueError, KeyError, TypeError):\n        return web.Response(status=400, text=\"Bad request\")\n    payment, newly_paid = request.app[DATABASE_KEY].settle_payment(provider_id, status)\n    logger.info(\"Payment callback %s -> %s\", status, payment[\"status\"] if payment else \"unknown payment\")\n    if newly_paid:\n        await payments.notify(payment[\"tg_id\"], payments.success_text(payment[\"tg_id\"]))\n    return web.Response(text=\"OK\")\n\n\nasync def handle_health(_request: web.Request) -> web.Response:'''),\n('''    app.router.add_get(\"/health\", handle_health)''', '''    app.router.add_get(\"/health\", handle_health)\n    app.router.add_post(\"/platega/callback\", handle_platega_callback)''')])\nprint('ok')\nEOF\ngrep -n \"^from handlers import\\|import .*legal\" bot.py","description":"Add Platega payments: database, client, bot screens and callback"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5129,"cache_read_input_tokens":552434,"output_tokens":6998,"output_tokens_details":{"thinking_tokens":166},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5129,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":6998,"cache_read_input_tokens":552434,"cache_creation_input_tokens":5129,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5129},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Q5an1uhswYyA5rANyxJbTf":{"command":"cd /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work && python3 - <<'EOF'\ndef patch(p, pairs):\n    s=open(p).read()\n    for old,new in pairs:\n        assert old in s, (p, old[:60]); s=s.replace(old,new,1)\n    open(p,'w').write(s)\n\n# ---------------------------------------------------------------- database\npatch('database.py', [\n('''            UNIQUE(tg_id, request_id)\n        );\n    \"\"\")''', '''            UNIQUE(tg_id, request_id)\n        );\n        CREATE TABLE IF NOT EXISTS payments (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            tg_id INTEGER NOT NULL,\n            tariff TEXT NOT NULL,\n            amount INTEGER NOT NULL,\n            days INTEGER NOT NULL,\n            provider TEXT NOT NULL DEFAULT 'platega',\n            provider_id TEXT UNIQUE,\n            status TEXT NOT NULL DEFAULT 'created',\n            created_at TEXT DEFAULT (datetime('now')),\n            paid_at TEXT\n        );\n    \"\"\")'''),\n('''        \"revoked_at\": \"TEXT\",\n    }''', '''        \"revoked_at\": \"TEXT\",\n        \"paid_until\": \"TEXT\",\n    }'''),\n])\ns=open('database.py').read()\ns += '''\n\n# ---------------------------------------------------------------- payments ------\ndef create_payment(tg_id: int, tariff: str, amount: int, days: int) -> int:\n    conn = get_db()\n    cursor = conn.execute(\n        \"INSERT INTO payments (tg_id, tariff, amount, days) VALUES (?, ?, ?, ?)\",\n        (tg_id, tariff, amount, days),\n    )\n    conn.commit()\n    conn.close()\n    return cursor.lastrowid\n\n\ndef set_payment_provider_id(payment_id: int, provider_id: str):\n    conn = get_db()\n    conn.execute(\"UPDATE payments SET provider_id = ?, status = 'pending' WHERE id = ?\", (provider_id, payment_id))\n    conn.commit()\n    conn.close()\n\n\ndef get_payment(payment_id: int) -> dict | None:\n    conn = get_db()\n    row = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (payment_id,)).fetchone()\n    conn.close()\n    return dict(row) if row else None\n\n\ndef settle_payment(provider_id: str, status: str) -> tuple[dict | None, bool]:\n    \"\"\"Apply a provider status idempotently. CONFIRMED extends paid_until once, from the later of\n    now and the current end; repeated or concurrent confirmations change nothing. Returns (payment, newly_paid).\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        row = conn.execute(\"SELECT * FROM payments WHERE provider_id = ?\", (provider_id,)).fetchone()\n        if not row:\n            conn.rollback()\n            return None, False\n        newly_paid = False\n        if status == \"CONFIRMED\" and row[\"status\"] != \"paid\":\n            now = datetime.utcnow().replace(microsecond=0)\n            user = conn.execute(\"SELECT paid_until FROM users WHERE tg_id = ?\", (row[\"tg_id\"],)).fetchone()\n            current = datetime.fromisoformat(user[\"paid_until\"]) if user and user[\"paid_until\"] else now\n            until = max(now, current) + timedelta(days=row[\"days\"])\n            conn.execute(\"UPDATE payments SET status = 'paid', paid_at = ? WHERE id = ?\", (now.isoformat(), row[\"id\"]))\n            conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), row[\"tg_id\"]))\n            newly_paid = True\n        elif status in (\"CANCELED\", \"CHARGEBACKED\") and row[\"status\"] != \"paid\":\n            conn.execute(\"UPDATE payments SET status = ? WHERE id = ?\", (status.lower(), row[\"id\"]))\n        conn.commit()\n        updated = conn.execute(\"SELECT * FROM payments WHERE id = ?\", (row[\"id\"],)).fetchone()\n        return dict(updated), newly_paid\n    finally:\n        conn.close()\n'''\ns=s.replace('from datetime import datetime\\n','from datetime import datetime, timedelta\\n',1)\nopen('database.py','w').write(s)\n\n# ---------------------------------------------------------------- payments module\nopen('payments.py','w').write('''\"\"\"Platega payments: a payment link per tariff, status checks and the provider callback.\n\nSecrets come from the environment (PLATEGA_MERCHANT_ID, PLATEGA_SECRET); without them payments\nare switched off and the bot hides the pay buttons. The provider decides the payment method on\nits own page (СБП, card, crypto). Access is extended only by database.settle_payment.\n\"\"\"\nfrom __future__ import annotations\n\nimport hmac\nimport logging\n\nimport aiohttp\n\nimport os\n\nimport database as db\nimport legal\nfrom config import BOT_TOKEN, BOT_USERNAME, BRAND_TITLE\n\nlogger = logging.getLogger(\"AuraVPN.payments\")\n\nBASE_URL = os.environ.get(\"PLATEGA_BASE_URL\", \"https://app.platega.io\").rstrip(\"/\")\nMERCHANT_ID = os.environ.get(\"PLATEGA_MERCHANT_ID\", \"\")\nSECRET = os.environ.get(\"PLATEGA_SECRET\", \"\")\nDAYS = {\"m1\": 30, \"m3\": 90, \"m12\": 365}\n\n\nclass PaymentError(Exception):\n    pass\n\n\ndef enabled() -> bool:\n    return bool(MERCHANT_ID and SECRET)\n\n\ndef paid_tariffs() -> list[dict]:\n    return [t for t in legal.TARIFFS if t[\"key\"] in DAYS]\n\n\ndef tariff(key: str) -> dict | None:\n    return next((t for t in paid_tariffs() if t[\"key\"] == key), None)\n\n\nasync def _request(method: str, path: str, payload: dict | None = None) -> dict:\n    headers = {\"X-MerchantId\": MERCHANT_ID, \"X-Secret\": SECRET, \"Content-Type\": \"application/json\"}\n    timeout = aiohttp.ClientTimeout(total=20)\n    try:\n        async with aiohttp.ClientSession(timeout=timeout) as session:\n            async with session.request(method, BASE_URL + path, json=payload, headers=headers) as response:\n                body = await response.json(content_type=None)\n                if response.status != 200:\n                    logger.error(\"Platega %s %s -> %s %s\", method, path, response.status,\n                                 (body or {}).get(\"code\") if isinstance(body, dict) else \"\")\n                    raise PaymentError(f\"HTTP {response.status}\")\n                return body\n    except (aiohttp.ClientError, TimeoutError, ValueError) as error:\n        raise PaymentError(str(error)) from error\n\n\nasync def create_link(tg_id: int, key: str) -> dict:\n    \"\"\"Create our payment row and a Platega transaction; returns the row with its payment url.\"\"\"\n    plan = tariff(key)\n    if not plan or not enabled():\n        raise PaymentError(\"payments are not available\")\n    payment_id = db.create_payment(tg_id, key, plan[\"price\"], DAYS[key])\n    back = f\"https://t.me/{BOT_USERNAME}\"\n    body = await _request(\"POST\", \"/v2/transaction/process\", {\n        \"paymentDetails\": {\"amount\": plan[\"price\"], \"currency\": \"RUB\"},\n        \"description\": f\"{BRAND_TITLE} · доступ на {plan['title'].lower()}\",\n        \"return\": back,\n        \"failedUrl\": back,\n        \"payload\": f\"payment:{payment_id}\",\n        \"orderId\": str(payment_id),\n        \"metadata\": {\"user_email\": f\"{tg_id}@telegram.org\", \"userId\": str(tg_id)},\n    })\n    if not body.get(\"transactionId\") or not str(body.get(\"url\", \"\")).startswith(\"https://\"):\n        raise PaymentError(\"unexpected response\")\n    db.set_payment_provider_id(payment_id, body[\"transactionId\"])\n    return {**db.get_payment(payment_id), \"url\": body[\"url\"]}\n\n\nasync def check(payment: dict) -> tuple[dict, bool]:\n    \"\"\"Ask Platega for the current status and apply it.\"\"\"\n    if payment[\"status\"] == \"paid\" or not payment.get(\"provider_id\"):\n        return payment, False\n    body = await _request(\"GET\", f\"/transaction/{payment['provider_id']}\")\n    settled, newly_paid = db.settle_payment(payment[\"provider_id\"], str(body.get(\"status\", \"\")))\n    return settled or payment, newly_paid\n\n\ndef callback_authentic(headers) -> bool:\n    \"\"\"Platega signs callbacks with our own merchant id and secret in the headers.\"\"\"\n    if not enabled():\n        return False\n    return (hmac.compare_digest(headers.get(\"X-MerchantId\", \"\"), MERCHANT_ID)\n            and hmac.compare_digest(headers.get(\"X-Secret\", \"\"), SECRET))\n\n\ndef paid_until_text(value: str | None) -> str:\n    from datetime import datetime\n    return datetime.fromisoformat(value).strftime(\"%d.%m.%Y\") if value else \"\"\n\n\ndef success_text(tg_id: int) -> str:\n    user = db.get_user(tg_id) or {}\n    return (f\"<b>✅ Оплата получена</b>\\\\n\\\\nДоступ к {BRAND_TITLE} продлён до \"\n            f\"<b>{paid_until_text(user.get('paid_until'))}</b>.\\\\nСпасибо!\")\n\n\nasync def notify(tg_id: int, text: str):\n    \"\"\"Message the user from the callback service (it has no bot instance of its own).\"\"\"\n    if not BOT_TOKEN:\n        return\n    try:\n        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=15)) as session:\n            await session.post(f\"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage\",\n                               json={\"chat_id\": tg_id, \"text\": text, \"parse_mode\": \"HTML\"})\n    except (aiohttp.ClientError, TimeoutError):\n        logger.warning(\"Could not notify user about a payment\")\n''')\n\n# ---------------------------------------------------------------- bot handlers\nopen('handlers/pay.py','w').write('''\"\"\"Paying for access: tariff choice → Platega payment page → confirmation (callback or «Проверить»).\"\"\"\nfrom aiogram import F, Router\nfrom aiogram.types import CallbackQuery, InlineKeyboardButton, InlineKeyboardMarkup\n\nimport database as db\nimport payments\nfrom navigation import show_card\n\nrouter = Router()\n\n\ndef kb(*rows):\n    return InlineKeyboardMarkup(inline_keyboard=[list(row) for row in rows])\n\n\ndef cb(text, data):\n    return InlineKeyboardButton(text=text, callback_data=data)\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\n@router.callback_query(F.data == \"pay\")\nasync def choose_tariff(callback: CallbackQuery):\n    if not payments.enabled():\n        await callback.answer(\"Оплата скоро появится.\", show_alert=True)\n        return\n    await callback.answer()\n    user = db.get_user(callback.from_user.id) or {}\n    text = \"<b>Оплата доступа</b>\\\\n\\\\nВыберите срок. В любой тариф входят все серверы и до 3 устройств.\"\n    if user.get(\"paid_until\"):\n        text += f\"\\\\n\\\\nСейчас доступ до <b>{payments.paid_until_text(user['paid_until'])}</b>, новый срок добавится к нему.\"\n    rows = [[cb(f\"{t['title']} — {price(t['price'])}\", f\"buy:{t['key']}\")] for t in payments.paid_tariffs()]\n    rows.append([cb(\"‹ Тарифы и документы\", \"docs\")])\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(*rows))\n\n\n@router.callback_query(F.data.startswith(\"buy:\"))\nasync def buy(callback: CallbackQuery):\n    plan = payments.tariff(callback.data.split(\":\", 1)[1])\n    if not plan or not payments.enabled():\n        await callback.answer(\"Выберите тариф заново.\", show_alert=True)\n        return\n    await callback.answer(\"Создаю ссылку на оплату…\")\n    try:\n        payment = await payments.create_link(callback.from_user.id, plan[\"key\"])\n    except payments.PaymentError:\n        await show_card(callback.message, \"help\", \"<b>Не удалось создать оплату</b>\\\\n\\\\nПопробуйте ещё раз через минуту.\",\n                        reply_markup=kb([cb(\"Попробовать снова\", callback.data)], [cb(\"💬 Поддержка\", \"doc_support\")],\n                                        [cb(\"‹ Назад\", \"pay\")]))\n        return\n    text = (f\"<b>Оплата · {plan['title']} · {price(plan['price'])}</b>\\\\n\\\\n\"\n            \"1. Нажмите «Оплатить» — откроется страница оплаты: СБП, карта или криптовалюта.\\\\n\"\n            \"2. После оплаты вернитесь сюда — доступ продлится автоматически.\\\\n\\\\n\"\n            \"Сообщение не пришло — нажмите «Проверить оплату».\\\\n\\\\n\"\n            \"<i>Ссылка действует 15 минут.</i>\")\n    await show_card(callback.message, \"docs\", text, reply_markup=kb(\n        [InlineKeyboardButton(text=f\"💳 Оплатить {price(plan['price'])}\", url=payment[\"url\"])],\n        [cb(\"🔄 Проверить оплату\", f\"pay_check:{payment['id']}\")],\n        [cb(\"‹ Другой тариф\", \"pay\")]))\n\n\n@router.callback_query(F.data.startswith(\"pay_check:\"))\nasync def check(callback: CallbackQuery):\n    part = callback.data.split(\":\", 1)[1]\n    payment = db.get_payment(int(part)) if part.isdigit() else None\n    if not payment or payment[\"tg_id\"] != callback.from_user.id:\n        await callback.answer(\"Платёж не найден.\", show_alert=True)\n        return\n    try:\n        payment, _ = await payments.check(payment)\n    except payments.PaymentError:\n        await callback.answer(\"Не удалось проверить. Попробуйте через минуту.\", show_alert=True)\n        return\n    if payment[\"status\"] == \"paid\":\n        await callback.answer()\n        await show_card(callback.message, \"done\", payments.success_text(callback.from_user.id),\n                        reply_markup=kb([cb(\"Главное меню\", \"back_main\")]))\n    elif payment[\"status\"] in (\"canceled\", \"chargebacked\"):\n        await callback.answer()\n        await show_card(callback.message, \"help\", \"<b>Оплата не прошла</b>\\\\n\\\\nДеньги не списаны. Можно попробовать ещё раз.\",\n                        reply_markup=kb([cb(\"Попробовать снова\", f\"buy:{payment['tariff']}\")], [cb(\"‹ Назад\", \"pay\")]))\n    else:\n        await callback.answer(\"Оплата ещё не поступила. Если вы уже оплатили — подождите минуту и проверьте снова.\",\n                              show_alert=True)\n''')\n\n# ---------------------------------------------------------------- entry points\npatch('keyboards.py', [('''def docs_menu() -> InlineKeyboardMarkup:\n    return keyboard(\n        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],''', '''def docs_menu() -> InlineKeyboardMarkup:\n    import payments\n    pay = [[(\"💳 Оплатить доступ\", \"pay\")]] if payments.enabled() else []\n    return keyboard(\n        *pay,\n        [(\"Тарифы\", \"doc_tariffs\"), (\"Поддержка\", \"doc_support\")],'''),\n('''def docs_back() -> InlineKeyboardMarkup:\n    return keyboard([(\"‹ Документы и тарифы\", \"docs\"), (\"Главное меню\", \"back_main\")])''', '''def docs_back(pay: bool = False) -> InlineKeyboardMarkup:\n    import payments\n    rows = [[(\"💳 Оплатить доступ\", \"pay\")]] if pay and payments.enabled() else []\n    return keyboard(*rows, [(\"‹ Документы и тарифы\", \"docs\"), (\"Главное меню\", \"back_main\")])''')])\npatch('handlers/legal.py', [('''    await show_text(callback.message, SCREENS[callback.data](), parse_mode=ParseMode.HTML,\n                    reply_markup=docs_back(), disable_web_page_preview=True)''', '''    await show_text(callback.message, SCREENS[callback.data](), parse_mode=ParseMode.HTML,\n                    reply_markup=docs_back(pay=callback.data == \"doc_tariffs\"), disable_web_page_preview=True)''')])\npatch('legal.py', [('''автоматического продления нет. Кнопка оплаты находится в разделе «Профиль».''',\n                    '''автоматического продления нет. Кнопка «💳 Оплатить доступ» — в разделе «Тарифы и документы».''')])\npatch('bot.py', [('''    dp.include_router(legal.router)''', '''    dp.include_router(legal.router)\n    dp.include_router(pay.router)''')])\n\n# ---------------------------------------------------------------- callback endpoint\npatch('subscription.py', [('''async def handle_health(_request: web.Request) -> web.Response:''', '''async def handle_platega_callback(request: web.Request) -> web.Response:\n    \"\"\"Platega payment status (POST, JSON). Authenticated by our merchant id + secret in the headers.\"\"\"\n    import payments\n    if not payments.callback_authentic(request.headers):\n        logger.warning(\"Rejected unauthenticated payment callback\")\n        return web.Response(status=401, text=\"Unauthorized\")\n    try:\n        body = await request.json()\n        provider_id, status = str(body[\"id\"]), str(body[\"status\"])\n    except (ValueError, KeyError, TypeError):\n        return web.Response(status=400, text=\"Bad request\")\n    payment, newly_paid = request.app[DATABASE_KEY].settle_payment(provider_id, status)\n    logger.info(\"Payment callback %s -> %s\", status, payment[\"status\"] if payment else \"unknown payment\")\n    if newly_paid:\n        await payments.notify(payment[\"tg_id\"], payments.success_text(payment[\"tg_id\"]))\n    return web.Response(text=\"OK\")\n\n\nasync def handle_health(_request: web.Request) -> web.Response:'''),\n('''    app.router.add_get(\"/health\", handle_health)''', '''    app.router.add_get(\"/health\", handle_health)\n    app.router.add_post(\"/platega/callback\", handle_platega_callback)''')])\nprint('ok')\nEOF\ngrep -n \"^from handlers import\\|import .*legal\" bot.py","description":"Add Platega payments: database, client, bot screens and callback"}},"serverClassifierRequest":"0e7c787f-c79f-4f94-bdca-15420c3f6db3","apiBlockIndex":3,"requestId":"req_011Cgb2obvLDURPCodwuRZuA","requestRef":"f81872b0-82bc-4201-be79-19d8605ce6e2","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"79149173-26f6-4120-a661-1deb295fb0d7","timestamp":"2026-10-31T21:34:36.206Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
