{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"260df7a09c09f11fce948b575b2a05cf31ebc99a1669159dfe1786d4cc89dc8e","message":{"role":"user","content":[{"tool_use_id":"toolu_01XfMjQxnbssDjY3ZkGvnyNV","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"Безопасно вписать ключ ElevenLabs в .env: ввод скрыт, ключ нигде не печатается.\"\"\"\nimport getpass\nimport re\nimport sys\nfrom pathlib import Path\n\nimport requests\n\nENV = Path(__file__).resolve().parent.parent / \".env\"\n\ndef ask_dialog():\n    import subprocess\n    script = ('display dialog \"Вставьте ключ ElevenLabs (Cmd+V) и нажмите OK\" '\n              'default answer \"\" with hidden answer with title \"Ключ ElevenLabs\" '\n              'buttons {\"Отмена\", \"OK\"} default button \"OK\"')\n    r = subprocess.run([\"osascript\", \"-e\", script], capture_output=True, text=True)\n    if r.returncode != 0:\n        sys.exit(\"Ввод отменён. Ничего не изменено.\")\n    out = r.stdout.strip()\n    return out.split(\"text returned:\", 1)[1] if \"text returned:\" in out else \"\"\n\n\nif \"--dialog\" in sys.argv:\n    key = ask_dialog().strip()\nelse:\n    key = getpass.getpass(\"Вставьте ключ ElevenLabs (символы не видны) и нажмите Enter: \").strip()\nif not key or len(key) < 20 or any(c.isspace() for c in key):\n    sys.exit(\"Похоже, это не ключ. Ничего не изменено.\")\n\ndef check(url):\n    r = requests.get(url, headers={\"xi-api-key\": key}, timeout=30)\n    reason = \"\"\n    if r.status_code != 200:\n        try:\n            det = r.json().get(\"detail\", {})\n            reason = det.get(\"status\") or det.get(\"code\") or \"\"\n            msg = det.get(\"message\", \"\")\n            reason = f\"{reason}: {msg}\" if msg else reason\n        except Exception:  # noqa: BLE001\n===\n32:MARINE_VOICE_FILE = ROOT / \"data/voices/marine_clone_src/marine_voice_id.txt\"\n37:VOICE_DIR = WORK / \"voice\"\n39:for d in (WORK, TMP, PORTRAIT_DIR, VOICE_DIR, LIPSYNC_DIR):\n192:    out = VOICE_DIR / f\"{name}.mp3\"\n195:    voice_id = MARINE_VOICE_FILE.read_text().strip()\n196:    if not voice_id:\n202:        voice_id=voice_id, text=ANI_TEXT, model_id=\"eleven_v3\",\n309:    parts = split_audio(audio_path, VOICE_DIR / \"split\")\n===\nelevenlabs 2.43.0\n/opt/homebrew/bin/ffmpeg\nPIL 12.2.0\n/dev/disk3s3s1   456Gi    13Gi   8.1Gi    61%    484k   85M    1%   /","is_error":false}]}}
