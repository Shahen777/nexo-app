{"type":"api-request","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","id":"f81872b0-82bc-4201-be79-19d8605ce6e2","timestamp":"2026-10-31T21:33:43.559Z","version":"2.1.309","querySource":"sdk","shapeHash":"62ee3ee963602fb1a5d4a6c639f1c0c9e6e7a15e6298490c1d6ca0c8f51d5556","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","thinking-token-count-2026-05-13","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","dangerous-tool-use-2026-09-03","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","afk-mode-2026-01-31","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"high"}},"base":"c286b446-de2d-4a40-af6f-b5f88cbaf7ce","keep":583,"tail":["94aec928e198d456e8e1cf929a5c2c0cf7ebebda44750bcaa4ab7382cb9c237b","69b54f5a77abd67e55fc687ba6bf7730cef7efa4cb730fb374dd5b33cf2eef94","ee10f41f54ebcceb05c8d76c0c496f7fb466048be6c11d28bbec76ce3adf6c7b"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",585,"content",0],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"646061d9c4833a8fcc99e7831c75ed895a32188ab88a2ca37ee4aa6419a909ef"}
