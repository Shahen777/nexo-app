on nexo-bot; sleep 4\nsystemctl is-active nexo-bot nexo-subscription; curl -s -o /dev/null -w \"health %{http_code}\\n\" https://152.53.50.204:8444/health\nsudo -n journalctl -u nexo-bot -u nexo-subscription --since \"-1 min\" --no-pager | grep -iE \"error|traceback\" || echo \"no errors\"\nrm -f /tmp/nexo-ox2.tgz'","description":"Deploy, commit and restart bot services"},"caller":{"type":"direct"}}]}}
