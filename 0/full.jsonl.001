{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"edc17d354e5a38b8a342dfe5d0f7e330ee24dea695183414101edbe667497d6d","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_01CS8oj6Bcm7J3LGb4kwF8cA","name":"Bash","input":{"command":"cd \"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory\" && python3 - <<'EOF'\np='build_nexo_karing.py'; s=open(p).read()\ns=s.replace('SRC, VOICE, TMP = P / \"src\", P / \"voice\", P / \"tmp\"', 'SRC, VOICE, TMP = P / \"src\", P / (sys.argv[1] if len(sys.argv) > 1 else \"voice_v2\"), P / \"tmp\"')\n# ring pop-in\nold='''        pulse = (math.sin((t - start) * 4.5) + 1) / 2\n        r = 58 + 18 * pulse'''\nnew='''        pulse = (math.sin((t - start) * 4.5) + 1) / 2\n        pop = min(1, (t - start) / 0.25)\n        pop = 1 + 0.6 * (1 - pop) * (1 - pop)      # starts big, settles quickly\n        r = (58 + 18 * pulse) * pop'''\nassert old in s; s=s.replace(old,new)\n# caption slide-up\nold='''    hgt = 60 * len(lines) + 56\n    y0 = H - 110 - hgt'''\nnew='''    hgt = 60 * len(lines) + 56\n    ease = 1 - (1 - min(1, t / 0.45)) ** 3\n    y0 = H - 110 - hgt + int(90 * (1 - ease))'''\nassert old in s; s=s.replace(old,new)\n# shorter fades, livelier push-in\ns=s.replace('zoom = 1 + 0.035 * min(1, t / T)       # slow push-in','zoom = 1 + 0.05 * (1 - (1 - min(1, t / T)) ** 2)   # push-in, eases out')\ns=s.replace('k = min(1, t / 0.35, (s[\"dur\"] - t) / 0.35)','k = min(1, t / 0.22, (s[\"dur\"] - t) / 0.22)')\ns=s.replace('s[\"dur\"] = dur(VOICE / f\"{s[\\'voice\\']}.mp3\") + s[\"pad\"] + 0.35','s[\"dur\"] = dur(VOICE / f\"{s[\\'voice\\']}.mp3\") + s[\"pad\"] + 0.25')\ns=s.replace('audio_parts.append((t0 + 0.35, VOICE / f\"{s[\\'voice\\']}.mp3\"))','audio_parts.append((t0 + 0.25, VOICE / f\"{s[\\'voice\\']}.mp3\"))')\n# snappier pads\ns=s.replace('pad=0.6)','pad=0.45)')\nopen(p,'w').write(s); print('patched')\nEOF\npython3 build_nexo_karing.py voice_v2 2>&1 | tail -2","description":"Add livelier motion and rebuild the video with the new voice","timeout":600000},"caller":{"type":"direct"}}]}}
