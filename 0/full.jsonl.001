{"parentUuid":"f331119c-e264-4b08-874d-56b95e308c44","isSidechain":false,"promptId":"a18293c7-dac5-4674-bb63-7408d16f626f","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kbpq1yBz88YXJf5AZ3RBTy","type":"tool_result","content":"\"\"\"Authenticated Karing subscription and installation HTTP service.\"\"\"\n\nfrom __future__ import annotations\n\nimport html\nimport logging\nimport os\nimport re\nimport ssl\nfrom collections.abc import Callable\n\nfrom aiohttp import web\n\nimport database as default_database\nfrom config import BRAND_TITLE\nfrom vpn_service import Node, build_karing_deep_link, build_subscription_payload\nfrom happ_client import build_native_subscription, install_page, routing_link, client_install_page, CLIENT_IMPORT_SCHEME\nimport nexo_client\n\nlogger = logging.getLogger(\"AuraVPN.subscription\")\n\nDATABASE_KEY = web.AppKey(\"database\", object)\nNODE_PROVIDER_KEY = web.AppKey(\"node_provider\", object)\nPUBLIC_BASE_URL_KEY = web.AppKey(\"public_base_url\", str)\nDEVICE_CLIENT_FACTORY_KEY = web.AppKey('device_client_factory', object)\n\n\n        self.token = REDACTED\n        self.nodes = [\n            Node(\"vienna\", \"Vienna\", \"203.0.113.10\", 443, \"pk1\", \"sid1\", \"one.example\"),\n            Node(\"brazil\", \"Brazil\", \"203.0.113.20\", 443, \"pk2\", \"sid2\", \"two.example\"),\n        ]\n\n        import subscription\n        self.subscription = importlib.reload(subscription)\n        app = self.subscription.create_app(\n            database_module=self.db,\n            node_provider=lambda: self.nodes,\n            public_base_url=\"https://vpn.example:8443\",\n        )\n        self.client = TestClient(TestServer(app))\n        await self.client.start_server()\n\n    async def asyncTearDown(self):\n        await self.client.close()\n        self.tempdir.cleanup()\n        if self.previous_env is None:\n            os.environ.pop('AURA_DB_PATH', None)\n        else:\n            os.environ['AURA_DB_PATH'] = self.previous_env\n        if self.previous_path is not None:\n            self.db.DB_PATH = self.previous_path\n\n    async def test_valid_random_token_returns_subscription(self):\n        response = await self.client.get(f\"/sub/{self.token}\")\n        self.assertEqual(response.status, 200)\n        decoded = base64.b64decode(await response.text()).decode()\n        self.assertIn(\"@203.0.113.10:443\", decoded)\n        self.assertIn(\"@203.0.113.20:443\", decoded)\n        self.assertEqual(response.headers[\"profile-title\"], \"Aura VPN\")\n        self.assertIn(\"upload=\", response.headers[\"subscription-userinfo\"])\n\n    async def test_unlimited_subscription_does_not_publish_unix_epoch_expiry(self):\n        response = await self.client.get(f\"/sub/{self.token}\")\n\n        userinfo = response.headers[\"subscription-userinfo\"]\n        self.assertNotIn(\"expire=0\", userinfo)\n        self.assertNotIn(\"total=0\", userinfo)\n        user = self.web_users()[0]\n        conn = db.get_db()\n        conn.execute(\"UPDATE users SET paid_until = NULL WHERE tg_id = ?\", (user[\"tg_id\"],))\n        conn.commit()\n        conn.close()\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn(\"Без срока\", text)\n        self.assertNotIn(\"Не активен\", text)\n        self.assertNotIn(\"Срок доступа закончился\", text)\n        self.assertIn(\"Добавить ключ в Karing\", text)\n\n\nclass NexoProfileTests(WebCabinetTests):\n    async def test_nexo_profile_has_servers_auto_choice_rules_and_expiry(self):\n        await self.start()\n        user = self.web_users()[0]\n        token = db.list_devices(user[\"tg_id\"])[0][\"token\"]\n        response = await self.client.get(f\"/nexo/sub/{token}\")\n        text = await response.text()\n        self.assertEqual(response.status, 200)\n        self.assertEqual(response.content_type, \"text/yaml\")\n        self.assertIn('\"type\": \"url-test\"', text)\n        self.assertIn('\"MATCH,Nexo\"', text)\n        self.assertIn('\"DOMAIN-SUFFIX,gosuslugi.ru,DIRECT\"', text)\n        self.assertEqual(text.count('\"type\": \"vless\"'), 2)\n        self.assertRegex(response.headers[\"subscription-userinfo\"], r\"expire=\\d{10}\")\n\n    async def test_unknown_token_has_no_nexo_profile(self):\n        response = await self.client.get(\"/nexo/sub/\" + \"x\" * 43)\n        self.assertEqual(response.status, 404)\n\n428:def key_pass(user, active_count):\n429-    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n430-    until = payments.active_until(user)\n431-    limit = user.get(\"device_limit\") or 3\n432-    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n433-    if not user.get(\"paid_until\"):  # accounts from before the paid period have no end date\n434-        body = (f'{head}<span class=\"state on\">Активен</span></div><p class=\"label\">Доступ</p>'\n435-                '<div class=\"big\">Без срока</div><div class=\"sub\">Ваш доступ не ограничен по времени.</div>'\n436-                '<div class=\"meter\"><i style=\"width:100%\"></i></div>')\n437-    elif until:\n438-        days = days_left(until)\n439-        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n440-        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n441-                f'<div class=\"big\">{day_month(until)}</div>'\n442-                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n443-                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n444-    else:\n130:.chip.off i{background:#FF9CA8}.chip.soon i{background:#FFC46B}\n159:.state{display:inline-flex;align-items:center;gap:6px;letter-spacing:.02em;text-transform:none;font-size:13px}\n160:.state::before{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}\n161:.state.on{color:var(--green)}.state.off{color:var(--red)}.state.soon{color:var(--amber)}\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]},"uuid":"176444c0-f58a-4973-acf5-819111d5162a","timestamp":"2026-11-05T22:56:09.926Z","toolUseResult":{"stdout":"\"\"\"Authenticated Karing subscription and installation HTTP service.\"\"\"\n\nfrom __future__ import annotations\n\nimport html\nimport logging\nimport os\nimport re\nimport ssl\nfrom collections.abc import Callable\n\nfrom aiohttp import web\n\nimport database as default_database\nfrom config import BRAND_TITLE\nfrom vpn_service import Node, build_karing_deep_link, build_subscription_payload\nfrom happ_client import build_native_subscription, install_page, routing_link, client_install_page, CLIENT_IMPORT_SCHEME\nimport nexo_client\n\nlogger = logging.getLogger(\"AuraVPN.subscription\")\n\nDATABASE_KEY = web.AppKey(\"database\", object)\nNODE_PROVIDER_KEY = web.AppKey(\"node_provider\", object)\nPUBLIC_BASE_URL_KEY = web.AppKey(\"public_base_url\", str)\nDEVICE_CLIENT_FACTORY_KEY = web.AppKey('device_client_factory', object)\n\n\n        self.token = REDACTED\n        self.nodes = [\n            Node(\"vienna\", \"Vienna\", \"203.0.113.10\", 443, \"pk1\", \"sid1\", \"one.example\"),\n            Node(\"brazil\", \"Brazil\", \"203.0.113.20\", 443, \"pk2\", \"sid2\", \"two.example\"),\n        ]\n\n        import subscription\n        self.subscription = importlib.reload(subscription)\n        app = self.subscription.create_app(\n            database_module=self.db,\n            node_provider=lambda: self.nodes,\n            public_base_url=\"https://vpn.example:8443\",\n        )\n        self.client = TestClient(TestServer(app))\n        await self.client.start_server()\n\n    async def asyncTearDown(self):\n        await self.client.close()\n        self.tempdir.cleanup()\n        if self.previous_env is None:\n            os.environ.pop('AURA_DB_PATH', None)\n        else:\n            os.environ['AURA_DB_PATH'] = self.previous_env\n        if self.previous_path is not None:\n            self.db.DB_PATH = self.previous_path\n\n    async def test_valid_random_token_returns_subscription(self):\n        response = await self.client.get(f\"/sub/{self.token}\")\n        self.assertEqual(response.status, 200)\n        decoded = base64.b64decode(await response.text()).decode()\n        self.assertIn(\"@203.0.113.10:443\", decoded)\n        self.assertIn(\"@203.0.113.20:443\", decoded)\n        self.assertEqual(response.headers[\"profile-title\"], \"Aura VPN\")\n        self.assertIn(\"upload=\", response.headers[\"subscription-userinfo\"])\n\n    async def test_unlimited_subscription_does_not_publish_unix_epoch_expiry(self):\n        response = await self.client.get(f\"/sub/{self.token}\")\n\n        userinfo = response.headers[\"subscription-userinfo\"]\n        self.assertNotIn(\"expire=0\", userinfo)\n        self.assertNotIn(\"total=0\", userinfo)\n        user = self.web_users()[0]\n        conn = db.get_db()\n        conn.execute(\"UPDATE users SET paid_until = NULL WHERE tg_id = ?\", (user[\"tg_id\"],))\n        conn.commit()\n        conn.close()\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn(\"Без срока\", text)\n        self.assertNotIn(\"Не активен\", text)\n        self.assertNotIn(\"Срок доступа закончился\", text)\n        self.assertIn(\"Добавить ключ в Karing\", text)\n\n\nclass NexoProfileTests(WebCabinetTests):\n    async def test_nexo_profile_has_servers_auto_choice_rules_and_expiry(self):\n        await self.start()\n        user = self.web_users()[0]\n        token = db.list_devices(user[\"tg_id\"])[0][\"token\"]\n        response = await self.client.get(f\"/nexo/sub/{token}\")\n        text = await response.text()\n        self.assertEqual(response.status, 200)\n        self.assertEqual(response.content_type, \"text/yaml\")\n        self.assertIn('\"type\": \"url-test\"', text)\n        self.assertIn('\"MATCH,Nexo\"', text)\n        self.assertIn('\"DOMAIN-SUFFIX,gosuslugi.ru,DIRECT\"', text)\n        self.assertEqual(text.count('\"type\": \"vless\"'), 2)\n        self.assertRegex(response.headers[\"subscription-userinfo\"], r\"expire=\\d{10}\")\n\n    async def test_unknown_token_has_no_nexo_profile(self):\n        response = await self.client.get(\"/nexo/sub/\" + \"x\" * 43)\n        self.assertEqual(response.status, 404)\n\n428:def key_pass(user, active_count):\n429-    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n430-    until = payments.active_until(user)\n431-    limit = user.get(\"device_limit\") or 3\n432-    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n433-    if not user.get(\"paid_until\"):  # accounts from before the paid period have no end date\n434-        body = (f'{head}<span class=\"state on\">Активен</span></div><p class=\"label\">Доступ</p>'\n435-                '<div class=\"big\">Без срока</div><div class=\"sub\">Ваш доступ не ограничен по времени.</div>'\n436-                '<div class=\"meter\"><i style=\"width:100%\"></i></div>')\n437-    elif until:\n438-        days = days_left(until)\n439-        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n440-        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n441-                f'<div class=\"big\">{day_month(until)}</div>'\n442-                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n443-                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n444-    else:\n130:.chip.off i{background:#FF9