{"parentUuid":"a35d1c05-9b7b-4845-bce7-44f265e14fdd","isSidechain":false,"promptId":"11a21958-d1af-4d83-8084-add45a119cfa","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EgCNCBiqzJra9kFAMxEU4e","type":"tool_result","content":[{"type":"text","text":"Plan updated: step 2 of 5 is in progress."}]}]},"uuid":"8ad59d1a-92a6-4822-9a8d-61c6069f1ad4","timestamp":"2026-11-02T13:00:15.821Z","toolUseResult":[{"type":"text","text":"Plan updated: step 2 of 5 is in progress."}],"sourceToolAssistantUUID":"a35d1c05-9b7b-4845-bce7-44f265e14fdd","permissionDecision":{"decision":"accept","source":"config","reasonType":"rule","ruleSource":"cliArg"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"8ad59d1a-92a6-4822-9a8d-61c6069f1ad4","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cge9G5jr2mzcfih9dazTm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ENRUY6rk67tGrZYV4wZ9FV","name":"Write","input":{"file_path":"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/webapp.py","content":"\"\"\"Web cabinet without Telegram: start a trial, connect a device and pay — all from a personal link.\n\nIn Russia Telegram itself needs a working VPN, so the first connection must be possible from a\nplain browser. A web account is an ordinary users row with a negative synthetic tg_id (Telegram ids\nare positive), so devices, subscriptions and payments work exactly as for bot users. The personal\nlink /c/<web_token> is the only credential; a cookie keeps it so /app reopens the cabinet.\n\"\"\"\nfrom __future__ import annotations\n\nimport html\nimport os\nimport secrets\nimport time\n\nfrom aiohttp import web\n\nimport catalog\nimport legal\nimport payments\nfrom config import BOT_USERNAME, BRAND_TITLE, PLATFORMS\nfrom device_service import DeviceError, DeviceService\nfrom happ_client import client_import_url, happ_install_url\nfrom vpn_service import build_karing_deep_link\n\nCOOKIE = \"nexo_cabinet\"\nTRIAL_DAYS = 7\nSTARTS_PER_IP = 3                     # a day; mobile networks share one address between many people\nWEB_PLATFORMS = ((\"ios\", \"iPhone\"), (\"android\", \"Android\"), (\"macos\", \"Mac\"), (\"windows\", \"Windows\"))\nASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"assets\")\n_starts: dict[str, list[float]] = {}\n\n\ndef _keys():\n    import subscription  # the app keys live there; imported late to avoid a cycle\n    return subscription\n\n\ndef detect_platform(user_agent: str) -> str | None:\n    ua = user_agent or \"\"\n    if \"iPhone\" in ua or \"iPad\" in ua:\n        return \"ios\"\n    if \"Android\" in ua:\n        return \"android\"\n    if \"Windows\" in ua:\n        return \"windows\"\n    if \"Macintosh\" in ua:\n        return \"macos\"\n    return None\n\n\ndef _allowed_start(ip: str) -> bool:\n    now = time.time()\n    recent = [t for t in _starts.get(ip, []) if now - t < 86400]\n    if len(recent) >= STARTS_PER_IP:\n        _starts[ip] = recent\n        return False\n    _starts[ip] = recent + [now]\n    return True\n\n\ndef import_link(app, platform, row, base):\n    \"\"\"One-tap «add key» link for the app, or None when the app has no importer.\"\"\"\n    install = f\"{base}/install/{row['token']}\"\n    if app.importer == \"happ\":\n        return happ_install_url(install)\n    if app.importer == \"xray\":\n        return client_import_url(install, app.key)\n    if app.importer == \"karing\":\n        return build_karing_deep_link(f\"{base}/sub/{row['token']}\")\n    return None\n\n\n# ---------------------------------------------------------------- page shell ----\nSTYLE = \"\"\"\n:root{color-scheme:dark}*{box-sizing:border-box}\nbody{margin:0;background:#081222;color:#edf3ff;font:17px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:560px;margin:0 auto;padding:28px 18px 64px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;letter-spacing:.02em}\n.logo img{width:36px;height:36px;border-radius:9px}\n.pill{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;background:#12305a;color:#9cc0ff}\n.pill.ok{background:#0f3d2c;color:#7ee2a8}.pill.off{background:#4a1620;color:#ffb3bf}\nh1{font-size:30px;line-height:1.15;margin:8px 0 12px;letter-spacing:-.02em}h2{font-size:20px;margin:0 0 10px}\np{margin:8px 0;color:#c4d3ee}small,.muted{color:#8ea3c4;font-size:14px}\n.card{background:#0f1f38;border:1px solid #20365a;border-radius:20px;padding:20px;margin:16px 0}\n.btn{display:block;width:100%;text-align:center;border:0;border-radius:16px;padding:16px;margin:10px 0;\n font:700 17px/1.2 inherit;font-family:inherit;color:#fff;background:#2f6bff;text-decoration:none;cursor:pointer}\n.btn.alt{background:#18304f;color:#d8e5ff}.btn.small{padding:12px;font-size:15px}\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 4px}.tabs a{flex:1;text-align:center;padding:10px 6px;border-radius:12px;\n background:#13284a;color:#b9cbea;text-decoration:none;font-weight:600;font-size:15px}.tabs a.on{background:#2f6bff;color:#fff}\n.step{display:flex;gap:12px;margin:14px 0}.num{flex:none;width:30px;height:30px;border-radius:50%;background:#2f6bff;\n display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px}\n.note{background:#132a4c;border-radius:14px;padding:12px 14px;font-size:15px;color:#cfe0ff}\n.flash{background:#0f3d2c;color:#c9f5dc;border-radius:14px;padding:12px 14px;margin:12px 0}.flash.err{background:#4a1620;color:#ffd5dc}\nvideo{width:100%;border-radius:16px;margin-top:8px;background:#000}\na{color:#9cc0ff}form{margin:0}footer{margin-top:26px;font-size:14px;color:#8ea3c4}footer a{margin-right:12px}\ncode{word-break:break-all;font-size:13px;color:#cfe0ff}\n\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#081222\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body><main>{body}</main></body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io\",\n        **(headers or {})})\n\n\ndef logo(pill=\"\"):\n    return (f'<div class=\"top\"><div class=\"logo\"><img src=\"/web/icon.png\" alt=\"\">{html.escape(BRAND_TITLE)}</div>{pill}</div>')\n\n\nFOOTER = ('<footer><a href=\"/docs/tariffs\">Тарифы</a><a href=\"/docs/terms\">Соглашение</a>'\n          '<a href=\"/docs/privacy\">Конфиденциальность</a><a href=\"/docs/support\">Поддержка</a></footer>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    body = (logo() + f\"<h1>Защищённое соединение для телефона и компьютера</h1>\"\n            f\"<p>Подключение за пару минут — прямо с этой страницы, без регистрации.</p>\"\n            f'<div class=\"card\"><h2>{TRIAL_DAYS} дней бесплатно</h2>'\n            \"<p>Все серверы, до 3 устройств. Банки и Госуслуги работают напрямую, без переключений.</p>\"\n            '<form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + device if device else \"\"}</button></form>'\n            '<small>Вы получите личную ссылку на кабинет — сохраните её.</small></div>'\n            '<div class=\"card\"><h2>Уже подключались?</h2><p>Откройте свою личную ссылку на кабинет — '\n            'её выдали при первом подключении.</p></div>' + FOOTER)\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", logo() + \"<h1>Слишком много попыток</h1>\"\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или с другой сети.</p>\",\n                    status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\"))\n\n\nasync def _create_device(request, tg_id, platform):\n    keys = _keys()\n    service = DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()),\n                            client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n    try:\n        return await service.create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment)\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">✅ Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Готово! Это ваш личный кабинет. Сохраните ссылку на него — '\n                  'кнопка «Скопировать ссылку» ниже.</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Не удалось создать ключ. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Не удалось создать оплату. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    pill = (f'<span class=\"pill ok\">Доступ до {until:%d.%m.%Y}</span>' if until else\n            '<span class=\"pill off\">Доступ закончился</span>')\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    tabs = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}\">{label}</a>' for key, label in WEB_PLATFORMS)\n\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n\n    steps = f'<div class=\"card\"><h2>Подключить устройство</h2><div class=\"tabs\">{tabs}</div>'\n    if platform == \"ios\":\n        steps += ('<p class=\"muted\" style=\"margin-top:14px\">Ваш App Store:</p><div class=\"tabs\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru\">🇷🇺 Российский</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other\">🌍 Другой страны</a></div>'\n                  '<small>Если цены в App Store в рублях — российский.</small>')\n    if not device:\n        steps += (f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\">'\n                  f'<button class=\"btn\">Создать ключ для {html.escape(dict(WEB_PLATFORMS)[platform])}</button></form>')\n    else:\n        link = import_link(app, platform, device, base)\n        steps += (f'<div class=\"step\"><div class=\"num\">1</div><div><b>Установите {app.name}</b>'\n                  f'<a class=\"btn small\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            steps += '<div class=\"note\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        steps += '</div></div>'\n        if link:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ</b>'\n                      f'<a class=\"btn small\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<small>Приложение откроется само и спросит подтверждение.</small></div></div>')\n        else:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ по ссылке</b><br>'\n                      f'<code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></div>')\n        steps += (f'<div class=\"step\"><div class=\"num\">3</div><div><b>Включите</b><br>'\n                  f'{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</div></div>')\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            steps += f'<p class=\"muted\">Видео: как это сделать</p><video src=\"/media/{video}\" controls playsinline preload=\"none\"></video>'\n        for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []):\n            steps += (f'<a class=\"btn alt small\" href=\"?p={platform}&store={store}&app={key}\">{html.escape(label)}</a>')\n    steps += \"</div>\"\n\n    pay = '<div class=\"card\"><h2>Оплата</h2>'\n    if payments.enabled():\n        pay += '<p>Новый срок добавляется к оставшемуся.</p>'\n        for t in payments.paid_tariffs():\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\">'\n                    f'<button class=\"btn alt small\">{t[\"title\"]} — {t[\"price\"]} ₽</button></form>')\n        pay += '<small>СБП, карта или криптовалюта. Автоматического продления нет.</small>'\n    else:\n        pay += '<p>Оплата скоро появится.</p>'\n    pay += \"</div>\"\n\n    link = f\"{base}/c/{token}\"\n    save = ('<div class=\"card\"><h2>Ваш личный кабинет</h2><p>По этой ссылке вы всегда вернётесь сюда. '\n            'Сохраните её в заметки или добавьте страницу на экран «Домой».</p>'\n            f'<button class=\"btn alt small\" onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано ✓\\')\">Скопировать ссылку</button>'\n            '<small>iPhone: «Поделиться» → «На экран „Домой“». Никому не пересылайте эту ссылку.</small></div>')\n    tg = ('<div class=\"card\"><h2>Telegram</h2><p>Когда VPN включится, откроется и Telegram — там наш бот '\n          f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> с подсказками и поддержкой.</p></div>')\n    body = logo(pill) + flash + steps + pay + save + tg + FOOTER\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))\n\n\nasync def handle_pay(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    key = request.query.get(\"tariff\", \"\")\n    try:\n        created = await payments.create_link(user[\"tg_id\"], key, return_url=f\"{base}/c/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\n# ---------------------------------------------------------------- documents & files\nDOCS = {\"terms\": legal.terms_text, \"privacy\": legal.privacy_text, \"tariffs\": legal.tariffs_text, \"support\": legal.support_text}\n\n\nasync def handle_doc(request):\n    render = DOCS.get(request.match_info.get(\"name\", \"\"))\n    if not render:\n        raise web.HTTPNotFound(text=\"Not found\")\n    text = render().replace(\"\\n\", \"<br>\")  # the bot texts use Telegram HTML: <b>, <i>, <code>, <a>\n    return page(BRAND_TITLE, logo() + f'<div class=\"card\">{text}</div><a class=\"btn alt small\" href=\"/app\">‹ Назад</a>')\n\n\nasync def handle_media(request):\n    name = request.match_info.get(\"name\", \"\")\n    allowed = {v for apps in catalog.VIDEOS.values() for v in apps.values()}\n    path = os.path.join(ASSETS, \"video\", name)\n    if name not in allowed or not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=86400\"})\n\n\nasync def handle_icon(_request):\n    path = os.path.join(ASSETS, \"web\", \"icon.png\")\n    if not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=604800\"})\n\n\nasync def handle_manifest(_request):\n    return web.json_response({\"name\": BRAND_TITLE, \"short_name\": BRAND_TITLE, \"start_url\": \"/app\", \"display\": \"standalone\",\n                              \"background_color\": \"#081222\", \"theme_color\": \"#081222\",\n                              \"icons\": [{\"src\": \"/web/icon.png\", \"sizes\": \"512x512\", \"type\": \"image/png\"}]},\n                             content_type=\"application/manifest+json\")\n\n\ndef add_routes(app):\n    app.router.add_get(\"/app\", handle_landing)\n    app.router.add_post(\"/app/start\", handle_start)\n    app.router.add_get(\"/c/{token}\", handle_cabinet)\n    app.router.add_post(\"/c/{token}/device\", handle_device)\n    app.router.add_post(\"/c/{token}/pay\", handle_pay)\n    app.router.add_get(\"/docs/{name}\", handle_doc)\n    app.router.add_get(\"/media/{name}\", handle_media)\n    app.router.add_get(\"/web/icon.png\", handle_icon)\n    app.router.add_get(\"/web/manifest.webmanifest\", handle_manifest)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8658,"cache_read_input_tokens":657473,"output_tokens":8315,"output_tokens_details":{"thinking_tokens":282},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8658,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8315,"cache_read_input_tokens":657473,"cache_creation_input_tokens":8658,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8658},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01ENRUY6rk67tGrZYV4wZ9FV":{"file_path":"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/webapp.py","content":"\"\"\"Web cabinet without Telegram: start a trial, connect a device and pay — all from a personal link.\n\nIn Russia Telegram itself needs a working VPN, so the first connection must be possible from a\nplain browser. A web account is an ordinary users row with a negative synthetic tg_id (Telegram ids\nare positive), so devices, subscriptions and payments work exactly as for bot users. The personal\nlink /c/<web_token> is the only credential; a cookie keeps it so /app reopens the cabinet.\n\"\"\"\nfrom __future__ import annotations\n\nimport html\nimport os\nimport secrets\nimport time\n\nfrom aiohttp import web\n\nimport catalog\nimport legal\nimport payments\nfrom config import BOT_USERNAME, BRAND_TITLE, PLATFORMS\nfrom device_service import DeviceError, DeviceService\nfrom happ_client import client_import_url, happ_install_url\nfrom vpn_service import build_karing_deep_link\n\nCOOKIE = \"nexo_cabinet\"\nTRIAL_DAYS = 7\nSTARTS_PER_IP = 3                     # a day; mobile networks share one address between many people\nWEB_PLATFORMS = ((\"ios\", \"iPhone\"), (\"android\", \"Android\"), (\"macos\", \"Mac\"), (\"windows\", \"Windows\"))\nASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"assets\")\n_starts: dict[str, list[float]] = {}\n\n\ndef _keys():\n    import subscription  # the app keys live there; imported late to avoid a cycle\n    return subscription\n\n\ndef detect_platform(user_agent: str) -> str | None:\n    ua = user_agent or \"\"\n    if \"iPhone\" in ua or \"iPad\" in ua:\n        return \"ios\"\n    if \"Android\" in ua:\n        return \"android\"\n    if \"Windows\" in ua:\n        return \"windows\"\n    if \"Macintosh\" in ua:\n        return \"macos\"\n    return None\n\n\ndef _allowed_start(ip: str) -> bool:\n    now = time.time()\n    recent = [t for t in _starts.get(ip, []) if now - t < 86400]\n    if len(recent) >= STARTS_PER_IP:\n        _starts[ip] = recent\n        return False\n    _starts[ip] = recent + [now]\n    return True\n\n\ndef import_link(app, platform, row, base):\n    \"\"\"One-tap «add key» link for the app, or None when the app has no importer.\"\"\"\n    install = f\"{base}/install/{row['token']}\"\n    if app.importer == \"happ\":\n        return happ_install_url(install)\n    if app.importer == \"xray\":\n        return client_import_url(install, app.key)\n    if app.importer == \"karing\":\n        return build_karing_deep_link(f\"{base}/sub/{row['token']}\")\n    return None\n\n\n# ---------------------------------------------------------------- page shell ----\nSTYLE = \"\"\"\n:root{color-scheme:dark}*{box-sizing:border-box}\nbody{margin:0;background:#081222;color:#edf3ff;font:17px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:560px;margin:0 auto;padding:28px 18px 64px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;letter-spacing:.02em}\n.logo img{width:36px;height:36px;border-radius:9px}\n.pill{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;background:#12305a;color:#9cc0ff}\n.pill.ok{background:#0f3d2c;color:#7ee2a8}.pill.off{background:#4a1620;color:#ffb3bf}\nh1{font-size:30px;line-height:1.15;margin:8px 0 12px;letter-spacing:-.02em}h2{font-size:20px;margin:0 0 10px}\np{margin:8px 0;color:#c4d3ee}small,.muted{color:#8ea3c4;font-size:14px}\n.card{background:#0f1f38;border:1px solid #20365a;border-radius:20px;padding:20px;margin:16px 0}\n.btn{display:block;width:100%;text-align:center;border:0;border-radius:16px;padding:16px;margin:10px 0;\n font:700 17px/1.2 inherit;font-family:inherit;color:#fff;background:#2f6bff;text-decoration:none;cursor:pointer}\n.btn.alt{background:#18304f;color:#d8e5ff}.btn.small{padding:12px;font-size:15px}\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 4px}.tabs a{flex:1;text-align:center;padding:10px 6px;border-radius:12px;\n background:#13284a;color:#b9cbea;text-decoration:none;font-weight:600;font-size:15px}.tabs a.on{background:#2f6bff;color:#fff}\n.step{display:flex;gap:12px;margin:14px 0}.num{flex:none;width:30px;height:30px;border-radius:50%;background:#2f6bff;\n display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px}\n.note{background:#132a4c;border-radius:14px;padding:12px 14px;font-size:15px;color:#cfe0ff}\n.flash{background:#0f3d2c;color:#c9f5dc;border-radius:14px;padding:12px 14px;margin:12px 0}.flash.err{background:#4a1620;color:#ffd5dc}\nvideo{width:100%;border-radius:16px;margin-top:8px;background:#000}\na{color:#9cc0ff}form{margin:0}footer{margin-top:26px;font-size:14px;color:#8ea3c4}footer a{margin-right:12px}\ncode{word-break:break-all;font-size:13px;color:#cfe0ff}\n\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#081222\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body><main>{body}</main></body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io\",\n        **(headers or {})})\n\n\ndef logo(pill=\"\"):\n    return (f'<div class=\"top\"><div class=\"logo\"><img src=\"/web/icon.png\" alt=\"\">{html.escape(BRAND_TITLE)}</div>{pill}</div>')\n\n\nFOOTER = ('<footer><a href=\"/docs/tariffs\">Тарифы</a><a href=\"/docs/terms\">Соглашение</a>'\n          '<a href=\"/docs/privacy\">Конфиденциальность</a><a href=\"/docs/support\">Поддержка</a></footer>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    body = (logo() + f\"<h1>Защищённое соединение для телефона и компьютера</h1>\"\n            f\"<p>Подключение за пару минут — прямо с этой страницы, без регистрации.</p>\"\n            f'<div class=\"card\"><h2>{TRIAL_DAYS} дней бесплатно</h2>'\n            \"<p>Все серверы, до 3 устройств. Банки и Госуслуги работают напрямую, без переключений.</p>\"\n            '<form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + device if device else \"\"}</button></form>'\n            '<small>Вы получите личную ссылку на кабинет — сохраните её.</small></div>'\n            '<div class=\"card\"><h2>Уже подключались?</h2><p>Откройте свою личную ссылку на кабинет — '\n            'её выдали при первом подключении.</p></div>' + FOOTER)\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", logo() + \"<h1>Слишком много попыток</h1>\"\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или с другой сети.</p>\",\n                    status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\"))\n\n\nasync def _create_device(request, tg_id, platform):\n    keys = _keys()\n    service = DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()),\n                            client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n    try:\n        return await service.create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment)\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">✅ Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Готово! Это ваш личный кабинет. Сохраните ссылку на него — '\n                  'кнопка «Скопировать ссылку» ниже.</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Не удалось создать ключ. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Не удалось создать оплату. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    pill = (f'<span class=\"pill ok\">Доступ до {until:%d.%m.%Y}</span>' if until else\n            '<span class=\"pill off\">Доступ закончился</span>')\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    tabs = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}\">{label}</a>' for key, label in WEB_PLATFORMS)\n\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n\n    steps = f'<div class=\"card\"><h2>Подключить устройство</h2><div class=\"tabs\">{tabs}</div>'\n    if platform == \"ios\":\n        steps += ('<p class=\"muted\" style=\"margin-top:14px\">Ваш App Store:</p><div class=\"tabs\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru\">🇷🇺 Российский</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other\">🌍 Другой страны</a></div>'\n                  '<small>Если цены в App Store в рублях — российский.</small>')\n    if not device:\n        steps += (f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\">'\n                  f'<button class=\"btn\">Создать ключ для {html.escape(dict(WEB_PLATFORMS)[platform])}</button></form>')\n    else:\n        link = import_link(app, platform, device, base)\n        steps += (f'<div class=\"step\"><div class=\"num\">1</div><div><b>Установите {app.name}</b>'\n                  f'<a class=\"btn small\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            steps += '<div class=\"note\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        steps += '</div></div>'\n        if link:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ</b>'\n                      f'<a class=\"btn small\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<small>Приложение откроется само и спросит подтверждение.</small></div></div>')\n        else:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ по ссылке</b><br>'\n                      f'<code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></div>')\n        steps += (f'<div class=\"step\"><div class=\"num\">3</div><div><b>Включите</b><br>'\n                  f'{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</div></div>')\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            steps += f'<p class=\"muted\">Видео: как это сделать</p><video src=\"/media/{video}\" controls playsinline preload=\"none\"></video>'\n        for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []):\n            steps += (f'<a class=\"btn alt small\" href=\"?p={platform}&store={store}&app={key}\">{html.escape(label)}</a>')\n    steps += \"</div>\"\n\n    pay = '<div class=\"card\"><h2>Оплата</h2>'\n    if payments.enabled():\n        pay += '<p>Новый срок добавляется к оставшемуся.</p>'\n        for t in payments.paid_tariffs():\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\">'\n                    f'<button class=\"btn alt small\">{t[\"title\"]} — {t[\"price\"]} ₽</button></form>')\n        pay += '<small>СБП, карта или криптовалюта. Автоматического продления нет.</small>'\n    else:\n        pay += '<p>Оплата скоро появится.</p>'\n    pay += \"</div>\"\n\n    link = f\"{base}/c/{token}\"\n    save = ('<div class=\"card\"><h2>Ваш личный кабинет</h2><p>По этой ссылке вы всегда вернётесь сюда. '\n            'Сохраните её в заметки или добавьте страницу на экран «Домой».</p>'\n            f'<button class=\"btn alt small\" onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано ✓\\')\">Скопировать ссылку</button>'\n            '<small>iPhone: «Поделиться» → «На экран „Домой“». Никому не пересылайте эту ссылку.</small></div>')\n    tg = ('<div class=\"card\"><h2>Telegram</h2><p>Когда VPN включится, откроется и Telegram — там наш бот '\n          f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> с подсказками и поддержкой.</p></div>')\n    body = logo(pill) + flash + steps + pay + save + tg + FOOTER\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))\n\n\nasync def handle_pay(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    key = request.query.get(\"tariff\", \"\")\n    try:\n        created = await payments.create_link(user[\"tg_id\"], key, return_url=f\"{base}/c/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\n# ---------------------------------------------------------------- documents & files\nDOCS = {\"terms\": legal.terms_text, \"privacy\": legal.privacy_text, \"tariffs\": legal.tariffs_text, \"support\": legal.support_text}\n\n\nasync def handle_doc(request):\n    render = DOCS.get(request.match_info.get(\"name\", \"\"))\n    if not render:\n        raise web.HTTPNotFound(text=\"Not found\")\n    text = render().replace(\"\\n\", \"<br>\")  # the bot texts use Telegram HTML: <b>, <i>, <code>, <a>\n    return page(BRAND_TITLE, logo() + f'<div class=\"card\">{text}</div><a class=\"btn alt small\" href=\"/app\">‹ Назад</a>')\n\n\nasync def handle_media(request):\n    name = request.match_info.get(\"name\", \"\")\n    allowed = {v for apps in catalog.VIDEOS.values() for v in apps.values()}\n    path = os.path.join(ASSETS, \"video\", name)\n    if name not in allowed or not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=86400\"})\n\n\nasync def handle_icon(_request):\n    path = os.path.join(ASSETS, \"web\", \"icon.png\")\n    if not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=604800\"})\n\n\nasync def handle_manifest(_request):\n    return web.json_response({\"name\": BRAND_TITLE, \"short_name\": BRAND_TITLE, \"start_url\": \"/app\", \"display\": \"standalone\",\n                              \"background_color\": \"#081222\", \"theme_color\": \"#081222\",\n                              \"icons\": [{\"src\": \"/web/icon.png\", \"sizes\": \"512x512\", \"type\": \"image/png\"}]},\n                             content_type=\"application/manifest+json\")\n\n\ndef add_routes(app):\n    app.router.add_get(\"/app\", handle_landing)\n    app.router.add_post(\"/app/start\", handle_start)\n    app.router.add_get(\"/c/{token}\", handle_cabinet)\n    app.router.add_post(\"/c/{token}/device\", handle_device)\n    app.router.add_post(\"/c/{token}/pay\", handle_pay)\n    app.router.add_get(\"/docs/{name}\", handle_doc)\n    app.router.add_get(\"/media/{name}\", handle_media)\n    app.router.add_get(\"/web/icon.png\", handle_icon)\n    app.router.add_get(\"/web/manifest.webmanifest\", handle_manifest)\n"}},"serverClassifierRequest":"d49ddbb6-b997-4e68-b217-65079605894b","apiBlockIndex":3,"requestId":"req_011Cge9G5J3qEZU2JpsP7oty","requestRef":"1a5e6aee-4032-42eb-9a26-3c7c573adce1","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"81d84aad-cd74-4924-99dd-665bfdb82034","timestamp":"2026-11-02T13:01:15.531Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"81d84aad-cd74-4924-99dd-665bfdb82034","isSidechain":false,"promptId":"11a21958-d1af-4d83-8084-add45a119cfa","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ENRUY6rk67tGrZYV4wZ9FV","type":"tool_result","content":"File created successfully at: /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/webapp.py (file state is current in your context — no need to Read it back)"}]},"uuid":"6a1c0719-11d5-4076-aa57-5c2be1aa2988","timestamp":"2026-11-02T13:01:15.563Z","toolUseResult":{"type":"create","filePath":"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/webapp.py","content":"\"\"\"Web cabinet without Telegram: start a trial, connect a device and pay — all from a personal link.\n\nIn Russia Telegram itself needs a working VPN, so the first connection must be possible from a\nplain browser. A web account is an ordinary users row with a negative synthetic tg_id (Telegram ids\nare positive), so devices, subscriptions and payments work exactly as for bot users. The personal\nlink /c/<web_token> is the only credential; a cookie keeps it so /app reopens the cabinet.\n\"\"\"\nfrom __future__ import annotations\n\nimport html\nimport os\nimport secrets\nimport time\n\nfrom aiohttp import web\n\nimport catalog\nimport legal\nimport payments\nfrom config import BOT_USERNAME, BRAND_TITLE, PLATFORMS\nfrom device_service import DeviceError, DeviceService\nfrom happ_client import client_import_url, happ_install_url\nfrom vpn_service import build_karing_deep_link\n\nCOOKIE = \"nexo_cabinet\"\nTRIAL_DAYS = 7\nSTARTS_PER_IP = 3                     # a day; mobile networks share one address between many people\nWEB_PLATFORMS = ((\"ios\", \"iPhone\"), (\"android\", \"Android\"), (\"macos\", \"Mac\"), (\"windows\", \"Windows\"))\nASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"assets\")\n_starts: dict[str, list[float]] = {}\n\n\ndef _keys():\n    import subscription  # the app keys live there; imported late to avoid a cycle\n    return subscription\n\n\ndef detect_platform(user_agent: str) -> str | None:\n    ua = user_agent or \"\"\n    if \"iPhone\" in ua or \"iPad\" in ua:\n        return \"ios\"\n    if \"Android\" in ua:\n        return \"android\"\n    if \"Windows\" in ua:\n        return \"windows\"\n    if \"Macintosh\" in ua:\n        return \"macos\"\n    return None\n\n\ndef _allowed_start(ip: str) -> bool:\n    now = time.time()\n    recent = [t for t in _starts.get(ip, []) if now - t < 86400]\n    if len(recent) >= STARTS_PER_IP:\n        _starts[ip] = recent\n        return False\n    _starts[ip] = recent + [now]\n    return True\n\n\ndef import_link(app, platform, row, base):\n    \"\"\"One-tap «add key» link for the app, or None when the app has no importer.\"\"\"\n    install = f\"{base}/install/{row['token']}\"\n    if app.importer == \"happ\":\n        return happ_install_url(install)\n    if app.importer == \"xray\":\n        return client_import_url(install, app.key)\n    if app.importer == \"karing\":\n        return build_karing_deep_link(f\"{base}/sub/{row['token']}\")\n    return None\n\n\n# ---------------------------------------------------------------- page shell ----\nSTYLE = \"\"\"\n:root{color-scheme:dark}*{box-sizing:border-box}\nbody{margin:0;background:#081222;color:#edf3ff;font:17px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:560px;margin:0 auto;padding:28px 18px 64px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;letter-spacing:.02em}\n.logo img{width:36px;height:36px;border-radius:9px}\n.pill{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;background:#12305a;color:#9cc0ff}\n.pill.ok{background:#0f3d2c;color:#7ee2a8}.pill.off{background:#4a1620;color:#ffb3bf}\nh1{font-size:30px;line-height:1.15;margin:8px 0 12px;letter-spacing:-.02em}h2{font-size:20px;margin:0 0 10px}\np{margin:8px 0;color:#c4d3ee}small,.muted{color:#8ea3c4;font-size:14px}\n.card{background:#0f1f38;border:1px solid #20365a;border-radius:20px;padding:20px;margin:16px 0}\n.btn{display:block;width:100%;text-align:center;border:0;border-radius:16px;padding:16px;margin:10px 0;\n font:700 17px/1.2 inherit;font-family:inherit;color:#fff;background:#2f6bff;text-decoration:none;cursor:pointer}\n.btn.alt{background:#18304f;color:#d8e5ff}.btn.small{padding:12px;font-size:15px}\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 4px}.tabs a{flex:1;text-align:center;padding:10px 6px;border-radius:12px;\n background:#13284a;color:#b9cbea;text-decoration:none;font-weight:600;font-size:15px}.tabs a.on{background:#2f6bff;color:#fff}\n.step{display:flex;gap:12px;margin:14px 0}.num{flex:none;width:30px;height:30px;border-radius:50%;background:#2f6bff;\n display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px}\n.note{background:#132a4c;border-radius:14px;padding:12px 14px;font-size:15px;color:#cfe0ff}\n.flash{background:#0f3d2c;color:#c9f5dc;border-radius:14px;padding:12px 14px;margin:12px 0}.flash.err{background:#4a1620;color:#ffd5dc}\nvideo{width:100%;border-radius:16px;margin-top:8px;background:#000}\na{color:#9cc0ff}form{margin:0}footer{margin-top:26px;font-size:14px;color:#8ea3c4}footer a{margin-right:12px}\ncode{word-break:break-all;font-size:13px;color:#cfe0ff}\n\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#081222\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body><main>{body}</main></body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io\",\n        **(headers or {})})\n\n\ndef logo(pill=\"\"):\n    return (f'<div class=\"top\"><div class=\"logo\"><img src=\"/web/icon.png\" alt=\"\">{html.escape(BRAND_TITLE)}</div>{pill}</div>')\n\n\nFOOTER = ('<footer><a href=\"/docs/tariffs\">Тарифы</a><a href=\"/docs/terms\">Соглашение</a>'\n          '<a href=\"/docs/privacy\">Конфиденциальность</a><a href=\"/docs/support\">Поддержка</a></footer>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    body = (logo() + f\"<h1>Защищённое соединение для телефона и компьютера</h1>\"\n            f\"<p>Подключение за пару минут — прямо с этой страницы, без регистрации.</p>\"\n            f'<div class=\"card\"><h2>{TRIAL_DAYS} дней бесплатно</h2>'\n            \"<p>Все серверы, до 3 устройств. Банки и Госуслуги работают напрямую, без переключений.</p>\"\n            '<form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + device if device else \"\"}</button></form>'\n            '<small>Вы получите личную ссылку на кабинет — сохраните её.</small></div>'\n            '<div class=\"card\"><h2>Уже подключались?</h2><p>Откройте свою личную ссылку на кабинет — '\n            'её выдали при первом подключении.</p></div>' + FOOTER)\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", logo() + \"<h1>Слишком много попыток</h1>\"\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или с другой сети.</p>\",\n                    status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\"))\n\n\nasync def _create_device(request, tg_id, platform):\n    keys = _keys()\n    service = DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()),\n                            client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n    try:\n        return await service.create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment)\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">✅ Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Готово! Это ваш личный кабинет. Сохраните ссылку на него — '\n                  'кнопка «Скопировать ссылку» ниже.</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Не удалось создать ключ. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Не удалось создать оплату. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    pill = (f'<span class=\"pill ok\">Доступ до {until:%d.%m.%Y}</span>' if until else\n            '<span class=\"pill off\">Доступ закончился</span>')\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    tabs = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}\">{label}</a>' for key, label in WEB_PLATFORMS)\n\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n\n    steps = f'<div class=\"card\"><h2>Подключить устройство</h2><div class=\"tabs\">{tabs}</div>'\n    if platform == \"ios\":\n        steps += ('<p class=\"muted\" style=\"margin-top:14px\">Ваш App Store:</p><div class=\"tabs\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru\">🇷🇺 Российский</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other\">🌍 Другой страны</a></div>'\n                  '<small>Если цены в App Store в рублях — российский.</small>')\n    if not device:\n        steps += (f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\">'\n                  f'<button class=\"btn\">Создать ключ для {html.escape(dict(WEB_PLATFORMS)[platform])}</button></form>')\n    else:\n        link = import_link(app, platform, device, base)\n        steps += (f'<div class=\"step\"><div class=\"num\">1</div><div><b>Установите {app.name}</b>'\n                  f'<a class=\"btn small\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            steps += '<div class=\"note\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        steps += '</div></div>'\n        if link:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ</b>'\n                      f'<a class=\"btn small\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<small>Приложение откроется само и спросит подтверждение.</small></div></div>')\n        else:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ по ссылке</b><br>'\n                      f'<code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></div>')\n        steps += (f'<div class=\"step\"><div class=\"num\">3</div><div><b>Включите</b><br>'\n                  f'{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</div></div>')\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            steps += f'<p class=\"muted\">Видео: как это сделать</p><video src=\"/media/{video}\" controls playsinline preload=\"none\"></video>'\n        for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []):\n            steps += (f'<a class=\"btn alt small\" href=\"?p={platform}&store={store}&app={key}\">{html.escape(label)}</a>')\n    steps += \"</div>\"\n\n    pay = '<div class=\"card\"><h2>Оплата</h2>'\n    if payments.enabled():\n        pay += '<p>Новый срок добавляется к оставшемуся.</p>'\n        for t in payments.paid_tariffs():\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\">'\n                    f'<button class=\"btn alt small\">{t[\"title\"]} — {t[\"price\"]} ₽</button></form>')\n        pay += '<small>СБП, карта или криптовалюта. Автоматического продления нет.</small>'\n    else:\n        pay += '<p>Оплата скоро появится.</p>'\n    pay += \"</div>\"\n\n    link = f\"{base}/c/{token}\"\n    save = ('<div class=\"card\"><h2>Ваш личный кабинет</h2><p>По этой ссылке вы всегда вернётесь сюда. '\n            'Сохраните её в заметки или добавьте страницу на экран «Домой».</p>'\n            f'<button class=\"btn alt small\" onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано ✓\\')\">Скопировать ссылку</button>'\n            '<small>iPhone: «Поделиться» → «На экран „Домой“». Никому не пересылайте эту ссылку.</small></div>')\n    tg = ('<div class=\"card\"><h2>Telegram</h2><p>Когда VPN включится, откроется и Telegram — там наш бот '\n          f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> с подсказками и поддержкой.</p></div>')\n    body = logo(pill) + flash + steps + pay + save + tg + FOOTER\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))\n\n\nasync def handle_pay(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    key = request.query.get(\"tariff\", \"\")\n    try:\n        created = await payments.create_link(user[\"tg_id\"], key, return_url=f\"{base}/c/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\n# ---------------------------------------------------------------- documents & files\nDOCS = {\"terms\": legal.terms_text, \"privacy\": legal.privacy_text, \"tariffs\": legal.tariffs_text, \"support\": legal.support_text}\n\n\nasync def handle_doc(request):\n    render = DOCS.get(request.match_info.get(\"name\", \"\"))\n    if not render:\n        raise web.HTTPNotFound(text=\"Not found\")\n    text = render().replace(\"\\n\", \"<br>\")  # the bot texts use Telegram HTML: <b>, <i>, <code>, <a>\n    return page(BRAND_TITLE, logo() + f'<div class=\"card\">{text}</div><a class=\"btn alt small\" href=\"/app\">‹ Назад</a>')\n\n\nasync def handle_media(request):\n    name = request.match_info.get(\"name\", \"\")\n    allowed = {v for apps in catalog.VIDEOS.values() for v in apps.values()}\n    path = os.path.join(ASSETS, \"video\", name)\n    if name not in allowed or not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=86400\"})\n\n\nasync def handle_icon(_request):\n    path = os.path.join(ASSETS, \"web\", \"icon.png\")\n    if not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=604800\"})\n\n\nasync def handle_manifest(_request):\n    return web.json_response({\"name\": BRAND_TITLE, \"short_name\": BRAND_TITLE, \"start_url\": \"/app\", \"display\": \"standalone\",\n                              \"background_color\": \"#081222\", \"theme_color\": \"#081222\",\n                              \"icons\": [{\"src\": \"/web/icon.png\", \"sizes\": \"512x512\", \"type\": \"image/png\"}]},\n                             content_type=\"application/manifest+json\")\n\n\ndef add_routes(app):\n    app.router.add_get(\"/app\", handle_landing)\n    app.router.add_post(\"/app/start\", handle_start)\n    app.router.add_get(\"/c/{token}\", handle_cabinet)\n    app.router.add_post(\"/c/{token}/device\", handle_device)\n    app.router.add_post(\"/c/{token}/pay\", handle_pay)\n    app.router.add_get(\"/docs/{name}\", handle_doc)\n    app.router.add_get(\"/media/{name}\", handle_media)\n    app.router.add_get(\"/web/icon.png\", handle_icon)\n    app.router.add_get(\"/web/manifest.webmanifest\", handle_manifest)\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"81d84aad-cd74-4924-99dd-665bfdb82034","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"6a1c0719-11d5-4076-aa57-5c2be1aa2988","isSidechain":false,"attachment":{"type":"async_hook_response","processId":"async_hook_72094","hookName":"PostToolUse:Bash","hookEvent":"PostToolUse","toolName":"Bash","response":{},"stdout":"","stderr":"","exitCode":1},"type":"attachment","uuid":"d3c2b1c7-6949-491c-aa36-ab99dc0b00a9","timestamp":"2026-11-02T13:01:17.871Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"d3c2b1c7-6949-491c-aa36-ab99dc0b00a9","isSidechain":false,"attachment":{"type":"async_hook_response","processId":"async_hook_72103","hookName":"PostToolUse:mcp__ccd_turn__update_plan","hookEvent":"PostToolUse","toolName":"mcp__ccd_turn__update_plan","response":{},"stdout":"","stderr":"","exitCode":1},"type":"attachment","uuid":"c8b88aa7-77d2-4ca7-82dd-d2261c04bafa","timestamp":"2026-11-02T13:01:17.872Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"parentUuid":"c8b88aa7-77d2-4ca7-82dd-d2261c04bafa","isSidechain":false,"attachment":{"type":"async_hook_response","processId":"async_hook_72147","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","toolName":"Write","response":{},"stdout":"","stderr":"","exitCode":1},"type":"attachment","uuid":"fe9e3405-7ad2-4342-b44c-e0b78406c44d","timestamp":"2026-11-02T13:01:17.872Z","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"0177308bdebbf41954113f6eb23c48eea5928fcbae4b97e5bed24a4e42d723ef","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"thinking","thinking":"Я пишу веб-кабинет для господина Шагена: страницу, где можно начать пробный период, подключить телефон и оплатить без Telegram.\n\n","signature":""},{"type":"tool_use","id":"toolu_01EgCNCBiqzJra9kFAMxEU4e","name":"mcp__ccd_turn__update_plan","input":{"done":[1],"start":2},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01ENRUY6rk67tGrZYV4wZ9FV","name":"Write","input":{"file_path":"/private/tmp/claude-501/-Users-Sagenkazaran-Library-Application-Support-Claude-scratch-workspaces-f907b165-4712-485f-a44b-7f7d54b74cf9-77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5-scratch-2026-10-26-b13584/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work/webapp.py","content":"\"\"\"Web cabinet without Telegram: start a trial, connect a device and pay — all from a personal link.\n\nIn Russia Telegram itself needs a working VPN, so the first connection must be possible from a\nplain browser. A web account is an ordinary users row with a negative synthetic tg_id (Telegram ids\nare positive), so devices, subscriptions and payments work exactly as for bot users. The personal\nlink /c/<web_token> is the only credential; a cookie keeps it so /app reopens the cabinet.\n\"\"\"\nfrom __future__ import annotations\n\nimport html\nimport os\nimport secrets\nimport time\n\nfrom aiohttp import web\n\nimport catalog\nimport legal\nimport payments\nfrom config import BOT_USERNAME, BRAND_TITLE, PLATFORMS\nfrom device_service import DeviceError, DeviceService\nfrom happ_client import client_import_url, happ_install_url\nfrom vpn_service import build_karing_deep_link\n\nCOOKIE = \"nexo_cabinet\"\nTRIAL_DAYS = 7\nSTARTS_PER_IP = 3                     # a day; mobile networks share one address between many people\nWEB_PLATFORMS = ((\"ios\", \"iPhone\"), (\"android\", \"Android\"), (\"macos\", \"Mac\"), (\"windows\", \"Windows\"))\nASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"assets\")\n_starts: dict[str, list[float]] = {}\n\n\ndef _keys():\n    import subscription  # the app keys live there; imported late to avoid a cycle\n    return subscription\n\n\ndef detect_platform(user_agent: str) -> str | None:\n    ua = user_agent or \"\"\n    if \"iPhone\" in ua or \"iPad\" in ua:\n        return \"ios\"\n    if \"Android\" in ua:\n        return \"android\"\n    if \"Windows\" in ua:\n        return \"windows\"\n    if \"Macintosh\" in ua:\n        return \"macos\"\n    return None\n\n\ndef _allowed_start(ip: str) -> bool:\n    now = time.time()\n    recent = [t for t in _starts.get(ip, []) if now - t < 86400]\n    if len(recent) >= STARTS_PER_IP:\n        _starts[ip] = recent\n        return False\n    _starts[ip] = recent + [now]\n    return True\n\n\ndef import_link(app, platform, row, base):\n    \"\"\"One-tap «add key» link for the app, or None when the app has no importer.\"\"\"\n    install = f\"{base}/install/{row['token']}\"\n    if app.importer == \"happ\":\n        return happ_install_url(install)\n    if app.importer == \"xray\":\n        return client_import_url(install, app.key)\n    if app.importer == \"karing\":\n        return build_karing_deep_link(f\"{base}/sub/{row['token']}\")\n    return None\n\n\n# ---------------------------------------------------------------- page shell ----\nSTYLE = \"\"\"\n:root{color-scheme:dark}*{box-sizing:border-box}\nbody{margin:0;background:#081222;color:#edf3ff;font:17px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}\nmain{max-width:560px;margin:0 auto;padding:28px 18px 64px}\n.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}\n.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:22px;letter-spacing:.02em}\n.logo img{width:36px;height:36px;border-radius:9px}\n.pill{font-size:13px;font-weight:700;padding:6px 12px;border-radius:999px;background:#12305a;color:#9cc0ff}\n.pill.ok{background:#0f3d2c;color:#7ee2a8}.pill.off{background:#4a1620;color:#ffb3bf}\nh1{font-size:30px;line-height:1.15;margin:8px 0 12px;letter-spacing:-.02em}h2{font-size:20px;margin:0 0 10px}\np{margin:8px 0;color:#c4d3ee}small,.muted{color:#8ea3c4;font-size:14px}\n.card{background:#0f1f38;border:1px solid #20365a;border-radius:20px;padding:20px;margin:16px 0}\n.btn{display:block;width:100%;text-align:center;border:0;border-radius:16px;padding:16px;margin:10px 0;\n font:700 17px/1.2 inherit;font-family:inherit;color:#fff;background:#2f6bff;text-decoration:none;cursor:pointer}\n.btn.alt{background:#18304f;color:#d8e5ff}.btn.small{padding:12px;font-size:15px}\n.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 4px}.tabs a{flex:1;text-align:center;padding:10px 6px;border-radius:12px;\n background:#13284a;color:#b9cbea;text-decoration:none;font-weight:600;font-size:15px}.tabs a.on{background:#2f6bff;color:#fff}\n.step{display:flex;gap:12px;margin:14px 0}.num{flex:none;width:30px;height:30px;border-radius:50%;background:#2f6bff;\n display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px}\n.note{background:#132a4c;border-radius:14px;padding:12px 14px;font-size:15px;color:#cfe0ff}\n.flash{background:#0f3d2c;color:#c9f5dc;border-radius:14px;padding:12px 14px;margin:12px 0}.flash.err{background:#4a1620;color:#ffd5dc}\nvideo{width:100%;border-radius:16px;margin-top:8px;background:#000}\na{color:#9cc0ff}form{margin:0}footer{margin-top:26px;font-size:14px;color:#8ea3c4}footer a{margin-right:12px}\ncode{word-break:break-all;font-size:13px;color:#cfe0ff}\n\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#081222\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body><main>{body}</main></body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io\",\n        **(headers or {})})\n\n\ndef logo(pill=\"\"):\n    return (f'<div class=\"top\"><div class=\"logo\"><img src=\"/web/icon.png\" alt=\"\">{html.escape(BRAND_TITLE)}</div>{pill}</div>')\n\n\nFOOTER = ('<footer><a href=\"/docs/tariffs\">Тарифы</a><a href=\"/docs/terms\">Соглашение</a>'\n          '<a href=\"/docs/privacy\">Конфиденциальность</a><a href=\"/docs/support\">Поддержка</a></footer>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    body = (logo() + f\"<h1>Защищённое соединение для телефона и компьютера</h1>\"\n            f\"<p>Подключение за пару минут — прямо с этой страницы, без регистрации.</p>\"\n            f'<div class=\"card\"><h2>{TRIAL_DAYS} дней бесплатно</h2>'\n            \"<p>Все серверы, до 3 устройств. Банки и Госуслуги работают напрямую, без переключений.</p>\"\n            '<form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + device if device else \"\"}</button></form>'\n            '<small>Вы получите личную ссылку на кабинет — сохраните её.</small></div>'\n            '<div class=\"card\"><h2>Уже подключались?</h2><p>Откройте свою личную ссылку на кабинет — '\n            'её выдали при первом подключении.</p></div>' + FOOTER)\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", logo() + \"<h1>Слишком много попыток</h1>\"\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или с другой сети.</p>\",\n                    status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\"))\n\n\nasync def _create_device(request, tg_id, platform):\n    keys = _keys()\n    service = DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()),\n                            client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n    try:\n        return await service.create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment)\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">✅ Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Готово! Это ваш личный кабинет. Сохраните ссылку на него — '\n                  'кнопка «Скопировать ссылку» ниже.</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Не удалось создать ключ. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Не удалось создать оплату. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    pill = (f'<span class=\"pill ok\">Доступ до {until:%d.%m.%Y}</span>' if until else\n            '<span class=\"pill off\">Доступ закончился</span>')\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    tabs = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}\">{label}</a>' for key, label in WEB_PLATFORMS)\n\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n\n    steps = f'<div class=\"card\"><h2>Подключить устройство</h2><div class=\"tabs\">{tabs}</div>'\n    if platform == \"ios\":\n        steps += ('<p class=\"muted\" style=\"margin-top:14px\">Ваш App Store:</p><div class=\"tabs\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru\">🇷🇺 Российский</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other\">🌍 Другой страны</a></div>'\n                  '<small>Если цены в App Store в рублях — российский.</small>')\n    if not device:\n        steps += (f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\">'\n                  f'<button class=\"btn\">Создать ключ для {html.escape(dict(WEB_PLATFORMS)[platform])}</button></form>')\n    else:\n        link = import_link(app, platform, device, base)\n        steps += (f'<div class=\"step\"><div class=\"num\">1</div><div><b>Установите {app.name}</b>'\n                  f'<a class=\"btn small\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            steps += '<div class=\"note\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        steps += '</div></div>'\n        if link:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ</b>'\n                      f'<a class=\"btn small\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<small>Приложение откроется само и спросит подтверждение.</small></div></div>')\n        else:\n            steps += (f'<div class=\"step\"><div class=\"num\">2</div><div><b>Добавьте ключ по ссылке</b><br>'\n                      f'<code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></div>')\n        steps += (f'<div class=\"step\"><div class=\"num\">3</div><div><b>Включите</b><br>'\n                  f'{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</div></div>')\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            steps += f'<p class=\"muted\">Видео: как это сделать</p><video src=\"/media/{video}\" controls playsinline preload=\"none\"></video>'\n        for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []):\n            steps += (f'<a class=\"btn alt small\" href=\"?p={platform}&store={store}&app={key}\">{html.escape(label)}</a>')\n    steps += \"</div>\"\n\n    pay = '<div class=\"card\"><h2>Оплата</h2>'\n    if payments.enabled():\n        pay += '<p>Новый срок добавляется к оставшемуся.</p>'\n        for t in payments.paid_tariffs():\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\">'\n                    f'<button class=\"btn alt small\">{t[\"title\"]} — {t[\"price\"]} ₽</button></form>')\n        pay += '<small>СБП, карта или криптовалюта. Автоматического продления нет.</small>'\n    else:\n        pay += '<p>Оплата скоро появится.</p>'\n    pay += \"</div>\"\n\n    link = f\"{base}/c/{token}\"\n    save = ('<div class=\"card\"><h2>Ваш личный кабинет</h2><p>По этой ссылке вы всегда вернётесь сюда. '\n            'Сохраните её в заметки или добавьте страницу на экран «Домой».</p>'\n            f'<button class=\"btn alt small\" onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано ✓\\')\">Скопировать ссылку</button>'\n            '<small>iPhone: «Поделиться» → «На экран „Домой“». Никому не пересылайте эту ссылку.</small></div>')\n    tg = ('<div class=\"card\"><h2>Telegram</h2><p>Когда VPN включится, откроется и Telegram — там наш бот '\n          f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> с подсказками и поддержкой.</p></div>')\n    body = logo(pill) + flash + steps + pay + save + tg + FOOTER\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\nasync def handle_device(request):\n    db, user = _user(request)\n    platform = request.query.get(\"p\")\n    token = request.match_info[\"token\"]\n    if platform not in dict(WEB_PLATFORMS):\n        raise web.HTTPSeeOther(f\"/c/{token}\")\n    row = _device_for(db, user, platform) or await _create_device(request, user[\"tg_id\"], platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))\n\n\nasync def handle_pay(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    key = request.query.get(\"tariff\", \"\")\n    try:\n        created = await payments.create_link(user[\"tg_id\"], key, return_url=f\"{base}/c/{token}?check={{id}}\")\n    except payments.PaymentError:\n        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")\n    raise web.HTTPSeeOther(created[\"url\"])\n\n\n# ---------------------------------------------------------------- documents & files\nDOCS = {\"terms\": legal.terms_text, \"privacy\": legal.privacy_text, \"tariffs\": legal.tariffs_text, \"support\": legal.support_text}\n\n\nasync def handle_doc(request):\n    render = DOCS.get(request.match_info.get(\"name\", \"\"))\n    if not render:\n        raise web.HTTPNotFound(text=\"Not found\")\n    text = render().replace(\"\\n\", \"<br>\")  # the bot texts use Telegram HTML: <b>, <i>, <code>, <a>\n    return page(BRAND_TITLE, logo() + f'<div class=\"card\">{text}</div><a class=\"btn alt small\" href=\"/app\">‹ Назад</a>')\n\n\nasync def handle_media(request):\n    name = request.match_info.get(\"name\", \"\")\n    allowed = {v for apps in catalog.VIDEOS.values() for v in apps.values()}\n    path = os.path.join(ASSETS, \"video\", name)\n    if name not in allowed or not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=86400\"})\n\n\nasync def handle_icon(_request):\n    path = os.path.join(ASSETS, \"web\", \"icon.png\")\n    if not os.path.exists(path):\n        raise web.HTTPNotFound(text=\"Not found\")\n    return web.FileResponse(path, headers={\"Cache-Control\": \"public, max-age=604800\"})\n\n\nasync def handle_manifest(_request):\n    return web.json_response({\"name\": BRAND_TITLE, \"short_name\": BRAND_TITLE, \"start_url\": \"/app\", \"display\": \"standalone\",\n                              \"background_color\": \"#081222\", \"theme_color\": \"#081222\",\n                              \"icons\": [{\"src\": \"/web/icon.png\", \"sizes\": \"512x512\", \"type\": \"image/png\"}]},\n                             content_type=\"application/manifest+json\")\n\n\ndef add_routes(app):\n    app.router.add_get(\"/app\", handle_landing)\n    app.router.add_post(\"/app/start\", handle_start)\n    app.router.add_get(\"/c/{token}\", handle_cabinet)\n    app.router.add_post(\"/c/{token}/device\", handle_device)\n    app.router.add_post(\"/c/{token}/pay\", handle_pay)\n    app.router.add_get(\"/docs/{name}\", handle_doc)\n    app.router.add_get(\"/media/{name}\", handle_media)\n    app.router.add_get(\"/web/icon.png\", handle_icon)\n    app.router.add_get(\"/web/manifest.webmanifest\", handle_manifest)\n"},"caller":{"type":"direct"}}]}}
