ram user (created on first request).\"\"\"\n    conn = get_db()\n    try:\n        row = conn.execute(\"SELECT web_token FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not row:\n            raise LookupError(\"user not found\")\n        if row[\"web_token\"]:\n            return row[\"web_token\"]\n        while True:\n            token = secrets.token_urlsafe(32)\n            try:\n                conn.execute(\"UPDATE users SET web_token = REDACTED WHERE tg_id = ?\", (token, tg_id))\n                conn.commit()\n                return token\n            except sqlite3.IntegrityError:\n                conn.rollback()\n    finally:\n        conn.close()\n\n\ndef create_link_code(web_tg_id: int, minutes: int = 30) -> str:\n    \"\"\"One-time code for t.me/<bot>?start=web_<code>: joins a web account to a Telegram account.\"\"\"\n    code = secrets.token_urlsafe(12)\n    expires = (datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None) + timedelta(minutes=minutes)).isoformat()\n    conn = get_db()\n    conn.execute(\"DELETE FROM link_codes WHERE expires_at < ?\", (_now(),))\n    conn.execute(\"INSERT INTO link_codes (code, tg_id, expires_at) VALUES (?, ?, ?)\", (code, web_tg_id, expires))\n    conn.commit()\n    conn.close()\n    return code\n\n\ndef _now() -> str:\n    return datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None).isoformat()\n\n\ndef merge_web_account(code: str, tg_id: int, username: str, first_name: str) -> dict | None:\n    \"\"\"Join the web account behind `code` to the Telegram user: devices and payments move over, the\n    paid period becomes the later of the two (an account without a period keeps unlimited access),\n    and the old cabinet link keeps working. Returns the Telegram user, or None for a bad/expired code.\"\"\"\n    conn = get_db()\n    try:\n        conn.execute(\"BEGIN IMMEDIATE\")\n        link = conn.execute(\"SELECT * FROM link_codes WHERE code = ? AND expires_at >= ?\", (code, _now())).fetchone()\n        conn.execute(\"DELETE FROM link_codes WHERE code = ?\", (code,))\n        web = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (link[\"tg_id\"],)).fetchone() if link else None\n        if not web or web[\"tg_id\"] >= 0 or web[\"merged_into\"] or tg_id <= 0:\n            conn.commit()\n            return None\n        own = conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone()\n        if not own:\n            conn.execute(\"INSERT INTO users (tg_id, username, first_name, referral_code, paid_until) VALUES (?, ?, ?, ?, ?)\",\n                         (tg_id, username, first_name, f\"aura_{tg_id}\", web[\"paid_until\"]))\n            paid_until = web[\"paid_until\"]\n        elif own[\"paid_until\"] is None:\n            paid_until = None  # accounts from before payments keep their unlimited access\n        else:\n            paid_until = max(own[\"paid_until\"], web[\"paid_until\"] or own[\"paid_until\"])\n        conn.execute(\"UPDATE devices SET tg_id = ?, request_id = request_id || '-' || id WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        conn.execute(\"UPDATE payments SET tg_id = ? WHERE tg_id = ?\", (tg_id, web[\"tg_id\"]))\n        token = web[\"web_token\"]\n        own_token = REDACTED if own else None\n        conn.execute(\"UPDATE users SET merged_into = ?, paid_until = NULL, web_token = REDACTED WHERE tg_id = ?\",\n                     (tg_id, None if not own_token else token, web[\"tg_id\"]))\n        conn.execute(\"UPDATE users SET paid_until = ?, web_token = REDACTED, ?), \"\n                     \"device_limit = MAX(device_limit, ?) WHERE tg_id = ?\",\n                     (paid_until, None if own_token else token, web[\"device_limit\"] or 3, tg_id))\n        conn.commit()\n        return dict(conn.execute(\"SELECT * FROM users WHERE tg_id = ?\", (tg_id,)).fetchone())\n    finally:\n        conn.close()\n\n\ndef users_to_notify(kind: str) -> list[dict]:\n    \"\"\"Telegram users to warn: «soon» — the period ends within 3 days; «ended» — it has ended.\n    Each period end is announced once (remembered in reminder_for / expiry_notice_for).\"\"\"\n    now = _now()\n    soon = (datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None) + timedelta(days=3)).isoformat()\n    conn = get_db()\n    if kind == \"soon\":\n        rows = conn.execute(\"\"\"SELECT * FROM users WHERE tg_id > 0 AND paid_until > ? AND paid_until <= ?\n                               AND COALESCE(reminder_for, '') != paid_until\"\"\", (now, soon)).fetchall()\n    else:\n        rows = conn.execute(\"\"\"SELECT * FROM users WHERE tg_id > 0 AND paid_until <= ?\n                               AND COALESCE(expiry_notice_for, '') != paid_until\"\"\", (now,)).fetchall()\n    conn.close()\n    return [dict(r) for r in rows]\n\n\ndef mark_notified(tg_id: int, kind: str, paid_until: str):\n    column = \"reminder_for\" if kind == \"soon\" else \"expiry_notice_for\"\n    conn = get_db()\n    conn.execute(f\"UPDATE users SET {column} = ? WHERE tg_id = ?\", (paid_until, tg_id))\n    conn.commit()\n    conn.close()\n''')\nopen('database.py','w').write(s)\n\n# ------------------------------------------------------------------ device service\npatch('device_service.py', [\n('''import uuid\nfrom contextlib import contextmanager\n''', '''import uuid\nfrom contextlib import contextmanager\nfrom datetime import datetime, timedelta, timezone\n'''),\n('''class DeviceError(Exception):''', '''TRIAL_DAYS = 7\n\n\ndef _now():\n    return datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None)\n\n\nclass DeviceError(Exception):'''),\n('''            if owner and (not owner['is_active'] or owner['revoked_at']):\n                raise DeviceError('Доступ отключён. Обратитесь к администратору.')''', '''            if owner and (not owner['is_active'] or owner['revoked_at']):\n                raise DeviceError('Доступ отключён. Обратитесь к администратору.')\n            if owner and owner['paid_until'] and owner['paid_until'] <= _now().isoformat():\n                raise DeviceError('Срок доступа закончился. Продлите доступ — и подключите устройство.')'''),\n('''                conn.execute('INSERT INTO users (tg_id, username, first_name, referral_code, referrer_id) VALUES (?, ?, ?, ?, ?)', (tg_id, username, first_name, f'aura_{tg_id}', referrer))''',\n '''                trial = (_now() + timedelta(days=TRIAL_DAYS)).isoformat()  # new accounts start with the trial\n                conn.execute('INSERT INTO users (tg_id, username, first_name, referral_code, referrer_id, paid_until) VALUES (?, ?, ?, ?, ?, ?)', (tg_id, username, first_name, f'aura_{tg_id}', referrer, trial))'''),\n('''    async def recover_pending(self):''', '''    # -------------------------------------------------------------- paid period\n    def _clients(self, row):\n        \"\"\"(key, client) for every node of the device, or None if a node is gone or was re-targeted.\"\"\"\n        configured = {n.key: n for n in self._nodes()}\n        pairs = []\n        for key in row['node_keys']:\n            node = configured.get(key)\n            if not node:\n                return None\n            client = self.client_factory(key)\n            if row['node_targets'].get(key) != _target(node, client):\n                return None\n            pairs.append((key, client))\n        return pairs\n\n    async def _suspend(self, row):\n        \"\"\"Period ended: remove the device from every panel. The row, token and subscription link stay.\"\"\"\n        pairs = self._clients(row)\n        if pairs is None:\n            return False\n        for _, client in pairs:\n            await client.remove_client(row['uuid'])\n            if await client.has_client(row['uuid']) is not False:\n                return False\n        _status(row['id'], 'suspended')\n        return True\n\n    async def _resume(self, row):\n        \"\"\"Period extended: put the device back on every panel with the same UUID.\"\"\"\n        pairs = self._clients(row)\n        if pairs is None:\n            return False\n        for key, client in pairs:\n            if await client.has_client(row['uuid']) is True:\n                continue\n            email = f\"aura_d_{row['id']}-{key}\"\n            ok = await client.add_client(row['uuid'], email, device_limit=3)\n            if ok is not True:  # the panel may still remember the old email\n                ok = await client.add_client(row['uuid'], f\"{email}-r{int(time.time())}\", device_limit=3)\n            if ok is not True:\n                return False\n        _status(row['id'], 'active')\n        return True\n\n    async def sync_access(self, tg_id=None):\n        \"\"\"Suspend devices whose paid period ended, resume them once it is extended. Accounts without\n        paid_until (from before payments) are never touched. Returns (suspended, resumed).\"\"\"\n        now = _now().isoformat()\n        query = \"\"\"SELECT d.* FROM devices d JOIN users u ON u.tg_id = d.tg_id WHERE u.paid_until IS NOT NULL\n                   AND ((d.status = 'active' AND u.paid_until <= ?) OR (d.status = 'suspended' AND u.paid_until > ?))\"\"\"\n        args = [now, now]\n        if tg_id is not None:\n            query += \" AND d.tg_id = ?\"\n            args.append(tg_id)\n        conn = db.get_db()\n        try:\n            rows = conn.execute(query + \" ORDER BY d.id LIMIT 200\", args).fetchall()\n        finally:\n            conn.close()\n        suspended = resumed = 0\n        for record in rows:\n            row = db._device_row(record)\n            with _operation_lock(row['id']) as acquired:\n                if not acquired:\n                    continue\n                current = db.get_device(row['tg_id'], row['id'])\n                owner = db.get_user(row['tg_id'])\n                if not current or not owner or not owner['paid_until']:\n                    continue\n                expired = owner['paid_until'] <= _now().isoformat()\n                try:\n                    if current['status'] == 'active' and expired:\n                        suspended += await self._suspend(current)\n                    elif current['status'] == 'suspended' and not expired:\n                        resumed += await self._resume(current)\n                except Exception:\n                    continue  # retried on the next pass\n        return suspended, resumed\n\n    async def recover_pending(self):'''),\n])\n\n# ------------------------------------------------------------------ payments\npatch('payments.py', [\n('''async def check(payment: dict) -> tuple[dict, bool]:\n    \"\"\"Ask Platega for the current status and apply it.\"\"\"\n    if payment[\"status\"] == \"paid\" or not payment.get(\"provider_id\"):\n        return payment, False\n    body = await _request(\"GET\", f\"/transaction/{payment['provider_id']}\")\n    settled, newly_paid = db.settle_payment(payment[\"provider_id\"], str(body.get(\"status\", \"\")))\n    return settled or payment, newly_paid''', '''async def check(payment: dict, service=None) -> tuple[dict, bool]:\n    \"\"\"Ask Platega for the current status and apply it; a confirmed payment turns the keys back on.\"\"\"\n    if payment[\"status\"] == \"paid\" or not payment.get(\"provider_id\"):\n        return payment, False\n    body = await _request(\"GET\", f\"/transaction/{payment['provider_id']}\")\n    settled, newly_paid = db.settle_payment(payment[\"provider_id\"], str(body.get(\"status\", \"\")))\n    if newly_paid:\n        await resume_access(payment[\"tg_id\"], service)\n    return settled or payment, newly_paid\n\n\nasync def resume_access(tg_id: int, service=None):\n    \"\"\"Turn suspended keys back on right after a payment (the periodic pass would do it within minutes).\"\"\"\n    try:\n        from device_service import DeviceService\n        await (service or DeviceService()).sync_access(tg_id)\n    except Exception:\n        logger.warning(\"Could not resume access right after payment; the periodic pass will retry\")'''),\n])\n\n# ------------------------------------------------------------------ callback resumes keys\npatch('subscription.py', [\n('''    if newly_paid:\n        await payments.notify(payment[\"tg_id\"], payments.success_text(payment[\"tg_id\"]))''', '''    if newly_paid:\n        from device_service import DeviceService\n        await payments.resume_access(payment[\"tg_id\"], DeviceService(nodes=list(request.app[NODE_PROVIDER_KEY]()),\n                                                                     client_factory=request.app[DEVICE_CLIENT_FACTORY_KEY]))\n        await payments.notify(payment[\"tg_id\"], payments.success_text(payment[\"tg_id\"]))'''),\n])\nprint('ok')\nPYEOF\ngrep -n \"def get_device\\b\\|def get_device(\" database.py | head -2","description":"Add paid-period suspension, resume, reminders data and account linking to the core"}},"serverClassifierRequest":"31a38106-7384-4e59-a7a7-42b56b91aec3","apiBlockIndex":1,"requestId":"req_011CgeBz5ZL88i3MUnDo1jWF","requestRef":"6c06ba83-9658-4d4d-81ce-d841ff41d569","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"7dce7357-e7b8-4859-bcde-78715ad57b96","timestamp":"2026-11-02T13:36:49.984Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
