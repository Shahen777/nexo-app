return web.Response(status=503, text=\"Temporarily unavailable\")\n\n    upload = int(user.get(\"traffic_up\") or 0)\n    download = int(user.get(\"traffic_down\") or 0)\n    headers = {\n        \"Cache-Control\": \"no-store\",\n        \"profile-update-interval\": \"6\",\n        \"profile-title\": BRAND_TITLE,\n        \"isp-name\": BRAND_TITLE,\n        \"isp-url\": request.app[PUBLIC_BASE_URL_KEY],\n    }\n    if not user.get('device_id') or all(user.get(k) is not None for k in ('traffic_up', 'traffic_down')):\n        headers['subscription-userinfo'] = f'upload={upload}; download={download}'\n    return web.Response(\n        text=payload,\n        content_type=\"text/plain\",\n        headers=headers,\n    )\n\n\naccess.py:30:        for user in db.users_to_notify(kind):\naccess.py:35:            db.mark_notified(user[\"tg_id\"], kind, user[\"paid_until\"])\ndatabase.py:552:def users_to_notify(kind: str) -> list[dict]:\ndatabase.py:568:def mark_notified(tg_id: int, kind: str, paid_until: str):\npayments.py:141:async def notify(tg_id: int, text: str):\nno mail/push settings\nno local mail\nno push libs\n514:    final expire = profile.subscriptionInfo?.expireDate;\n515:    final seconds = expire?.difference(DateTime.now()).inSeconds;\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","is_error":false}]},"uuid":"a3634f8d-5e50-4eda-85a6-cf054011774a","timestamp":"2026-11-05T22:54:14.528Z","toolUseResult":{"stdout":"subscription.py:59:        \"profile-update-interval\": \"6\",\nsubscription.py:60:        \"profile-title\": BRAND_TITLE,\nsubscription.py:65:        headers['subscription-userinfo'] = f'upload={upload}; download={download}'\nsubscription.py:149:    headers['routing'] = routing_link()\nsubscription.py:172:        info = headers.get('subscription-userinfo', 'upload=0; download=0')\nsubscription.py:173:     