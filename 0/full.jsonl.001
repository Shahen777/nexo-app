un: |\n          if ! compgen -G '*_test.go' > /dev/null; then\n            echo 'No Go tests found in core/; the test step would pass vacuously.' >&2\n            exit 1\n          fi\n          test -z \"$(gofmt -l ./*.go ./cmd ./mobile ./platform ./tun)\" || {\n            gofmt -l ./*.go ./cmd ./mobile ./platform ./tun >&2\n            exit 1\n          }\n          go test -count=1 .\n          go vet . ./cmd/...\n          GOOS=linux go vet ./platform\n\n      - name: Validate the Android core library\n        working-directory: core\n        env:\n          CGO_ENABLED: 0\n        run: |\n          tags=\"$(sed -n 's/^tags: *//p' ../build_config.yaml)\"\n          test -n \"$tags\" || { echo 'Could not read tags from build_config.yaml' >&2; exit 1; }\n          GOOS=android GOARCH=arm64 go vet \"-tags=$tags\" . ./mobile ./tun ./platform\n\n  android:\n    name: Android unit tests\n    if: *checks\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          submodules: recursive\n\n      - name: Setup Go\n        uses: actions/setup-go@v5\n        with:\n          go-version: ${{ env.GO_VERSION }}\n          cache: ${{ env.BRANCH_CACHE }}\n          cache-dependency-path: |\n            core/go.sum\n            android/core/build.gradle.kts\n\n      - name: Setup Flutter\n        uses: subosito/flutter-action@v2\n        with:\n          channel: stable\n          flutter-version: ${{ env.FLUTTER_VERSION }}\n          cache: ${{ env.BRANCH_CACHE }}\n\n      - name: Install dependencies\n        run: flutter pub get\n\n      - name: Setup NDK\n        uses: nttld/setup-ndk@v1\n        id: ndk\n        with:\n          ndk-version: ${{ env.NDK_VERSION }}\n          link-to-sdk: true\n\n      - name: Setup Java\n        uses: actions/setup-java@v4\n        with:\n          distribution: temurin\n          java-version: '17'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v6\n        with:\n          cache-read-only: ${{ github.ref != 'refs/heads/main' && github.ref != 'refs/heads/dev' }}\n\n      - name: Run Android unit tests\n        working-directory: android\n        env:\n          ANDROID_NDK_HOME: ${{ steps.ndk.outputs.ndk-path }}\n        run: |\n          {\n            echo \"flutter.sdk=$FLUTTER_ROOT\"\n            echo \"sdk.dir=$ANDROID_HOME\"\n          } > local.properties\n          wrapper=\"$FLUTTER_ROOT/bin/cache/artifacts/gradle_wrapper\"\n          test -d \"$wrapper\" || flutter precache\n          cp -R \"$wrapper/.\" .\n          chmod +x gradlew\n          # No JVM unit test loads the Core or the Flutter build, but `:core` compiles against\n          # the gomobile AAR, so one ABI of it is built.\n          ./gradlew :common:testDebugUnitTest :service:testDebugUnitTest :app:testDebugUnitTest \\\n            -Ptarget-platform=android-arm64 \\\n            -x :app:compileFlutterBuildDebug -x :app:copyFlutterAssetsDebug\n\n  rust:\n    name: Rust\n    if: *checks\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Rust cache\n        uses: Swatinem/rust-cache@v2\n        with:\n          workspaces: |\n            services/helper\n            plugins/rust_api/rust\n          save-if: ${{ env.BRANCH_CACHE }}\n\n      - name: Check format\n        run: |\n          cargo fmt --manifest-path services/helper/Cargo.toml -- --check\n          cargo fmt --manifest-path plugins/rust_api/rust/Cargo.toml -- --check\n\n      - name: Run tests\n        run: |\n          cargo test --manifest-path services/helper/Cargo.toml\n          cargo test --manifest-path plugins/rust_api/rust/Cargo.toml\n\n  windows-helper-test:\n    name: Windows helper test\n    if: *checks\n    runs-on: windows-2022\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Rust cache\n        uses: Swatinem/rust-cache@v2\n        with:\n          workspaces: services/helper\n          save-if: ${{ env.BRANCH_CACHE }}\n\n      - name: Check format\n        run: cargo fmt --manifest-path services/helper/Cargo.toml -- --check\n\n      - name: Run Windows service tests\n        run: cargo test --manifest-path services/helper/Cargo.toml --features windows-service\n\n  build:\n    # Releases publish where the release links point: the public repository.\n    if: github.repository == 'chen08209/FlClash' && github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')\n    runs-on: ${{ matrix.os }}\n    strategy:\n      matrix:\n        include:\n          - platform: android\n            os: ubuntu-latest\n          - platform: windows\n            os: Windows-2022\n            arch: amd64\n          - platform: linux\n            os: ubuntu-22.04\n            arch: amd64\n          - platform: macos\n            os: macos-15-intel\n            arch: amd64\n          - platform: macos\n            os: macos-latest\n            arch: arm64\n          - platform: windows\n            os: windows-11-arm\n            arch: arm64\n            flutter-channel: master\n          - platform: linux\n            os: ubuntu-24.04-arm\n            arch: arm64\n            flutter-channel: master\n\n    steps:\n      - name: Setup rust\n        if: startsWith(matrix.os, 'windows-11-arm')\n        shell: pwsh\n        run: |\n          Invoke-WebRequest -Uri \"https://win.rustup.rs/aarch64\" -OutFile rustup-init.exe\n          .\\rustup-init.exe -y --default-toolchain stable\n          $cargoPath = \"$env:USERPROFILE\\.cargo\\bin\"\n          Add-Content $env:GITHUB_PATH $cargoPath\n\n      - name: Checkout\n        uses: actions/checkout@v4\n        with:\n          submodules: recursive\n\n      - name: Setup Android Signing\n        if: startsWith(matrix.platform,'android')\n        run: |\n          echo \"${{ secrets.KEYSTORE }}\" | base64 --decode > android/app/keystore.jks\n          {\n            echo \"keyAlias=${{ secrets.KEY_ALIAS }}\"\n            echo \"storePassword=${{ secrets.STORE_PASSWORD }}\"\n            echo \"keyPassword=${{ secrets.KEY_PASSWORD }}\"\n          } >> android/local.properties\n\n      - name: Setup Go\n        uses: actions/setup-go@v5\n        with:\n          go-version: ${{ env.GO_VERSION }}\n          cache: ${{ env.BRANCH_CACHE }}\n          cache-dependency-path: core/go.sum\n\n      - name: Setup Gradle\n        if: startsWith(matrix.platform,'android')\n        uses: gradle/actions/setup-gradle@v6\n\n      - name: Enable git long paths (Windows)\n        if: startsWith(matrix.os, 'windows')\n        run: git config --global core.longpaths true\n\n      # Stable publishes no Windows or Linux arm64 archive; master makes the action\n      # clone the SDK at the pinned tag and let it fetch the host's own Dart SDK.\n      - name: Setup Flutter\n        uses: subosito/flutter-action@v2\n        with:\n          channel: ${{ matrix.flutter-channel || 'stable' }}","stderr":"\nShell cwd was reset to /Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"ce03c520-9975-4ac8-8352-10ba867e5401","context":{"git_state":{"cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","root":null,"branch":null,"default_branch":null,"status":null,"visibility":{"origin":null,"push_remote":null,"remotes":[],"visibility_cache":[]},"error":"not_a_repo"},"live_cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"f3f4407d-6c26-47bc-b298-301