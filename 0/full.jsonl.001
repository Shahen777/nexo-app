private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work"},".claude/launch.json":{"backupFileName":"0e331d5d30a61cb0@v2","version":2,"backupTime":"2026-11-02T15:00:01.154Z","realParentDir":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584/.claude"},"nexo-logo/brandbook/build_brandbook.py":{"backupFileName":"65072ea8001483f5@v2","version":2,"backupTime":"2026-10-29T23:01:47.563Z","realParentDir":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584/nexo-logo/brandbook"},"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory/build_nexo_karing.py":{"backupFileName":"40004dcbb493c31b@v6","version":6,"backupTime":"2026-10-31T23:00:27.238Z","realParentDir":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory"}},"timestamp":"2026-11-05T22:34:42.078Z"},"isSnapshotUpdate":false}
