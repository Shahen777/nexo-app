{"parentUuid":"afb4a709-a627-4461-b11a-204b7c784be6","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgeDPtzsNubLSCnXyKWQv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QUvU8jPRMfRz7eRRZ8xks1","name":"Bash","input":{"command":"cd /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work && python3 - <<'PYEOF'\np='webapp.py'; s=open(p).read()\nstart=s.index('STYLE = FONTS + \"\"\"')\nend=s.index('async def handle_device(request):')\nnew=r'''STYLE = FONTS + \"\"\"\n:root{--blue:#2F6BFF;--ink:#0B1F3A;--slate:#5B6B86;--mist:#F2F5FA;--line:#E3E9F3;--paper:#FFFFFF;--app:#EEF2F8;\n --green:#13A86B;--red:#E5484D;--amber:#C26A00;--top:env(safe-area-inset-top);--bottom:env(safe-area-inset-bottom)}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{overflow-x:hidden}\nbody{margin:0;background:var(--app);color:var(--ink);font:400 16px/1.45 Manrope,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n -webkit-font-smoothing:antialiased;overscroll-behavior-y:none}\na{color:var(--blue)}button{font-family:inherit}\n.app{max-width:520px;margin:0 auto;min-height:100vh;padding-bottom:calc(84px + var(--bottom))}\n.appbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:10px;\n padding:calc(10px + var(--top)) 18px 10px;background:var(--blue);color:#fff}\n.brand{display:flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font:700 19px/1 Unbounded,sans-serif}\n.brand svg{width:26px;height:26px}\n.chip{font-size:12px;font-weight:800;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.16);color:#fff;white-space:nowrap}\n.chip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:#7CF0B6;vertical-align:1px}\n.chip.off i{background:#FF9CA8}.chip.soon i{background:#FFC46B}\n.hero{background:var(--blue);padding:6px 18px 26px;border-radius:0 0 28px 28px;position:relative;overflow:hidden}\n.mark-bg{position:absolute;right:-120px;top:-90px;width:320px;height:320px;opacity:.12;pointer-events:none}\n.screen{padding:0 16px}.js .screen{display:none}.js .screen.on{display:block;animation:fade .22s ease-out}\n@keyframes fade{from{opacity:0;transform:translateY(6px)}}\n.large{font:600 27px/1.15 Unbounded,sans-serif;letter-spacing:-.015em;margin:22px 4px 14px}\n.group{background:var(--paper);border-radius:20px;padding:6px 16px;margin:0 0 14px;box-shadow:0 1px 2px rgba(11,31,58,.05)}\n.group.pad{padding:16px}\n.cap{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--slate);margin:18px 4px 8px}\n.row{display:flex;align-items:center;gap:12px;padding:13px 0;color:var(--ink);text-decoration:none}\n.row+.row{border-top:1px solid var(--line)}.row .tx{flex:1;min-width:0}.row .tx b{display:block;font-weight:700}\n.row .tx span{display:block;font-size:13px;color:var(--slate)}.row .chev{color:#A7B3C8;font-size:20px;line-height:1}\n.ic{flex:none;width:36px;height:36px;border-radius:11px;display:grid;place-items:center;background:var(--mist);color:var(--blue)}\n.ic svg,.tile svg,.tabbar svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}\n.tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:-2px 0 14px}\n.tile{background:var(--paper);border-radius:20px;padding:16px;color:var(--ink);text-decoration:none;box-shadow:0 1px 2px rgba(11,31,58,.05);\n display:flex;flex-direction:column;gap:22px;min-height:112px;transition:transform .12s}\n.tile:active,.row:active{transform:scale(.98)}\n.tile .ic{background:#E8EFFF}.tile b{font-weight:800;font-size:15px;line-height:1.25}\n.tile.primary{background:var(--ink);color:#fff}.tile.primary .ic{background:rgba(255,255,255,.12);color:#fff}\n.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:52px;border:0;border-radius:14px;padding:14px 18px;\n font:800 16px/1.2 Manrope,sans-serif;text-decoration:none;cursor:pointer;background:var(--blue);color:#fff;transition:transform .12s}\n.btn:active{transform:scale(.985)}.btn.white{background:#fff;color:var(--ink)}.btn.quiet{background:var(--mist);color:var(--ink)}\n.btn:focus-visible,.tile:focus-visible,.row:focus-visible,.tabbar a:focus-visible{outline:3px solid #9DB8FF;outline-offset:2px}\n.muted{color:var(--slate);font-size:14px}p{margin:6px 0}\n.pass{position:relative;background:#fff;color:var(--ink);border-radius:18px;padding:16px 18px 14px;box-shadow:0 16px 36px rgba(11,31,58,.22);\n margin-top:8px;animation:rise .6s cubic-bezier(.2,.8,.2,1) both}\n@keyframes rise{from{opacity:0;transform:translateY(22px)}}\n@media (prefers-reduced-motion:reduce){.pass,.js .screen.on{animation:none}.btn,.tile,.row{transition:none}}\n.pass .head{display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)}\n.state{display:inline-flex;align-items:center;gap:6px;letter-spacing:.02em;text-transform:none;font-size:13px}\n.state::before{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}\n.state.on{color:var(--green)}.state.off{color:var(--red)}.state.soon{color:var(--amber)}\n.pass .label{margin:12px 0 0;font-size:13px;color:var(--slate)}.pass .big{font:600 29px/1.08 Unbounded,sans-serif;margin:2px 0 4px}\n.pass .sub{font-size:14px;color:var(--slate)}\n.meter{height:6px;border-radius:6px;background:var(--mist);margin:12px 0 0;overflow:hidden}.meter i{display:block;height:100%;background:var(--blue);border-radius:6px}\n.perf{position:relative;margin:14px -18px 10px;border-top:2px dashed var(--line)}\n.perf::before,.perf::after{content:\"\";position:absolute;top:-11px;width:20px;height:20px;border-radius:50%;background:var(--blue)}\n.perf::before{left:-10px}.perf::after{right:-10px}\n.stub{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px;font-weight:700}.stub a{text-decoration:none;font-weight:800}\n.pass .mk{position:absolute;right:16px;top:42px;width:46px;height:46px}\n.seg{display:flex;background:#E4EAF3;border-radius:12px;padding:3px;gap:3px;margin:0 0 12px}\n.seg a{flex:1;min-width:0;text-align:center;padding:9px 2px;border-radius:10px;color:var(--slate);font-weight:700;font-size:14px;text-decoration:none;\n white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.seg a.on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(11,31,58,.16)}\n.seg.small a{font-size:13px;padding:7px 2px}\nol.steps{list-style:none;margin:4px 0 0;padding:0;counter-reset:s}\nol.steps li{position:relative;padding:4px 0 20px 46px;counter-increment:s}\nol.steps li::before{content:counter(s);position:absolute;left:0;top:2px;width:30px;height:30px;border-radius:50%;background:var(--ink);color:#fff;\n font:600 13px/30px Unbounded,sans-serif;text-align:center}\nol.steps li::after{content:\"\";position:absolute;left:14px;top:38px;bottom:4px;width:2px;background:var(--line)}\nol.steps li:last-child{padding-bottom:6px}ol.steps li:last-child::after{display:none}\nol.steps b{display:block;font-size:16px;margin:3px 0 10px}ol.steps .muted{margin-top:6px}\n.hint{border-left:3px solid var(--blue);background:var(--mist);padding:10px 12px;border-radius:0 10px 10px 0;font-size:14px;margin:10px 0 0}\nvideo{display:block;width:100%;aspect-ratio:9/16;max-height:70vh;object-fit:contain;background:var(--ink);border-radius:16px}\n.plan{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;padding:14px 0;color:var(--ink);cursor:pointer;text-align:left;font:inherit}\nform+form .plan{border-top:1px solid var(--line)}form{margin:0}\n.plan .t{flex:1;font-weight:800}.plan .t span.s{display:block;font-weight:500;font-size:13px;color:var(--slate)}\n.price{font:600 16px Unbounded,sans-serif;white-space:nowrap}\n.go{flex:none;width:34px;height:34px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:17px}\n.tag{display:inline-block;margin-left:6px;font-size:11px;font-weight:800;color:var(--green);background:#E3F6EC;border-radius:6px;padding:2px 6px;vertical-align:2px}\n.linkbox{display:flex;gap:8px;align-items:center;background:var(--mist);border-radius:12px;padding:6px 6px 6px 12px;margin:10px 0 6px}\n.linkbox code{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:600 13px/1 Manrope,sans-serif;color:var(--slate)}\n.linkbox button{border:0;background:var(--ink);color:#fff;border-radius:9px;padding:11px 12px;font:800 13px Manrope,sans-serif;cursor:pointer;white-space:nowrap}\n.flash{border-radius:16px;padding:12px 14px;margin:14px 0 0;font-weight:700;font-size:15px;background:#E3F6EC;color:#0B5E3B}\n.flash.err{background:#FDECEC;color:#8E1F24}\n.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;justify-content:center;background:rgba(255,255,255,.92);\n -webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);border-top:1px solid var(--line);padding-bottom:var(--bottom)}\n.tabbar nav{display:flex;width:100%;max-width:520px}\n.tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 0 8px;color:#8A97AD;text-decoration:none;font-size:11px;font-weight:700}\n.tabbar a.on{color:var(--blue)}.tabbar svg{width:24px;height:24px}\n.onb{min-height:100vh;background:var(--blue);color:#fff;display:flex;flex-direction:column;padding:calc(14px + var(--top)) 20px calc(150px + var(--bottom));\n position:relative;overflow:hidden;max-width:520px;margin:0 auto}\n.onb h1{font:600 30px/1.1 Unbounded,sans-serif;letter-spacing:-.015em;margin:26px 0 10px;position:relative}\n.onb .lead{color:rgba(255,255,255,.88);margin:0 0 22px;position:relative}\n.ticks{list-style:none;padding:0;margin:22px 0 0;position:relative}\n.ticks li{display:flex;gap:10px;align-items:flex-start;padding:7px 0;font-weight:600}\n.ticks li::before{content:\"✓\";flex:none;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:12px;font-weight:800}\n.dock{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#fff;border-radius:24px 24px 0 0;padding:16px 20px calc(14px + var(--bottom));\n box-shadow:0 -10px 30px rgba(11,31,58,.14)}\n.dock-in{max-width:480px;margin:0 auto;text-align:center}.dock small{display:block;color:var(--slate);font-size:13px;margin-top:8px}\n.doc{font-size:15px;line-height:1.55}\n\"\"\"\n\nICONS = {\n    \"home\": '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 10.5 12 3.5l8.5 7V20a1 1 0 0 1-1 1H15v-6H9v6H4.5a1 1 0 0 1-1-1z\"/></svg>',\n    \"setup\": '<svg viewBox=\"0 0 24 24\"><path d=\"M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1\"/><path d=\"M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1\"/></svg>',\n    \"pay\": '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5.5\" width=\"18\" height=\"13\" rx=\"2.5\"/><path d=\"M3 10h18M7 15h3.5\"/></svg>',\n    \"more\": '<svg viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"12\" r=\"1.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.3\"/><circle cx=\"18\" cy=\"12\" r=\"1.3\"/></svg>',\n    \"phone\": '<svg viewBox=\"0 0 24 24\"><rect x=\"7\" y=\"2.5\" width=\"10\" height=\"19\" rx=\"2.5\"/><path d=\"M11 18h2\"/></svg>',\n    \"chat\": '<svg viewBox=\"0 0 24 24\"><path d=\"M4 5h16v11H9l-5 4z\"/></svg>',\n    \"link\": '<svg viewBox=\"0 0 24 24\"><path d=\"M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1\"/><path d=\"M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1\"/></svg>',\n    \"doc\": '<svg viewBox=\"0 0 24 24\"><path d=\"M7 3h7l4 4v14H7z\"/><path d=\"M14 3v4h4M10 12h5M10 16h5\"/></svg>',\n    \"send\": '<svg viewBox=\"0 0 24 24\"><path d=\"M21 4 3 11l7 2 2 7z\"/><path d=\"m10 13 5-5\"/></svg>',\n}\nTABS = ((\"home\", \"Главная\"), (\"setup\", \"Подключить\"), (\"pay\", \"Оплата\"), (\"more\", \"Ещё\"))\nTAB_SCRIPT = \"\"\"<script>(function(){var ids=['home','setup','pay','more'];function show(){var h=(location.hash||'#home').slice(1);\nif(ids.indexOf(h)<0)h='home';document.querySelectorAll('.screen').forEach(function(s){s.classList.toggle('on',s.id===h)});\ndocument.querySelectorAll('.tabbar a').forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+h)});window.scrollTo(0,0)}\nwindow.addEventListener('hashchange',show);show()})();</script>\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#2F6BFF\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<link rel=\"preload\" href=\"/web/fonts/unbounded-cyrillic.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<script>document.documentElement.className='js'</script>\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body>{body}</body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src 'self'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io https://t.me\",\n        **(headers or {})})\n\n\ndef appbar(home=\"/app\", right=\"\"):\n    return (f'<header class=\"appbar\"><a class=\"brand\" href=\"{home}\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"br\")}'\n            f'{html.escape(BRAND_TITLE.lower())}</a>{right}</header>')\n\n\ndef row(href, icon, title, sub=\"\", external=False):\n    target = ' target=\"_blank\" rel=\"noreferrer\"' if external else \"\"\n    return (f'<a class=\"row\" href=\"{href}\"{target}><span class=\"ic\">{ICONS[icon]}</span><span class=\"tx\"><b>{title}</b>'\n            f'{f\"<span>{sub}</span>\" if sub else \"\"}</span><span class=\"chev\">›</span></a>')\n\n\nDOC_ROWS = (row(\"/docs/tariffs\", \"doc\", \"Тарифы\") + row(\"/docs/terms\", \"doc\", \"Пользовательское соглашение\")\n            + row(\"/docs/privacy\", \"doc\", \"Политика конфиденциальности\") + row(\"/docs/support\", \"chat\", \"Поддержка\"))\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\ndef per_month(plan) -> int:\n    return round(plan[\"price\"] / (payments.DAYS[plan[\"key\"]] / 30))\n\n\ndef simple(title, inner, back=\"/app\"):\n    \"\"\"A plain app screen: app bar, large title, one white group (documents, errors).\"\"\"\n    return (f'<div class=\"app\">{appbar(back)}<div class=\"screen\" style=\"display:block\"><h1 class=\"large\">{title}</h1>'\n            f'<div class=\"group pad\">{inner}</div><a class=\"btn quiet\" href=\"{back}\">Назад</a></div></div>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    cheapest = min(per_month(t) for t in payments.paid_tariffs())\n    sample = (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}'\n              f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}<span class=\"state on\">готов к выдаче</span></div>'\n              f'<p class=\"label\">Пробный доступ</p><div class=\"big\">{TRIAL_DAYS} дней бесплатно</div>'\n              '<div class=\"sub\">Австрия и Бразилия · до 3 устройств</div>'\n              f'<div class=\"perf\"></div><div class=\"stub\"><span>{html.escape(device or \"Телефон или компьютер\")}</span>'\n              '<span class=\"muted\">банки — напрямую</span></div></div>')\n    body = (f'<div class=\"onb\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"bg\", \"mark-bg\")}'\n            f'<div class=\"brand\" style=\"position:relative\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"br\")}{html.escape(BRAND_TITLE.lower())}</div>'\n            \"<h1>Подключитесь за две минуты</h1>\"\n            '<p class=\"lead\">Без регистрации и без Telegram — всё прямо здесь.</p>' + sample +\n            '<ul class=\"ticks\"><li>Установите приложение — кнопка откроет App Store или Google Play</li>'\n            \"<li>Добавьте ключ одной кнопкой</li><li>Включите — банки и Госуслуги работают как обычно</li></ul></div>\"\n            '<div class=\"dock\"><div class=\"dock-in\"><form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + html.escape(device) if device else \"\"}</button></form>'\n            f'<small>Потом — от {cheapest} ₽ в месяц, без автосписаний. Уже подключались? Откройте свою личную ссылку.</small>'\n            '<small><a href=\"/docs/tariffs\">Тарифы</a> · <a href=\"/docs/terms\">Соглашение</a> · <a href=\"/docs/privacy\">Конфиденциальность</a></small>'\n            \"</div></div>\")\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", simple(\"Слишком много попыток\",\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или из другой сети — \"\n                    \"например, с мобильного интернета вместо Wi-Fi.</p>\"), status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\") + \"#setup\")\n\n\ndef _service(request):\n    keys = _keys()\n    return DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()), client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n\n\nasync def _create_device(request, tg_id, platform):\n    try:\n        return await _service(request).create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\ndef days_left(until):\n    from datetime import datetime, timezone\n    return max(1, (until - datetime.now(timezone.utc).replace(tzinfo=None)).days + 1)\n\n\ndef key_pass(user, active_count):\n    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n    until = payments.active_until(user)\n    limit = user.get(\"device_limit\") or 3\n    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n    if until:\n        days = days_left(until)\n        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n                f'<div class=\"big\">{day_month(until)}</div>'\n                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n    else:\n        body = (f'{head}<span class=\"state off\">Не активен</span></div><p class=\"label\">Доступ закончился</p>'\n                '<div class=\"big\">Продлите</div><div class=\"sub\">Ключи заработают сразу после оплаты.</div>')\n    return (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}{body}<div class=\"perf\"></div>'\n            f'<div class=\"stub\"><span>Устройств: {active_count} из {limit}</span><a href=\"#pay\">Продлить →</a></div></div>')\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов. Это ваш личный кабинет — сохраните ссылку на него: вкладка «Ещё» → '\n                  '«Скопировать ссылку».</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Ключ не создался: сервер не ответил. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    active = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"status\"] == \"active\"]\n    chip = ('<span class=\"chip off\"><i></i>Не активен</span>' if not until else\n            '<span class=\"chip soon\"><i></i>Заканчивается</span>' if days_left(until) <= 3 else '<span class=\"chip\"><i></i>Активен</span>')\n\n    # -- home\n    devices = \"\".join(row(\"#setup\", \"phone\", html.escape(d[\"label\"]), f'ключ выдан {html.escape(str(d.get(\"created_at\") or \"\")[:10])}')\n                      for d in active)\n    home = (f'<section class=\"screen\" id=\"home\"><div class=\"hero\" style=\"margin:0 -16px\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"bg\", \"mark-bg\")}'\n            f'{key_pass(user, len(active))}</div>{flash}<div class=\"cap\">Быстрые действия</div><div class=\"tiles\">'\n            f'<a class=\"tile primary\" href=\"#setup\"><span class=\"ic\">{ICONS[\"setup\"]}</span><b>Подключить устройство</b></a>'\n            f'<a class=\"tile\" href=\"#pay\"><span class=\"ic\">{ICONS[\"pay\"]}</span><b>Продлить доступ</b></a>'\n            f'<a class=\"tile\" href=\"#more\"><span class=\"ic\">{ICONS[\"link\"]}</span><b>Ссылка на кабинет</b></a>'\n            f'<a class=\"tile\" href=\"/docs/support\"><span class=\"ic\">{ICONS[\"chat\"]}</span><b>Поддержка</b></a></div>'\n            + (f'<div class=\"cap\">Мои устройства</div><div class=\"group\">{devices}</div>' if devices else \"\") + \"</section>\")\n\n    # -- setup\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    name = dict(WEB_PLATFORMS)[platform]\n    seg = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}#setup\">{label}</a>' for key, label in WEB_PLATFORMS)\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n    setup = f'<section class=\"screen\" id=\"setup\"><h1 class=\"large\">Подключение</h1><div class=\"seg\">{seg}</div>'\n    if platform == \"ios\":\n        setup += ('<div class=\"seg small\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru#setup\">Российский App Store</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other#setup\">Другой страны</a></div>')\n    setup += '<div class=\"group pad\">'\n    if not until:\n        setup += ('<div class=\"hint\" style=\"margin:0\">Срок доступа закончился — VPN на ваших устройствах отключён. '\n                  'Продлите во вкладке «Оплата»: ключи заработают сразу, настраивать заново не нужно.</div>'\n                  '<a class=\"btn\" href=\"#pay\" style=\"margin-top:12px\">Продлить</a>')\n    elif not device:\n        setup += (f'<p class=\"muted\" style=\"margin-top:0\">Для {html.escape(name)} ещё нет ключа.</p>'\n                  f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\"><button class=\"btn\">Создать ключ для {html.escape(name)}</button></form>'\n                  '<p class=\"muted\">Ключ появится через несколько секунд.</p>')\n    else:\n        link = import_link(app, platform, device, base)\n        setup += (f'<ol class=\"steps\"><li><b>Установите {app.name}</b>'\n                  f'<a class=\"btn\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            setup += '<div class=\"hint\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        setup += '</li>'\n        if link:\n            setup += (f'<li><b>Добавьте ключ</b><a class=\"btn\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<p class=\"muted\">Приложение откроется само и спросит подтверждение.</p></li>')\n        else:\n            setup += (f'<li><b>Добавьте ключ по ссылке</b><div class=\"linkbox\"><code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></li>')\n        setup += f'<li><b>Включите</b><p class=\"muted\">{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</p></li>'\n        if user[\"tg_id\"] < 0:  # right after the VPN works, Telegram opens too: join the accounts then\n            setup += (f'<li><b>Подключите Telegram</b><p class=\"muted\">VPN включён — Telegram тоже заработал. Откройте наш бот: '\n                      'устройства, срок и оплата станут общими, и он напомнит, когда пора продлить.</p>'\n                      f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></li>')\n        setup += '</ol>'\n    setup += '</div>'\n    if until and device:\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            setup += ('<div class=\"cap\">Видео · 1,5 минуты</div>'\n                      f'<video src=\"/media/{video}\" poster=\"/web/{os.path.splitext(video)[0]}-poster.jpg\" controls playsinline preload=\"none\"></video>')\n        switches = \"\".join(row(f\"?p={platform}&store={store}&app={key}#setup\", \"phone\", html.escape(label))\n                           for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []))\n        if switches:\n            setup += f'<div class=\"cap\">Не получается?</div><div class=\"group\">{switches}</div>'\n    setup += \"</section>\"\n\n    # -- pay\n    pay = '<section class=\"screen\" id=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\n    # -- more\n    link = f\"{base}/c/{token}\"\n    linked_step = bool(device) and until and user[\"tg_id\"] < 0\n    if linked_step:\n        tg = \"\"  # offered as step 4 of the setup\n    elif user[\"tg_id\"] > 0:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin:0\">Кабинет связан с Telegram: в боте '\n              f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> те же устройства, срок и оплата. '\n              'Там же придёт напоминание за 3 дня до конца срока.</p></div>')\n    else:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin-top:0\">Подключите наш бот — '\n              'в нём будут те же устройства и срок, и он напомнит, когда пора продлить.</p>'\n              f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></div>')\n    more = ('<section class=\"screen\" id=\"more\"><h1 class=\"large\">Ещё</h1><div class=\"cap\">Ссылка на кабинет</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Это вход в кабинет — логина и пароля нет. Сохраните ссылку в заметки или добавьте '\n            'страницу на экран «Домой»: «Поделиться» → «На экран „Домой“».</p>'\n            f'<div class=\"linkbox\"><code>{html.escape(link)}</code><button onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано\\')\">Скопировать ссылку</button></div>'\n            '<p class=\"muted\">Не пересылайте её никому: по ней открывается ваш доступ.</p></div>'\n            + tg + f'<div class=\"cap\">Документы и помощь</div><div class=\"group\">{DOC_ROWS}</div></section>')\n\n    tabbar = ('<div class=\"tabbar\"><nav>' + \"\".join(f'<a href=\"#{key}\">{ICONS[key]}{label}</a>' for key, label in TABS) + \"</nav></div>\")\n    body = (f'<div class=\"app\">{appbar(f\"/c/{token}#home\", chip)}{home}{setup}{pay}{more}</div>{tabbar}{TAB_SCRIPT}')\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\n'''\ns=s[:start]+new+s[end:]\n# helpers removed: top(), sheet(), logo(), FOOTER — fix remaining references\ns=s.replace('''    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))''','''    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\") + \"#setup\")''')\ns=s.replace('''        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")''','''        raise web.HTTPSeeOther(f\"/c/{token}?err=pay#pay\")''')\nold='''    return page(BRAND_TITLE, top(\"\") + sheet(f'<section class=\"doc\">{text}</section><a class=\"btn quiet\" href=\"/app\">Назад</a>', flat=True))'''\nassert old in s\ns=s.replace(old,'''    titles = {\"terms\": \"Соглашение\", \"privacy\": \"Конфиденциальность\", \"tariffs\": \"Тарифы\", \"support\": \"Поддержка\"}\n    return page(BRAND_TITLE, simple(titles[request.match_info[\"name\"]], f'<div class=\"doc\">{text}</div>'))''')\nopen(p,'w').write(s)\nimport re\nfor name in (\"top(\", \"sheet(\", \"logo(\", \"FOOTER\"):\n    print(name, len(re.findall(re.escape(name), s)))\nPYEOF\npython3 -c \"import ast;ast.parse(open('webapp.py').read());print('syntax ok')\"; PYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=/tmp/x_m.db AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay python3 -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -E \"^(FAIL|ERROR)|Error|Ran|^OK|FAILED|line [0-9]+, in test\" | head -20; rm -f /tmp/x_m.db","description":"Rebuild the web cabinet as an app: app bar, tab bar and separate screens","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1084,"cache_read_input_tokens":876682,"output_tokens":14625,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1084,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":14625,"cache_read_input_tokens":876682,"cache_creation_input_tokens":1084,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1084},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01QUvU8jPRMfRz7eRRZ8xks1":{"command":"cd /private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad/nexo-work && python3 - <<'PYEOF'\np='webapp.py'; s=open(p).read()\nstart=s.index('STYLE = FONTS + \"\"\"')\nend=s.index('async def handle_device(request):')\nnew=r'''STYLE = FONTS + \"\"\"\n:root{--blue:#2F6BFF;--ink:#0B1F3A;--slate:#5B6B86;--mist:#F2F5FA;--line:#E3E9F3;--paper:#FFFFFF;--app:#EEF2F8;\n --green:#13A86B;--red:#E5484D;--amber:#C26A00;--top:env(safe-area-inset-top);--bottom:env(safe-area-inset-bottom)}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{overflow-x:hidden}\nbody{margin:0;background:var(--app);color:var(--ink);font:400 16px/1.45 Manrope,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n -webkit-font-smoothing:antialiased;overscroll-behavior-y:none}\na{color:var(--blue)}button{font-family:inherit}\n.app{max-width:520px;margin:0 auto;min-height:100vh;padding-bottom:calc(84px + var(--bottom))}\n.appbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:10px;\n padding:calc(10px + var(--top)) 18px 10px;background:var(--blue);color:#fff}\n.brand{display:flex;align-items:center;gap:8px;color:#fff;text-decoration:none;font:700 19px/1 Unbounded,sans-serif}\n.brand svg{width:26px;height:26px}\n.chip{font-size:12px;font-weight:800;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.16);color:#fff;white-space:nowrap}\n.chip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:#7CF0B6;vertical-align:1px}\n.chip.off i{background:#FF9CA8}.chip.soon i{background:#FFC46B}\n.hero{background:var(--blue);padding:6px 18px 26px;border-radius:0 0 28px 28px;position:relative;overflow:hidden}\n.mark-bg{position:absolute;right:-120px;top:-90px;width:320px;height:320px;opacity:.12;pointer-events:none}\n.screen{padding:0 16px}.js .screen{display:none}.js .screen.on{display:block;animation:fade .22s ease-out}\n@keyframes fade{from{opacity:0;transform:translateY(6px)}}\n.large{font:600 27px/1.15 Unbounded,sans-serif;letter-spacing:-.015em;margin:22px 4px 14px}\n.group{background:var(--paper);border-radius:20px;padding:6px 16px;margin:0 0 14px;box-shadow:0 1px 2px rgba(11,31,58,.05)}\n.group.pad{padding:16px}\n.cap{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--slate);margin:18px 4px 8px}\n.row{display:flex;align-items:center;gap:12px;padding:13px 0;color:var(--ink);text-decoration:none}\n.row+.row{border-top:1px solid var(--line)}.row .tx{flex:1;min-width:0}.row .tx b{display:block;font-weight:700}\n.row .tx span{display:block;font-size:13px;color:var(--slate)}.row .chev{color:#A7B3C8;font-size:20px;line-height:1}\n.ic{flex:none;width:36px;height:36px;border-radius:11px;display:grid;place-items:center;background:var(--mist);color:var(--blue)}\n.ic svg,.tile svg,.tabbar svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}\n.tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:-2px 0 14px}\n.tile{background:var(--paper);border-radius:20px;padding:16px;color:var(--ink);text-decoration:none;box-shadow:0 1px 2px rgba(11,31,58,.05);\n display:flex;flex-direction:column;gap:22px;min-height:112px;transition:transform .12s}\n.tile:active,.row:active{transform:scale(.98)}\n.tile .ic{background:#E8EFFF}.tile b{font-weight:800;font-size:15px;line-height:1.25}\n.tile.primary{background:var(--ink);color:#fff}.tile.primary .ic{background:rgba(255,255,255,.12);color:#fff}\n.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:52px;border:0;border-radius:14px;padding:14px 18px;\n font:800 16px/1.2 Manrope,sans-serif;text-decoration:none;cursor:pointer;background:var(--blue);color:#fff;transition:transform .12s}\n.btn:active{transform:scale(.985)}.btn.white{background:#fff;color:var(--ink)}.btn.quiet{background:var(--mist);color:var(--ink)}\n.btn:focus-visible,.tile:focus-visible,.row:focus-visible,.tabbar a:focus-visible{outline:3px solid #9DB8FF;outline-offset:2px}\n.muted{color:var(--slate);font-size:14px}p{margin:6px 0}\n.pass{position:relative;background:#fff;color:var(--ink);border-radius:18px;padding:16px 18px 14px;box-shadow:0 16px 36px rgba(11,31,58,.22);\n margin-top:8px;animation:rise .6s cubic-bezier(.2,.8,.2,1) both}\n@keyframes rise{from{opacity:0;transform:translateY(22px)}}\n@media (prefers-reduced-motion:reduce){.pass,.js .screen.on{animation:none}.btn,.tile,.row{transition:none}}\n.pass .head{display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--slate)}\n.state{display:inline-flex;align-items:center;gap:6px;letter-spacing:.02em;text-transform:none;font-size:13px}\n.state::before{content:\"\";width:8px;height:8px;border-radius:50%;background:currentColor}\n.state.on{color:var(--green)}.state.off{color:var(--red)}.state.soon{color:var(--amber)}\n.pass .label{margin:12px 0 0;font-size:13px;color:var(--slate)}.pass .big{font:600 29px/1.08 Unbounded,sans-serif;margin:2px 0 4px}\n.pass .sub{font-size:14px;color:var(--slate)}\n.meter{height:6px;border-radius:6px;background:var(--mist);margin:12px 0 0;overflow:hidden}.meter i{display:block;height:100%;background:var(--blue);border-radius:6px}\n.perf{position:relative;margin:14px -18px 10px;border-top:2px dashed var(--line)}\n.perf::before,.perf::after{content:\"\";position:absolute;top:-11px;width:20px;height:20px;border-radius:50%;background:var(--blue)}\n.perf::before{left:-10px}.perf::after{right:-10px}\n.stub{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:14px;font-weight:700}.stub a{text-decoration:none;font-weight:800}\n.pass .mk{position:absolute;right:16px;top:42px;width:46px;height:46px}\n.seg{display:flex;background:#E4EAF3;border-radius:12px;padding:3px;gap:3px;margin:0 0 12px}\n.seg a{flex:1;min-width:0;text-align:center;padding:9px 2px;border-radius:10px;color:var(--slate);font-weight:700;font-size:14px;text-decoration:none;\n white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.seg a.on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(11,31,58,.16)}\n.seg.small a{font-size:13px;padding:7px 2px}\nol.steps{list-style:none;margin:4px 0 0;padding:0;counter-reset:s}\nol.steps li{position:relative;padding:4px 0 20px 46px;counter-increment:s}\nol.steps li::before{content:counter(s);position:absolute;left:0;top:2px;width:30px;height:30px;border-radius:50%;background:var(--ink);color:#fff;\n font:600 13px/30px Unbounded,sans-serif;text-align:center}\nol.steps li::after{content:\"\";position:absolute;left:14px;top:38px;bottom:4px;width:2px;background:var(--line)}\nol.steps li:last-child{padding-bottom:6px}ol.steps li:last-child::after{display:none}\nol.steps b{display:block;font-size:16px;margin:3px 0 10px}ol.steps .muted{margin-top:6px}\n.hint{border-left:3px solid var(--blue);background:var(--mist);padding:10px 12px;border-radius:0 10px 10px 0;font-size:14px;margin:10px 0 0}\nvideo{display:block;width:100%;aspect-ratio:9/16;max-height:70vh;object-fit:contain;background:var(--ink);border-radius:16px}\n.plan{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;padding:14px 0;color:var(--ink);cursor:pointer;text-align:left;font:inherit}\nform+form .plan{border-top:1px solid var(--line)}form{margin:0}\n.plan .t{flex:1;font-weight:800}.plan .t span.s{display:block;font-weight:500;font-size:13px;color:var(--slate)}\n.price{font:600 16px Unbounded,sans-serif;white-space:nowrap}\n.go{flex:none;width:34px;height:34px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-size:17px}\n.tag{display:inline-block;margin-left:6px;font-size:11px;font-weight:800;color:var(--green);background:#E3F6EC;border-radius:6px;padding:2px 6px;vertical-align:2px}\n.linkbox{display:flex;gap:8px;align-items:center;background:var(--mist);border-radius:12px;padding:6px 6px 6px 12px;margin:10px 0 6px}\n.linkbox code{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font:600 13px/1 Manrope,sans-serif;color:var(--slate)}\n.linkbox button{border:0;background:var(--ink);color:#fff;border-radius:9px;padding:11px 12px;font:800 13px Manrope,sans-serif;cursor:pointer;white-space:nowrap}\n.flash{border-radius:16px;padding:12px 14px;margin:14px 0 0;font-weight:700;font-size:15px;background:#E3F6EC;color:#0B5E3B}\n.flash.err{background:#FDECEC;color:#8E1F24}\n.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;justify-content:center;background:rgba(255,255,255,.92);\n -webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);border-top:1px solid var(--line);padding-bottom:var(--bottom)}\n.tabbar nav{display:flex;width:100%;max-width:520px}\n.tabbar a{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 0 8px;color:#8A97AD;text-decoration:none;font-size:11px;font-weight:700}\n.tabbar a.on{color:var(--blue)}.tabbar svg{width:24px;height:24px}\n.onb{min-height:100vh;background:var(--blue);color:#fff;display:flex;flex-direction:column;padding:calc(14px + var(--top)) 20px calc(150px + var(--bottom));\n position:relative;overflow:hidden;max-width:520px;margin:0 auto}\n.onb h1{font:600 30px/1.1 Unbounded,sans-serif;letter-spacing:-.015em;margin:26px 0 10px;position:relative}\n.onb .lead{color:rgba(255,255,255,.88);margin:0 0 22px;position:relative}\n.ticks{list-style:none;padding:0;margin:22px 0 0;position:relative}\n.ticks li{display:flex;gap:10px;align-items:flex-start;padding:7px 0;font-weight:600}\n.ticks li::before{content:\"✓\";flex:none;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:12px;font-weight:800}\n.dock{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#fff;border-radius:24px 24px 0 0;padding:16px 20px calc(14px + var(--bottom));\n box-shadow:0 -10px 30px rgba(11,31,58,.14)}\n.dock-in{max-width:480px;margin:0 auto;text-align:center}.dock small{display:block;color:var(--slate);font-size:13px;margin-top:8px}\n.doc{font-size:15px;line-height:1.55}\n\"\"\"\n\nICONS = {\n    \"home\": '<svg viewBox=\"0 0 24 24\"><path d=\"M3.5 10.5 12 3.5l8.5 7V20a1 1 0 0 1-1 1H15v-6H9v6H4.5a1 1 0 0 1-1-1z\"/></svg>',\n    \"setup\": '<svg viewBox=\"0 0 24 24\"><path d=\"M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1\"/><path d=\"M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1\"/></svg>',\n    \"pay\": '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5.5\" width=\"18\" height=\"13\" rx=\"2.5\"/><path d=\"M3 10h18M7 15h3.5\"/></svg>',\n    \"more\": '<svg viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"12\" r=\"1.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.3\"/><circle cx=\"18\" cy=\"12\" r=\"1.3\"/></svg>',\n    \"phone\": '<svg viewBox=\"0 0 24 24\"><rect x=\"7\" y=\"2.5\" width=\"10\" height=\"19\" rx=\"2.5\"/><path d=\"M11 18h2\"/></svg>',\n    \"chat\": '<svg viewBox=\"0 0 24 24\"><path d=\"M4 5h16v11H9l-5 4z\"/></svg>',\n    \"link\": '<svg viewBox=\"0 0 24 24\"><path d=\"M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1\"/><path d=\"M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1\"/></svg>',\n    \"doc\": '<svg viewBox=\"0 0 24 24\"><path d=\"M7 3h7l4 4v14H7z\"/><path d=\"M14 3v4h4M10 12h5M10 16h5\"/></svg>',\n    \"send\": '<svg viewBox=\"0 0 24 24\"><path d=\"M21 4 3 11l7 2 2 7z\"/><path d=\"m10 13 5-5\"/></svg>',\n}\nTABS = ((\"home\", \"Главная\"), (\"setup\", \"Подключить\"), (\"pay\", \"Оплата\"), (\"more\", \"Ещё\"))\nTAB_SCRIPT = \"\"\"<script>(function(){var ids=['home','setup','pay','more'];function show(){var h=(location.hash||'#home').slice(1);\nif(ids.indexOf(h)<0)h='home';document.querySelectorAll('.screen').forEach(function(s){s.classList.toggle('on',s.id===h)});\ndocument.querySelectorAll('.tabbar a').forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+h)});window.scrollTo(0,0)}\nwindow.addEventListener('hashchange',show);show()})();</script>\"\"\"\n\n\ndef page(title, body, status=200, headers=None):\n    doc = f\"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#2F6BFF\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"{html.escape(BRAND_TITLE)}\">\n<link rel=\"apple-touch-icon\" href=\"/web/icon.png\"><link rel=\"manifest\" href=\"/web/manifest.webmanifest\">\n<link rel=\"preload\" href=\"/web/fonts/unbounded-cyrillic.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n<script>document.documentElement.className='js'</script>\n<title>{html.escape(title)}</title><style>{STYLE}</style></head><body>{body}</body></html>\"\"\"\n    return web.Response(text=doc, status=status, content_type=\"text/html\", headers={\n        \"Cache-Control\": \"no-store\", \"X-Robots-Tag\": \"noindex, nofollow\", \"Referrer-Policy\": \"no-referrer\",\n        \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\",\n        \"Content-Security-Policy\": \"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; font-src 'self'; \"\n                                   \"img-src 'self' data:; media-src 'self'; base-uri 'none'; frame-ancestors 'none'; \"\n                                   \"form-action 'self' https://pay.platega.io https://t.me\",\n        **(headers or {})})\n\n\ndef appbar(home=\"/app\", right=\"\"):\n    return (f'<header class=\"appbar\"><a class=\"brand\" href=\"{home}\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"br\")}'\n            f'{html.escape(BRAND_TITLE.lower())}</a>{right}</header>')\n\n\ndef row(href, icon, title, sub=\"\", external=False):\n    target = ' target=\"_blank\" rel=\"noreferrer\"' if external else \"\"\n    return (f'<a class=\"row\" href=\"{href}\"{target}><span class=\"ic\">{ICONS[icon]}</span><span class=\"tx\"><b>{title}</b>'\n            f'{f\"<span>{sub}</span>\" if sub else \"\"}</span><span class=\"chev\">›</span></a>')\n\n\nDOC_ROWS = (row(\"/docs/tariffs\", \"doc\", \"Тарифы\") + row(\"/docs/terms\", \"doc\", \"Пользовательское соглашение\")\n            + row(\"/docs/privacy\", \"doc\", \"Политика конфиденциальности\") + row(\"/docs/support\", \"chat\", \"Поддержка\"))\n\n\ndef price(value: int) -> str:\n    return f\"{value:,} ₽\".replace(\",\", \" \")\n\n\ndef per_month(plan) -> int:\n    return round(plan[\"price\"] / (payments.DAYS[plan[\"key\"]] / 30))\n\n\ndef simple(title, inner, back=\"/app\"):\n    \"\"\"A plain app screen: app bar, large title, one white group (documents, errors).\"\"\"\n    return (f'<div class=\"app\">{appbar(back)}<div class=\"screen\" style=\"display:block\"><h1 class=\"large\">{title}</h1>'\n            f'<div class=\"group pad\">{inner}</div><a class=\"btn quiet\" href=\"{back}\">Назад</a></div></div>')\n\n\n# ---------------------------------------------------------------- landing -------\nasync def handle_landing(request):\n    db = request.app[_keys().DATABASE_KEY]\n    token = request.cookies.get(COOKIE, \"\")\n    if token and db.get_user_by_web_token(token):\n        raise web.HTTPFound(f\"/c/{token}\")\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    device = dict(WEB_PLATFORMS).get(platform, \"\")\n    cheapest = min(per_month(t) for t in payments.paid_tariffs())\n    sample = (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}'\n              f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}<span class=\"state on\">готов к выдаче</span></div>'\n              f'<p class=\"label\">Пробный доступ</p><div class=\"big\">{TRIAL_DAYS} дней бесплатно</div>'\n              '<div class=\"sub\">Австрия и Бразилия · до 3 устройств</div>'\n              f'<div class=\"perf\"></div><div class=\"stub\"><span>{html.escape(device or \"Телефон или компьютер\")}</span>'\n              '<span class=\"muted\">банки — напрямую</span></div></div>')\n    body = (f'<div class=\"onb\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"bg\", \"mark-bg\")}'\n            f'<div class=\"brand\" style=\"position:relative\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"br\")}{html.escape(BRAND_TITLE.lower())}</div>'\n            \"<h1>Подключитесь за две минуты</h1>\"\n            '<p class=\"lead\">Без регистрации и без Telegram — всё прямо здесь.</p>' + sample +\n            '<ul class=\"ticks\"><li>Установите приложение — кнопка откроет App Store или Google Play</li>'\n            \"<li>Добавьте ключ одной кнопкой</li><li>Включите — банки и Госуслуги работают как обычно</li></ul></div>\"\n            '<div class=\"dock\"><div class=\"dock-in\"><form method=\"post\" action=\"/app/start\">'\n            f'<button class=\"btn\">Начать{\" на \" + html.escape(device) if device else \"\"}</button></form>'\n            f'<small>Потом — от {cheapest} ₽ в месяц, без автосписаний. Уже подключались? Откройте свою личную ссылку.</small>'\n            '<small><a href=\"/docs/tariffs\">Тарифы</a> · <a href=\"/docs/terms\">Соглашение</a> · <a href=\"/docs/privacy\">Конфиденциальность</a></small>'\n            \"</div></div>\")\n    return page(f\"{BRAND_TITLE} — подключение\", body)\n\n\nasync def handle_start(request):\n    keys = _keys()\n    db = request.app[keys.DATABASE_KEY]\n    if not _allowed_start(request.remote or \"unknown\"):\n        return page(\"Слишком много попыток\", simple(\"Слишком много попыток\",\n                    \"<p>С этого адреса сегодня уже начинали подключение. Попробуйте завтра или из другой сети — \"\n                    \"например, с мобильного интернета вместо Wi-Fi.</p>\"), status=429)\n    tg_id, token = db.create_web_user(TRIAL_DAYS)\n    platform = detect_platform(request.headers.get(\"User-Agent\", \"\"))\n    if platform:\n        await _create_device(request, tg_id, platform)\n    raise web.HTTPSeeOther(f\"/c/{token}?new=1\" + (f\"&p={platform}\" if platform else \"\") + \"#setup\")\n\n\ndef _service(request):\n    keys = _keys()\n    return DeviceService(nodes=list(request.app[keys.NODE_PROVIDER_KEY]()), client_factory=request.app[keys.DEVICE_CLIENT_FACTORY_KEY])\n\n\nasync def _create_device(request, tg_id, platform):\n    try:\n        return await _service(request).create(tg_id, \"\", \"Web\", PLATFORMS[platform], platform, f\"web-{platform}\")\n    except DeviceError:\n        return None\n\n\n# ---------------------------------------------------------------- cabinet -------\ndef _user(request):\n    db = request.app[_keys().DATABASE_KEY]\n    user = db.get_user_by_web_token(request.match_info.get(\"token\", \"\"))\n    if not user:\n        raise web.HTTPNotFound(text=\"Not found\")\n    return db, user\n\n\ndef _device_for(db, user, platform):\n    rows = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"platform\"] == platform and d[\"status\"] == \"active\"]\n    return rows[-1] if rows else None\n\n\ndef days_left(until):\n    from datetime import datetime, timezone\n    return max(1, (until - datetime.now(timezone.utc).replace(tzinfo=None)).days + 1)\n\n\ndef key_pass(user, active_count):\n    \"\"\"The personal key as a ticket: status, end date, days left (a full bar is 30 days), devices.\"\"\"\n    until = payments.active_until(user)\n    limit = user.get(\"device_limit\") or 3\n    head = f'<div class=\"head\">Ключ {html.escape(BRAND_TITLE)}'\n    if until:\n        days = days_left(until)\n        state = '<span class=\"state soon\">Заканчивается</span>' if days <= 3 else '<span class=\"state on\">Активен</span>'\n        body = (f'{head}{state}</div><p class=\"label\">Доступ до</p>'\n                f'<div class=\"big\">{day_month(until)}</div>'\n                f'<div class=\"sub\">осталось {days} {plural(days, \"день\", \"дня\", \"дней\")} · до {until:%d.%m.%Y}</div>'\n                f'<div class=\"meter\"><i style=\"width:{min(100, round(days / 30 * 100))}%\"></i></div>')\n    else:\n        body = (f'{head}<span class=\"state off\">Не активен</span></div><p class=\"label\">Доступ закончился</p>'\n                '<div class=\"big\">Продлите</div><div class=\"sub\">Ключи заработают сразу после оплаты.</div>')\n    return (f'<div class=\"pass\">{knot(\"#2F6BFF\", \"#FFFFFF\", \"#0B1F3A\", \"pk\", \"mk\")}{body}<div class=\"perf\"></div>'\n            f'<div class=\"stub\"><span>Устройств: {active_count} из {limit}</span><a href=\"#pay\">Продлить →</a></div></div>')\n\n\nasync def handle_cabinet(request):\n    db, user = _user(request)\n    token = request.match_info[\"token\"]\n    base = request.app[_keys().PUBLIC_BASE_URL_KEY].rstrip(\"/\")\n    q = request.query\n    flash = \"\"\n    if q.get(\"check\", \"\").isdigit():  # back from the payment page\n        payment = db.get_payment(int(q[\"check\"]))\n        if payment and payment[\"tg_id\"] == user[\"tg_id\"]:\n            try:\n                payment, _ = await payments.check(payment, service=_service(request))\n            except payments.PaymentError:\n                pass\n            flash = ('<div class=\"flash\">Оплата получена, доступ продлён.</div>' if payment[\"status\"] == \"paid\" else\n                     '<div class=\"flash err\">Оплата пока не поступила. Если вы уже оплатили — обновите страницу через минуту.</div>'\n                     if payment[\"status\"] == \"pending\" else '<div class=\"flash err\">Оплата не прошла, деньги не списаны. Можно попробовать ещё раз.</div>')\n            user = db.get_user(user[\"tg_id\"])\n    if q.get(\"new\"):\n        flash += ('<div class=\"flash\">Ключ готов. Это ваш личный кабинет — сохраните ссылку на него: вкладка «Ещё» → '\n                  '«Скопировать ссылку».</div>')\n    if q.get(\"err\") == \"device\":\n        flash += '<div class=\"flash err\">Ключ не создался: сервер не ответил. Попробуйте ещё раз через минуту.</div>'\n    if q.get(\"err\") == \"pay\":\n        flash += '<div class=\"flash err\">Страница оплаты не открылась. Попробуйте ещё раз через минуту.</div>'\n\n    until = payments.active_until(user)\n    active = [d for d in db.list_devices(user[\"tg_id\"]) if d[\"status\"] == \"active\"]\n    chip = ('<span class=\"chip off\"><i></i>Не активен</span>' if not until else\n            '<span class=\"chip soon\"><i></i>Заканчивается</span>' if days_left(until) <= 3 else '<span class=\"chip\"><i></i>Активен</span>')\n\n    # -- home\n    devices = \"\".join(row(\"#setup\", \"phone\", html.escape(d[\"label\"]), f'ключ выдан {html.escape(str(d.get(\"created_at\") or \"\")[:10])}')\n                      for d in active)\n    home = (f'<section class=\"screen\" id=\"home\"><div class=\"hero\" style=\"margin:0 -16px\">{knot(\"#FFFFFF\", \"#2F6BFF\", \"#2F6BFF\", \"bg\", \"mark-bg\")}'\n            f'{key_pass(user, len(active))}</div>{flash}<div class=\"cap\">Быстрые действия</div><div class=\"tiles\">'\n            f'<a class=\"tile primary\" href=\"#setup\"><span class=\"ic\">{ICONS[\"setup\"]}</span><b>Подключить устройство</b></a>'\n            f'<a class=\"tile\" href=\"#pay\"><span class=\"ic\">{ICONS[\"pay\"]}</span><b>Продлить доступ</b></a>'\n            f'<a class=\"tile\" href=\"#more\"><span class=\"ic\">{ICONS[\"link\"]}</span><b>Ссылка на кабинет</b></a>'\n            f'<a class=\"tile\" href=\"/docs/support\"><span class=\"ic\">{ICONS[\"chat\"]}</span><b>Поддержка</b></a></div>'\n            + (f'<div class=\"cap\">Мои устройства</div><div class=\"group\">{devices}</div>' if devices else \"\") + \"</section>\")\n\n    # -- setup\n    platform = q.get(\"p\") if q.get(\"p\") in dict(WEB_PLATFORMS) else detect_platform(request.headers.get(\"User-Agent\", \"\")) or \"ios\"\n    name = dict(WEB_PLATFORMS)[platform]\n    seg = \"\".join(f'<a class=\"{\"on\" if key == platform else \"\"}\" href=\"?p={key}#setup\">{label}</a>' for key, label in WEB_PLATFORMS)\n    apps = catalog.apps_for(platform)\n    store = q.get(\"store\") if q.get(\"store\") in catalog.STORE_APP else \"ru\"\n    default_app = catalog.STORE_APP[store] if platform == \"ios\" else apps[0].key\n    app = catalog.get_app(platform, q.get(\"app\") or default_app)\n    device = _device_for(db, user, platform)\n    setup = f'<section class=\"screen\" id=\"setup\"><h1 class=\"large\">Подключение</h1><div class=\"seg\">{seg}</div>'\n    if platform == \"ios\":\n        setup += ('<div class=\"seg small\">'\n                  f'<a class=\"{\"on\" if store != \"other\" else \"\"}\" href=\"?p=ios&store=ru#setup\">Российский App Store</a>'\n                  f'<a class=\"{\"on\" if store == \"other\" else \"\"}\" href=\"?p=ios&store=other#setup\">Другой страны</a></div>')\n    setup += '<div class=\"group pad\">'\n    if not until:\n        setup += ('<div class=\"hint\" style=\"margin:0\">Срок доступа закончился — VPN на ваших устройствах отключён. '\n                  'Продлите во вкладке «Оплата»: ключи заработают сразу, настраивать заново не нужно.</div>'\n                  '<a class=\"btn\" href=\"#pay\" style=\"margin-top:12px\">Продлить</a>')\n    elif not device:\n        setup += (f'<p class=\"muted\" style=\"margin-top:0\">Для {html.escape(name)} ещё нет ключа.</p>'\n                  f'<form method=\"post\" action=\"/c/{token}/device?p={platform}\"><button class=\"btn\">Создать ключ для {html.escape(name)}</button></form>'\n                  '<p class=\"muted\">Ключ появится через несколько секунд.</p>')\n    else:\n        link = import_link(app, platform, device, base)\n        setup += (f'<ol class=\"steps\"><li><b>Установите {app.name}</b>'\n                  f'<a class=\"btn\" href=\"{html.escape(app.install[0][1], quote=True)}\">Установить {app.name}</a>')\n        if not app.auto_rules and app.importer:\n            setup += '<div class=\"hint\">При первом запуске выберите язык «Русский» и страну «Россия» — так банки будут работать.</div>'\n        setup += '</li>'\n        if link:\n            setup += (f'<li><b>Добавьте ключ</b><a class=\"btn\" href=\"{html.escape(link, quote=True)}\">Добавить ключ в {app.name}</a>'\n                      '<p class=\"muted\">Приложение откроется само и спросит подтверждение.</p></li>')\n        else:\n            setup += (f'<li><b>Добавьте ключ по ссылке</b><div class=\"linkbox\"><code>{html.escape(base + \"/sub/\" + device[\"token\"])}</code></div></li>')\n        setup += f'<li><b>Включите</b><p class=\"muted\">{html.escape(catalog.POWER_ON[platform].format(app=app.name))}</p></li>'\n        if user[\"tg_id\"] < 0:  # right after the VPN works, Telegram opens too: join the accounts then\n            setup += (f'<li><b>Подключите Telegram</b><p class=\"muted\">VPN включён — Telegram тоже заработал. Откройте наш бот: '\n                      'устройства, срок и оплата станут общими, и он напомнит, когда пора продлить.</p>'\n                      f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></li>')\n        setup += '</ol>'\n    setup += '</div>'\n    if until and device:\n        video = catalog.VIDEOS.get(platform, {}).get(app.key)\n        if video and os.path.exists(os.path.join(ASSETS, \"video\", video)):\n            setup += ('<div class=\"cap\">Видео · 1,5 минуты</div>'\n                      f'<video src=\"/media/{video}\" poster=\"/web/{os.path.splitext(video)[0]}-poster.jpg\" controls playsinline preload=\"none\"></video>')\n        switches = \"\".join(row(f\"?p={platform}&store={store}&app={key}#setup\", \"phone\", html.escape(label))\n                           for label, key in catalog.SWITCH.get(platform, {}).get(app.key, []))\n        if switches:\n            setup += f'<div class=\"cap\">Не получается?</div><div class=\"group\">{switches}</div>'\n    setup += \"</section>\"\n\n    # -- pay\n    pay = '<section class=\"screen\" id=\"pay\"><h1 class=\"large\">Оплата</h1>'\n    if payments.enabled():\n        full = payments.tariff(\"m1\")[\"price\"]\n        pay += '<div class=\"group\">'\n        for t in payments.paid_tariffs():\n            months = payments.DAYS[t[\"key\"]] // 30\n            saving = round(100 * (1 - t[\"price\"] / (full * months))) if months > 1 else 0\n            tag = f'<span class=\"tag\">−{saving}%</span>' if saving >= 20 else \"\"\n            pay += (f'<form method=\"post\" action=\"/c/{token}/pay?tariff={t[\"key\"]}\"><button class=\"plan\">'\n                    f'<span class=\"t\">{t[\"title\"]}{tag}<span class=\"s\">{price(per_month(t))} в месяц</span></span>'\n                    f'<span class=\"price\">{price(t[\"price\"])}</span><span class=\"go\">→</span></button></form>')\n        pay += ('</div><p class=\"muted\" style=\"margin:0 4px\">Новый срок добавляется к оставшемуся. СБП, карта или криптовалюта. '\n                'Автоматических списаний нет.</p>')\n    else:\n        pay += '<div class=\"group pad\"><p class=\"muted\">Оплата скоро появится.</p></div>'\n    pay += \"</section>\"\n\n    # -- more\n    link = f\"{base}/c/{token}\"\n    linked_step = bool(device) and until and user[\"tg_id\"] < 0\n    if linked_step:\n        tg = \"\"  # offered as step 4 of the setup\n    elif user[\"tg_id\"] > 0:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin:0\">Кабинет связан с Telegram: в боте '\n              f'<a href=\"https://t.me/{BOT_USERNAME}\">@{BOT_USERNAME}</a> те же устройства, срок и оплата. '\n              'Там же придёт напоминание за 3 дня до конца срока.</p></div>')\n    else:\n        tg = ('<div class=\"cap\">Telegram</div><div class=\"group pad\"><p class=\"muted\" style=\"margin-top:0\">Подключите наш бот — '\n              'в нём будут те же устройства и срок, и он напомнит, когда пора продлить.</p>'\n              f'<form method=\"post\" action=\"/c/{token}/telegram\"><button class=\"btn quiet\">Подключить Telegram</button></form></div>')\n    more = ('<section class=\"screen\" id=\"more\"><h1 class=\"large\">Ещё</h1><div class=\"cap\">Ссылка на кабинет</div><div class=\"group pad\">'\n            '<p class=\"muted\" style=\"margin-top:0\">Это вход в кабинет — логина и пароля нет. Сохраните ссылку в заметки или добавьте '\n            'страницу на экран «Домой»: «Поделиться» → «На экран „Домой“».</p>'\n            f'<div class=\"linkbox\"><code>{html.escape(link)}</code><button onclick=\"navigator.clipboard.writeText(\\'{html.escape(link)}\\')'\n            '.then(()=>this.textContent=\\'Скопировано\\')\">Скопировать ссылку</button></div>'\n            '<p class=\"muted\">Не пересылайте её никому: по ней открывается ваш доступ.</p></div>'\n            + tg + f'<div class=\"cap\">Документы и помощь</div><div class=\"group\">{DOC_ROWS}</div></section>')\n\n    tabbar = ('<div class=\"tabbar\"><nav>' + \"\".join(f'<a href=\"#{key}\">{ICONS[key]}{label}</a>' for key, label in TABS) + \"</nav></div>\")\n    body = (f'<div class=\"app\">{appbar(f\"/c/{token}#home\", chip)}{home}{setup}{pay}{more}</div>{tabbar}{TAB_SCRIPT}')\n    return page(f\"{BRAND_TITLE} — кабинет\", body, headers={\n        \"Set-Cookie\": f\"{COOKIE}={token}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax\"})\n\n\n'''\ns=s[:start]+new+s[end:]\n# helpers removed: top(), sheet(), logo(), FOOTER — fix remaining references\ns=s.replace('''    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\"))''','''    raise web.HTTPSeeOther(f\"/c/{token}?p={platform}\" + (\"\" if row else \"&err=device\") + \"#setup\")''')\ns=s.replace('''        raise web.HTTPSeeOther(f\"/c/{token}?err=pay\")''','''        raise web.HTTPSeeOther(f\"/c/{token}?err=pay#pay\")''')\nold='''    return page(BRAND_TITLE, top(\"\") + sheet(f'<section class=\"doc\">{text}</section><a class=\"btn quiet\" href=\"/app\">Назад</a>', flat=True))'''\nassert old in s\ns=s.replace(old,'''    titles = {\"terms\": \"Соглашение\", \"privacy\": \"Конфиденциальность\", \"tariffs\": \"Тарифы\", \"support\": \"Поддержка\"}\n    return page(BRAND_TITLE, simple(titles[request.match_info[\"name\"]], f'<div class=\"doc\">{text}</div>'))''')\nopen(p,'w').write(s)\nimport re\nfor name in (\"top(\", \"sheet(\", \"logo(\", \"FOOTER\"):\n    print(name, len(re.findall(re.escape(name), s)))\nPYEOF\npython3 -c \"import ast;ast.parse(open('webapp.py').read());print('syntax ok')\"; PYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=/tmp/x_m.db AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay python3 -m unittest discover -s tests -p \"test_*.py\" 2>&1 | grep -E \"^(FAIL|ERROR)|Error|Ran|^OK|FAILED|line [0-9]+, in test\" | head -20; rm -f /tmp/x_m.db","description":"Rebuild the web cabinet as an app: app bar, tab bar and separate screens","timeout":300000}},"serverClassifierRequest":"d32df657-a7eb-46a7-997e-19069a59fd82","apiBlockIndex":0,"requestId":"req_011CgeDPH1Qspan64tHBD4Bz","requestRef":"ae48174c-8ef4-4a0b-8a25-dc5da8788f6c","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"2b91c603-bc02-4fb4-bf8e-ab007c32dcc3","timestamp":"2026-11-02T13:56:08.660Z","advisorModel":"claude-opus-5-5","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/Library/Application Support/Claude/scratch-workspaces/f907b165-4712-485f-a44b-7f7d54b74cf9/77d6453f-aaee-4ad3-a7ea-34b17cbaf2e5/scratch-2026-10-26-b13584","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
