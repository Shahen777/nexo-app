ta.startswith(\"new_device:\"))\n180:async def new_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n189:async def provision(callback: CallbackQuery, state: FSMContext, data):\n206:@router.callback_query(F.data.startswith(\"reuse_legacy:\"))\n207:async def reuse_legacy(callback: CallbackQuery, state: FSMContext, bot: Bot):\n217:@router.callback_query(F.data.startswith(\"reuse_device:\"))\n218:async def reuse_device(callback: CallbackQuery, state: FSMContext, bot: Bot):\n230:def key_urls(owner, data):\n231:    \"\"\"(label, install page URL, subscription URL for manual import) of the wizard's key, or None.\"\"\"\n234:        from handlers.vpn import subscription_urls\n248:def import_link(app, install):\n250:        if app.importer == \"happ\":\n252:        if app.importer == \"xray\":\n253:            return client_import_url(install, app.key)\n254:        if app.importer == \"karing\" and install.startswith(\"https://\"):\n262:async def render_step2(message, owner, data):\n272:    link = import_link(app, install)\n284:    if not app.auto_rules and app.importer:\n296:@router.callback_query(F.data.startswith(\"app:\"))\n297:async def choose_app(callback: CallbackQuery, state: FSMContext):\n309:@router.callback_query(F.data.startswith(\"step2:\"))\n310:async def back_to_step2(callback: CallbackQuery, state: FSMContext):\n319:@router.callback_query(F.data.startswith(\"howto:\"))\n320:async def howto_video(callback: CallbackQuery, state: FSMContext, bot: Bot):\n330:    link = import_link(app, urls[1])\n339:@router.callback_query(F.data.startswith(\"ob_qr:\"))\n340:async def wizard_qr(callback: CallbackQuery, state: FSMContext, bot: Bot):\n348:    from handlers.vpn import send_qr\n355:def power_on_keyboard(back):\n359:@router.callback_query(F.data.startswith(\"activate:\"))\n360:async def activate_platform(callback: CallbackQuery, state: FSMContext):\n377:@router.callback_query(F.data == \"connected\")\n378:async def connection_check(callback: CallbackQuery, 