"User-Agent\", \"\")) +\n''')\np = sub(p, '''    setup = f'<section class=\"screen\" data-tab=\"setup\"><h1 class=\"large\">Подключение</h1><div class=\"seg\">{seg}</div>'\n''', '''    notice = in_app_notice(request.headers.get(\"User-Agent\", \"\"))\n    flash = notice + flash\n    setup = f'<section class=\"screen\" data-tab=\"setup\"><h1 class=\"large\">Подключение</h1>{notice}<div class=\"seg\">{seg}</div>'\n''')\nopen('webapp.py','w').write(p)\nt = open('tests/test_webapp.py').read()\nt = sub(t, '''    async def test_landing_leads_to_the_code_entry(self):\n''', '''    async def test_browser_inside_another_app_is_told_to_open_a_real_one(self):\n        instagram = \"Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148 Instagram 350.0\"\n        text = await (await self.client.get(\"/app\", headers={\"User-Agent\": instagram})).text()\n        self.assertIn(\"Открыть в браузере\", text)\n        location = await self.start(ua=IPHONE)\n        cabinet = await (await self.client.get(location.split(\"?\")[0], headers={\"User-Agent\": instagram})).text()\n        self.assertIn(\"Открыть в браузере\", cabinet)\n        for agent in (IPHONE, ANDROID):\n            self.assertNotIn(\"Открыть в браузере\", await (await self.client.get(\"/app\", headers={\"User-Agent\": agent})).text())\n\n    async def test_page_can_be_zoomed(self):\n        text = await (await self.client.get(\"/app\", headers={\"User-Agent\": IPHONE})).text()\n        self.assertNotIn(\"user-scalable=no\", text)\n\n    async def test_landing_leads_to_the_code_entry(self):\n''')\nopen('tests/test_webapp.py','w').write(t)\nPY\nsed -n 345,352p webapp.py | cut -c1-120; export PYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=\"$S/speed/st.db\" AURA_PUBLIC_BASE_URL=https://example.test AURA_VERIFY_CODE=pay; python3 -m unittest discover -s tests -p \"test_webapp.py\" 2>&1 | tail -6 | cut -c1-170","description":"Allow page zoom, add the in-app browser notice, run web tests",