table\"),\n    \"macos\": (\"⬇️ Скачать Karing\", \"https://dot.karing.app/client.html?tag=macos-stable\"),\n    \"router\": (\"📖 Установка sing-box\", \"https://sing-box.sagernet.org/installation/package-manager/\"),\n}\n\n\n# Compatible client apps per platform, shown on the install step. All links are official\n# vendor/store pages (Happ: happ.su, checked 2026-10-29). The subscription is the same for every app.\nAPP_LINKS = {\n    # ⭐ = the app imports our subscription together with the Russian split-routing rules;\n    # nothing has to be toggled by hand. Other apps need the region rules enabled once manually.\n    \"ios\": [\n        (\"⭐ Happ · App Store других стран\", \"https://apps.apple.com/us/app/happ-proxy-utility/id6504287215?l=ru\"),\n        (\"⭐ Happ · для App Store Россия (сайт)\", \"https://www.happ.su/main\"),\n        (\"⭐ v2RayTun · App Store Россия\", \"https://apps.apple.com/ru/app/id6798667599\"),\n        (\"⭐ V2Box · App Store других стран\", \"https://apps.apple.com/us/app/v2box-v2ray-client/id6446814690\"),\n        (\"⭐ Streisand · App Store других стран\", \"https://apps.apple.com/us/app/streisand/id6450534064\"),\n        (\"Karing · App Store (есть в России, правила вручную)\", \"https://apps.apple.com/us/app/karing/id6472431552\"),\n    ],\n    \"android\": [\n        (\"⭐ Happ · Google Play\", \"https://play.google.com/store/apps/details?id=com.happproxy\"),\n        (\"⭐ Happ · APK\", \"https://github.com/Happ-proxy/happ-android/releases/latest/download/Happ.apk\"),\n        (\"⭐ v2RayTun · Google Play\", \"https://play.google.com/store/apps/details?id=com.v2raytun.android\"),\n        (\"Karing · APK (правила вручную)\", \"https://dot.karing.app/client.html?tag=android-stable\"),\n        (\"Hiddify · Google Play (правила вручную)\", \"https://play.google.com/store/apps/details?id=app.hiddify.com\"),\n    ],\n    \"windows\": [\n        (\"⭐ Happ · сайт\", \"https://www.happ.su/main\"),\n        (\"⭐ v2RayTun · сайт\", \"https://v