 -n chown shagen:shagen /opt/nexo-bot/catalog.py /opt/nexo-bot/navigation.py /opt/nexo-bot/handlers/onboarding.py /opt/nexo-bot/tests/test_onboarding.py /opt/nexo-bot/.gitignore\nG=\"sudo -n git -C /opt/nexo-bot -c safe.directory=/opt/nexo-bot\"\n$G status --short; $G ls-files | grep -E \"(^|/)\\.env$|\\.mp4$\" && echo \"BAD_TRACKED\" || echo \"no .env or video tracked\"\n$G add -A && $G -c user.name=Claude -c user.email=noreply@anthropic.com commit -q -m \"Karing install step: walkthrough video button (assets/video, kept out of git)\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\" && $G log --oneline -1\nsudo -n chown -R shagen:shagen /opt/nexo-bot/.git --from=root 2>/dev/null || true\nsudo -n systemctl restart nexo-bot; sleep 4; systemctl is-active nexo-bot nexo-subscription\nls -la /opt/nexo-bot/assets/video/\nsudo -n journalctl -u nexo-bot --since \"-1 min\" --no-pager | grep -iE \"error|traceback\" || echo \"no errors\"\nrm -f /tmp/nexo-video.tgz /tmp/nexo-karing_FINAL_intro.mp4'","description":"Deploy the video button and the Karing video to the Nexo bot","timeout":300000},"caller":{"type":"direct"}}]}}
