или не подошло — вернитесь назад и нажмите «Запасной вариант».\")\n        if platform == \"android\":\n            tips.append(\"• Нет Google Play — скачайте Happ кнопкой ниже.\")\n        tips.append(\"• Кнопка «Добавить ключ» не сработала — откройте приложение один раз и нажмите её снова. \"\n                    \"Или используйте QR-код.\")\n        return \"<b>Не получается установить или добавить ключ</b>\\n\\n\" + \"\\n\".join(tips)\n    return (\"<b>VPN не работает</b>\\n\\n\"\n            \"• Проверьте, что без VPN интернет есть.\\n\"\n            \"• В приложении обновите подписку и включите VPN снова.\\n\"\n            \"• Выключите другие VPN-приложения.\")\n\n\n@router.callback_query(F.data.startswith(\"stuck:\"))\nasync def stuck(callback: CallbackQuery, state: FSMContext):\n    parts = callback.data.split(\":\")\n    step = 2 if len(parts) > 1 and parts[1] == \"2\" else 3\n    await callback.answer()\n    data = await state.get_data()\n    nonce = data.get(\"request_id\")\n    has_key = bool(nonce and (data.get(\"device_id\") or data.get(\"legacy\")))\n    app = get_app(data.get(\"platform\"), data.get(\"app\")) if data.get(\"platform\") in PLATFORMS else None\n    rows = []\n    if step == 2 and app:\n        rows += [[url(label, link)] for label, link in app.install[1:]]\n    if step == 2 and has_key:\n        rows.append([cb(\"QR-код\", f\"ob_qr:{nonce}\")])\n    rows.append([support_button()])\n    if has_key:\n        rows.append([cb(\"‹ Назад\", f\"step2:{nonce}\" if step == 2 else f\"activate:{data.get('platform')}\")])\n    else:\n        rows.append([cb(\"‹ Мои устройства\", \"devices\"), cb(\"Главное меню\", \"back_main\")])\n    await show_card(callback.message, \"help\", stuck_text(step, data.get(\"platform\")), reply_markup=kb(*rows))\nhandlers/onboarding.py:230:def key_urls(owner, data):\nhandlers/onboarding.py:264:    urls = key_urls(owner, data)\nhandlers/onboarding.py:323:    urls = key_urls(callback.from_user.id, data) if data else No