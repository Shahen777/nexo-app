{"parentUuid":"4f5118fb-8210-431c-bdc6-71180be5e76d","isSidechain":false,"message":{"model":"claude-fable-5-1","id":"msg_011CgawTj1aefR6LtyJGPi7z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XBrRVe3wc8ZFDjCDwk6g9E","name":"Write","input":{"file_path":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory/build_nexo_karing.py","content":"#!/usr/bin/env python3\n\"\"\"Nexo · обучающий ролик «Подключение в Karing» (9:16, 1080x1920).\n\nВход: data/videos/nexo-karing/src/*.jpg — снимки окна Karing на Mac (402x734),\n       data/videos/nexo-karing/voice/s*.mp3 — озвучка ElevenLabs (по сцене).\nВыход: data/videos/nexo-karing/nexo-karing_FINAL.mp4\n\nСцены: заставка → бот (установить) → бот (добавить ключ) → Karing: добавление подписки →\n«Добавлено успешно» → главный экран, щит → включено → выбор сервера → финал.\nКлюч подписки на экранах размывается. Подсказки: пульсирующее кольцо + подпись внизу.\n\"\"\"\nimport json\nimport math\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont\n\nROOT = Path(__file__).resolve().parent\nP = ROOT / \"data/videos/nexo-karing\"\nSRC, VOICE, TMP = P / \"src\", P / \"voice\", P / \"tmp\"\nTMP.mkdir(exist_ok=True)\nW, H, FPS = 1080, 1920, 30\nBG_TOP, BG_BOT = (11, 31, 58), (8, 18, 34)\nACCENT, ACCENT2 = (47, 107, 255), (120, 170, 255)\nCHROME = \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"\n\nFONT_B = next(f for f in [\"/System/Library/Fonts/Supplemental/Arial Bold.ttf\", \"/Library/Fonts/Arial Bold.ttf\"] if Path(f).exists())\nFONT_R = next(f for f in [\"/System/Library/Fonts/Supplemental/Arial.ttf\", \"/Library/Fonts/Arial.ttf\"] if Path(f).exists())\n\n\ndef font(size, bold=False):\n    return ImageFont.truetype(FONT_B if bold else FONT_R, size)\n\n\ndef dur(path):\n    return float(subprocess.check_output([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n                                          \"-of\", \"csv=p=0\", str(path)]).decode().strip())\n\n\n# ---------------------------------------------------------------- bot mock ----\nBOT_HTML = \"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>\nhtml,body{margin:0;width:402px;height:734px;background:#0e1621;font-family:-apple-system,\"SF Pro Text\",Helvetica,Arial,sans-serif;color:#fff;overflow:hidden}\n.top{height:84px;background:#17212b;display:flex;align-items:flex-end;padding:0 16px 10px;gap:10px}\n.ava{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#2F6BFF,#6FA0FF);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px}\n.name{font-weight:700;font-size:17px}.sub{font-size:12px;color:#7d8b99}\n.msg{margin:14px 10px 0;background:#182533;border-radius:14px;overflow:hidden;width:330px}\n.msg img{display:block;width:330px}\n.txt{padding:10px 12px 8px;font-size:14.5px;line-height:1.35}.txt b{font-weight:700}\n.btn{margin:6px 10px 0;width:330px;background:#2b5278;border-radius:10px;padding:9px 0;text-align:center;font-size:14px;font-weight:600}\n.row{display:flex;gap:6px;margin:6px 10px 0;width:330px}.row .btn{margin:0;flex:1}\n.hint{position:absolute;bottom:14px;left:0;right:0;text-align:center;color:#7d8b99;font-size:12px}\n</style></head><body>\n<div class=\"top\"><div class=\"ava\">N</div><div><div class=\"name\">Nexo</div><div class=\"sub\">бот</div></div></div>\n<div class=\"msg\"><img src=\"step2.png\"><div class=\"txt\"><b>Шаг 2 из 3</b><br><br>1. Установите приложение Karing.<br>2. Нажмите «Добавить ключ в Karing».<br>3. Вернитесь сюда и нажмите «Готово».<br><br><i style=\"color:#a9b8d2\">Чтобы банки и Госуслуги работали, при первом запуске Karing выберите страну «Россия».</i></div></div>\n<div class=\"btn\">1️⃣ Установить Karing</div>\n<div class=\"btn\">2️⃣ Добавить ключ в Karing</div>\n<div class=\"btn\">✅ Готово →</div>\n<div class=\"btn\" style=\"background:#1f2f3f\">Запасной вариант — Happ</div>\n<div class=\"btn\" style=\"background:#1f2f3f\">‹ Вернуться к OneXray</div>\n<div class=\"row\"><div class=\"btn\" style=\"background:#1f2f3f\">‹ Назад</div><div class=\"btn\" style=\"background:#1f2f3f\">Не получается</div></div>\n</body></html>\"\"\"\n\n\ndef render_bot_mock():\n    out = TMP / \"bot_step2.png\"\n    if out.exists():\n        return out\n    card = ROOT.parent.parent / \"Documents/Codex/2026-08-02/vps/nexo-bot/candidate/assets/step2.png\"\n    (TMP / \"step2.png\").write_bytes(Path(card).read_bytes())\n    (TMP / \"bot.html\").write_text(BOT_HTML, encoding=\"utf-8\")\n    subprocess.run([CHROME, \"--headless=new\", \"--disable-gpu\", \"--hide-scrollbars\", \"--force-device-scale-factor=3\",\n                    \"--window-size=402,734\", f\"--screenshot={out}\", f\"file://{TMP / 'bot.html'}\"],\n                   check=True, capture_output=True)\n    return out\n\n\n# ---------------------------------------------------------------- screens -----\ndef load_screen(name, blur_box=None, cover=None):\n    im = Image.open(SRC / name).convert(\"RGB\")\n    if blur_box:\n        region = im.crop(blur_box).filter(ImageFilter.GaussianBlur(9))\n        im.paste(region, blur_box[:2])\n    if cover:  # hide the mouse pointer with the surrounding background colour\n        x, y, w, h = cover\n        ImageDraw.Draw(im).rectangle([x, y, x + w, y + h], fill=im.getpixel((x - 4, y + h // 2)))\n    return im\n\n\ndef rounded_mask(size, r):\n    m = Image.new(\"L\", size, 0)\n    ImageDraw.Draw(m).rounded_rectangle([0, 0, size[0] - 1, size[1] - 1], r, fill=255)\n    return m\n\n\ndef background():\n    bg = Image.new(\"RGB\", (W, H))\n    px = bg.load()\n    for y in range(H):\n        t = y / H\n        c = tuple(int(BG_TOP[i] * (1 - t) + BG_BOT[i] * t) for i in range(3))\n        for x in range(W):\n            px[x, y] = c\n    glow = Image.new(\"RGB\", (W, H), (0, 0, 0))\n    ImageDraw.Draw(glow).ellipse([W * 0.15, -200, W * 0.85, 500], fill=(30, 70, 160))\n    glow = glow.filter(ImageFilter.GaussianBlur(160))\n    return Image.blend(bg, Image.composite(glow, bg, glow.convert(\"L\").point(lambda v: min(255, v * 2))), 0.5)\n\n\nBG = background()\nPHONE_W, PHONE_H = 820, 1497   # 402x734 * 2.04\nPHONE_X, PHONE_Y = (W - PHONE_W) // 2, 250\n\n\ndef draw_text_center(d, y, text, f, fill=(255, 255, 255)):\n    tw = d.textlength(text, font=f)\n    d.text(((W - tw) / 2, y), text, font=f, fill=fill)\n\n\ndef wrap(text, f, maxw, d):\n    words, lines, cur = text.split(), [], \"\"\n    for w in words:\n        t = (cur + \" \" + w).strip()\n        if d.textlength(t, font=f) <= maxw:\n            cur = t\n        else:\n            lines.append(cur)\n            cur = w\n    return lines + [cur]\n\n\ndef frame(scene, t, T):\n    \"\"\"One frame: background, step chip, phone with screen, highlight ring, caption.\"\"\"\n    im = BG.copy()\n    d = ImageDraw.Draw(im, \"RGBA\")\n    if scene.get(\"card\"):\n        title, sub = scene[\"card\"]\n        k = min(1, t / 0.6)\n        d.text((W / 2 - d.textlength(\"NEXO\", font=font(44, True)) / 2, 700), \"NEXO\", font=font(44, True), fill=(149, 181, 255))\n        f = font(78, True)\n        for i, line in enumerate(wrap(title, f, 940, d)):\n            draw_text_center(d, 800 + i * 92, line, f, (255, 255, 255, int(255 * k)))\n        f2 = font(40)\n        for i, line in enumerate(wrap(sub, f2, 900, d)):\n            draw_text_center(d, 1060 + i * 52, line, f2, (185, 201, 228, int(255 * k)))\n        return im\n    # step chip\n    chip = scene[\"chip\"]\n    f = font(34, True)\n    tw = d.textlength(chip, font=f)\n    d.rounded_rectangle([W / 2 - tw / 2 - 34, 120, W / 2 + tw / 2 + 34, 196], 38, fill=(47, 107, 255, 70), outline=(120, 170, 255, 140), width=2)\n    d.text((W / 2 - tw / 2, 136), chip, font=f, fill=(214, 226, 247))\n    # phone\n    zoom = 1 + 0.035 * min(1, t / T)       # slow push-in\n    screen = scene[\"img\"]\n    sw, sh = int(PHONE_W * zoom), int(PHONE_H * zoom)\n    scr = screen.resize((sw, sh), Image.LANCZOS)\n    ox, oy = PHONE_X - (sw - PHONE_W) // 2, PHONE_Y - (sh - PHONE_H) // 2\n    shadow = Image.new(\"RGBA\", (W, H), (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).rounded_rectangle([ox - 6, oy + 30, ox + sw + 6, oy + sh + 60], 60, fill=(0, 0, 0, 140))\n    im.paste(Image.alpha_composite(im.convert(\"RGBA\"), shadow.filter(ImageFilter.GaussianBlur(40))).convert(\"RGB\"))\n    d = ImageDraw.Draw(im, \"RGBA\")\n    d.rounded_rectangle([ox - 14, oy - 14, ox + sw + 14, oy + sh + 14], 70, fill=(18, 24, 36), outline=(60, 72, 96), width=3)\n    im.paste(scr, (ox, oy), rounded_mask((sw, sh), 54))\n    d = ImageDraw.Draw(im, \"RGBA\")\n    # highlight ring\n    for (hx, hy, start) in scene.get(\"rings\", []):\n        if t < start:\n            continue\n        cx, cy = ox + hx / 402 * sw, oy + hy / 734 * sh\n        pulse = (math.sin((t - start) * 4.5) + 1) / 2\n        r = 58 + 18 * pulse\n        d.ellipse([cx - r - 10, cy - r - 10, cx + r + 10, cy + r + 10], fill=(47, 107, 255, int(60 + 50 * pulse)))\n        d.ellipse([cx - r, cy - r, cx + r, cy + r], outline=(255, 255, 255, 235), width=7)\n        d.ellipse([cx - 12, cy - 12, cx + 12, cy + 12], fill=(255, 255, 255, 230))\n    # caption\n    f = font(42, True)\n    lines = wrap(scene[\"caption\"], f, 960, d)\n    hgt = 60 * len(lines) + 56\n    y0 = H - 110 - hgt\n    d.rounded_rectangle([50, y0, W - 50, y0 + hgt], 34, fill=(8, 14, 28, 215), outline=(47, 107, 255, 160), width=2)\n    for i, line in enumerate(lines):\n        draw_text_center(d, y0 + 28 + i * 60, line, f)\n    return im\n\n\ndef main():\n    bot = Image.open(render_bot_mock()).convert(\"RGB\")\n    key_box = (18, 112, 385, 248)\n    scenes = [\n        dict(voice=\"s1\", card=(\"Подключение Nexo в Karing\", \"iPhone и Mac · одна минута\"), pad=0.8),\n        dict(voice=\"s2\", chip=\"Шаг 1 · Установить\", img=bot, rings=[(201, 492, 0.4)],\n             caption=\"В боте нажмите «Установить Karing». При первом запуске: язык — русский, страна — Россия\", pad=0.6),\n        dict(voice=\"s3\", chip=\"Шаг 2 · Добавить ключ\", img=bot, rings=[(201, 532, 0.3)],\n             caption=\"Нажмите «Добавить ключ в Karing»\", pad=0.6),\n        dict(voice=\"s4\", chip=\"Шаг 2 · Karing\", img=load_screen(\"02_add_subscription.jpg\", blur_box=key_box), rings=[(374, 68, 1.2)],\n             caption=\"Ссылка и название уже заполнены — нажмите галочку справа вверху\", pad=0.6),\n        dict(voice=\"s5\", chip=\"Шаг 2 · Karing\", img=load_screen(\"03_added_ok.jpg\", blur_box=key_box), rings=[(199, 411, 0.8)],\n             caption=\"«Добавлено успешно» — нажмите «Ок»\", pad=0.6),\n        dict(voice=\"s6\", chip=\"Шаг 3 · Включить\", img=load_screen(\"11_main_off.jpg\", cover=(196, 640, 26, 30)), rings=[(200, 648, 1.0)],\n             caption=\"Нажмите на щит в центре. Внизу уже выбран сервер Nexo\", pad=0.6),\n        dict(voice=\"s7\", chip=\"Шаг 3 · Включено\", img=load_screen(\"12_main_on.jpg\"), rings=[(200, 648, 0.2)],\n             caption=\"Щит зелёный — всё работает. Банки и Госуслуги открываются напрямую\", pad=0.8),\n        dict(voice=\"s8\", chip=\"Подсказка\", img=load_screen(\"08_servers_nexo.jpg\"), rings=[(130, 386, 0.3), (130, 449, 1.2)],\n             caption=\"Сменить страну: Вена или Бразилия\", pad=0.6),\n        dict(voice=\"s9\", card=(\"Готово!\", \"Не получилось — кнопка «Поддержка» в боте\"), pad=1.2),\n    ]\n    # timeline\n    audio_parts, t0 = [], 0.0\n    for s in scenes:\n        s[\"dur\"] = dur(VOICE / f\"{s['voice']}.mp3\") + s[\"pad\"] + 0.35\n        audio_parts.append((t0 + 0.35, VOICE / f\"{s['voice']}.mp3\"))\n        t0 += s[\"dur\"]\n    total = t0\n    print(f\"total {total:.1f}s, frames {int(total * FPS)}\")\n    # video frames → ffmpeg\n    raw = TMP / \"video.mp4\"\n    ff = subprocess.Popen([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"rawvideo\", \"-pix_fmt\", \"rgb24\", \"-s\", f\"{W}x{H}\", \"-r\", str(FPS),\n                           \"-i\", \"-\", \"-c:v\", \"libx264\", \"-preset\", \"medium\", \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", str(raw)], stdin=subprocess.PIPE)\n    n = 0\n    for s in scenes:\n        nf = int(round(s[\"dur\"] * FPS))\n        for i in range(nf):\n            t = i / FPS\n            im = frame(s, t, s[\"dur\"])\n            # fade in/out 0.35 s\n            k = min(1, t / 0.35, (s[\"dur\"] - t) / 0.35)\n            if k < 1:\n                im = Image.blend(Image.new(\"RGB\", (W, H), BG_BOT), im, max(0, k))\n            ff.stdin.write(im.tobytes())\n            n += 1\n        print(s[\"voice\"], nf, \"frames\", flush=True)\n    ff.stdin.close(); ff.wait()\n    # audio: place each clip at its offset\n    cmd = [\"ffmpeg\", \"-y\", \"-v\", \"error\"]\n    for _, p in audio_parts:\n        cmd += [\"-i\", str(p)]\n    delays = \";\".join(f\"[{i}:a]adelay={int(off * 1000)}|{int(off * 1000)}[a{i}]\" for i, (off, _) in enumerate(audio_parts))\n    mix = \"\".join(f\"[a{i}]\" for i in range(len(audio_parts))) + f\"amix=inputs={len(audio_parts)}:normalize=0,apad=whole_dur={total:.3f}[out]\"\n    cmd += [\"-filter_complex\", delays + \";\" + mix, \"-map\", \"[out]\", \"-ar\", \"44100\", str(TMP / \"voice.m4a\")]\n    subprocess.run(cmd, check=True)\n    final = P / \"nexo-karing_FINAL.mp4\"\n    subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(raw), \"-i\", str(TMP / \"voice.m4a\"), \"-c:v\", \"copy\", \"-c:a\", \"aac\", \"-b:a\", \"160k\",\n                    \"-shortest\", \"-movflags\", \"+faststart\", str(final)], check=True)\n    print(\"done\", final, f\"{final.stat().st_size / 1e6:.1f} MB\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":3352,"cache_read_input_tokens":402525,"output_tokens":8406,"output_tokens_details":{"thinking_tokens":1970},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3352,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":32,"output_tokens":8406,"cache_read_input_tokens":402525,"cache_creation_input_tokens":3352,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3352},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XBrRVe3wc8ZFDjCDwk6g9E":{"file_path":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory/build_nexo_karing.py","content":"#!/usr/bin/env python3\n\"\"\"Nexo · обучающий ролик «Подключение в Karing» (9:16, 1080x1920).\n\nВход: data/videos/nexo-karing/src/*.jpg — снимки окна Karing на Mac (402x734),\n       data/videos/nexo-karing/voice/s*.mp3 — озвучка ElevenLabs (по сцене).\nВыход: data/videos/nexo-karing/nexo-karing_FINAL.mp4\n\nСцены: заставка → бот (установить) → бот (добавить ключ) → Karing: добавление подписки →\n«Добавлено успешно» → главный экран, щит → включено → выбор сервера → финал.\nКлюч подписки на экранах размывается. Подсказки: пульсирующее кольцо + подпись внизу.\n\"\"\"\nimport json\nimport math\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont\n\nROOT = Path(__file__).resolve().parent\nP = ROOT / \"data/videos/nexo-karing\"\nSRC, VOICE, TMP = P / \"src\", P / \"voice\", P / \"tmp\"\nTMP.mkdir(exist_ok=True)\nW, H, FPS = 1080, 1920, 30\nBG_TOP, BG_BOT = (11, 31, 58), (8, 18, 34)\nACCENT, ACCENT2 = (47, 107, 255), (120, 170, 255)\nCHROME = \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"\n\nFONT_B = next(f for f in [\"/System/Library/Fonts/Supplemental/Arial Bold.ttf\", \"/Library/Fonts/Arial Bold.ttf\"] if Path(f).exists())\nFONT_R = next(f for f in [\"/System/Library/Fonts/Supplemental/Arial.ttf\", \"/Library/Fonts/Arial.ttf\"] if Path(f).exists())\n\n\ndef font(size, bold=False):\n    return ImageFont.truetype(FONT_B if bold else FONT_R, size)\n\n\ndef dur(path):\n    return float(subprocess.check_output([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n                                          \"-of\", \"csv=p=0\", str(path)]).decode().strip())\n\n\n# ---------------------------------------------------------------- bot mock ----\nBOT_HTML = \"\"\"<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><style>\nhtml,body{margin:0;width:402px;height:734px;background:#0e1621;font-family:-apple-system,\"SF Pro Text\",Helvetica,Arial,sans-serif;color:#fff;overflow:hidden}\n.top{height:84px;background:#17212b;display:flex;align-items:flex-end;padding:0 16px 10px;gap:10px}\n.ava{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#2F6BFF,#6FA0FF);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px}\n.name{font-weight:700;font-size:17px}.sub{font-size:12px;color:#7d8b99}\n.msg{margin:14px 10px 0;background:#182533;border-radius:14px;overflow:hidden;width:330px}\n.msg img{display:block;width:330px}\n.txt{padding:10px 12px 8px;font-size:14.5px;line-height:1.35}.txt b{font-weight:700}\n.btn{margin:6px 10px 0;width:330px;background:#2b5278;border-radius:10px;padding:9px 0;text-align:center;font-size:14px;font-weight:600}\n.row{display:flex;gap:6px;margin:6px 10px 0;width:330px}.row .btn{margin:0;flex:1}\n.hint{position:absolute;bottom:14px;left:0;right:0;text-align:center;color:#7d8b99;font-size:12px}\n</style></head><body>\n<div class=\"top\"><div class=\"ava\">N</div><div><div class=\"name\">Nexo</div><div class=\"sub\">бот</div></div></div>\n<div class=\"msg\"><img src=\"step2.png\"><div class=\"txt\"><b>Шаг 2 из 3</b><br><br>1. Установите приложение Karing.<br>2. Нажмите «Добавить ключ в Karing».<br>3. Вернитесь сюда и нажмите «Готово».<br><br><i style=\"color:#a9b8d2\">Чтобы банки и Госуслуги работали, при первом запуске Karing выберите страну «Россия».</i></div></div>\n<div class=\"btn\">1️⃣ Установить Karing</div>\n<div class=\"btn\">2️⃣ Добавить ключ в Karing</div>\n<div class=\"btn\">✅ Готово →</div>\n<div class=\"btn\" style=\"background:#1f2f3f\">Запасной вариант — Happ</div>\n<div class=\"btn\" style=\"background:#1f2f3f\">‹ Вернуться к OneXray</div>\n<div class=\"row\"><div class=\"btn\" style=\"background:#1f2f3f\">‹ Назад</div><div class=\"btn\" style=\"background:#1f2f3f\">Не получается</div></div>\n</body></html>\"\"\"\n\n\ndef render_bot_mock():\n    out = TMP / \"bot_step2.png\"\n    if out.exists():\n        return out\n    card = ROOT.parent.parent / \"Documents/Codex/2026-08-02/vps/nexo-bot/candidate/assets/step2.png\"\n    (TMP / \"step2.png\").write_bytes(Path(card).read_bytes())\n    (TMP / \"bot.html\").write_text(BOT_HTML, encoding=\"utf-8\")\n    subprocess.run([CHROME, \"--headless=new\", \"--disable-gpu\", \"--hide-scrollbars\", \"--force-device-scale-factor=3\",\n                    \"--window-size=402,734\", f\"--screenshot={out}\", f\"file://{TMP / 'bot.html'}\"],\n                   check=True, capture_output=True)\n    return out\n\n\n# ---------------------------------------------------------------- screens -----\ndef load_screen(name, blur_box=None, cover=None):\n    im = Image.open(SRC / name).convert(\"RGB\")\n    if blur_box:\n        region = im.crop(blur_box).filter(ImageFilter.GaussianBlur(9))\n        im.paste(region, blur_box[:2])\n    if cover:  # hide the mouse pointer with the surrounding background colour\n        x, y, w, h = cover\n        ImageDraw.Draw(im).rectangle([x, y, x + w, y + h], fill=im.getpixel((x - 4, y + h // 2)))\n    return im\n\n\ndef rounded_mask(size, r):\n    m = Image.new(\"L\", size, 0)\n    ImageDraw.Draw(m).rounded_rectangle([0, 0, size[0] - 1, size[1] - 1], r, fill=255)\n    return m\n\n\ndef background():\n    bg = Image.new(\"RGB\", (W, H))\n    px = bg.load()\n    for y in range(H):\n        t = y / H\n        c = tuple(int(BG_TOP[i] * (1 - t) + BG_BOT[i] * t) for i in range(3))\n        for x in range(W):\n            px[x, y] = c\n    glow = Image.new(\"RGB\", (W, H), (0, 0, 0))\n    ImageDraw.Draw(glow).ellipse([W * 0.15, -200, W * 0.85, 500], fill=(30, 70, 160))\n    glow = glow.filter(ImageFilter.GaussianBlur(160))\n    return Image.blend(bg, Image.composite(glow, bg, glow.convert(\"L\").point(lambda v: min(255, v * 2))), 0.5)\n\n\nBG = background()\nPHONE_W, PHONE_H = 820, 1497   # 402x734 * 2.04\nPHONE_X, PHONE_Y = (W - PHONE_W) // 2, 250\n\n\ndef draw_text_center(d, y, text, f, fill=(255, 255, 255)):\n    tw = d.textlength(text, font=f)\n    d.text(((W - tw) / 2, y), text, font=f, fill=fill)\n\n\ndef wrap(text, f, maxw, d):\n    words, lines, cur = text.split(), [], \"\"\n    for w in words:\n        t = (cur + \" \" + w).strip()\n        if d.textlength(t, font=f) <= maxw:\n            cur = t\n        else:\n            lines.append(cur)\n            cur = w\n    return lines + [cur]\n\n\ndef frame(scene, t, T):\n    \"\"\"One frame: background, step chip, phone with screen, highlight ring, caption.\"\"\"\n    im = BG.copy()\n    d = ImageDraw.Draw(im, \"RGBA\")\n    if scene.get(\"card\"):\n        title, sub = scene[\"card\"]\n        k = min(1, t / 0.6)\n        d.text((W / 2 - d.textlength(\"NEXO\", font=font(44, True)) / 2, 700), \"NEXO\", font=font(44, True), fill=(149, 181, 255))\n        f = font(78, True)\n        for i, line in enumerate(wrap(title, f, 940, d)):\n            draw_text_center(d, 800 + i * 92, line, f, (255, 255, 255, int(255 * k)))\n        f2 = font(40)\n        for i, line in enumerate(wrap(sub, f2, 900, d)):\n            draw_text_center(d, 1060 + i * 52, line, f2, (185, 201, 228, int(255 * k)))\n        return im\n    # step chip\n    chip = scene[\"chip\"]\n    f = font(34, True)\n    tw = d.textlength(chip, font=f)\n    d.rounded_rectangle([W / 2 - tw / 2 - 34, 120, W / 2 + tw / 2 + 34, 196], 38, fill=(47, 107, 255, 70), outline=(120, 170, 255, 140), width=2)\n    d.text((W / 2 - tw / 2, 136), chip, font=f, fill=(214, 226, 247))\n    # phone\n    zoom = 1 + 0.035 * min(1, t / T)       # slow push-in\n    screen = scene[\"img\"]\n    sw, sh = int(PHONE_W * zoom), int(PHONE_H * zoom)\n    scr = screen.resize((sw, sh), Image.LANCZOS)\n    ox, oy = PHONE_X - (sw - PHONE_W) // 2, PHONE_Y - (sh - PHONE_H) // 2\n    shadow = Image.new(\"RGBA\", (W, H), (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).rounded_rectangle([ox - 6, oy + 30, ox + sw + 6, oy + sh + 60], 60, fill=(0, 0, 0, 140))\n    im.paste(Image.alpha_composite(im.convert(\"RGBA\"), shadow.filter(ImageFilter.GaussianBlur(40))).convert(\"RGB\"))\n    d = ImageDraw.Draw(im, \"RGBA\")\n    d.rounded_rectangle([ox - 14, oy - 14, ox + sw + 14, oy + sh + 14], 70, fill=(18, 24, 36), outline=(60, 72, 96), width=3)\n    im.paste(scr, (ox, oy), rounded_mask((sw, sh), 54))\n    d = ImageDraw.Draw(im, \"RGBA\")\n    # highlight ring\n    for (hx, hy, start) in scene.get(\"rings\", []):\n        if t < start:\n            continue\n        cx, cy = ox + hx / 402 * sw, oy + hy / 734 * sh\n        pulse = (math.sin((t - start) * 4.5) + 1) / 2\n        r = 58 + 18 * pulse\n        d.ellipse([cx - r - 10, cy - r - 10, cx + r + 10, cy + r + 10], fill=(47, 107, 255, int(60 + 50 * pulse)))\n        d.ellipse([cx - r, cy - r, cx + r, cy + r], outline=(255, 255, 255, 235), width=7)\n        d.ellipse([cx - 12, cy - 12, cx + 12, cy + 12], fill=(255, 255, 255, 230))\n    # caption\n    f = font(42, True)\n    lines = wrap(scene[\"caption\"], f, 960, d)\n    hgt = 60 * len(lines) + 56\n    y0 = H - 110 - hgt\n    d.rounded_rectangle([50, y0, W - 50, y0 + hgt], 34, fill=(8, 14, 28, 215), outline=(47, 107, 255, 160), width=2)\n    for i, line in enumerate(lines):\n        draw_text_center(d, y0 + 28 + i * 60, line, f)\n    return im\n\n\ndef main():\n    bot = Image.open(render_bot_mock()).convert(\"RGB\")\n    key_box = (18, 112, 385, 248)\n    scenes = [\n        dict(voice=\"s1\", card=(\"Подключение Nexo в Karing\", \"iPhone и Mac · одна минута\"), pad=0.8),\n        dict(voice=\"s2\", chip=\"Шаг 1 · Установить\", img=bot, rings=[(201, 492, 0.4)],\n             caption=\"В боте нажмите «Установить Karing». При первом запуске: язык — русский, страна — Россия\", pad=0.6),\n        dict(voice=\"s3\", chip=\"Шаг 2 · Добавить ключ\", img=bot, rings=[(201, 532, 0.3)],\n             caption=\"Нажмите «Добавить ключ в Karing»\", pad=0.6),\n        dict(voice=\"s4\", chip=\"Шаг 2 · Karing\", img=load_screen(\"02_add_subscription.jpg\", blur_box=key_box), rings=[(374, 68, 1.2)],\n             caption=\"Ссылка и название уже заполнены — нажмите галочку справа вверху\", pad=0.6),\n        dict(voice=\"s5\", chip=\"Шаг 2 · Karing\", img=load_screen(\"03_added_ok.jpg\", blur_box=key_box), rings=[(199, 411, 0.8)],\n             caption=\"«Добавлено успешно» — нажмите «Ок»\", pad=0.6),\n        dict(voice=\"s6\", chip=\"Шаг 3 · Включить\", img=load_screen(\"11_main_off.jpg\", cover=(196, 640, 26, 30)), rings=[(200, 648, 1.0)],\n             caption=\"Нажмите на щит в центре. Внизу уже выбран сервер Nexo\", pad=0.6),\n        dict(voice=\"s7\", chip=\"Шаг 3 · Включено\", img=load_screen(\"12_main_on.jpg\"), rings=[(200, 648, 0.2)],\n             caption=\"Щит зелёный — всё работает. Банки и Госуслуги открываются напрямую\", pad=0.8),\n        dict(voice=\"s8\", chip=\"Подсказка\", img=load_screen(\"08_servers_nexo.jpg\"), rings=[(130, 386, 0.3), (130, 449, 1.2)],\n             caption=\"Сменить страну: Вена или Бразилия\", pad=0.6),\n        dict(voice=\"s9\", card=(\"Готово!\", \"Не получилось — кнопка «Поддержка» в боте\"), pad=1.2),\n    ]\n    # timeline\n    audio_parts, t0 = [], 0.0\n    for s in scenes:\n        s[\"dur\"] = dur(VOICE / f\"{s['voice']}.mp3\") + s[\"pad\"] + 0.35\n        audio_parts.append((t0 + 0.35, VOICE / f\"{s['voice']}.mp3\"))\n        t0 += s[\"dur\"]\n    total = t0\n    print(f\"total {total:.1f}s, frames {int(total * FPS)}\")\n    # video frames → ffmpeg\n    raw = TMP / \"video.mp4\"\n    ff = subprocess.Popen([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"rawvideo\", \"-pix_fmt\", \"rgb24\", \"-s\", f\"{W}x{H}\", \"-r\", str(FPS),\n                           \"-i\", \"-\", \"-c:v\", \"libx264\", \"-preset\", \"medium\", \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", str(raw)], stdin=subprocess.PIPE)\n    n = 0\n    for s in scenes:\n        nf = int(round(s[\"dur\"] * FPS))\n        for i in range(nf):\n            t = i / FPS\n            im = frame(s, t, s[\"dur\"])\n            # fade in/out 0.35 s\n            k = min(1, t / 0.35, (s[\"dur\"] - t) / 0.35)\n            if k < 1:\n                im = Image.blend(Image.new(\"RGB\", (W, H), BG_BOT), im, max(0, k))\n            ff.stdin.write(im.tobytes())\n            n += 1\n        print(s[\"voice\"], nf, \"frames\", flush=True)\n    ff.stdin.close(); ff.wait()\n    # audio: place each clip at its offset\n    cmd = [\"ffmpeg\", \"-y\", \"-v\", \"error\"]\n    for _, p in audio_parts:\n        cmd += [\"-i\", str(p)]\n    delays = \";\".join(f\"[{i}:a]adelay={int(off * 1000)}|{int(off * 1000)}[a{i}]\" for i, (off, _) in enumerate(audio_parts))\n    mix = \"\".join(f\"[a{i}]\" for i in range(len(audio_parts))) + f\"amix=inputs={len(audio_parts)}:normalize=0,apad=whole_dur={total:.3f}[out]\"\n    cmd += [\"-filter_complex\", delays + \";\" + mix, \"-map\", \"[out]\", \"-ar\", \"44100\", str(TMP / \"voice.m4a\")]\n    subprocess.run(cmd, check=True)\n    final = P / \"nexo-karing_FINAL.mp4\"\n    subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(raw), \"-i\", str(TMP / \"voice.m4a\"), \"-c:v\", \"copy\", \"-c:a\", \"aac\", \"-b:a\", \"160k\",\n                    \"-shortest\", \"-movflags\", \"+faststart\", str(final)], check=True)\n    print(\"done\", final, f\"{final.stat().st_size / 1e6:.1f} MB\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"serverClassifierRequest":"f398362f-3350-497e-bd5a-bc19e1eb4bea","apiBlockIndex":1,"requestId":"req_011CgawTigF7YRxxhXuxno4p","requestRef":"4b50b164-8361-413c-afff-f34ef11beb90","requestedModel":"claude-fable-5-1","attributionMcpServer":"computer-use","attributionMcpTool":"app_click","type":"assistant","uuid":"47da6d0a-425a-4ad0-b0a8-81ff013ac8dd","timestamp":"2026-10-31T20:25:18.475Z","effort":"high","perTurnEffort":"high","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","version":"2.1.309","gitBranch":"HEAD","slug":"deep-singing-taco"}
