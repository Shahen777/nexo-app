{"parentUuid":"8146b136-fb9e-4684-91c3-63992c26263b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgkc8n6R2RTZtwkaGGAbF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018WoyrMuaEsr2BwrFkfVo2R","name":"Bash","input":{"command":"S=\"/private/tmp/claude-501/REDACTED/1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb/scratchpad\"; cd \"$S/nexo-work\"; python3 - <<'PY'\ndef sub(text, old, new):\n    assert text.count(old) == 1, old\n    return text.replace(old, new)\ns = open('subscription.py').read()\ns = sub(s, 'import html\\nimport logging\\n', 'import base64\\nimport calendar\\nimport html\\nimport logging\\n')\ns = sub(s, 'from collections.abc import Callable\\n', 'from collections.abc import Callable\\nfrom datetime import datetime, timedelta, timezone\\n')\ns = sub(s, '''async def handle_subscription(request: web.Request) -> web.Response:\n''', '''def access_notice(until: datetime, base: str) -> str | None:\n    \"\"\"Text for the VPN app in the last 3 days of the paid period and after its end.\"\"\"\n    now = datetime.now(timezone.utc).replace(tzinfo=None)\n    if until <= now:\n        return f'Доступ {BRAND_TITLE} закончился, VPN отключён. Продлите, и он заработает сразу после оплаты: {base}/app'\n    if until <= now + timedelta(days=3):\n        return f'Доступ {BRAND_TITLE} заканчивается {until:%d.%m}. Продлите заранее, и VPN продолжит работать без перерыва: {base}/app'\n    return None\n\n\nasync def handle_subscription(request: web.Request) -> web.Response:\n''')\ns = sub(s, '''        headers['subscription-userinfo'] = f'upload={upload}; download={download}'\n    return web.Response(\n''', '''        headers['subscription-userinfo'] = f'upload={upload}; download={download}'\n    owner = database_module.get_user(user['tg_id'])\n    if owner and owner.get('paid_until'):\n        # Every client shows the end date. The notice and the renew button are Happ's; the button leads\n        # to /app, not to the cabinet link, because people share subscription links.\n        until = datetime.fromisoformat(owner['paid_until'])\n        base = request.app[PUBLIC_BASE_URL_KEY].rstrip('/')\n        notice = access_notice(until, base)\n        info = headers.get('subscription-userinfo', 'upload=0; download=0')\n        headers['subscription-userinfo'] = f'{info}; total=0; expire={calendar.timegm(until.timetuple())}'\n        headers['announce'] = 'base64:' + base64.b64encode(notice.encode()).decode() if notice else '0'\n        headers['profile-web-page-url'] = f'{base}/app#pay'\n    return web.Response(\n''')\ns = sub(s, '''    \"\"\"mihomo profile for the Nexo app; `expire` lets the app show the end of the paid period.\"\"\"\n''', '''    \"\"\"mihomo profile for the Nexo app.\"\"\"\n''')\ns = sub(s, '''    headers.pop('Content-Length', None)\n    database_module = request.app[DATABASE_KEY]\n    user = database_module.get_user_by_subscription_token(request.match_info['token'])\n    import calendar\n    import payments\n    until = payments.active_until(database_module.get_user(user['tg_id']))\n    if until:\n        info = headers.get('subscription-userinfo', 'upload=0; download=0')\n        headers['subscription-userinfo'] = f'{info}; total=0; expire={calendar.timegm(until.timetuple())}'\n    return web.Response(text=text, content_type='text/yaml', headers=headers)\n''', '''    headers.pop('Content-Length', None)\n    return web.Response(text=text, content_type='text/yaml', headers=headers)\n''')\nopen('subscription.py','w').write(s)\n\np = open('webapp.py').read()\np = sub(p, '''.flash.err{background:#FDECEC;color:#8E1F24}\n''', '''.flash.err{background:#FDECEC;color:#8E1F24}.flash.soon{background:#FFF3DC;color:#7A4B00}.flash .btn{margin-top:10px}\n''')\np = sub(p, '''    # -- home\n    devices = ''', '''    if user.get(\"paid_until\") and not until:\n        flash = ('<div class=\"flash err\">Доступ закончился, VPN отключён. Продлите, и он заработает сразу после оплаты.'\n                 '<a class=\"btn\" href=\"#pay\">Продлить</a></div>') + flash\n    elif until and days_left(until) <= 3:\n        flash = (f'<div class=\"flash soon\">Доступ заканчивается {until:%d.%m}. Продлите заранее, и VPN продолжит работать без перерыва.'\n                 '<a class=\"btn\" href=\"#pay\">Продлить</a></div>') + flash\n\n    # -- home\n    devices = ''')\nopen('webapp.py','w').write(p)\n\nt = open('tests/test_webapp.py').read()\nt = sub(t, 'import asyncio\\nimport importlib\\n', 'import asyncio\\nimport base64\\nimport importlib\\n')\nt = sub(t, 'import tempfile\\nimport unittest\\n', 'import tempfile\\nimport unittest\\nfrom datetime import datetime, timedelta, timezone\\n')\nt = sub(t, '''    async def test_unknown_token_has_no_nexo_profile(self):\n''', '''    async def period_ending_in(self, delta):\n        location = (await self.start()).split(\"?\")[0]\n        user = self.web_users()[0]\n        until = datetime.now(timezone.utc).replace(microsecond=0, tzinfo=None) + delta\n        conn = db.get_db()\n        conn.execute(\"UPDATE users SET paid_until = ? WHERE tg_id = ?\", (until.isoformat(), user[\"tg_id\"]))\n        conn.commit()\n        conn.close()\n        return location, db.list_devices(user[\"tg_id\"])[0][\"token\"], until\n\n    def notice(self, response):\n        return base64.b64decode(response.headers[\"announce\"].removeprefix(\"base64:\")).decode()\n\n    async def test_every_client_gets_the_end_date_and_no_notice_while_time_remains(self):\n        _, token, until = await self.period_ending_in(timedelta(days=10))\n        for path in (\"/sub/\", \"/happ/sub/\", \"/nexo/sub/\"):\n            response = await self.client.get(path + token)\n            self.assertEqual(response.status, 200)\n            self.assertIn(f\"expire={calendar.timegm(until.timetuple())}\", response.headers[\"subscription-userinfo\"])\n            self.assertEqual(response.headers[\"announce\"], \"0\")\n            self.assertEqual(response.headers[\"profile-web-page-url\"], \"https://vpn.example/app#pay\")\n\n    async def test_vpn_app_warns_in_the_last_days(self):\n        location, token, until = await self.period_ending_in(timedelta(days=2))\n        response = await self.client.get(\"/happ/sub/\" + token)\n        notice = self.notice(response)\n        self.assertIn(f\"заканчивается {until:%d.%m}\", notice)\n        self.assertLessEqual(len(notice), 200)\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn('class=\"flash soon\"', text)\n\n    async def test_vpn_app_and_cabinet_say_when_access_has_ended(self):\n        location, token, until = await self.period_ending_in(timedelta(days=-1))\n        response = await self.client.get(\"/nexo/sub/\" + token)\n        notice = self.notice(response)\n        self.assertIn(\"закончился\", notice)\n        self.assertLessEqual(len(notice), 200)\n        self.assertIn(f\"expire={calendar.timegm(until.timetuple())}\", response.headers[\"subscription-userinfo\"])\n        text = await (await self.client.get(location, headers={\"User-Agent\": IPHONE})).text()\n        self.assertIn(\"Доступ закончился, VPN отключён\", text)\n\n    async def test_subscription_headers_do_not_reveal_the_cabinet(self):\n        location, token, _ = await self.period_ending_in(timedelta(days=2))\n        response = await self.client.get(\"/sub/\" + token)\n        cabinet_token = REDACTED, 1)[1]\n        self.assertFalse(any(cabinet_token in value for value in response.headers.values()))\n        self.assertNotIn(cabinet_token, self.notice(response))\n\n    async def test_unknown_token_has_no_nexo_profile(self):\n''')\nt = sub(t, 'import asyncio\\nimport base64\\nimport importlib\\n', 'import asyncio\\nimport base64\\nimport calendar\\nimport importlib\\n')\nopen('tests/test_webapp.py','w').write(t)\nPY\ngrep -n \"add_get.*sub\" subscription.py | cut -c1-110; PYTHONPATH=.:tests AURA_NO_CARDS=1 AURA_DB_PATH=\"$S/speed/st.db\" AURA_PUBL