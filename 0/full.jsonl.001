StringSync())\n                as Map<String, dynamic>,\n    };\n    final expectedKeys = arbByLocale['en']!.keys\n        .where((key) => !key.startsWith('@'))\n        .toSet();\n\n    for (final entry in lookups.entries) {\n      final locale = entry.key;\n      final lookup = entry.value;\n      final messages = lookup.messages;\n      expect(\n\n  /// `New version found`\n  String get discoverNewVersion {\n    return Intl.message(\n      'New version found',\n      name: 'discoverNewVersion',\n      desc: '',\n      args: [],\n    );\n  }\n\n      \"Отсутствие гарантий\",\n    ),\n    \"disconnected\": MessageLookupByLibrary.simpleMessage(\"Отключено\"),\n    \"discoverNewVersion\": MessageLookupByLibrary.simpleMessage(\n      \"Доступна новая версия\",\n    ),\n    \"dnsCacheCleared\": MessageLookupByLibrary.simpleMessage(\"Кэш DNS очищен\"),\n    \"dnsHijackDesc\": MessageLookupByLibrary.simpleMessage(\norigin\thttps://github.com/Shahen777/nexo-app.git (fetch)\norigin\thttps://github.com/Shahen777/nexo-app.git (push)\nupstream\thttps://github.com/chen08209/FlClash.git (fetch)\nupstream\thttps://github.com/chen08209/FlClash.git (push)\n    await Future.wait([_dataDir.value, _downloadDir.value, _tempDir.value]);\n  }\n\n  void _bind() {\n    _dataDir = ResolveOnce(supportDirectory);\n    _downloadDir = ResolveOnce(downloadDirectory);\n    _tempDir = ResolveOnce(temporaryDirectory);\n    cacheDirectory().then(cacheDir.complete);\n  }\n\n  factory AppPath() {\n    _instance ??= AppPath._internal();\n    return _instance!;\n  }\n\n  String get executableExtension {\n    return system.isWindows ? '.exe' : '';\n  }\n\n  String get executableDirPath {\n    final currentExecutablePath = Platform.resolvedExecutable;\n  }\n\n  Future<String> get tempFilePath async {\n    final mTempDir = await _tempDir.value;\n    return join(mTempDir.path, 'temp$uniqueId');\n  }\n\n  Future<String> get lockFilePath async {\n            <intent-filter>\n                <action android:name=\"android.service.quicksettings.action.QS_TILE_PREFERENCES\" />\n            </intent-filter>\n            <intent-filter>\n                <action android:name=\"android.intent.action.VIEW\" />\n\n                <category android:name=\"android.intent.category.DEFAULT\" />\n                <category android:name=\"android.intent.category.BROWSABLE\" />\n\n                <data android:scheme=\"nexo\" />\n                <data android:scheme=\"clash\" />\n            QuickAction.STOP -> R.drawable.ic_shortcut_stop\n            QuickAction.TOGGLE -> R.drawable.ic_shortcut_toggle\n        }\n\n    private fun openAppSettings(): Boolean {\n        val activity = activity ?: return false\n        return try {\n            val intent = Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {\n                data = \"package:${GlobalState.application.packageName}\".toUri()\n            }\n            activity.startActivity(intent)\n            true\n        } catch (_: Exception) {\n            false\n        }\n    }\n\n    @Suppress(\"DEPRECATION\")","is_error":false},{"tool_use_id":"toolu_018P5iSVSik3PABwU3HEys2u","type":"tool_result","content":"Nexo-android.apk\nbash: line 1: unzip: command not found\nNexo-android-old.apk\nbash: line 1: unzip: command not found\nfalse\nmain","is_error":false}]}}
