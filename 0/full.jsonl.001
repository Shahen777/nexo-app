{"parentUuid":"86152f40-15f5-4159-b53f-6a975a285938","isSidechain":false,"promptId":"cc6b4e86-18b8-4e65-826e-ac485cbab2ac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017FnCoVH16Aof9svCRCLDsM","type":"tool_result","content":"# Проверка статуса оплаты платежа\n## OpenAPI Specification\n```yaml\nopenapi: 3.0.1\ninfo:\n  title: ''\n  description: ''\n  version: 1.0.0\npaths:\n  /transaction/{id}:\n    get:\n      summary: Проверка статуса оплаты платежа\n      deprecated: false\n      description: Возвращает статус и детали транзакции.\n      operationId: getTransactionStatus\n      tags:\n        - Платежи\n        - Payments\n      parameters:\n        - name: id\n          in: path\n          description: ID транзакции (UUID)\n          required: true\n          example: ''\n          schema:\n            type: string\n            format: uuid\n        - name: X-MerchantId\n          in: header\n          description: ''\n          required: true\n          example: ''\n          schema:\n            type: string\n        - name: X-Secret\n          in: header\n          description: ''\n          required: true\n          example: ''\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Данные транзакции\n          content:\n            application/json:\n              schema:\n                type: object\n                  01M5A1FRJNKAKCBB630B9PJDYJ:\n                    $ref: '#/components/schemas/TransactionStatusResponse'\n                properties:\n                  id:\n                    type: string\n                    format: uuid\n                  status: &ref_0\n                    $ref: '#/components/schemas/PaymentStatus'\n                  paymentDetails:\n                    type: object\n                    properties:\n                      amount:\n                        type: number\n                      currency:\n                        type: string\n                      - amount\n                      - currency\n                  merchantName:\n                    type: string\n                  mechantId:\n                    type: string\n                    format: uuid\n                  comission:\n                    type: number\n                  paymentMethod:\n                    type: string\n                    description: Название метода оплаты (например, SBPQR)\n                  expiresIn:\n                    type: string\n                  return:\n                    type: string\n                    format: uri\n                  comissionUsdt:\n                    type: number\n                  amountUsdt:\n                    type: number\n                  qr:\n                    type: string\n                  payformSuccessUrl:\n                    type: string\n                    format: uri\n                  payload:\n                    type: string\n                  comissionType:\n                    type: integer\n                  externalId:\n                    type: string\n                  description:\n                    type: string\n                  isBalanceProcessed:\n                    type: boolean\n                    description: Признак конвертации транзакции\n                  - 01M5A1FRJNKAKCBB630B9PJDYJ\n                  - isBalanceProcessed\n                  - id\n                  - status\n                  - paymentDetails\n                  - merchantName\n                  - mechantId\n                  - comission\n                  - paymentMethod\n                  - expiresIn\n                  - return\n                  - comissionUsdt\n                  - amountUsdt\n                  - qr\n                  - payformSuccessUrl\n                  - payload\n                  - comissionType\n                  - externalId\n                  - description\n              example:\n                id: 3fa85f64-5717-4562-b3fc-2c963f66afa6\n           