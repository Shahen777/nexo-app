{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"6f9fccc37724adb185e8c2e9bd28e226921cac0e0d4744c419db1f6111f95c6e","message":{"role":"user","content":[{"tool_use_id":"toolu_011TZwzoUCSgbo54BLFC4kAq","type":"tool_result","content":"Switched to a new branch 'feat/in-app-update'\nimport 'dart:async';\n\nimport 'package:fl_clash/common/common.dart';\nimport 'package:fl_clash/enum/enum.dart';\nimport 'package:fl_clash/models/models.dart';\nimport 'package:fl_clash/widgets/widgets.dart';\nimport 'package:material_ui/material_ui.dart';\nimport 'package:url_launcher/url_launcher.dart';\n\nclass Dialogs {\n  Dialogs._();\n\n  // Focus sits in the route the user acts in, so an alert raised from a form\n  // sheet, or a page pushed inside one, opens over it, beside the navigation\n  // as the sheet sits.\n  BuildContext get _context {\n    var context = FocusManager.instance.primaryFocus?.context;\n    while (context != null) {\n      final route = ModalRoute.of(context);\n      if (route is AlertHostRoute) {\n        final host = route.navigator;\n        if (host != null && host.mounted) {\n          return host.context;\n        }\n        break;\n      }\n      context = route?.navigator?.context;\n    }\n    return rootNavigatorKey.currentContext!;\n  }\n\n  Future<T?> showCommonDialog<T>({\n    required Widget child,\n    BuildContext? context,\n    bool? dismissible,\n  }) async {\n    return showFloatingDialog<T>(\n      context: context ?? _context,\n      child: child,\n      dismissible: dismissible ?? true,\n    );\n  }\n\n  Future<bool?> showMessage({\n    required InlineSpan message,\n    BuildContext? context,\n    String? title,\n    String? confirmText,\n    String? cancelText,\n    bool? dismissible,\n    );\n  }\n\n  Future<bool?> _showMessage({\n    required InlineSpan message,\n    required bool cancelable,\n    BuildContext? context,\n    String? title,\n    String? confirmText,\n    String? cancelText,\n    bool? dismissible,\n    bool destructive = false,\n  }) async {\n    return showCommonDialog<bool>(\n      context: context,\n      dismissible: dismissible,\n      child: Builder(\n        builder: (context) {\n          final appLocalizations = context.appLocalizations;\n          return CommonDialog(\n            title: title ?? appLocalizations.tip,\n            destructive: destructive,\n            actions: [\n              if (cancelable)\n                TextButton(\n                  onPressed: () {\n                    Navigator.of(context).pop(false);\n                  },\n                  child: Text(cancelText ?? appLocalizations.cancel),\n                ),\n              TextButton(\n                onPressed: () {\n                  Navigator.of(context).pop(true);\n                },\n                child: Text(confirmText ?? appLocalizations.confirm),\n              ),\n            ],\n            child: SelectableText.rich(\n              TextSpan(children: [message]),\n              style: const TextStyle(overflow: TextOverflow.visible),\n            ),\n          );\n        },\n      ),\n    );\n  }\n\n  Future<void> showFailureDetails(List<UpdatingMessage> failures) {\n41:void main() {\n44:  test('getTextResponseForUrl propagates the typed DioException', () async {\n59:  test('getFileResponseForUrl propagates the typed DioException', () async {\n72:  group('latestRelease', () {\n88:      expect(await request.latestRelease(), {\n110:        expect(await request.latestRelease(), {'tag_name': 'v1.2.4'});\n120:      await expectLater(request.latestRelease(), throwsA(isA<DioException>()));\n124:  group('downloadTarget', () {\n148:  group('decompressUnlabeled', () {\nlib/providers/actions/common.dart:89:      res = await request.checkForUpdate();\nlib/providers/actions/common.dart:92:        'checkForUpdate failed: ${compactError(error)}',\nlib/providers/actions/common.dart:97:    await checkUpdateResultHandle(data: res);\nlib/providers/actions/common.dart