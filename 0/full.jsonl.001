{"parentUuid":"78c680cc-4ff8-4561-8876-23bc29641cbb","isSidechain":false,"promptId":"24b0c033-0466-4f42-9839-6cf96259e6ae","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017RpwoqGNBJRH6Z8sqUcfb5","type":"tool_result","content":"\"\"\"Render text screens from either a text menu or a QR/photo message.\"\"\"\nfrom aiogram.exceptions import TelegramBadRequest\nfrom aiogram.types import Message\n\n\nasync def show_text(message: Message, text: str, **kwargs):\n    # A photo card stays a single screen: short texts become its caption, long ones replace it.\n    if message.text is None:\n        if message.photo and len(text) <= 1024 and not getattr(message, \"_is_qr\", False):\n            try:\n                return await message.edit_caption(caption=text, **kwargs)\n            except TelegramBadRequest as error:\n                if \"message is not modified\" in error.message.lower():\n                    return None\n        sent = await message.answer(text, **kwargs)\n        if message.photo and message.from_user and message.from_user.is_bot:\n            try:\n                await message.delete()\n            except TelegramBadRequest:\n                pass\n        return sent\n    try:\n        return await message.edit_text(text, **kwargs)\n    except TelegramBadRequest as error:\n        description = error.message.lower()\n        if \"message is not modified\" in description:\n            return None\n        if any(reason in description for reason in (\n            \"message to edit not found\", \"message can't be edited\",\n            \"there is no text in the message to edit\",\n        )):\n            return await message.answer(text, **kwargs)\n        # Malformed content and other errors must remain visible in server logs.\n        raise\n\n\n# ---- photo cards (brand screens) -------------------------------------------------\nimport os\nfrom aiogram.types import FSInputFile, InputMediaPhoto\n\nASSETS = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"assets\")\n_file_ids: dict[str, str] = {}\n\n\ndef card_path(card: str) -> str | None:\n    path = os.path.join(ASSETS, f\"{card}.png\")\n    return path if not os.environ.get(\"AURA_NO_CARDS\") and os.path.exists(path) else None\n\n\nasync def send_card(message: Message, card: str, caption: str, reply_markup=None):\n    \"\"\"Answer a user's command with a new card (commands cannot be edited in place).\"\"\"\n    path = card_path(card)\n    if not path:\n        return await message.answer(caption, reply_markup=reply_markup)\n    sent = await message.answer_photo(_file_ids.get(card) or FSInputFile(path), caption=caption, reply_markup=reply_markup)\n    if isinstance(sent, Message) and sent.photo:\n        _file_ids[card] = sent.photo[-1].file_id\n    return sent\n\n\nasync def show_card(message: Message, card: str, caption: str, reply_markup=None):\n    \"\"\"Show a branded photo card. Edits the current card in place, replaces a text screen, or falls back to text.\"\"\"\n    path = card_path(card)\n    if not path:\n        return await show_text(message, caption, reply_markup=reply_markup)\n    media = _file_ids.get(card) or FSInputFile(path)\n    sent = None\n    if message.photo:\n        try:\n            sent = await message.edit_media(InputMediaPhoto(media=media, caption=caption, parse_mode=\"HTML\"),\n                                            reply_markup=reply_markup)\n        except TelegramBadRequest as error:\n            if \"message is not modified\" in error.message.lower():\n                return None\n            sent = await message.answer_photo(media, caption=caption, reply_markup=reply_markup)\n    else:\n        sent = await message.answer_photo(media, caption=caption, reply_markup=reply_markup)\n        if message.from_user and message.from_user.is_bot:\n            try:\n                await message.delete()\n            except TelegramBadRequest:\n                pass\n    if isinstance(sent, Message) and sent.photo:\n        _file_ids[card] = sent.photo[-1].file_id\n    return sent\n======\n58:async def send_qr(bot, owner, url, install_url, label, back=\"devices\", platform=None, device_id=None, guided=False):\n59-    \"\"\"QR code + link for manual import. Guided mode (setup wizard, key card) shows one next step only.\"\"\"\n60-    if guided:\n61-        rows = [[InlineKeyboardButton(text=\"✅ Готово →\",\n62-                                      callback_data=f\"activate:{platform}\" if platform else \"connected\")],\n63-                [InlineKeyboardButton(text=\"‹ Назад\", callback_data=back),\n64-                 InlineKeyboardButton(text=\"Главное меню\", callback_data=\"back_main\")]]\n65-        caption = (f\"<b>Ваш ключ · {escape(label)}</b>\\n\\n\"\n66-                   \"Отсканируйте QR-код в приложении.\\n\"\n67-                   \"Или нажмите на ссылку — она скопируется — и в приложении нажмите «+» → «Из буфера обмена».\\n\\n\"\n68-                   f\"<code>{escape(url)}</code>\\n\\n\"\n69-                   \"<i>Никому не пересылайте этот ключ.</i>\")\n70-        await bot.send_photo(chat_id=owner, photo=BufferedInputFile(generate_qr_bytes(url), filename=\"nexo-qr.png\"),\n71-                             caption=caption, reply_markup=InlineKeyboardMarkup(inline_keyboard=rows))\n72-        return\n73-    rows = []\n74-    if platform not in (\"router\", \"androidtv\"):\n75-        rows.append([InlineKeyboardButton(text=\"Добавить в Karing\", url=install_url)])\n76-    if platform in (None, 'ios', 'android', 'windows', 'macos'):\n77-        rows.append([InlineKeyboardButton(text='Добавить в Happ', url=happ_install_url(install_url))])\n78-        extra = [InlineKeyboardButton(text=label, url=link) for label, link in client_import_links(install_url, platform)]\n79-        for i in range(0, len(extra), 2):\n80-            rows.append(extra[i:i + 2])\n81-    if platform:\n82-        rows.append([InlineKeyboardButton(text=\"Инструкция для устройства\", callback_data=f\"device_inst:{device_id}\" if device_id else f\"inst_{platform}\")])\n83-    rows.extend([[InlineKeyboardButton(text=\"Профиль добавлен → Включить VPN\", callback_data=f\"activate:{platform}\" if platform else \"connected\")],\n84-                 [InlineKeyboardButton(text=\"‹ Назад\", callback_data=back),\n85-                  InlineKeyboardButton(text=\"Главное меню\", callback_data=\"back_main\")]])\n86-    await bot.send_photo(chat_id=owner, photo=BufferedInputFile(generate_qr_bytes(url), filename=\"nexo-qr.png\"),\n87-                         caption=f\"<b>{BRAND} · {escape(label)}</b>\\n\\n\"\n88-                         + (\"<b>Happ, v2RayTun, V2Box, Streisand:</b> нажмите кнопку своего приложения и подтвердите импорт. \"\n89-                            \"Правила для российских сервисов (банки, Госуслуги, Ozon, Wildberries, Авито) подгрузятся из подписки сами. \"\n90-                            \"Затем вернитесь сюда к включению VPN.\\n\\n\" if platform in (None, 'ios', 'android', 'windows', 'macos') else \"\")\n91-                         + (IMPORT_STEPS[platform] + \"\\n\\n\" if platform in IMPORT_STEPS else\n92-                            \"Нажмите «Добавить в Karing» или отсканируйте QR внутри приложения на другом устройстве.\\n\\n\")\n93-                         + f\"Ссылка для ручного импорта:\\n<code>{escape(url)}</code>\\n\\n\"\n94-                         \"<i>Это личный ключ доступа. Не публикуйте ссылку и QR.</i>\",\n95-                         reply_markup=InlineKeyboardMarkup(inline_keyboard=rows))\n96-\n97-\n98-async def send_subscription(callback, bot):\n99-    user = db.get_user(callback.from_user.id)\n100-    if user and (not user.get(\"is_active\", True) or user.get(\"revoked_at\")):\n101-        await show_text(callback.message, \"<b>Выдача подписки отключена</b>\\n\\nОбратитесь к администратору.\", reply_markup=back_button())\n102-        return\n103-    if not user or not user.get(\"vpn_uuid\"):\n======\nvenv/\n__pycach