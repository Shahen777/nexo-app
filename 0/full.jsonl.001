{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"a86f7bc4cd4fa1c6a4459a1cb9670db09227ff6ef658b25e0333d4d8de52e9ed","message":{"role":"user","content":[{"tool_use_id":"toolu_01LwhiKQStxELvYB6MPevWqD","type":"tool_result","content":"96\t\n97\tdef background():\n98\t    bg = Image.new(\"RGB\", (W, H))\n99\t    px = bg.load()\n100\t    for y in range(H):\n101\t        t = y / H\n102\t        c = tuple(int(BG_TOP[i] * (1 - t) + BG_BOT[i] * t) for i in range(3))\n103\t        for x in range(W):\n104\t            px[x, y] = c\n105\t    glow = Image.new(\"RGB\", (W, H), (0, 0, 0))\n106\t    ImageDraw.Draw(glow).ellipse([W * 0.15, -200, W * 0.85, 500], fill=(30, 70, 160))\n107\t    glow = glow.filter(ImageFilter.GaussianBlur(160))\n108\t    return Image.blend(bg, Image.composite(glow, bg, glow.convert(\"L\").point(lambda v: min(255, v * 2))), 0.5)\n109\t\n110\t\n111\tBG = background()\n112\tPHONE_W, PHONE_H = 720, 1315   # 402x734 * 1.79, leaves room for the caption below\n113\tPHONE_X, PHONE_Y = (W - PHONE_W) // 2, 240\n114\t\n115\t\n116\tdef draw_text_center(d, y, text, f, fill=(255, 255, 255)):\n117\t    tw = d.textlength(text, font=f)\n118\t    d.text(((W - tw) / 2, y), text, font=f, fill=fill)\n119\t\n120\t\n121\tdef wrap(text, f, maxw, d):\n122\t    words, lines, cur = text.split(), [], \"\"\n123\t    for w in words:\n124\t        t = (cur + \" \" + w).strip()\n125\t        if d.textlength(t, font=f) <= maxw:\n126\t            cur = t\n127\t        else:\n128\t            lines.append(cur)\n129\t            cur = w\n130\t    return lines + [cur]\n131\t\n132\t\n133\tdef frame(scene, t, T):\n134\t    \"\"\"One frame: background, step chip, phone with screen, highlight ring, caption.\"\"\"\n135\t    im = BG.copy()\n136\t    d = ImageDraw.Draw(im, \"RGBA\")\n137\t    if scene.get(\"card\"):\n138\t        title, sub = scene[\"card\"]\n139\t        k = min(1, t / 0.6)\n140\t        d.text((W / 2 - d.textlength(\"NEXO\", font=font(44, True)) / 2, 700), \"NEXO\", font=font(44, True), fill=(149, 181, 255))\n141\t        f = font(78, True)\n142\t        for i, line in enumerate(wrap(title, f, 940, d)):\n143\t            draw_text_center(d, 800 + i * 92, line, f, (255, 255, 255, int(255 * k)))\n144\t        f2 = font(40)\n145\t        for i, line in enumerate(wrap(sub, f2, 900, d)):\n146\t            draw_text_center(d, 1060 + i * 52, line, f2, (185, 201, 228, int(255 * k)))\n147\t        return im\n148\t    # step chip\n149\t    chip = scene[\"chip\"]\n150\t    f = font(34, True)\n151\t    tw = d.textlength(chip, font=f)\n152\t    d.rounded_rectangle([W / 2 - tw / 2 - 34, 120, W / 2 + tw / 2 + 34, 196], 38, fill=(47, 107, 255, 70), outline=(120, 170, 255, 140), width=2)\n153\t    d.text((W / 2 - tw / 2, 136), chip, font=f, fill=(214, 226, 247))\n154\t    # phone\n155\t    zoom = 1 + 0.05 * (1 - (1 - min(1, t / T)) ** 2)   # push-in, eases out\n156\t    screen = scene[\"img\"]\n157\t    sw, sh = int(PHONE_W * zoom), int(PHONE_H * zoom)\n158\t    scr = screen.resize((sw, sh), Image.LANCZOS)\n159\t    ox, oy = PHONE_X - (sw - PHONE_W) // 2, PHONE_Y - (sh - PHONE_H) // 2\n160\t    shadow = Image.new(\"RGBA\", (W, H), (0, 0, 0, 0))\n161\t    ImageDraw.Draw(shadow).rounded_rectangle([ox - 6, oy + 30, ox + sw + 6, oy + sh + 60], 60, fill=(0, 0, 0, 140))\n162\t    im.paste(Image.alpha_composite(im.convert(\"RGBA\"), shadow.filter(ImageFilter.GaussianBlur(40))).convert(\"RGB\"))\n163\t    d = ImageDraw.Draw(im, \"RGBA\")\n164\t    d.rounded_rectangle([ox - 14, oy - 14, ox + sw + 14, oy + sh + 14], 70, fill=(18, 24, 36), outline=(60, 72, 96), width=3)\n165\t    im.paste(scr, (ox, oy), rounded_mask((sw, sh), 54))\n166\t    d = ImageDraw.Draw(im, \"RGBA\")\n167\t    # highlight ring\n168\t    for (hx, hy, start) in scene.get(\"rings\", []):\n169\t        if t < start:\n170\t            continue\n171\t        cx, cy = ox + hx / 402 * sw, oy + hy / 734 * sh\n172\t        pulse = (math.sin((t - start) * 4.5) + 1) / 2\n173\t        pop = min(1, (t - start) / 0.25)\n174\t        pop = 1 + 0.6 * (1 - pop) * (1 - pop)      # starts big, settles quickly\n175\t        r = (58 + 18 * pulse) * pop\n176\t        d.ellipse([cx - r - 10, cy - r - 10, cx + r + 10, cy + r + 10], fill=(47, 107, 255, int(60 + 50 * pulse)))\n177\t        d.ellipse([cx - r, cy - r, cx + r, cy + r], outline=(255, 255, 255, 235), width=7)\n178\t        d.ellipse([cx - 12, cy - 12, cx + 12, cy + 12], fill=(255, 255, 255, 230))\n179\t    # caption\n180\t    f = font(42, True)\n181\t    lines = wrap(scene[\"caption\"], f, 960, d)\n182\t    hgt = 60 * len(lines) + 56\n183\t    ease = 1 - (1 - min(1, t / 0.45)) ** 3\n184\t    y0 = H - 110 - hgt + int(90 * (1 - ease))\n185\t    d.rounded_rectangle([50, y0, W - 50, y0 + hgt], 34, fill=(8, 14, 28, 215), outline=(47, 107, 255, 160), width=2)\n186\t    for i, line in enumerate(lines):\n187\t        draw_text_center(d, y0 + 28 + i * 60, line, f)\n188\t    return im\n189\t\n190\t\n191\tdef main():\n192\t    bot = Image.open(render_bot_mock()).convert(\"RGB\")\n193\t    key_box = (18, 112, 385, 248)\n194\t    scenes = [\n195\t        dict(voice=\"s1\", card=(\"Подключение Nexo в Karing\", \"iPhone и Mac · одна минута\"), pad=0.8),\n196\t        dict(voice=\"s2\", chip=\"Шаг 1 · Установить\", img=bot, rings=[(201, 492, 0.4)],\n197\t             caption=\"В боте нажмите «Установить Karing». При первом запуске: язык — русский, страна — Россия\", pad=0.45),\n198\t        dict(voice=\"s3\", chip=\"Шаг 2 · Добавить ключ\", img=bot, rings=[(201, 532, 0.3)],\n199\t             caption=\"Нажмите «Добавить ключ в Karing»\", pad=0.45),\n200\t        dict(voice=\"s4\", chip=\"Шаг 2 · Karing\", img=load_screen(\"02_add_subscription.jpg\", blur_box=key_box, cover=(290, 604, 26, 30)), rings=[(374, 68, 1.2)],\n201\t             caption=\"Ссылка и название уже заполнены — нажмите галочку справа вверху\", pad=0.45),\n202\t        dict(voice=\"s5\", chip=\"Шаг 2 · Karing\", img=load_screen(\"03_added_ok.jpg\", blur_box=key_box), rings=[(199, 411, 0.8)],\n203\t             caption=\"«Добавлено успешно» — нажмите «Ок»\", pad=0.45),\n204\t        dict(voice=\"s6\", chip=\"Шаг 3 · Включить\", img=load_screen(\"11_main_off.jpg\", cover=(196, 640, 26, 30)), rings=[(200, 648, 1.0)],\n205\t             caption=\"Нажмите на щит в центре. Внизу уже выбран сервер Nexo\", pad=0.45),\n206\t        dict(voice=\"s7\", chip=\"Шаг 3 · Включено\", img=load_screen(\"12_main_on.jpg\"), rings=[(200, 648, 0.2)],\n207\t             caption=\"Щит зелёный — всё работает. Банки и Госуслуги открываются напрямую\", pad=0.8),\n208\t        dict(voice=\"s8\", chip=\"Подсказка\", img=load_screen(\"08_servers_nexo.jpg\"), rings=[(130, 386, 0.3), (130, 449, 1.2)],\n209\t             caption=\"Сменить страну: Вена или Бразилия\", pad=0.45),\n210\t        dict(voice=\"s9\", card=(\"Готово!\", \"Не получилось — кнопка «Поддержка» в боте\"), pad=1.2),\n211\t    ]\n212\t    # timeline\n213\t    audio_parts, t0 = [], 0.0\n214\t    for s in scenes:\n215\t        s[\"dur\"] = dur(VOICE / f\"{s['voice']}.mp3\") + s[\"pad\"] + 0.25\n216\t        audio_parts.append((t0 + 0.25, VOICE / f\"{s['voice']}.mp3\"))\n217\t        t0 += s[\"dur\"]\n218\t    total = t0\n219\t    print(f\"total {total:.1f}s, frames {int(total * FPS)}\")\n220\t    # video frames → ffmpeg\n221\t    raw = TMP / \"video.mp4\"\n222\t    ff = subprocess.Popen([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"rawvideo\", \"-pix_fmt\", \"rgb24\", \"-s\", f\"{W}x{H}\", \"-r\", str(FPS),\n223\t                           \"-i\", \"-\", \"-c:v\", \"libx264\", \"-preset\", \"medium\", \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", str(raw)], stdin=subprocess.PIPE)\n224\t    n = 0\n225\t    for s in scenes:\n226\t        nf = int(round(s[\"dur\"] * FPS))\n227\t        for i in range(nf):\n228\t            t = i / FPS\n229\t            im = frame(s, t, s[\"dur\"])\n230\t            # fade in/out 0.35 s\n231\t            k = min(1, t / 0.22, (s[\"dur\"] - t) / 0.22)\n232\t            if k < 1:\n233\t                im = Image.blend(Image.new(\"RGB\", (W, H), BG_BOT), im, max(0, k))\n234\t            ff.stdin.write(im.tobytes())\n235\t            n += 1\n236\t        print(s[\"voice\"], nf, \"frames\", flush=True)\n237\t    ff.stdin.close(); ff.wait()\n238\t    # audio: place each clip at its offset\n239\t    cmd = [\"ffmpeg\", \"-y\", \"-v\", \"error\"]\n240\t    for _, p in audio_parts:\n241\t        cmd += [\"-i\", str(p)]\n242\t    delays = \";\".join(f\"[{i}:a]adelay={int(off * 1000)}|{int(off * 1000)}[a{i}]\" for i, (off, _) in enumerate(audio_parts))\n243\t    mix = \"\".join(f\"[a{i}]\" for i in range(len(audio_parts))) + f\"amix=inputs={len(audio_parts)}:normalize=0,apad=whole_dur={total:.3f}[out]\"\n244\t    cmd += [\"-filter_complex\", delays + \";\" + mix, \"-map\", \"[out]\", \"-ar\", \"44100\", str(TMP / \"voice.m4a\")]\n245\t    subprocess.run(cmd, check=True)\n246\t    final = P / \"nexo-karing_FINAL.mp4\"\n247\t    subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(raw), \"-i\", str(TMP / \"voice.m4a\"), \"-c:v\", \"copy\", \"-c:a\", \"aac\", \"-b:a\", \"160k\",\n248\t                    \"-shortest\", \"-movflags\", \"+faststart\", str(final)], check=True)\n249\t    intro = P / \"intro/nexo-reveal-9x16-1080x1920.mp4\"   # animated Nexo logo, 5 s, no audio\n250\t    if intro.exists():\n251\t        with_intro = P / \"nexo-karing_FINAL_intro.mp4\"\n252\t        subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(intro), \"-i\", str(final), \"-filter_complex\",\n253\t                        \"[0:v]trim=0:4.6,setpts=PTS-STARTPTS,fade=t=out:st=4.2:d=0.4[iv];anullsrc=r=44100:cl=stereo,atrim=0:4.6[ia];\"\n254\t                        \"[iv][ia][1:v][1:a]concat=n=2:v=1:a=1[v][a]\", \"-map\", \"[v]\", \"-map\", \"[a]\", \"-c:v\", \"libx264\", \"-preset\", \"medium\",\n255\t                        \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", \"-r\", str(FPS), \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-movflags\", \"+faststart\", str(with_intro)], check=True)\n256\t        final = with_intro\n257\t    print(\"done\", final, f\"{final.stat().st_size / 1e6:.1f} MB\")\n258\t\n259\t\n260\tif __name__ == \"__main__\":\n261\t    main()\n262\t"}]}}
{"type":"api-request-blob","sessionId":"1fd4ae39-09c4-4cf0-9bfe-fc8abaa281eb","hash":"e9fa190649688d230fd0d0644bcca086839bc23ba2be78bb141f6c7e23e98874","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01RwWS7a7veusNA3mZMB1mpg","name":"Bash","input":{"command":"cd \"/Users/Sagenkazaran/ИИ АГЕНТ/content-factory\" && python3 - <<'EOF'\np='build_nexo_karing.py'; s=open(p).read()\ndef rep(old, new):\n    global s\n    assert old in s, old[:60]\n    s = s.replace(old, new)\n\nrep('''BG = background()\nPHONE_W, PHONE_H''', '''BG = background()\n# Logo: the reveal clip (sped up) ends with the stacked logo in the centre; it then flies to the\n# top-right corner and stays there, semi-transparent, for the rest of the video.\nLOGO = Image.open(P / \"intro/logo-stacked-crop.png\").convert(\"RGBA\")\nINTRO = P / \"intro/nexo-reveal-9x16-1080x1920.mp4\"\nINTRO_CUT, INTRO_SPEED, FLY = 4.1, 1.6, 0.85     # seconds of the reveal kept, speed-up, fly-to-corner\nLOGO_FROM = (539, 979, 674)                      # centre x, centre y, height in the reveal's last frame\nLOGO_TO = (W - 104, 104, 140)                    # resting place in the corner\nWATERMARK_ALPHA = 0.55\nREVEAL_BG = (9, 30, 56)\nPHONE_W, PHONE_H''')\n\nrep('''def frame(scene, t, T):''', '''def paste_logo(im, cx, cy, h, alpha):\n    w = int(LOGO.width * h / LOGO.height)\n    logo = LOGO.resize((w, int(h)), Image.LANCZOS)\n    if alpha < 1:\n        logo.putalpha(logo.getchannel(\"A\").point(lambda v: int(v * alpha)))\n    im.paste(logo, (int(cx - w / 2), int(cy - h / 2)), logo)\n\n\ndef ease(x):\n    x = max(0.0, min(1.0, x))\n    return 1 - (1 - x) ** 3 if x > 0.5 else 4 * x ** 3 if x < 0.5 else 0.5\n\n\ndef fly_frame(t, reveal_last):\n    \"\"\"The logo leaves the centre for the top-right corner while the reveal background turns into ours.\"\"\"\n    p = ease(t / FLY)\n    im = Image.blend(Image.new(\"RGB\", (W, H), REVEAL_BG), BG, p)\n    (x0, y0, h0), (x1, y1, h1) = LOGO_FROM, LOGO_TO\n    paste_logo(im, x0 + (x1 - x0) * p, y0 + (y1 - y0) * p, h0 * (h1 / h0) ** p, 1 - (1 - WATERMARK_ALPHA) * p)\n    if t < 0.15:  # hide the seam between the reveal's own logo and ours\n        im = Image.blend(reveal_last, im, t / 0.15)\n    return im\n\n\ndef frame(scene, t, T):''')\n\nrep('''        k = min(1, t / 0.6)''', '''        k = min(1, t / 0.35)''')\n\nrep('''        dict(voice=\"s1\", card=(\"Подключение Nexo в Karing\", \"iPhone и Mac · одна минута\"), pad=0.8),\n        dict(voice=\"s2\", chip=\"Шаг 1 · Установить\", img=bot, rings=[(201, 492, 0.4)],''', '''        dict(voice=None, fly=True, dur=FLY),\n        dict(voice=\"s1\", card=(\"Подключение Nexo в Karing\", \"iPhone и Mac · одна минута\"), pad=0.35),\n        dict(voice=\"s2\", chip=\"Шаг 1 · Установить\", img=bot, rings=[(175, 531, 0.4)],''')\nrep('''img=bot, rings=[(201, 532, 0.3)],''', '''img=bot, rings=[(175, 573, 0.3)],''')\n\nrep('''    audio_parts, t0 = [], 0.0\n    for s in scenes:\n        s[\"dur\"] = dur(VOICE / f\"{s['voice']}.mp3\") + s[\"pad\"] + 0.25\n        audio_parts.append((t0 + 0.25, VOICE / f\"{s['voice']}.mp3\"))\n        t0 += s[\"dur\"]''', '''    audio_parts, t0 = [(0.0, P / \"sfx/whoosh.mp3\", 0.7)], 0.0\n    for s in scenes:\n        if s[\"voice\"]:\n            s[\"dur\"] = dur(VOICE / f\"{s['voice']}.mp3\") + s[\"pad\"] + 0.25\n            audio_parts.append((t0 + 0.25, VOICE / f\"{s['voice']}.mp3\", 1.0))\n        t0 += s[\"dur\"]''')\n\nrep('''    n = 0\n    for s in scenes:\n        nf = int(round(s[\"dur\"] * FPS))\n        for i in range(nf):\n            t = i / FPS\n            im = frame(s, t, s[\"dur\"])\n            # fade in/out 0.35 s\n            k = min(1, t / 0.22, (s[\"dur\"] - t) / 0.22)\n            if k < 1:\n                im = Image.blend(Image.new(\"RGB\", (W, H), BG_BOT), im, max(0, k))\n            ff.stdin.write(im.tobytes())\n            n += 1\n        print(s[\"voice\"], nf, \"frames\", flush=True)''', '''    cut = TMP / \"reveal_cut.png\"\n    subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-ss\", str(INTRO_CUT - 0.04), \"-i\", str(INTRO), \"-frames:v\", \"1\", str(cut)], check=True)\n    reveal_last = Image.open(cut).convert(\"RGB\")\n    for s in scenes:\n        nf = int(round(s[\"dur\"] * FPS))\n        for i in range(nf):\n            t = i / FPS\n            if s.get(\"fly\"):\n                im = fly_frame(t, reveal_last)\n            else:\n                im = frame(s, t, s[\"dur\"])\n                k = min(1, t / 0.22, (s[\"dur\"] - t) / 0.22)   # scene fade; the corner logo stays steady\n                if k < 1:\n                    im = Image.blend(Image.new(\"RGB\", (W, H), BG_BOT), im, max(0, k))\n                paste_logo(im, *LOGO_TO, WATERMARK_ALPHA)\n            ff.stdin.write(im.tobytes())\n        print(s[\"voice\"] or \"fly\", nf, \"frames\", flush=True)''')\n\nrep('''    for _, p in audio_parts:\n        cmd += [\"-i\", str(p)]\n    delays = \";\".join(f\"[{i}:a]adelay={int(off * 1000)}|{int(off * 1000)}[a{i}]\" for i, (off, _) in enumerate(audio_parts))''', '''    for _, p, _ in audio_parts:\n        cmd += [\"-i\", str(p)]\n    delays = \";\".join(f\"[{i}:a]volume={vol},adelay={int(off * 1000)}|{int(off * 1000)}[a{i}]\"\n                      for i, (off, _, vol) in enumerate(audio_parts))''')\n\nrep('''    intro = P / \"intro/nexo-reveal-9x16-1080x1920.mp4\"   # animated Nexo logo, 5 s, no audio\n    if intro.exists():\n        with_intro = P / \"nexo-karing_FINAL_intro.mp4\"\n        subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(intro), \"-i\", str(final), \"-filter_complex\",\n                        \"[0:v]trim=0:4.6,setpts=PTS-STARTPTS,fade=t=out:st=4.2:d=0.4[iv];anullsrc=r=44100:cl=stereo,atrim=0:4.6[ia];\"\n                        \"[iv][ia][1:v][1:a]concat=n=2:v=1:a=1[v][a]\", \"-map\", \"[v]\", \"-map\", \"[a]\", \"-c:v\", \"libx264\", \"-preset\", \"medium\",\n                        \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", \"-r\", str(FPS), \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-movflags\", \"+faststart\", str(with_intro)], check=True)\n        final = with_intro''', '''    # intro: the reveal sped up, with its sound, then straight into the fly-to-corner of the main video\n    intro_len = INTRO_CUT / INTRO_SPEED\n    with_intro = P / \"nexo-karing_FINAL_intro.mp4\"\n    subprocess.run([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", str(INTRO), \"-i\", str(P / \"sfx/reveal.mp3\"), \"-i\", str(final), \"-filter_complex\",\n                    f\"[0:v]trim=0:{INTRO_CUT},setpts=(PTS-STARTPTS)/{INTRO_SPEED},fps={FPS}[iv];\"\n                    f\"[1:a]volume=0.8,apad,atrim=0:{intro_len:.3f},afade=t=out:st={intro_len - 0.3:.3f}:d=0.3,aformat=sample_rates=44100:channel_layouts=stereo[ia];\"\n                    \"[2:a]aformat=sample_rates=44100:channel_layouts=stereo[ma];\"\n                    \"[iv][ia][2:v][ma]concat=n=2:v=1:a=1[v][a]\", \"-map\", \"[v]\", \"-map\", \"[a]\", \"-c:v\", \"libx264\", \"-preset\", \"medium\",\n                    \"-crf\", \"19\", \"-pix_fmt\", \"yuv420p\", \"-r\", str(FPS), \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-movflags\", \"+faststart\", str(with_intro)], check=True)\n    final = with_intro''')\nopen(p,'w').write(s); print('patched')\nEOF\npython3 build_nexo_karing.py voice_marat 2>&1 | tail -3","description":"Add fast intro, sound, logo fly-to-corner watermark and rebuild","timeout":600000},"caller":{"type":"direct"}}]}}
